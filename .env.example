# Gryffi Community Edition settings
#
# The install script writes this file for you, with random passwords. When you
# set it up by hand: copy it to .env and fill in every value marked "required".
# Generate a password with:  openssl rand -hex 24
#
# Everything else (AI provider, email, options) is set in the setup wizard and
# later under Installation in the dashboard.

# Version to run. A fixed version (for example 1.0.0) is safer than latest;
# "gryffi update" changes it for you.
GRYFFI_VERSION=latest

# Web address of Gryffi, as people type it (required)
APP_URL=https://gryffi.example.com

# Domain for automatic HTTPS with Caddy (the https profile)
GRYFFI_DOMAIN=gryffi.example.com

# Optional services: https, parser, nsfw (comma separated, may be empty)
COMPOSE_PROFILES=https,parser,nsfw

# Port on 127.0.0.1 for a reverse proxy of your own (without the https profile)
GRYFFI_PORT=3000

# Database owner, used for migrations (required)
DB_PASSWORD=
# Database login of the app itself, with fewer rights (required)
APP_DB_PASSWORD=
# Redis (required)
REDIS_PASSWORD=
# Signs the login sessions (required, at least 32 characters)
SESSION_SECRET=
# Encrypts the API keys and passwords stored in the database (required).
# 64 hexadecimal characters: openssl rand -hex 32
# Keep a copy outside this server: without it, a restored backup cannot read
# its stored keys.
OAUTH_TOKEN_KEY=

# Automatic daily backups kept in ./backups (0 switches them off)
GRYFFI_BACKUP_KEEP=7
