#!/usr/bin/env bash
# gryffi: manage a Gryffi Community Edition installation
#
#   gryffi status             containers, version and health
#   gryffi logs [service]     last log lines (add -f to follow)
#   gryffi start | stop | restart
#   gryffi update [version]   back up, then switch to a version (default: the latest release)
#   gryffi backup             back up the database and uploaded files to ./backups
#   gryffi restore <file>     put a backup back (replaces all current data; --yes skips the question)
#   gryffi setup-code         new one-time link for the setup wizard
#   gryffi doctor             run the installation checks of the setup wizard
#   gryffi version
#
# The installation lives in /opt/gryffi, or in GRYFFI_HOME.
set -euo pipefail

GRYFFI_CLI_VERSION="1.0.0"
GRYFFI_HOME="${GRYFFI_HOME:-/opt/gryffi}"
GRYFFI_REPO="${GRYFFI_REPO:-lloydstellar/gryffi}"
RELEASES_URL="${GRYFFI_RELEASES_URL:-https://github.com/$GRYFFI_REPO/releases}"
# Seconds Gryffi may take to start after an update or restore
START_TIMEOUT="${GRYFFI_START_TIMEOUT:-300}"

CLEANUP=()
trap 'rm -rf "${CLEANUP[@]}"' EXIT

die() { echo "gryffi: $*" >&2; exit 1; }
info() { echo "$*"; }

[ -f "$GRYFFI_HOME/compose.yml" ] || die "no installation in $GRYFFI_HOME (set GRYFFI_HOME if it is elsewhere)"
[ -f "$GRYFFI_HOME/.env" ] || die "$GRYFFI_HOME/.env is missing"
command -v docker >/dev/null || die "docker is not installed"

compose() { docker compose --project-directory "$GRYFFI_HOME" -f "$GRYFFI_HOME/compose.yml" "$@"; }

# Value of a key in .env, empty when the key is missing
env_value() {
  { grep -E "^$1=" "$GRYFFI_HOME/.env" || true; } | tail -1 | cut -d= -f2- | sed 's/^"\(.*\)"$/\1/'
}

set_env_value() {
  local key="$1" value="$2" file="$GRYFFI_HOME/.env"
  if grep -qE "^$key=" "$file"; then
    sed -i "s|^$key=.*|$key=$value|" "$file"
  else
    echo "$key=$value" >> "$file"
  fi
}

running_version() {
  compose exec -T app printenv GRYFFI_VERSION 2>/dev/null || echo unknown
}

# Wait until the app answers /health from inside its container
wait_healthy() {
  local seconds="${1:-$START_TIMEOUT}" waited=0
  while [ "$waited" -lt "$seconds" ]; do
    if compose exec -T app wget -q -O /dev/null http://localhost:3000/health 2>/dev/null; then
      return 0
    fi
    sleep 5
    waited=$((waited + 5))
  done
  return 1
}

latest_version() {
  # The latest release redirects to /releases/tag/v1.2.3
  local url
  url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$RELEASES_URL/latest")" || return 1
  echo "${url##*/v}"
}

# ---------------------------------------------------------------- commands

cmd_status() {
  info "Installation: $GRYFFI_HOME"
  info "Version:      $(running_version) (set in .env: $(env_value GRYFFI_VERSION))"
  info "Address:      $(env_value APP_URL)"
  echo
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  if compose exec -T app wget -q -O /dev/null http://localhost:3000/health 2>/dev/null; then
    info "Health: Gryffi answers."
  else
    info "Health: Gryffi does not answer. See: gryffi logs app"
    return 1
  fi
}

cmd_logs() {
  local follow=() service=()
  for arg in "$@"; do
    if [ "$arg" = "-f" ]; then follow=(-f); else service+=("$arg"); fi
  done
  compose logs --tail 200 "${follow[@]}" "${service[@]}"
}

cmd_backup() {
  local auto=0
  [ "${1:-}" = "--auto" ] && auto=1
  local keep
  keep="$(env_value GRYFFI_BACKUP_KEEP)"
  keep="${keep:-7}"
  if [ "$auto" = 1 ] && [ "$keep" = "0" ]; then
    info "Automatic backups are off (GRYFFI_BACKUP_KEEP=0)."
    return 0
  fi

  local dir="$GRYFFI_HOME/backups" stamp work file
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dir"
  chmod 700 "$dir"
  work="$(mktemp -d)"
  CLEANUP+=("$work")

  info "Backing up the database..."
  compose exec -T db pg_dump -U gryffi_user -d gryffi_db -Fc > "$work/database.dump" \
    || die "the database backup failed"
  info "Backing up the uploaded files..."
  compose exec -T app tar -C /app/uploads -cf - . > "$work/uploads.tar" \
    || die "the backup of the uploaded files failed"
  printf 'version=%s\ncreated=%s\n' "$(running_version)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$work/backup-info.txt"

  file="$dir/gryffi-$stamp.tar.gz"
  tar -C "$work" -czf "$file" database.dump uploads.tar backup-info.txt
  chmod 600 "$file"
  info "Backup: $file ($(du -h "$file" | cut -f1))"

  if [ "$keep" -gt 0 ] 2>/dev/null; then
    # Oldest first; remove all but the newest $keep
    find "$dir" -maxdepth 1 -name 'gryffi-*.tar.gz' -printf '%T@ %p\n' | sort -n | head -n "-$keep" | cut -d' ' -f2- \
      | while IFS= read -r old; do rm -f "$old"; info "Removed old backup: $old"; done
  fi
  if [ "$auto" = 0 ]; then
    info "The backup does not contain the encryption key (OAUTH_TOKEN_KEY in $GRYFFI_HOME/.env)."
    info "Keep a copy of .env in a safe place: without it, stored API keys cannot be read after a restore."
  fi
}

cmd_restore() {
  local file="" yes=0 arg
  for arg in "$@"; do
    if [ "$arg" = "--yes" ]; then yes=1; else file="$arg"; fi
  done
  [ -n "$file" ] || die "usage: gryffi restore <backup file> [--yes]"
  [ -f "$file" ] || die "$file does not exist"
  local work
  work="$(mktemp -d)"
  CLEANUP+=("$work")
  tar -C "$work" -xzf "$file" || die "$file is not a Gryffi backup"
  if [ ! -f "$work/database.dump" ] || [ ! -f "$work/uploads.tar" ]; then
    die "$file is not a Gryffi backup"
  fi

  info "Backup: $file"
  sed 's/^/  /' "$work/backup-info.txt" 2>/dev/null || true
  info "This replaces ALL current data of this installation (database and uploaded files)."
  if [ "$yes" = 0 ]; then
    local answer=""
    printf 'Type restore to continue: '
    if ! read -r answer 2>/dev/null < /dev/tty; then
      echo
      die "no terminal to ask for confirmation; add --yes to restore without asking"
    fi
    [ "$answer" = "restore" ] || die "nothing changed"
  fi

  info "Stopping Gryffi..."
  compose stop app
  info "Restoring the database..."
  compose exec -T db psql -q -U gryffi_user -d postgres \
    -c "DROP DATABASE IF EXISTS gryffi_db WITH (FORCE)" -c "CREATE DATABASE gryffi_db OWNER gryffi_user" >/dev/null
  compose exec -T db pg_restore -U gryffi_user -d gryffi_db --no-owner --role=gryffi_user < "$work/database.dump" \
    || die "the database restore reported errors (see above)"
  info "Restoring the uploaded files..."
  compose run --rm --no-deps -T --entrypoint sh app -c 'find /app/uploads -mindepth 1 -delete && tar -C /app/uploads -xf -' \
    < "$work/uploads.tar" || die "restoring the uploaded files failed"
  info "Starting Gryffi..."
  compose up -d app
  if wait_healthy "$START_TIMEOUT"; then
    info "Restored. Gryffi answers again."
  else
    die "Gryffi does not answer after the restore. See: gryffi logs app"
  fi
}

cmd_update() {
  local target="${1:-}"
  local current
  current="$(env_value GRYFFI_VERSION)"
  if [ -z "$target" ]; then
    info "Looking up the latest release..."
    target="$(latest_version)" || die "could not reach $RELEASES_URL"
  fi
  target="${target#v}"
  [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "not a version: $target"
  if [ "$target" = "$current" ] && [ "${GRYFFI_FORCE:-0}" != "1" ]; then
    info "Gryffi $current is already installed."
    return 0
  fi

  info "Updating from $current to $target."
  local new_compose
  new_compose="$(mktemp)"
  CLEANUP+=("$new_compose")
  curl -fsSL "$RELEASES_URL/download/v$target/compose.yml" -o "$new_compose" \
    || die "could not download compose.yml of version $target"

  cmd_backup
  cp "$GRYFFI_HOME/compose.yml" "$GRYFFI_HOME/compose.yml.previous"

  install -m 644 "$new_compose" "$GRYFFI_HOME/compose.yml"
  set_env_value GRYFFI_VERSION "$target"

  info "Downloading the new images..."
  if ! compose pull --quiet || ! compose up -d --remove-orphans; then
    rollback "$current"
  fi
  info "Waiting for Gryffi to start (the database is updated first)..."
  if ! wait_healthy "$START_TIMEOUT"; then
    rollback "$current"
  fi
  rm -f "$GRYFFI_HOME/compose.yml.previous"
  info "Gryffi $target is running."
}

rollback() {
  local previous="$1"
  echo "The update failed. Last log lines of the new version:" >&2
  compose logs --no-log-prefix --tail 30 app >&2 || true
  echo "Going back to $previous..." >&2
  mv "$GRYFFI_HOME/compose.yml.previous" "$GRYFFI_HOME/compose.yml"
  set_env_value GRYFFI_VERSION "$previous"
  compose up -d --remove-orphans || true
  if wait_healthy "$START_TIMEOUT"; then
    die "update failed; version $previous runs again"
  fi
  die "update failed and $previous does not start either. Restore the backup made before the update: gryffi restore <file in $GRYFFI_HOME/backups>"
}

cmd_version() {
  info "gryffi command $GRYFFI_CLI_VERSION"
  info "Gryffi $(running_version)"
}

case "${1:-}" in
  status) cmd_status ;;
  logs) shift; cmd_logs "$@" ;;
  start) compose up -d ;;
  stop) compose stop ;;
  restart) compose restart ;;
  update) shift; cmd_update "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  setup-code) compose exec -T app node src/setup/cli.js new-code ;;
  doctor) compose exec -T app node src/setup/cli.js doctor ;;
  version | --version) cmd_version ;;
  help | --help | -h | "") sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see: gryffi help)" ;;
esac
