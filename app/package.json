{
  "name": "gryffi-app",
  "version": "1.0.0",
  "description": "Gryffi - Interactive Journey Builder for Business",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/cluster.js",
    "start:single": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "lint": "eslint src/ public/js/ test/",
    "lint:fix": "eslint src/ public/js/ test/ --fix",
    "lint:security": "eslint src/ --rule 'security/*: error'",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [
    "saas",
    "gryffi",
    "decision-tree",
    "onboarding",
    "interactive-journey"
  ],
  "author": "Gryffi",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.1",
    "image-size": "^2.0.2",
    "ioredis": "^5.3.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "tailwindcss": "^3.4.0"
  }
}
