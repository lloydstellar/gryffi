    // Toast helper functions (safe fallback if window.gryffi is not yet loaded)
    const toastSuccess = (message) => {
      if (window.gryffi?.toast?.success) {
        window.gryffi.toast.success(message);
      } else {
        console.log('[Toast Success]', message);
      }
    };
    const toastError = (message) => {
      if (window.gryffi?.toast?.error) {
        window.gryffi.toast.error(message);
      } else {
        console.error('[Toast Error]', message);
      }
    };
    
    // Show limit exceeded modal with upgrade CTA
    async function showLimitExceededModal(limitType) {
      const resourceLabels = {
        journeys: <%-safeJson(t('subscription.features.journeys'))%>,
        guides: <%-safeJson(t('subscription.features.guides'))%>,
        endUsers: <%-safeJson(t('subscription.features.endUsers'))%>,
        makers: <%-safeJson(t('subscription.features.makers'))%>
      };
      
      const resourceName = resourceLabels[limitType] || limitType;
      const message = <%-safeJson(t('subscription.banner.limitReached'))%>.replace('{{resource}}', resourceName);
      
      const result = await window.gryffi.modal.confirm(
        `<div style="text-align: center;">
          <p style="margin: 0 0 16px; color: #4b5563;">${message}</p>
          <p style="margin: 0; font-size: 13px; color: #6b7280;"><%-t('subscription.limits.wantMore')%></p>
        </div>`,
        {
          title: <%-safeJson(t('subscription.limits.limitReached'))%>,
          type: 'warning',
          danger: false,
          okText: <%-safeJson(t('subscription.cta.upgradeNow'))%>,
          cancelText: <%-safeJson(t('common.cancel'))%>
        }
      );
      
      if (result) {
        window.location.href = '/dashboard/subscription';
      }
      
      return result;
    }
    
    // State
    let currentPage = 1;
    let totalPages = 1;
    let totalUsers = 0;
    let searchQuery = '';
    let searchTimeout = null;
    let deleteUserId = null;
    let currentImportMethod = 'manual';
    let validatedImportUsers = [];
    
    // DOM elements
    const usersTableContainer = document.getElementById('usersTableContainer');
    const pagination = document.getElementById('pagination');
    const prevPageBtn = document.getElementById('prevPageBtn');
    const nextPageBtn = document.getElementById('nextPageBtn');
    const pageInfo = document.getElementById('pageInfo');
    const searchInput = document.getElementById('searchInput');
    const addUserForm = document.getElementById('addUserForm');
    const editModal = document.getElementById('editModal');
    const deleteModal = document.getElementById('deleteModal');
    const editUserForm = document.getElementById('editUserForm');
    
    // Load users
    async function loadUsers() {
      try {
        const params = new URLSearchParams({
          page: currentPage,
          limit: 50
        });
        if (searchQuery) params.append('search', searchQuery);
        
        const response = await fetch(`/api/end-users?${params}`);
        const data = await response.json();
        
        if (data.success) {
          renderUsers(data.endUsers);
          updatePagination(data.pagination);
        }
      } catch (err) {
        console.error('Failed to load users:', err);
        toastError(<%-safeJson(t("systemSettings.endUsers.loadFailed"))%>);
      }
    }
    
    // Render users table
    function renderUsers(users) {
      if (users.length === 0) {
        usersTableContainer.innerHTML = `
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <h3>${searchQuery ? T.noSearchResults : T.noUsers}</h3>
            <p>${searchQuery ? '' : T.noUsersDescription}</p>
          </div>
        `;
        return;
      }
      
      const tableHtml = `
        <table class="users-table">
          <thead>
            <tr>
              <th>${T.name}</th>
              <th>${T.email}</th>
              <th>${T.groups.title}</th>
              <th>${T.source}</th>
              <th style="text-align: right;">${T.actions}</th>
            </tr>
          </thead>
          <tbody>
            ${users.map(user => `
              <tr data-user-id="${user.id}">
                <td>
                  <span class="user-name">${escapeHtml(user.first_name)} ${escapeHtml(user.last_name)}</span>
                </td>
                <td>
                  <span class="user-email">${escapeHtml(user.email)}</span>
                </td>
                <td>
                  <div class="user-groups-badges">
                    ${(user.groups && user.groups.length > 0) 
                      ? user.groups.map(g => `<span class="user-group-badge">${escapeHtml(g.name)}</span>`).join('')
                      : '<span class="text-zen-400">—</span>'}
                  </div>
                </td>
                <td>
                  <span class="source-badge ${user.source}">${T.sources[user.source] || user.source}</span>
                </td>
                <td>
                  <div class="actions-cell">
                    ${['manual', 'csv'].includes(user.source) ? `
                      <button class="btn btn-icon edit-user-btn" data-user-id="${user.id}" data-first-name="${escapeHtml(user.first_name)}" data-last-name="${escapeHtml(user.last_name)}" data-email="${escapeHtml(user.email)}" title="${T.editTooltip}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </button>
                      <button class="btn btn-icon danger delete-user-btn" data-user-id="${user.id}" data-user-name="${escapeHtml(user.first_name)} ${escapeHtml(user.last_name)}" title="${T.deleteTooltip}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    ` : ''}
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      
      usersTableContainer.innerHTML = tableHtml;
      
      // Bind edit button events
      document.querySelectorAll('.edit-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const id = this.dataset.userId;
          const firstName = this.dataset.firstName;
          const lastName = this.dataset.lastName;
          const email = this.dataset.email;
          openEditModal(id, firstName, lastName, email);
        });
      });
      
      // Bind delete button events
      document.querySelectorAll('.delete-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const id = this.dataset.userId;
          const name = this.dataset.userName;
          openDeleteModal(id, name);
        });
      });
    }
    
    // Update pagination
    function updatePagination(paginationData) {
      currentPage = paginationData.page;
      totalPages = paginationData.totalPages;
      totalUsers = paginationData.total;
      
      document.getElementById('usersCountText').innerHTML = plural(T.totalUsers_one, T.totalUsers_other, totalUsers).replace(totalUsers.toString(), `<strong>${totalUsers}</strong>`);
      
      if (totalPages > 1) {
        pagination.style.display = 'flex';
        pageInfo.textContent = T.pageOf.replace('{{current}}', currentPage).replace('{{total}}', totalPages);
        prevPageBtn.disabled = currentPage <= 1;
        nextPageBtn.disabled = currentPage >= totalPages;
      } else {
        pagination.style.display = 'none';
      }
    }
    
    // Add user
    addUserForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const firstName = document.getElementById('firstName').value.trim();
      const lastName = document.getElementById('lastName').value.trim();
      const email = document.getElementById('email').value.trim();
      
      const addBtn = document.getElementById('addUserBtn');
      addBtn.disabled = true;
      
      try {
        const response = await fetch('/api/end-users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ first_name: firstName, last_name: lastName, email })
        });
        
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message);
          addUserForm.reset();
          currentPage = 1;
          loadUsers();
        } else if (data.code === 'LIMIT_EXCEEDED') {
          await showLimitExceededModal(data.limitType || 'endUsers');
        } else {
          toastError(data.message);
        }
      } catch (err) {
        console.error('Failed to add user:', err);
        toastError(<%-safeJson(t("systemSettings.endUsers.createFailed"))%>);
      } finally {
        addBtn.disabled = false;
      }
    });
    
    // Search
    searchInput.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        searchQuery = e.target.value.trim();
        currentPage = 1;
        loadUsers();
      }, 300);
    });
    
    // Pagination
    prevPageBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadUsers();
      }
    });
    
    nextPageBtn.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadUsers();
      }
    });
    
    // Edit modal
    let editUserGroups = []; // Groups the user is currently in
    
    async function openEditModal(id, firstName, lastName, email) {
      document.getElementById('editUserId').value = id;
      document.getElementById('editFirstName').value = firstName;
      document.getElementById('editLastName').value = lastName;
      document.getElementById('editEmail').value = email;
      editModal.classList.add('active');
      
      // Load user's groups
      await loadEditUserGroups(id);
    }
    
    function closeEditModal() {
      editModal.classList.remove('active');
      editUserGroups = [];
    }
    
    // Load groups for the user being edited
    async function loadEditUserGroups(userId) {
      const groupsList = document.getElementById('editUserGroupsList');
      const addGroupSelect = document.getElementById('editUserAddGroupSelect');
      
      try {
        // Get all groups to populate the dropdown
        const allGroupsResponse = await fetch('/api/groups');
        const allGroupsData = await allGroupsResponse.json();
        const allGroups = allGroupsData.success ? allGroupsData.groups : [];
        
        // Find which groups this user is in by checking each group
        editUserGroups = [];
        for (const group of allGroups) {
          const groupDetailResponse = await fetch(`/api/groups/${group.id}`);
          const groupDetail = await groupDetailResponse.json();
          if (groupDetail.success && groupDetail.group.members) {
            const isMember = groupDetail.group.members.some(m => m.id === userId);
            if (isMember) {
              editUserGroups.push({ id: group.id, name: group.name });
            }
          }
        }
        
        // Render user's current groups
        renderEditUserGroups();
        
        // Populate dropdown with groups user is NOT in
        const userGroupIds = editUserGroups.map(g => g.id);
        const availableGroups = allGroups.filter(g => !userGroupIds.includes(g.id));
        
        addGroupSelect.innerHTML = '<option value="">— ' + T.groups.addToGroup + ' —</option>';
        availableGroups.forEach(group => {
          const option = document.createElement('option');
          option.value = group.id;
          option.textContent = group.name;
          addGroupSelect.appendChild(option);
        });
      } catch (err) {
        console.error('Failed to load user groups:', err);
        groupsList.innerHTML = '<span class="edit-user-no-groups">Error loading groups</span>';
      }
    }
    
    // Render the groups tags in edit modal
    function renderEditUserGroups() {
      const groupsList = document.getElementById('editUserGroupsList');
      
      if (editUserGroups.length === 0) {
        groupsList.innerHTML = '<span class="edit-user-no-groups">' + T.groups.noMembers + '</span>';
        return;
      }
      
      groupsList.innerHTML = editUserGroups.map(group => `
        <span class="edit-user-group-tag">
          ${escapeHtml(group.name)}
          <button type="button" class="remove-from-group" data-group-id="${group.id}" title="${T.groups.removeFromGroup}">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </span>
      `).join('');
      
      // Bind remove buttons
      groupsList.querySelectorAll('.remove-from-group').forEach(btn => {
        btn.addEventListener('click', async function(e) {
          e.preventDefault();
          const groupId = this.dataset.groupId;
          await removeUserFromGroupInEdit(groupId);
        });
      });
    }
    
    // Add user to a group from edit modal
    async function addUserToGroupInEdit() {
      const userId = document.getElementById('editUserId').value;
      const groupId = document.getElementById('editUserAddGroupSelect').value;
      
      if (!userId || !groupId) return;
      
      try {
        const response = await fetch(`/api/groups/${groupId}/members`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userIds: [userId] })
        });
        
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          await loadEditUserGroups(userId);
          loadUsers(); // Refresh user list
          loadGroups(); // Refresh group counts
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to add user to group:', err);
      }
    }
    
    // Remove user from a group from edit modal
    async function removeUserFromGroupInEdit(groupId) {
      const userId = document.getElementById('editUserId').value;
      
      if (!userId || !groupId) return;
      
      try {
        const response = await fetch(`/api/groups/${groupId}/members/${userId}`, { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          await loadEditUserGroups(userId);
          loadUsers(); // Refresh user list
          loadGroups(); // Refresh group counts
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to remove user from group:', err);
      }
    }
    
    // Add group button event listener
    document.getElementById('editUserAddGroupBtn')?.addEventListener('click', addUserToGroupInEdit);
    
    editUserForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = document.getElementById('editUserId').value;
      const firstName = document.getElementById('editFirstName').value.trim();
      const lastName = document.getElementById('editLastName').value.trim();
      const email = document.getElementById('editEmail').value.trim();
      
      try {
        const response = await fetch(`/api/end-users/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ first_name: firstName, last_name: lastName, email })
        });
        
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message);
          closeEditModal();
          loadUsers();
        } else {
          toastError(data.message);
        }
      } catch (err) {
        console.error('Failed to update user:', err);
        toastSuccess(<%-safeJson(t("systemSettings.endUsers.updateFailed"))%>, true);
      }
    });
    
    // Delete modal
    function openDeleteModal(id, name) {
      deleteUserId = id;
      document.getElementById('deleteUserName').textContent = name;
      deleteModal.classList.add('active');
    }
    
    function closeDeleteModal() {
      deleteModal.classList.remove('active');
      deleteUserId = null;
    }
    
    document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
      if (!deleteUserId) return;
      
      try {
        const response = await fetch(`/api/end-users/${deleteUserId}`, {
          method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message);
          closeDeleteModal();
          loadUsers();
        } else {
          toastError(data.message);
        }
      } catch (err) {
        console.error('Failed to delete user:', err);
        toastSuccess(<%-safeJson(t("systemSettings.endUsers.deleteFailed"))%>, true);
      }
    });
    
    // Helper
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
    
    // Close modals on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeEditModal();
        closeDeleteModal();
        closeImportConfirmModal();
      }
    });
    
    // Close modals on backdrop click
    editModal.addEventListener('click', (e) => {
      if (e.target === editModal) closeEditModal();
    });
    deleteModal.addEventListener('click', (e) => {
      if (e.target === deleteModal) closeDeleteModal();
    });
    
    // Modal close/cancel button event listeners
    document.getElementById('editModalCloseBtn').addEventListener('click', closeEditModal);
    document.getElementById('editModalCancelBtn').addEventListener('click', closeEditModal);
    document.getElementById('deleteModalCloseBtn').addEventListener('click', closeDeleteModal);
    document.getElementById('deleteModalCancelBtn').addEventListener('click', closeDeleteModal);
    
    // ==========================================
    // Import Method Switching
    // ==========================================
    
    const manualEntryForm = document.getElementById('manualEntryForm');
    const csvImportForm = document.getElementById('csvImportForm');
    const googleWorkspaceForm = document.getElementById('googleWorkspaceForm');
    const microsoft365Form = document.getElementById('microsoft365Form');
    const importOptions = document.querySelectorAll('.import-option:not(.disabled)');
    
    importOptions.forEach(option => {
      option.addEventListener('click', function() {
        const method = this.dataset.method;
        if (method === currentImportMethod) return;
        
        // Update active state
        importOptions.forEach(opt => opt.classList.remove('active'));
        this.classList.add('active');
        
        currentImportMethod = method;
        
        // Save to localStorage for persistence
        localStorage.setItem('gryffi_import_method', method);
        
        // Update URL hash to include import method
        history.replaceState(null, null, '#users/' + method);
        
        // Show/hide forms
        manualEntryForm.style.display = 'none';
        csvImportForm.style.display = 'none';
        googleWorkspaceForm.style.display = 'none';
        microsoft365Form.style.display = 'none';
        
        if (method === 'manual') {
          manualEntryForm.style.display = 'block';
        } else if (method === 'csv') {
          csvImportForm.style.display = 'block';
          resetImportState();
        } else if (method === 'google') {
          googleWorkspaceForm.style.display = 'block';
          loadGoogleStatus();
        } else if (method === 'microsoft') {
          microsoft365Form.style.display = 'block';
          loadMicrosoftStatus();
        }
      });
    });
    
    // ==========================================
    // CSV Import
    // ==========================================
    
    const importDropzone = document.getElementById('importDropzone');
    const importFileInput = document.getElementById('importFileInput');
    const importErrors = document.getElementById('importErrors');
    const importErrorsList = document.getElementById('importErrorsList');
    const importErrorsTitle = document.getElementById('importErrorsTitle');
    const importPreview = document.getElementById('importPreview');
    const importConfirmModal = document.getElementById('importConfirmModal');
    
    // Dropzone click
    importDropzone.addEventListener('click', () => {
      importFileInput.click();
    });
    
    // Drag and drop
    importDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      importDropzone.classList.add('dragover');
    });
    
    importDropzone.addEventListener('dragleave', () => {
      importDropzone.classList.remove('dragover');
    });
    
    importDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      importDropzone.classList.remove('dragover');
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        handleFileUpload(files[0]);
      }
    });
    
    // File input change
    importFileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleFileUpload(e.target.files[0]);
      }
    });
    
    // Handle file upload
    async function handleFileUpload(file) {
      // Reset state
      resetImportState();
      
      // Check file size (10MB max)
      if (file.size > 10 * 1024 * 1024) {
        showImportError([{ message: T.import.fileTooLarge }]);
        return;
      }
      
      // Check file type
      const validExtensions = ['.csv', '.xlsx', '.xls', '.ods'];
      const fileExt = '.' + file.name.split('.').pop().toLowerCase();
      if (!validExtensions.includes(fileExt)) {
        showImportError([{ message: T.import.invalidFileType }]);
        return;
      }
      
      // Show processing state
      importDropzone.classList.add('processing');
      
      try {
        const formData = new FormData();
        formData.append('file', file);
        
        const response = await fetch('/api/end-users/import/validate', {
          method: 'POST',
          body: formData
        });
        
        const data = await response.json();
        
        importDropzone.classList.remove('processing');
        
        if (data.success) {
          showImportPreview(data);
        } else {
          showImportError(data.errors || [{ message: data.message }]);
        }
      } catch (err) {
        console.error('Import validation failed:', err);
        importDropzone.classList.remove('processing');
        showImportError([{ message: T.import.importFailed }]);
      }
      
      // Reset file input
      importFileInput.value = '';
    }
    
    // Show import error
    function showImportError(errors) {
      importErrors.style.display = 'block';
      importPreview.style.display = 'none';
      
      importErrorsTitle.textContent = T.import.errorTitle;
      importErrorsList.innerHTML = errors.map(err => `<li>${escapeHtml(err.message)}</li>`).join('');
    }
    
    // Show import preview
    function showImportPreview(data) {
      importErrors.style.display = 'none';
      importPreview.style.display = 'block';
      
      const preview = data.preview;
      validatedImportUsers = data.validatedUsers || [];
      
      // Update stats
      document.querySelector('#previewNewCount span').textContent = 
        T.import.newUsers.replace('{{count}}', preview.newUsers);
      
      if (preview.duplicates > 0) {
        document.getElementById('previewDuplicateCount').style.display = 'flex';
        document.querySelector('#previewDuplicateCount span').textContent = 
          T.import.duplicates.replace('{{count}}', preview.duplicates);
      } else {
        document.getElementById('previewDuplicateCount').style.display = 'none';
      }
      
      if (preview.skippedHeader) {
        document.getElementById('previewHeaderSkipped').style.display = 'flex';
        document.querySelector('#previewHeaderSkipped span').textContent = T.import.skippedHeader;
      } else {
        document.getElementById('previewHeaderSkipped').style.display = 'none';
      }
      
      // Sample users
      const sampleUsersList = document.getElementById('sampleUsersList');
      if (preview.sampleUsers && preview.sampleUsers.length > 0) {
        document.getElementById('sampleUsersSection').style.display = 'block';
        sampleUsersList.innerHTML = preview.sampleUsers.map(u => 
          `<li>${escapeHtml(u.first_name)} ${escapeHtml(u.last_name)} — ${escapeHtml(u.email)}</li>`
        ).join('');
      } else {
        document.getElementById('sampleUsersSection').style.display = 'none';
      }
      
      // Duplicate emails
      if (preview.duplicateEmails && preview.duplicateEmails.length > 0) {
        document.getElementById('duplicateEmailsSection').style.display = 'block';
        document.getElementById('duplicateEmailsList').innerHTML = 
          preview.duplicateEmails.map(email => `<li>${escapeHtml(email)}</li>`).join('');
      } else {
        document.getElementById('duplicateEmailsSection').style.display = 'none';
      }
    }
    
    // Reset import state
    function resetImportState() {
      importErrors.style.display = 'none';
      importPreview.style.display = 'none';
      validatedImportUsers = [];
    }
    
    // Cancel import
    document.getElementById('cancelImportBtn').addEventListener('click', resetImportState);
    
    // Confirm import button (opens confirmation modal)
    document.getElementById('confirmImportBtn').addEventListener('click', () => {
      if (validatedImportUsers.length === 0) return;
      
      document.getElementById('importConfirmMessage').textContent = 
        T.import.confirmMessage.replace('{{count}}', validatedImportUsers.length);
      importConfirmModal.classList.add('active');
    });
    
    // Import confirm modal
    function closeImportConfirmModal() {
      importConfirmModal.classList.remove('active');
    }
    
    document.getElementById('importConfirmModalCloseBtn').addEventListener('click', closeImportConfirmModal);
    document.getElementById('importConfirmCancelBtn').addEventListener('click', closeImportConfirmModal);
    importConfirmModal.addEventListener('click', (e) => {
      if (e.target === importConfirmModal) closeImportConfirmModal();
    });
    
    // Execute import
    document.getElementById('importConfirmYesBtn').addEventListener('click', async () => {
      if (validatedImportUsers.length === 0) return;
      
      try {
        const response = await fetch('/api/end-users/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ users: validatedImportUsers })
        });
        
        const data = await response.json();
        
        closeImportConfirmModal();
        
        if (data.success) {
          toastSuccess(T.import.success.replace('{{count}}', data.imported));
          resetImportState();
          loadUsers();
        } else if (data.code === 'LIMIT_EXCEEDED') {
          await showLimitExceededModal(data.limitType || 'endUsers');
        } else {
          toastError(data.message);
        }
      } catch (err) {
        console.error('Import failed:', err);
        closeImportConfirmModal();
        toastError(T.import.importFailed);
      }
    });
    
    // ==========================================
    // Google Workspace Integration
    // ==========================================
    
    const googleLoadingState = document.getElementById('googleLoadingState');
    const googleNotConnected = document.getElementById('googleNotConnected');
    const googleConnected = document.getElementById('googleConnected');
    const googleNotConfigured = document.getElementById('googleNotConfigured');
    const googleConnectBtn = document.getElementById('googleConnectBtn');
    const googleSyncBtn = document.getElementById('googleSyncBtn');
    const googleDisconnectBtn = document.getElementById('googleDisconnectBtn');
    const googleConnectedEmail = document.getElementById('googleConnectedEmail');
    const googleDomain = document.getElementById('googleDomain');
    const googleUserCount = document.getElementById('googleUserCount');
    const googleGroupCount = document.getElementById('googleGroupCount');
    const googleLastSync = document.getElementById('googleLastSync');
    const setupGuideToggle = document.getElementById('setupGuideToggle');
    const setupGuideContent = document.getElementById('setupGuideContent');
    const googleOrphanedUsersAlert = document.getElementById('googleOrphanedUsersAlert');
    const googleOrphanedUsersText = document.getElementById('googleOrphanedUsersText');
    const googleViewOrphanedUsersBtn = document.getElementById('googleViewOrphanedUsersBtn');
    const googleDeleteOrphanedUsersBtn = document.getElementById('googleDeleteOrphanedUsersBtn');
    const googleOrphanedGroupsAlert = document.getElementById('googleOrphanedGroupsAlert');
    const googleOrphanedGroupsText = document.getElementById('googleOrphanedGroupsText');
    const googleDeleteOrphanedGroupsBtn = document.getElementById('googleDeleteOrphanedGroupsBtn');
    const googleGroupsSelection = document.getElementById('googleGroupsSelection');
    const googleGroupsList = document.getElementById('googleGroupsList');
    const googleSaveConfigBtn = document.getElementById('googleSaveConfigBtn');
    const googleGroupsToSyncSection = document.getElementById('googleGroupsToSyncSection');
    const googleGroupsToSyncList = document.getElementById('googleGroupsToSyncList');
    const googleImportGroupMembers = document.getElementById('googleImportGroupMembers');
    const googleSyncGroupsCheckbox = document.getElementById('googleSyncGroups');
    
    let googleSyncConfig = { syncMode: 'all', syncGroups: true, selectedGroupIds: [], groupsToSync: [], importGroupMembersAsUsers: false };
    let googleAvailableGroups = [];
    
    // Setup Guide Toggle
    setupGuideToggle?.addEventListener('click', () => {
      const isExpanded = setupGuideContent.classList.contains('show');
      setupGuideContent.classList.toggle('show');
      setupGuideToggle.classList.toggle('expanded');
      const toggleText = setupGuideToggle.querySelector('span');
      if (toggleText) {
        toggleText.textContent = isExpanded 
          ? <%-safeJson(t("systemSettings.google.setupGuide.showGuide"))%>
          : <%-safeJson(t("systemSettings.google.setupGuide.hideGuide"))%>;
      }
    });
    
    // Copy buttons for setup guide
    document.querySelectorAll('.setup-copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const targetId = btn.dataset.copy;
        const targetEl = document.getElementById(targetId);
        const copiedText = btn.dataset.copiedText;
        const originalText = btn.textContent;
        
        if (targetEl) {
          try {
            await navigator.clipboard.writeText(targetEl.textContent);
            btn.textContent = copiedText;
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            console.error('Copy failed:', err);
          }
        }
      });
    });
    
    // Format relative time
    function formatRelativeTime(dateString) {
      if (!dateString) return '-';
      const date = new Date(dateString);
      const now = new Date();
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);
      
      if (diffMins < 1) return <%-safeJson(t("systemSettings.google.justNow"))%>;
      if (diffMins < 60) return diffMins + ' ' + <%-safeJson(t("systemSettings.google.minutesAgo"))%>;
      if (diffHours < 24) return diffHours + ' ' + <%-safeJson(t("systemSettings.google.hoursAgo"))%>;
      return diffDays + ' ' + <%-safeJson(t("systemSettings.google.daysAgo"))%>;
    }
    
    // Load Google connection status
    async function loadGoogleStatus() {
      try {
        // Show loading state
        googleLoadingState.style.display = 'block';
        googleNotConnected.style.display = 'none';
        googleConnected.style.display = 'none';
        googleNotConfigured.style.display = 'none';
        if (googleOrphanedUsersAlert) googleOrphanedUsersAlert.style.display = 'none';
        if (googleOrphanedGroupsAlert) googleOrphanedGroupsAlert.style.display = 'none';
        
        const response = await fetch('/api/google/status');
        const data = await response.json();
        
        googleLoadingState.style.display = 'none';
        
        if (!data.configured) {
          googleNotConfigured.style.display = 'block';
        } else if (data.connected) {
          googleConnected.style.display = 'block';
          googleConnectedEmail.textContent = data.connectedEmail || '';
          googleDomain.textContent = data.domain || '-';
          googleUserCount.textContent = data.userCount || '0';
          if (googleGroupCount) googleGroupCount.textContent = data.groupCount || '0';
          googleLastSync.textContent = formatRelativeTime(data.lastSync);
          
          // Load sync config
          googleSyncConfig = data.syncConfig || { syncMode: 'all', syncGroups: true, selectedGroupIds: [] };
          updateGoogleSyncConfigUI();
          
          // Load available groups
          loadGoogleGroups();
        } else {
          googleNotConnected.style.display = 'block';
          // Show orphaned users alert if there are Google users but no connection
          if (data.userCount > 0 && googleOrphanedUsersAlert) {
            googleOrphanedUsersAlert.style.display = 'block';
            googleOrphanedUsersText.textContent = <%-safeJson(t("systemSettings.google.orphanedUsersDescription"))%>.replace('{{count}}', data.userCount);
          }
          // Show orphaned groups alert if there are Google groups but no connection
          if (data.orphanedGroupCount > 0 && googleOrphanedGroupsAlert) {
            googleOrphanedGroupsAlert.style.display = 'block';
            googleOrphanedGroupsText.textContent = <%-safeJson(t("systemSettings.google.orphanedGroupsDescription"))%>.replace('{{count}}', data.orphanedGroupCount);
          }
          // Auto-expand setup guide when not connected
          if (setupGuideContent && !setupGuideContent.classList.contains('show')) {
            setupGuideContent.classList.add('show');
            setupGuideToggle?.classList.add('expanded');
            const toggleText = setupGuideToggle?.querySelector('span');
            if (toggleText) {
              toggleText.textContent = <%-safeJson(t("systemSettings.google.setupGuide.hideGuide"))%>;
            }
          }
        }
      } catch (err) {
        console.error('Failed to load Google status:', err);
        googleLoadingState.style.display = 'none';
        googleNotConfigured.style.display = 'block';
      }
    }
    
    // Update Google sync config UI
    function updateGoogleSyncConfigUI() {
      const syncModeAll = document.getElementById('googleSyncModeAll');
      const syncModeGroups = document.getElementById('googleSyncModeGroups');
      const syncGroupsCheckbox = document.getElementById('googleSyncGroups');
      
      if (syncModeAll && syncModeGroups) {
        syncModeAll.checked = googleSyncConfig.syncMode === 'all';
        syncModeGroups.checked = googleSyncConfig.syncMode === 'groups';
      }
      
      if (syncGroupsCheckbox) {
        syncGroupsCheckbox.checked = googleSyncConfig.syncGroups !== false;
      }
      
      if (googleGroupsSelection) {
        googleGroupsSelection.style.display = googleSyncConfig.syncMode === 'groups' ? 'block' : 'none';
      }
      
      // Update groups to sync section visibility
      if (googleGroupsToSyncSection) {
        googleGroupsToSyncSection.style.display = googleSyncConfig.syncGroups !== false ? 'block' : 'none';
      }
      
      // Update import group members checkbox
      if (googleImportGroupMembers) {
        googleImportGroupMembers.checked = googleSyncConfig.importGroupMembersAsUsers === true;
      }
    }
    
    // Handle sync mode change
    document.querySelectorAll('input[name="googleSyncMode"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        googleSyncConfig.syncMode = e.target.value;
        if (googleGroupsSelection) {
          googleGroupsSelection.style.display = e.target.value === 'groups' ? 'block' : 'none';
        }
      });
    });
    
    // Handle syncGroups checkbox change
    googleSyncGroupsCheckbox?.addEventListener('change', (e) => {
      googleSyncConfig.syncGroups = e.target.checked;
      if (googleGroupsToSyncSection) {
        googleGroupsToSyncSection.style.display = e.target.checked ? 'block' : 'none';
      }
    });
    
    // Handle import group members checkbox change
    googleImportGroupMembers?.addEventListener('change', (e) => {
      googleSyncConfig.importGroupMembersAsUsers = e.target.checked;
    });
    
    // Load available Google groups
    async function loadGoogleGroups() {
      if (!googleGroupsList && !googleGroupsToSyncList) return;
      
      try {
        if (googleGroupsList) googleGroupsList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 20px;"><%= t("common.loading") %></p>';
        if (googleGroupsToSyncList) googleGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 12px; font-size: 13px;"><%= t("common.loading") %></p>';
        
        const response = await fetch('/api/google/groups');
        const data = await response.json();
        
        if (data.success) {
          googleAvailableGroups = data.groups;
          renderGoogleGroupsList();
          renderGoogleGroupsToSyncList();
        } else {
          const errorMsg = data.message || <%-safeJson(t("errors.failedToLoad"))%>;
          if (googleGroupsList) googleGroupsList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 20px;">' + errorMsg + '</p>';
          if (googleGroupsToSyncList) googleGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 12px; font-size: 13px;">' + errorMsg + '</p>';
        }
      } catch (err) {
        console.error('Failed to load Google groups:', err);
        const errorMsg = <%-safeJson(t("errors.failedToLoad"))%>;
        if (googleGroupsList) googleGroupsList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 20px;">' + errorMsg + '</p>';
        if (googleGroupsToSyncList) googleGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 12px; font-size: 13px;">' + errorMsg + '</p>';
      }
    }
    
    // Render Google groups list (for user sync from groups)
    function renderGoogleGroupsList() {
      if (!googleGroupsList) return;
      
      if (googleAvailableGroups.length === 0) {
        googleGroupsList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 20px;"><%= t("systemSettings.google.noGroupsFound") %></p>';
        return;
      }
      
      let html = '';
      googleAvailableGroups.forEach(group => {
        const isChecked = googleSyncConfig.selectedGroupIds?.includes(group.id);
        html += `
          <label style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-bottom: 1px solid #e5e7eb; cursor: pointer;">
            <input type="checkbox" class="google-group-checkbox" data-group-id="${group.id}" ${isChecked ? 'checked' : ''} style="width: 16px; height: 16px;">
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 14px; font-weight: 500; color: #111827;">${escapeHtml(group.name)}</div>
              <div style="font-size: 12px; color: #6b7280;">${escapeHtml(group.email)} · ${group.memberCount} <%= t("systemSettings.google.membersLabel") %></div>
            </div>
          </label>
        `;
      });
      
      googleGroupsList.innerHTML = html;
      
      // Bind checkbox events
      googleGroupsList.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const groupId = e.target.dataset.groupId;
          if (e.target.checked) {
            if (!googleSyncConfig.selectedGroupIds.includes(groupId)) {
              googleSyncConfig.selectedGroupIds.push(groupId);
            }
          } else {
            googleSyncConfig.selectedGroupIds = googleSyncConfig.selectedGroupIds.filter(id => id !== groupId);
          }
        });
      });
    }
    
    // Render Google groups to sync list (for group sync selection)
    function renderGoogleGroupsToSyncList() {
      if (!googleGroupsToSyncList) return;
      
      if (googleAvailableGroups.length === 0) {
        googleGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 12px; font-size: 13px;"><%= t("systemSettings.google.noGroupsFound") %></p>';
        return;
      }
      
      let html = '';
      googleAvailableGroups.forEach(group => {
        const isChecked = googleSyncConfig.groupsToSync?.includes(group.id);
        html += `
          <label style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-bottom: 1px solid #f3f4f6; cursor: pointer;">
            <input type="checkbox" class="google-group-to-sync-checkbox" data-group-id="${group.id}" ${isChecked ? 'checked' : ''} style="width: 14px; height: 14px;">
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 13px; font-weight: 500; color: #111827;">${escapeHtml(group.name)}</div>
              <div style="font-size: 11px; color: #6b7280;">${group.memberCount} <%= t("systemSettings.google.membersLabel") %></div>
            </div>
          </label>
        `;
      });
      
      googleGroupsToSyncList.innerHTML = html;
      
      // Bind checkbox events
      googleGroupsToSyncList.querySelectorAll('.google-group-to-sync-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const groupId = e.target.dataset.groupId;
          if (!googleSyncConfig.groupsToSync) googleSyncConfig.groupsToSync = [];
          if (e.target.checked) {
            if (!googleSyncConfig.groupsToSync.includes(groupId)) {
              googleSyncConfig.groupsToSync.push(groupId);
            }
          } else {
            googleSyncConfig.groupsToSync = googleSyncConfig.groupsToSync.filter(id => id !== groupId);
          }
        });
      });
    }
    
    // Save Google sync config
    googleSaveConfigBtn?.addEventListener('click', async () => {
      try {
        googleSaveConfigBtn.disabled = true;
        
        const response = await fetch('/api/google/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            syncMode: googleSyncConfig.syncMode,
            selectedGroupIds: googleSyncConfig.selectedGroupIds,
            syncGroups: googleSyncGroupsCheckbox?.checked !== false,
            groupsToSync: googleSyncConfig.groupsToSync || [],
            importGroupMembersAsUsers: googleImportGroupMembers?.checked === true
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(<%-safeJson(t("systemSettings.google.configSaved"))%>);
        } else {
          toastError(data.message || <%-safeJson(t("errors.saveFailed"))%>);
        }
      } catch (err) {
        console.error('Failed to save Google config:', err);
        toastError(<%-safeJson(t("errors.saveFailed"))%>);
      } finally {
        googleSaveConfigBtn.disabled = false;
      }
    });
    
    // Connect to Google
    googleConnectBtn?.addEventListener('click', async () => {
      try {
        googleConnectBtn.disabled = true;
        const response = await fetch('/api/google/connect');
        const data = await response.json();
        
        if (data.success && data.authUrl) {
          // Redirect to Google OAuth
          window.location.href = data.authUrl;
        } else {
          toastError(data.message || T.google.connectFailed);
          googleConnectBtn.disabled = false;
        }
      } catch (err) {
        console.error('Google connect failed:', err);
        toastError(T.google.connectFailed);
        googleConnectBtn.disabled = false;
      }
    });
    
    // Sync users from Google
    googleSyncBtn?.addEventListener('click', async () => {
      try {
        // Validate: if groups mode is selected, at least one group must be selected
        if (googleSyncConfig.syncMode === 'groups' && googleSyncConfig.selectedGroupIds.length === 0) {
          toastError(<%-safeJson(t("systemSettings.google.noGroupsSelected"))%>);
          return;
        }
        
        googleSyncBtn.disabled = true;
        googleSyncBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <%= t('common.syncing') %>
        `;
        
        // First save the current config to ensure sync uses latest settings
        await fetch('/api/google/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            syncMode: googleSyncConfig.syncMode,
            selectedGroupIds: googleSyncConfig.selectedGroupIds,
            syncGroups: googleSyncGroupsCheckbox?.checked !== false,
            groupsToSync: googleSyncConfig.groupsToSync || [],
            importGroupMembersAsUsers: googleImportGroupMembers?.checked === true
          })
        });
        
        const response = await fetch('/api/google/sync', { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
          // Use the pre-formatted message from the server, or fallback to client-side formatting
          const syncCount = (data.added || 0) + (data.updated || 0);
          const message = data.message || plural(T.google.syncSuccess_one, T.google.syncSuccess_other, syncCount);
          toastSuccess(message);
          loadGoogleStatus(); // Refresh status to update user count
          loadUsers(); // Refresh user list
        } else {
          toastError(data.message || T.google.syncFailed);
        }
      } catch (err) {
        console.error('Google sync failed:', err);
        toastError(T.google.syncFailed);
      } finally {
        googleSyncBtn.disabled = false;
        googleSyncBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <%= t('systemSettings.google.syncButton') %>
        `;
      }
    });
    
    // Disconnect Google
    googleDisconnectBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.google.disconnectConfirm"))%>)) return;
      
      try {
        googleDisconnectBtn.disabled = true;
        const response = await fetch('/api/google/disconnect');
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(T.google.disconnected);
          loadGoogleStatus(); // Refresh status
        } else {
          toastError(data.message || T.google.disconnectFailed);
        }
      } catch (err) {
        console.error('Google disconnect failed:', err);
        toastError(T.google.disconnectFailed);
      } finally {
        googleDisconnectBtn.disabled = false;
      }
    });
    
    // View orphaned Google users (filter the user list)
    googleViewOrphanedUsersBtn?.addEventListener('click', () => {
      // Switch to manual tab to see the user list, then filter
      const manualOption = document.querySelector('[data-method="manual"]');
      if (manualOption) manualOption.click();
      // Set search to filter Google users
      if (searchInput) {
        searchInput.value = 'source:google';
        searchQuery = 'source:google';
        currentPage = 1;
        loadUsers();
      }
    });
    
    // Delete all orphaned Google users
    googleDeleteOrphanedUsersBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.google.confirmDeleteAllOrphaned"))%>)) return;
      
      try {
        googleDeleteOrphanedUsersBtn.disabled = true;
        const response = await fetch('/api/end-users/source/google', { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.google.orphanedUsersDeleted"))%>);
          loadGoogleStatus(); // Refresh to hide alert
          loadUsers(); // Refresh user list
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.endUsers.deleteFailed"))%>);
        }
      } catch (err) {
        console.error('Delete orphaned users failed:', err);
        toastError(<%-safeJson(t("systemSettings.endUsers.deleteFailed"))%>);
      } finally {
        googleDeleteOrphanedUsersBtn.disabled = false;
      }
    });
    
    // Delete all orphaned Google groups
    googleDeleteOrphanedGroupsBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.google.confirmDeleteAllOrphanedGroups"))%>)) return;
      
      try {
        googleDeleteOrphanedGroupsBtn.disabled = true;
        const response = await fetch('/api/groups/source/google', { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.google.orphanedGroupsDeleted"))%>);
          loadGoogleStatus(); // Refresh to hide alert
          loadGroups(); // Refresh groups list
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.groups.deleteFailed"))%>);
        }
      } catch (err) {
        console.error('Delete orphaned groups failed:', err);
        toastError(<%-safeJson(t("systemSettings.groups.deleteFailed"))%>);
      } finally {
        googleDeleteOrphanedGroupsBtn.disabled = false;
      }
    });
    
    // OAuth callback handling is now integrated into initTabs() for proper timing
    
    // ==========================================
    // Microsoft 365 Integration
    // ==========================================
    
    const microsoftLoadingState = document.getElementById('microsoftLoadingState');
    const microsoftNotConnected = document.getElementById('microsoftNotConnected');
    const microsoftConnected = document.getElementById('microsoftConnected');
    const microsoftNotConfigured = document.getElementById('microsoftNotConfigured');
    const microsoftConnectBtn = document.getElementById('microsoftConnectBtn');
    const microsoftSyncBtn = document.getElementById('microsoftSyncBtn');
    const microsoftDisconnectBtn = document.getElementById('microsoftDisconnectBtn');
    const microsoftConnectedTenant = document.getElementById('microsoftConnectedTenant');
    const microsoftTenantId = document.getElementById('microsoftTenantId');
    const microsoftUserCount = document.getElementById('microsoftUserCount');
    const microsoftGroupCount = document.getElementById('microsoftGroupCount');
    const microsoftLastSync = document.getElementById('microsoftLastSync');
    const microsoftSetupGuideToggle = document.getElementById('microsoftSetupGuideToggle');
    const microsoftSetupGuideContent = document.getElementById('microsoftSetupGuideContent');
    const microsoftOrphanedUsersAlert = document.getElementById('microsoftOrphanedUsersAlert');
    const microsoftOrphanedUsersText = document.getElementById('microsoftOrphanedUsersText');
    const microsoftViewOrphanedUsersBtn = document.getElementById('microsoftViewOrphanedUsersBtn');
    const microsoftDeleteOrphanedUsersBtn = document.getElementById('microsoftDeleteOrphanedUsersBtn');
    const microsoftOrphanedGroupsAlert = document.getElementById('microsoftOrphanedGroupsAlert');
    const microsoftOrphanedGroupsText = document.getElementById('microsoftOrphanedGroupsText');
    const microsoftDeleteOrphanedGroupsBtn = document.getElementById('microsoftDeleteOrphanedGroupsBtn');
    const microsoftSaveConfigBtn = document.getElementById('microsoftSaveConfigBtn');
    const microsoftGroupsSelection = document.getElementById('microsoftGroupsSelection');
    const microsoftGroupsList = document.getElementById('microsoftGroupsList');
    const microsoftGroupsToSyncSection = document.getElementById('microsoftGroupsToSyncSection');
    const microsoftGroupsToSyncList = document.getElementById('microsoftGroupsToSyncList');
    const microsoftImportGroupMembers = document.getElementById('microsoftImportGroupMembers');
    const microsoftSyncGroupsCheckbox = document.getElementById('microsoftSyncGroups');
    
    // Microsoft Sync Config
    let microsoftSyncConfig = { syncMode: 'all', syncGroups: true, selectedGroupIds: [], groupsToSync: [], importGroupMembersAsUsers: false };
    let microsoftAvailableGroups = [];
    
    // Setup Guide Toggle
    microsoftSetupGuideToggle?.addEventListener('click', () => {
      const isExpanded = microsoftSetupGuideContent.classList.contains('show');
      microsoftSetupGuideContent.classList.toggle('show');
      microsoftSetupGuideToggle.querySelector('span').textContent = isExpanded 
        ? <%-safeJson(t("systemSettings.microsoft.setupGuide.showGuide"))%>
        : <%-safeJson(t("systemSettings.microsoft.setupGuide.hideGuide"))%>;
    });
    
    // Load Microsoft status
    async function loadMicrosoftStatus() {
      try {
        microsoftLoadingState.style.display = 'block';
        microsoftNotConnected.style.display = 'none';
        microsoftConnected.style.display = 'none';
        microsoftNotConfigured.style.display = 'none';
        
        const response = await fetch('/api/microsoft/status');
        const data = await response.json();
        
        microsoftLoadingState.style.display = 'none';
        
        if (!data.configured) {
          microsoftNotConfigured.style.display = 'block';
        } else if (data.connected) {
          microsoftConnected.style.display = 'block';
          microsoftConnectedTenant.textContent = data.tenantName || data.tenantId || '';
          microsoftTenantId.textContent = data.tenantId ? `Tenant ID: ${data.tenantId}` : '';
          microsoftUserCount.textContent = data.userCount || '0';
          microsoftGroupCount.textContent = data.groupCount || '0';
          microsoftLastSync.textContent = formatRelativeTime(data.lastSync);
          
          // Load sync config
          microsoftSyncConfig = data.syncConfig || { syncMode: 'all', syncGroups: true, selectedGroupIds: [] };
          updateMicrosoftSyncConfigUI();
          
          // Load available groups
          loadMicrosoftGroups();
        } else {
          microsoftNotConnected.style.display = 'block';
          // Show orphaned users alert if there are Microsoft users but no connection
          if (data.userCount > 0 && microsoftOrphanedUsersAlert) {
            microsoftOrphanedUsersAlert.style.display = 'block';
            microsoftOrphanedUsersText.textContent = <%-safeJson(t("systemSettings.microsoft.orphanedUsersDescription"))%>.replace('{{count}}', data.userCount);
          }
          // Show orphaned groups alert if there are Microsoft groups but no connection
          if (data.orphanedGroupCount > 0 && microsoftOrphanedGroupsAlert) {
            microsoftOrphanedGroupsAlert.style.display = 'block';
            microsoftOrphanedGroupsText.textContent = <%-safeJson(t("systemSettings.microsoft.orphanedGroupsDescription"))%>.replace('{{count}}', data.orphanedGroupCount);
          }
          // Auto-expand setup guide when not connected
          if (microsoftSetupGuideContent && !microsoftSetupGuideContent.classList.contains('show')) {
            microsoftSetupGuideContent.classList.add('show');
            microsoftSetupGuideToggle?.classList.add('expanded');
            const toggleText = microsoftSetupGuideToggle?.querySelector('span');
            if (toggleText) {
              toggleText.textContent = <%-safeJson(t("systemSettings.microsoft.setupGuide.hideGuide"))%>;
            }
          }
        }
      } catch (err) {
        console.error('Failed to load Microsoft status:', err);
        microsoftLoadingState.style.display = 'none';
        microsoftNotConfigured.style.display = 'block';
      }
    }
    
    // Update sync config UI based on current config
    function updateMicrosoftSyncConfigUI() {
      const syncModeAll = document.getElementById('syncModeAll');
      const syncModeGroups = document.getElementById('syncModeGroups');
      
      if (syncModeAll && syncModeGroups) {
        syncModeAll.checked = microsoftSyncConfig.syncMode === 'all';
        syncModeGroups.checked = microsoftSyncConfig.syncMode === 'groups';
      }
      
      if (microsoftSyncGroupsCheckbox) {
        microsoftSyncGroupsCheckbox.checked = microsoftSyncConfig.syncGroups !== false;
      }
      
      microsoftGroupsSelection.style.display = microsoftSyncConfig.syncMode === 'groups' ? 'block' : 'none';
      
      // Update groups to sync section visibility
      if (microsoftGroupsToSyncSection) {
        microsoftGroupsToSyncSection.style.display = microsoftSyncConfig.syncGroups !== false ? 'block' : 'none';
      }
      
      // Update import group members checkbox
      if (microsoftImportGroupMembers) {
        microsoftImportGroupMembers.checked = microsoftSyncConfig.importGroupMembersAsUsers === true;
      }
    }
    
    // Handle Microsoft syncGroups checkbox change
    microsoftSyncGroupsCheckbox?.addEventListener('change', (e) => {
      microsoftSyncConfig.syncGroups = e.target.checked;
      if (microsoftGroupsToSyncSection) {
        microsoftGroupsToSyncSection.style.display = e.target.checked ? 'block' : 'none';
      }
    });
    
    // Handle Microsoft import group members checkbox change
    microsoftImportGroupMembers?.addEventListener('change', (e) => {
      microsoftSyncConfig.importGroupMembersAsUsers = e.target.checked;
    });
    
    // Sync mode change handlers
    document.querySelectorAll('input[name="microsoftSyncMode"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        microsoftSyncConfig.syncMode = e.target.value;
        microsoftGroupsSelection.style.display = e.target.value === 'groups' ? 'block' : 'none';
        
        // Update option styling
        document.querySelectorAll('.microsoft-sync-option').forEach(opt => {
          opt.classList.toggle('active', opt.dataset.mode === e.target.value);
        });
      });
    });
    
    // Load available Microsoft groups
    async function loadMicrosoftGroups() {
      try {
        if (microsoftGroupsList) microsoftGroupsList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 20px;"><%= t("common.loading") %></p>';
        if (microsoftGroupsToSyncList) microsoftGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 12px; font-size: 13px;"><%= t("common.loading") %></p>';
        
        const response = await fetch('/api/microsoft/groups');
        const data = await response.json();
        
        if (data.success) {
          microsoftAvailableGroups = data.groups;
          renderMicrosoftGroupsList();
          renderMicrosoftGroupsToSyncList();
        } else {
          const errorMsg = data.message || <%-safeJson(t("errors.failedToLoad"))%>;
          if (microsoftGroupsList) microsoftGroupsList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 20px;">' + errorMsg + '</p>';
          if (microsoftGroupsToSyncList) microsoftGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 12px; font-size: 13px;">' + errorMsg + '</p>';
        }
      } catch (err) {
        console.error('Failed to load Microsoft groups:', err);
        const errorMsg = <%-safeJson(t("errors.failedToLoad"))%>;
        if (microsoftGroupsList) microsoftGroupsList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 20px;">' + errorMsg + '</p>';
        if (microsoftGroupsToSyncList) microsoftGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #dc2626; padding: 12px; font-size: 13px;">' + errorMsg + '</p>';
      }
    }
    
    // Render groups list (for user sync from groups)
    function renderMicrosoftGroupsList() {
      if (!microsoftGroupsList) return;
      
      if (microsoftAvailableGroups.length === 0) {
        microsoftGroupsList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 20px;"><%= t("systemSettings.microsoft.noGroupsFound") %></p>';
        return;
      }
      
      let html = '';
      microsoftAvailableGroups.forEach(group => {
        const isSelected = microsoftSyncConfig.selectedGroupIds?.includes(group.id);
        html += `
          <div class="microsoft-group-checkbox">
            <input type="checkbox" id="msgroup_${group.id}" value="${group.id}" ${isSelected ? 'checked' : ''}>
            <label for="msgroup_${group.id}">
              <strong>${escapeHtml(group.name)}</strong>
              ${group.description ? `<br><small style="color: #64748b;">${escapeHtml(group.description)}</small>` : ''}
            </label>
          </div>
        `;
      });
      
      microsoftGroupsList.innerHTML = html;
      
      // Add change listeners
      microsoftGroupsList.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', () => {
          const groupId = checkbox.value;
          if (checkbox.checked) {
            if (!microsoftSyncConfig.selectedGroupIds.includes(groupId)) {
              microsoftSyncConfig.selectedGroupIds.push(groupId);
            }
          } else {
            microsoftSyncConfig.selectedGroupIds = microsoftSyncConfig.selectedGroupIds.filter(id => id !== groupId);
          }
        });
      });
    }
    
    // Render Microsoft groups to sync list (for group sync selection)
    function renderMicrosoftGroupsToSyncList() {
      if (!microsoftGroupsToSyncList) return;
      
      if (microsoftAvailableGroups.length === 0) {
        microsoftGroupsToSyncList.innerHTML = '<p style="text-align: center; color: #64748b; padding: 12px; font-size: 13px;"><%= t("systemSettings.microsoft.noGroupsFound") %></p>';
        return;
      }
      
      let html = '';
      microsoftAvailableGroups.forEach(group => {
        const isChecked = microsoftSyncConfig.groupsToSync?.includes(group.id);
        html += `
          <label style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-bottom: 1px solid #f3f4f6; cursor: pointer;">
            <input type="checkbox" class="microsoft-group-to-sync-checkbox" data-group-id="${group.id}" ${isChecked ? 'checked' : ''} style="width: 14px; height: 14px;">
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 13px; font-weight: 500; color: #111827;">${escapeHtml(group.name)}</div>
              ${group.description ? `<div style="font-size: 11px; color: #6b7280;">${escapeHtml(group.description)}</div>` : ''}
            </div>
          </label>
        `;
      });
      
      microsoftGroupsToSyncList.innerHTML = html;
      
      // Bind checkbox events
      microsoftGroupsToSyncList.querySelectorAll('.microsoft-group-to-sync-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const groupId = e.target.dataset.groupId;
          if (!microsoftSyncConfig.groupsToSync) microsoftSyncConfig.groupsToSync = [];
          if (e.target.checked) {
            if (!microsoftSyncConfig.groupsToSync.includes(groupId)) {
              microsoftSyncConfig.groupsToSync.push(groupId);
            }
          } else {
            microsoftSyncConfig.groupsToSync = microsoftSyncConfig.groupsToSync.filter(id => id !== groupId);
          }
        });
      });
    }
    
    // Save Microsoft sync config
    microsoftSaveConfigBtn?.addEventListener('click', async () => {
      try {
        microsoftSaveConfigBtn.disabled = true;
        
        const response = await fetch('/api/microsoft/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            syncMode: microsoftSyncConfig.syncMode,
            syncGroups: microsoftSyncGroupsCheckbox?.checked !== false,
            selectedGroupIds: microsoftSyncConfig.selectedGroupIds,
            groupsToSync: microsoftSyncConfig.groupsToSync || [],
            importGroupMembersAsUsers: microsoftImportGroupMembers?.checked === true
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.microsoft.configSaved"))%>);
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.microsoft.configFailed"))%>);
        }
      } catch (err) {
        console.error('Save config failed:', err);
        toastError(<%-safeJson(t("systemSettings.microsoft.configFailed"))%>);
      } finally {
        microsoftSaveConfigBtn.disabled = false;
      }
    });
    
    // Connect to Microsoft
    microsoftConnectBtn?.addEventListener('click', async () => {
      try {
        microsoftConnectBtn.disabled = true;
        const response = await fetch('/api/microsoft/connect');
        const data = await response.json();
        
        if (data.success && data.authUrl) {
          // Redirect to Microsoft OAuth
          window.location.href = data.authUrl;
        } else {
          toastError(data.message || T.microsoft?.connectFailed || 'Connection failed');
          microsoftConnectBtn.disabled = false;
        }
      } catch (err) {
        console.error('Microsoft connect failed:', err);
        toastError(T.microsoft?.connectFailed || 'Connection failed');
        microsoftConnectBtn.disabled = false;
      }
    });
    
    // Sync users from Microsoft
    microsoftSyncBtn?.addEventListener('click', async () => {
      try {
        // Validate: if groups mode is selected, at least one group must be selected
        if (microsoftSyncConfig.syncMode === 'groups' && microsoftSyncConfig.selectedGroupIds.length === 0) {
          toastError(<%-safeJson(t("systemSettings.microsoft.noGroupsSelected"))%>);
          return;
        }
        
        microsoftSyncBtn.disabled = true;
        microsoftSyncBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <%= t('common.syncing') %>
        `;
        
        // First save the current config to ensure sync uses latest settings
        await fetch('/api/microsoft/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            syncMode: microsoftSyncConfig.syncMode,
            selectedGroupIds: microsoftSyncConfig.selectedGroupIds,
            syncGroups: microsoftSyncGroupsCheckbox?.checked !== false,
            groupsToSync: microsoftSyncConfig.groupsToSync || [],
            importGroupMembersAsUsers: microsoftImportGroupMembers?.checked === true
          })
        });
        
        const response = await fetch('/api/microsoft/sync', { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.microsoft.syncSuccess"))%>);
          loadMicrosoftStatus(); // Refresh status
          loadUsers(); // Refresh user list
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.microsoft.syncFailed"))%>);
        }
      } catch (err) {
        console.error('Microsoft sync failed:', err);
        toastError(<%-safeJson(t("systemSettings.microsoft.syncFailed"))%>);
      } finally {
        microsoftSyncBtn.disabled = false;
        microsoftSyncBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <%= t('systemSettings.microsoft.syncButton') %>
        `;
      }
    });
    
    // Disconnect Microsoft
    microsoftDisconnectBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.microsoft.disconnectConfirm"))%>)) return;
      
      try {
        microsoftDisconnectBtn.disabled = true;
        const response = await fetch('/api/microsoft/disconnect');
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.microsoft.disconnected"))%>);
          loadMicrosoftStatus(); // Refresh status
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.microsoft.disconnectFailed"))%>);
        }
      } catch (err) {
        console.error('Microsoft disconnect failed:', err);
        toastError(<%-safeJson(t("systemSettings.microsoft.disconnectFailed"))%>);
      } finally {
        microsoftDisconnectBtn.disabled = false;
      }
    });
    
    // View orphaned Microsoft users
    microsoftViewOrphanedUsersBtn?.addEventListener('click', () => {
      // Set search to filter Microsoft users
      if (searchInput) {
        searchInput.value = 'source:microsoft';
        searchQuery = 'source:microsoft';
        currentPage = 1;
        loadUsers();
      }
    });
    
    // Delete all orphaned Microsoft users
    microsoftDeleteOrphanedUsersBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.microsoft.confirmDeleteAllOrphaned"))%>)) return;
      
      try {
        microsoftDeleteOrphanedUsersBtn.disabled = true;
        const response = await fetch('/api/end-users/source/microsoft', { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.microsoft.orphanedUsersDeleted"))%>);
          loadMicrosoftStatus(); // Refresh to hide alert
          loadUsers(); // Refresh user list
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.endUsers.deleteFailed"))%>);
        }
      } catch (err) {
        console.error('Delete orphaned users failed:', err);
        toastError(<%-safeJson(t("systemSettings.endUsers.deleteFailed"))%>);
      } finally {
        microsoftDeleteOrphanedUsersBtn.disabled = false;
      }
    });
    
    // Delete all orphaned Microsoft groups
    microsoftDeleteOrphanedGroupsBtn?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("systemSettings.microsoft.confirmDeleteAllOrphanedGroups"))%>)) return;
      
      try {
        microsoftDeleteOrphanedGroupsBtn.disabled = true;
        const response = await fetch('/api/groups/source/microsoft', { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          toastSuccess(data.message || <%-safeJson(t("systemSettings.microsoft.orphanedGroupsDeleted"))%>);
          loadMicrosoftStatus(); // Refresh to hide alert
          loadGroups(); // Refresh groups list
        } else {
          toastError(data.message || <%-safeJson(t("systemSettings.groups.deleteFailed"))%>);
        }
      } catch (err) {
        console.error('Delete orphaned groups failed:', err);
        toastError(<%-safeJson(t("systemSettings.groups.deleteFailed"))%>);
      } finally {
        microsoftDeleteOrphanedGroupsBtn.disabled = false;
      }
    });
    
    // Microsoft OAuth callback handling is now integrated into initTabs() for proper timing
    
    // ==========================================
    // Organization Settings
    // ==========================================
    
    const orgForm = document.getElementById('orgForm');
    const orgNameInput = document.getElementById('orgName');
    const saveOrgBtn = document.getElementById('saveOrgBtn');
    const orgLangMode = document.getElementById('orgLangMode');
    const orgLang = document.getElementById('orgLang');
    const orgLangFixedWrap = document.getElementById('orgLangFixedWrap');
    const orgCountry = document.getElementById('orgCountry');
    
    if (orgForm && orgNameInput) {
      const initialOrg = {
        name: (orgNameInput.value || '').trim(),
        mode: orgLangMode?.value || 'auto',
        lang: orgLang?.value || 'en',
        country: orgCountry?.value || ''
      };
      
      function updateOrgSaveEnabled() {
        if (!saveOrgBtn) return;
        const current = {
          name: (orgNameInput.value || '').trim(),
          mode: orgLangMode?.value || 'auto',
          lang: orgLang?.value || 'en',
          country: orgCountry?.value || ''
        };
        const effectiveLangChanged = current.mode === 'fixed'
          ? (current.mode !== initialOrg.mode || current.lang !== initialOrg.lang)
          : (current.mode !== initialOrg.mode);
        const countryChanged = current.country !== initialOrg.country;
        const changed = current.name !== initialOrg.name || effectiveLangChanged || countryChanged;
        saveOrgBtn.disabled = !changed;
      }
      
      function updateOrgLangUi() {
        if (!orgLangMode || !orgLangFixedWrap) return;
        const mode = orgLangMode.value || 'auto';
        orgLangFixedWrap.style.display = mode === 'fixed' ? '' : 'none';
        updateOrgSaveEnabled();
      }
      
      orgNameInput.addEventListener('input', updateOrgSaveEnabled);
      orgLangMode?.addEventListener('change', updateOrgLangUi);
      orgLang?.addEventListener('change', updateOrgSaveEnabled);
      orgCountry?.addEventListener('change', updateOrgSaveEnabled);
      updateOrgLangUi();
      updateOrgSaveEnabled();
      
      orgForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (orgNameInput.value || '').trim();
        if (!name) {
          toastSuccess(<%-safeJson(t("settings.organization.validationEmpty"))%>, true);
          return;
        }
        if (saveOrgBtn) saveOrgBtn.disabled = true;
        try {
          const mode = orgLangMode?.value || 'auto';
          const lang = orgLang?.value || 'en';
          const country = orgCountry?.value || '';
          const res = await fetch('/api/organization', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              default_language_mode: mode,
              default_language: mode === 'fixed' ? lang : undefined,
              country: country || undefined
            })
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.success) throw new Error(data.message || <%-safeJson(t("settings.organization.saveFailed"))%>);
          toastSuccess(data.message || <%-safeJson(t("settings.organization.saved"))%>);
          // Update sidebar org name if visible
          const sidebarOrg = document.querySelector('[data-organization-name]');
          if (sidebarOrg) sidebarOrg.textContent = name;
          // Reset initial values after successful save
          initialOrg.name = name;
          initialOrg.mode = mode;
          initialOrg.lang = lang;
          initialOrg.country = country;
        } catch (err) {
          toastSuccess(err.message || <%-safeJson(t("settings.organization.saveFailed"))%>, true);
        } finally {
          updateOrgSaveEnabled();
        }
      });
    }
    
    // Initial load
    loadUsers();
    
    // ==========================================
    // Data Export (Admin only)
    // ==========================================
    <% if (user && user.role === 'admin') { %>
    const exportBtn = document.getElementById('exportOrgBtn');
    const exportStatus = document.getElementById('exportStatus');
    if (exportBtn) {
      exportBtn.addEventListener('click', async () => {
        exportBtn.disabled = true;
        exportStatus.style.display = 'inline';
        exportStatus.textContent = '<%= t("systemSettings.dataExport.preparing") %>';
        
        try {
          const response = await fetch('/api/organization/export', {
            method: 'GET',
            credentials: 'same-origin'
          });
          
          if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(err.message || 'Export failed');
          }
          
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          const disposition = response.headers.get('Content-Disposition');
          const match = disposition && disposition.match(/filename="?(.+?)"?$/);
          a.download = match ? match[1] : 'gryffi-export.zip';
          document.body.appendChild(a);
          a.click();
          a.remove();
          window.URL.revokeObjectURL(url);
          
          exportStatus.textContent = '<%= t("systemSettings.dataExport.success") %>';
          setTimeout(() => { exportStatus.style.display = 'none'; }, 4000);
        } catch (err) {
          console.error('Export error:', err);
          exportStatus.style.color = '#c62828';
          exportStatus.textContent = '<%= t("systemSettings.dataExport.error") %>';
          setTimeout(() => { 
            exportStatus.style.display = 'none'; 
            exportStatus.style.color = '';
          }, 5000);
        } finally {
          exportBtn.disabled = false;
        }
      });
    }
    <% } %>

    // ==========================================
    // Delete Organization (Admin only)
    // ==========================================
    <% if (user && user.role === 'admin') { %>
    const deleteOrgBtn = document.getElementById('deleteOrgBtn');
    if (deleteOrgBtn) {
      deleteOrgBtn.addEventListener('click', async () => {
        const orgName = <%- safeJson(organization.name) %>;
        const dangerZoneT = {
          confirmTitle: <%-safeJson(t("systemSettings.dangerZone.confirmTitle"))%>,
          confirmStep1: <%-safeJson(t("systemSettings.dangerZone.confirmStep1"))%>.replace('{{orgName}}', orgName),
          confirmStep1Detail: <%-safeJson(t("systemSettings.dangerZone.confirmStep1Detail"))%>,
          confirmStep2: <%-safeJson(t("systemSettings.dangerZone.confirmStep2"))%>,
          confirmPlaceholder: <%-safeJson(t("systemSettings.dangerZone.confirmPlaceholder"))%>,
          confirmMismatch: <%-safeJson(t("systemSettings.dangerZone.confirmMismatch"))%>,
          buttonText: <%-safeJson(t("systemSettings.dangerZone.buttonText"))%>,
          deleting: <%-safeJson(t("systemSettings.dangerZone.deleting"))%>,
          success: <%-safeJson(t("systemSettings.dangerZone.success"))%>,
          error: <%-safeJson(t("systemSettings.dangerZone.error"))%>
        };

        // Step 1: First confirmation
        const step1 = await window.gryffi.modal.confirm(
          `<div style="text-align: left;">
            <p style="margin: 0 0 12px; color: #4b5563;">${dangerZoneT.confirmStep1}</p>
            <p style="margin: 0; font-size: 13px; color: #6b7280;">${dangerZoneT.confirmStep1Detail}</p>
          </div>`,
          {
            title: dangerZoneT.confirmTitle,
            danger: true,
            confirmText: dangerZoneT.buttonText,
            html: true
          }
        );
        if (!step1) return;

        // Step 2: Type organization name to confirm
        const typedName = await window.gryffi.modal.prompt(
          `<div style="text-align: left;">
            <p style="margin: 0 0 4px; color: #4b5563;">${dangerZoneT.confirmStep2}</p>
            <p style="margin: 0 0 12px; font-size: 13px; color: #9ca3af;"><strong>${escapeHtml(orgName)}</strong></p>
          </div>`,
          {
            title: dangerZoneT.confirmTitle,
            placeholder: dangerZoneT.confirmPlaceholder,
            okText: dangerZoneT.buttonText,
            html: true,
            danger: true
          }
        );
        if (!typedName || typedName.trim() !== orgName) {
          if (typedName !== null && typedName !== undefined) {
            window.gryffi.toast.error(dangerZoneT.confirmMismatch);
          }
          return;
        }

        // Execute deletion
        deleteOrgBtn.disabled = true;
        deleteOrgBtn.textContent = dangerZoneT.deleting;
        try {
          const response = await fetch('/api/organization', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ confirmName: typedName.trim() })
          });
          const data = await response.json();
          if (data.success) {
            window.gryffi.toast.success(dangerZoneT.success);
            setTimeout(() => { window.location.href = '/login'; }, 2000);
          } else {
            window.gryffi.toast.error(data.message || dangerZoneT.error);
            deleteOrgBtn.disabled = false;
            deleteOrgBtn.textContent = dangerZoneT.buttonText;
          }
        } catch (err) {
          window.gryffi.toast.error(dangerZoneT.error);
          deleteOrgBtn.disabled = false;
          deleteOrgBtn.textContent = dangerZoneT.buttonText;
        }
      });
    }
    <% } %>

    // ==========================================
    // API Key Management (Admin only)
    // ==========================================
    <% if (user && user.role === 'admin') { %>
    const apiKeyLoading = document.getElementById('apiKeyLoading');
    const apiNoAccess = document.getElementById('apiNoAccess');
    const apiNoKey = document.getElementById('apiNoKey');
    const apiNewKey = document.getElementById('apiNewKey');
    const apiHasKey = document.getElementById('apiHasKey');
    const newApiKeyValue = document.getElementById('newApiKeyValue');
    const apiKeyCreatedAt = document.getElementById('apiKeyCreatedAt');
    const apiKeyLastUsedAt = document.getElementById('apiKeyLastUsedAt');
    
    // Format date for display
    function formatApiDate(dateString) {
      if (!dateString) return '-';
      const date = new Date(dateString);
      return date.toLocaleDateString('<%= language %>', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }
    
    // Load API key status
    async function loadApiKeyStatus() {
      try {
        const response = await fetch('/api/api-key/status');
        const data = await response.json();
        
        apiKeyLoading.style.display = 'none';
        
        if (!data.api_access_enabled) {
          apiNoAccess.style.display = 'block';
          return;
        }
        
        if (data.has_api_key) {
          apiHasKey.style.display = 'block';
          apiKeyCreatedAt.textContent = formatApiDate(data.api_key_created_at);
          apiKeyLastUsedAt.textContent = data.api_key_last_used_at 
            ? formatApiDate(data.api_key_last_used_at) 
            : <%-safeJson(t("api.neverUsed"))%>;
        } else {
          apiNoKey.style.display = 'block';
        }
      } catch (err) {
        console.error('Failed to load API key status:', err);
        apiKeyLoading.style.display = 'none';
        apiNoAccess.style.display = 'block';
      }
    }
    
    // Generate new API key
    document.getElementById('generateApiKeyBtn')?.addEventListener('click', async () => {
      // Generate is a positive action
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("api.confirmGenerate"))%>, { danger: false })) return;
      
      const btn = document.getElementById('generateApiKeyBtn');
      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> <%= t("common.loading") %>';
      
      try {
        const response = await fetch('/api/api-key/generate', { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
          apiNoKey.style.display = 'none';
          apiNewKey.style.display = 'block';
          newApiKeyValue.textContent = data.api_key;
          toastSuccess(<%-safeJson(t("api.keyGenerated"))%>);
        } else {
          toastError(data.error || <%-safeJson(t("api.generateFailed"))%>);
          btn.disabled = false;
          btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> <%= t("api.generateKey") %>';
        }
      } catch (err) {
        console.error('Failed to generate API key:', err);
        toastError(<%-safeJson(t("api.generateFailed"))%>);
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> <%= t("api.generateKey") %>';
      }
    });
    
    // Copy API key
    document.getElementById('copyNewApiKeyBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('copyNewApiKeyBtn');
      try {
        await navigator.clipboard.writeText(newApiKeyValue.textContent);
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <%= t("api.copied") %>';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> <%= t("api.copyKey") %>';
          btn.classList.remove('copied');
        }, 2000);
      } catch (err) {
        toastError(<%-safeJson(t("api.copyFailed"))%>);
      }
    });
    
    // Close new key display and show active key status
    document.getElementById('closeNewKeyBtn')?.addEventListener('click', () => {
      apiNewKey.style.display = 'none';
      loadApiKeyStatus();
    });
    
    // Regenerate API key
    document.getElementById('regenerateApiKeyBtn')?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("api.confirmRegenerate"))%>)) return;
      
      const btn = document.getElementById('regenerateApiKeyBtn');
      btn.disabled = true;
      
      try {
        const response = await fetch('/api/api-key/generate', { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
          apiHasKey.style.display = 'none';
          apiNewKey.style.display = 'block';
          newApiKeyValue.textContent = data.api_key;
          toastSuccess(<%-safeJson(t("api.keyRegenerated"))%>);
        } else {
          toastError(data.error || <%-safeJson(t("api.regenerateFailed"))%>);
        }
      } catch (err) {
        console.error('Failed to regenerate API key:', err);
        toastError(<%-safeJson(t("api.regenerateFailed"))%>);
      } finally {
        btn.disabled = false;
      }
    });
    
    // Revoke API key
    document.getElementById('revokeApiKeyBtn')?.addEventListener('click', async () => {
      if (!await window.gryffi.modal.confirm(<%-safeJson(t("api.confirmRevoke"))%>)) return;
      
      const btn = document.getElementById('revokeApiKeyBtn');
      btn.disabled = true;
      
      try {
        const response = await fetch('/api/api-key', { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          apiHasKey.style.display = 'none';
          apiNoKey.style.display = 'block';
          toastSuccess(<%-safeJson(t("api.keyRevoked"))%>);
        } else {
          toastError(data.error || <%-safeJson(t("api.revokeFailed"))%>);
        }
      } catch (err) {
        console.error('Failed to revoke API key:', err);
        toastError(<%-safeJson(t("api.revokeFailed"))%>);
      } finally {
        btn.disabled = false;
      }
    });
    
    // Copy API example code
    document.querySelectorAll('.copy-example-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const exampleId = btn.dataset.example;
        const codeBlock = document.getElementById('example-' + exampleId);
        if (!codeBlock) return;
        
        const code = codeBlock.textContent;
        
        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('copied');
          btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
          
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
          }, 2000);
          
          toastSuccess(<%-safeJson(t("api.examples.copySuccess"))%>);
        } catch (err) {
          toastError(<%-safeJson(t("api.copyFailed"))%>);
        }
      });
    });
    
    // Load API key status on page load
    loadApiKeyStatus();
    <% } %>
    
    // Deep links are now handled by initTabs() which switches to the correct tab
    // Old hash names like #endUsersCard and #groupsCard are mapped to the users tab
    
    // ============================================
    // GROUPS FUNCTIONALITY
    // ============================================
    
    let groups = [];
    let currentGroupMembers = [];
    let selectedNonMembers = [];
    
    // DOM elements for groups
    const groupsContainer = document.getElementById('groupsContainer');
    const groupsLoading = document.getElementById('groupsLoading');
    const createGroupBtn = document.getElementById('createGroupBtn');
    const groupModal = document.getElementById('groupModal');
    const groupModalTitle = document.getElementById('groupModalTitle');
    const groupForm = document.getElementById('groupForm');
    const closeGroupModal = document.getElementById('closeGroupModal');
    const cancelGroupBtn = document.getElementById('cancelGroupBtn');
    const groupMembersModal = document.getElementById('groupMembersModal');
    const groupMembersTitle = document.getElementById('groupMembersTitle');
    const closeGroupMembersModal = document.getElementById('closeGroupMembersModal');
    const closeGroupMembersBtn = document.getElementById('closeGroupMembersBtn');
    const deleteGroupModal = document.getElementById('deleteGroupModal');
    const closeDeleteGroupModal = document.getElementById('closeDeleteGroupModal');
    const cancelDeleteGroupBtn = document.getElementById('cancelDeleteGroupBtn');
    const confirmDeleteGroupBtn = document.getElementById('confirmDeleteGroupBtn');
    
    // Load groups
    async function loadGroups() {
      try {
        groupsLoading.style.display = 'block';
        const response = await fetch('/api/groups');
        const data = await response.json();
        
        if (data.success) {
          groups = data.groups;
          renderGroups();
        }
      } catch (err) {
        console.error('Failed to load groups:', err);
      } finally {
        groupsLoading.style.display = 'none';
      }
    }
    
    // Render groups
    function renderGroups() {
      if (groups.length === 0) {
        groupsContainer.innerHTML = `
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <h3>${T.groups.noGroups}</h3>
            <p>${T.groups.noGroupsDescription}</p>
          </div>
        `;
        return;
      }
      
      const html = `
        <table class="groups-table">
          <thead>
            <tr>
              <th>${T.groups.name}</th>
              <th>${T.groups.descriptionLabel}</th>
              <th>${T.source}</th>
              <th style="text-align: right;">${T.actions}</th>
            </tr>
          </thead>
          <tbody>
            ${groups.map(group => `
              <tr data-group-id="${group.id}">
                <td>
                  <span class="group-name">${escapeHtml(group.name)}</span>
                </td>
                <td>
                  <span class="group-description">${group.description ? escapeHtml(group.description) : '<span class="text-zen-400">—</span>'}</span>
                </td>
                <td>
                  <span class="source-badge ${group.source}">${T.groups.sources[group.source] || group.source}</span>
                </td>
                <td>
                  <div class="actions-cell">
                    <button type="button" class="btn btn-icon members-group-btn" data-group-id="${group.id}" title="${T.groups.manageMembers}">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                      </svg>
                    </button>
                    ${['manual'].includes(group.source) ? `
                      <button type="button" class="btn btn-icon edit-group-btn" data-group-id="${group.id}" title="${T.editTooltip}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </button>
                      <button type="button" class="btn btn-icon danger delete-group-btn" data-group-id="${group.id}" title="${T.deleteTooltip}">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    ` : ''}
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      
      groupsContainer.innerHTML = html;
      
      // Bind members button events
      document.querySelectorAll('.members-group-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const groupId = this.dataset.groupId;
          openGroupMembersModal(groupId);
        });
      });
      
      // Bind edit buttons
      document.querySelectorAll('.edit-group-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const groupId = this.dataset.groupId;
          openEditGroupModal(groupId);
        });
      });
      
      // Bind delete buttons
      document.querySelectorAll('.delete-group-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const groupId = this.dataset.groupId;
          openDeleteGroupModal(groupId);
        });
      });
    }
    
    // Open create group modal
    function openCreateGroupModal() {
      groupModalTitle.textContent = T.groups.createGroup;
      document.getElementById('groupId').value = '';
      document.getElementById('groupName').value = '';
      document.getElementById('groupDescription').value = '';
      groupModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    
    // Open edit group modal
    async function openEditGroupModal(groupId) {
      const group = groups.find(g => g.id === groupId);
      if (!group) return;
      
      groupModalTitle.textContent = T.groups.editGroup;
      document.getElementById('groupId').value = group.id;
      document.getElementById('groupName').value = group.name;
      document.getElementById('groupDescription').value = group.description || '';
      groupModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    
    // Close group modal
    function closeGroupModalFunc() {
      groupModal.style.display = 'none';
      document.body.style.overflow = '';
    }
    
    // Save group
    async function saveGroup(e) {
      e.preventDefault();
      
      const groupId = document.getElementById('groupId').value;
      const name = document.getElementById('groupName').value.trim();
      const description = document.getElementById('groupDescription').value.trim();
      
      if (!name) return;
      
      try {
        const url = groupId ? `/api/groups/${groupId}` : '/api/groups';
        const method = groupId ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description })
        });
        
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          closeGroupModalFunc();
          loadGroups();
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to save group:', err);
        window.gryffi?.toast?.error('Failed to save group');
      }
    }
    
    // Open delete group modal
    function openDeleteGroupModal(groupId) {
      document.getElementById('deleteGroupId').value = groupId;
      deleteGroupModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    
    // Close delete group modal
    function closeDeleteGroupModalFunc() {
      deleteGroupModal.style.display = 'none';
      document.body.style.overflow = '';
    }
    
    // Confirm delete group
    async function confirmDeleteGroup() {
      const groupId = document.getElementById('deleteGroupId').value;
      if (!groupId) return;
      
      try {
        const response = await fetch(`/api/groups/${groupId}`, { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          closeDeleteGroupModalFunc();
          loadGroups();
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to delete group:', err);
        window.gryffi?.toast?.error('Failed to delete group');
      }
    }
    
    // Open group members modal
    async function openGroupMembersModal(groupId) {
      const group = groups.find(g => g.id === groupId);
      if (!group) return;
      
      document.getElementById('currentGroupId').value = groupId;
      groupMembersTitle.textContent = `${group.name} - ${T.groups.title}`;
      selectedNonMembers = [];
      
      groupMembersModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      
      await loadGroupMembers(groupId);
      await loadNonMembers(groupId);
    }
    
    // Close group members modal
    function closeGroupMembersModalFunc() {
      groupMembersModal.style.display = 'none';
      document.body.style.overflow = '';
    }
    
    // Load group members
    async function loadGroupMembers(groupId) {
      try {
        const response = await fetch(`/api/groups/${groupId}`);
        const data = await response.json();
        
        if (data.success) {
          currentGroupMembers = data.group.members || [];
          renderGroupMembers();
        }
      } catch (err) {
        console.error('Failed to load group members:', err);
      }
    }
    
    // Render group members
    function renderGroupMembers() {
      const membersList = document.getElementById('membersList');
      document.getElementById('memberCount').textContent = currentGroupMembers.length;
      
      if (currentGroupMembers.length === 0) {
        membersList.innerHTML = `<div class="members-empty">${T.groups.noMembers}</div>`;
        return;
      }
      
      membersList.innerHTML = currentGroupMembers.map(member => `
        <div class="member-item">
          <div class="member-info">
            <div class="member-avatar">${escapeHtml(getInitials(member.first_name, member.last_name))}</div>
            <div class="member-details">
              <div class="member-name">${escapeHtml(member.first_name)} ${escapeHtml(member.last_name)}</div>
              <div class="member-email">${escapeHtml(member.email)}</div>
            </div>
          </div>
          <button type="button" class="btn-remove-member" data-user-id="${member.id}" title="${T.groups.removeFromGroup}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      `).join('');
      
      // Bind remove buttons
      membersList.querySelectorAll('.btn-remove-member').forEach(btn => {
        btn.addEventListener('click', function() {
          const userId = this.dataset.userId;
          removeMemberFromGroup(userId);
        });
      });
    }
    
    // Load non-members for adding
    async function loadNonMembers(groupId, search = '') {
      try {
        const params = new URLSearchParams({ search });
        const response = await fetch(`/api/groups/${groupId}/non-members?${params}`);
        const data = await response.json();
        
        if (data.success) {
          renderNonMembers(data.users);
        }
      } catch (err) {
        console.error('Failed to load non-members:', err);
      }
    }
    
    // Render non-members
    function renderNonMembers(users) {
      const nonMembersList = document.getElementById('nonMembersList');
      
      if (users.length === 0) {
        nonMembersList.innerHTML = `<div class="member-select-empty">${T.groups.allUsersInGroup}</div>`;
        return;
      }
      
      nonMembersList.innerHTML = users.map(user => `
        <label class="member-select-item ${selectedNonMembers.includes(user.id) ? 'selected' : ''}">
          <input type="checkbox" value="${user.id}" ${selectedNonMembers.includes(user.id) ? 'checked' : ''}>
          <div class="member-select-info">
            <div class="member-select-name">${escapeHtml(user.first_name)} ${escapeHtml(user.last_name)}</div>
            <div class="member-select-email">${escapeHtml(user.email)}</div>
          </div>
        </label>
      `).join('');
      
      // Bind checkboxes
      nonMembersList.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
          const userId = this.value;
          if (this.checked) {
            selectedNonMembers.push(userId);
            this.closest('.member-select-item').classList.add('selected');
          } else {
            selectedNonMembers = selectedNonMembers.filter(id => id !== userId);
            this.closest('.member-select-item').classList.remove('selected');
          }
          updateAddMembersButton();
        });
      });
    }
    
    // Update add members button state
    function updateAddMembersButton() {
      const btn = document.getElementById('addSelectedMembersBtn');
      btn.disabled = selectedNonMembers.length === 0;
    }
    
    // Add selected members to group
    async function addSelectedMembers() {
      const groupId = document.getElementById('currentGroupId').value;
      if (!groupId || selectedNonMembers.length === 0) return;
      
      try {
        const response = await fetch(`/api/groups/${groupId}/members`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userIds: selectedNonMembers })
        });
        
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          selectedNonMembers = [];
          await loadGroupMembers(groupId);
          await loadNonMembers(groupId);
          loadGroups(); // Refresh member counts
          loadUsers(); // Refresh user list to show updated group badges
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to add members:', err);
        window.gryffi?.toast?.error('Failed to add members');
      }
    }
    
    // Remove member from group
    async function removeMemberFromGroup(userId) {
      const groupId = document.getElementById('currentGroupId').value;
      if (!groupId) return;
      
      try {
        const response = await fetch(`/api/groups/${groupId}/members/${userId}`, { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          window.gryffi?.toast?.success(data.message);
          await loadGroupMembers(groupId);
          await loadNonMembers(groupId);
          loadGroups(); // Refresh member counts
          loadUsers(); // Refresh user list to show updated group badges
        } else {
          window.gryffi?.toast?.error(data.message);
        }
      } catch (err) {
        console.error('Failed to remove member:', err);
        window.gryffi?.toast?.error('Failed to remove member');
      }
    }
    
    // Helper: Get initials
    function getInitials(firstName, lastName) {
      return ((firstName?.[0] || '') + (lastName?.[0] || '')).toUpperCase();
    }
    
    // Initialize groups
    if (createGroupBtn) {
      createGroupBtn.addEventListener('click', openCreateGroupModal);
    }
    if (closeGroupModal) {
      closeGroupModal.addEventListener('click', closeGroupModalFunc);
    }
    if (cancelGroupBtn) {
      cancelGroupBtn.addEventListener('click', closeGroupModalFunc);
    }
    if (groupForm) {
      groupForm.addEventListener('submit', saveGroup);
    }
    if (closeGroupMembersModal) {
      closeGroupMembersModal.addEventListener('click', closeGroupMembersModalFunc);
    }
    if (closeGroupMembersBtn) {
      closeGroupMembersBtn.addEventListener('click', closeGroupMembersModalFunc);
    }
    if (closeDeleteGroupModal) {
      closeDeleteGroupModal.addEventListener('click', closeDeleteGroupModalFunc);
    }
    if (cancelDeleteGroupBtn) {
      cancelDeleteGroupBtn.addEventListener('click', closeDeleteGroupModalFunc);
    }
    if (confirmDeleteGroupBtn) {
      confirmDeleteGroupBtn.addEventListener('click', confirmDeleteGroup);
    }
    
    // Search non-members
    const searchNonMembersInput = document.getElementById('searchNonMembers');
    let searchNonMembersTimeout = null;
    if (searchNonMembersInput) {
      searchNonMembersInput.addEventListener('input', function() {
        clearTimeout(searchNonMembersTimeout);
        searchNonMembersTimeout = setTimeout(() => {
          const groupId = document.getElementById('currentGroupId').value;
          if (groupId) {
            loadNonMembers(groupId, this.value);
          }
        }, 300);
      });
    }
    
    // Add members button
    const addSelectedMembersBtn = document.getElementById('addSelectedMembersBtn');
    if (addSelectedMembersBtn) {
      addSelectedMembersBtn.addEventListener('click', addSelectedMembers);
    }
    
    // Close modals on backdrop click
    [groupModal, groupMembersModal, deleteGroupModal].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === this) {
            this.style.display = 'none';
            document.body.style.overflow = '';
          }
        });
      }
    });
    
    // Close modals on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        [groupModal, groupMembersModal, deleteGroupModal].forEach(modal => {
          if (modal && modal.style.display === 'flex') {
            modal.style.display = 'none';
            document.body.style.overflow = '';
          }
        });
      }
    });
    
    // Load groups on page load
    loadGroups();
    
    // ============================================
    // THEME EDITOR (Tier 3+4 only)
    // ============================================
    <% if (isThemesEnabled) { %>
    (function() {
      // State
      let themes = [];
      let presets = [];
      let activeThemeId = null;
      let defaultTokens = {};
      let editingThemeId = null;
      let currentTokens = {};
      let currentLogoFile = null;
      let currentLogoUrl = null;
      let currentLogoLightUrl = null;
      
      // DOM elements
      const modal = document.getElementById('themeEditorModal');
      const createBtn = document.getElementById('createThemeBtn');
      const closeBtn = document.getElementById('closeThemeEditorBtn');
      const cancelBtn = document.getElementById('cancelThemeBtn');
      const saveBtn = document.getElementById('saveThemeBtn');
      const useDefaultBtn = document.getElementById('useDefaultThemeBtn');
      const presetGrid = document.getElementById('presetThemesGrid');
      const customGrid = document.getElementById('customThemesGrid');
      const noCustomThemes = document.getElementById('noCustomThemes');
      const activeThemeName = document.getElementById('activeThemeName');
      const previewContainer = document.getElementById('themePreviewContainer');
      
      // Translations
      const themesT = {
        gryffiDefault: <%-safeJson(t("systemSettings.themes.gryffiDefault"))%>,
        editTheme: <%-safeJson(t("systemSettings.themes.editTheme"))%>,
        deleteTheme: <%-safeJson(t("systemSettings.themes.deleteTheme"))%>,
        deleteConfirm: <%-safeJson(t("systemSettings.themes.deleteConfirm"))%>,
        activateTheme: <%-safeJson(t("systemSettings.themes.activateTheme"))%>,
        active: <%-safeJson(t("systemSettings.themes.activeTheme"))%>,
        saved: <%-safeJson(t("systemSettings.themes.editor.saved"))%>,
        saveError: <%-safeJson(t("systemSettings.themes.editor.saveError"))%>,
        deleted: <%-safeJson(t("systemSettings.themes.editor.deleted"))%>
      };
      
      // Load themes
      async function loadThemes() {
        console.log('[Themes] Loading themes...');
        try {
          const response = await fetch('/api/themes');
          console.log('[Themes] API response status:', response.status);
          const data = await response.json();
          if (data.success) {
            themes = data.themes;
            presets = data.presets;
            activeThemeId = data.activeThemeId;
            defaultTokens = data.defaultTokens;
            renderPresets();
            renderCustomThemes();
            updateActiveThemeDisplay();
          }
        } catch (err) {
          console.error('Failed to load themes:', err);
        }
      }
      
      // Render preset themes
      function renderPresets() {
        console.log('[Themes] Rendering presets:', presets.length, 'presets found');
        console.log('[Themes] presetGrid element:', presetGrid);
        presetGrid.innerHTML = presets.map(preset => {
          const tokens = preset.tokens;
          const isActive = !activeThemeId && preset.key === 'gryffi_default';
          return `
            <div class="preset-theme-card ${isActive ? 'active' : ''}" data-preset="${preset.key}">
              <div class="preset-theme-colors">
                <div class="preset-theme-color" style="background: ${tokens.primary}"></div>
                <div class="preset-theme-color" style="background: ${tokens.accent}"></div>
                <div class="preset-theme-color" style="background: ${tokens.background}"></div>
              </div>
              <div class="preset-theme-name">${preset.name}</div>
            </div>
          `;
        }).join('');
        
        // Add click handlers
        presetGrid.querySelectorAll('.preset-theme-card').forEach(card => {
          card.addEventListener('click', () => {
            const presetKey = card.dataset.preset;
            const preset = presets.find(p => p.key === presetKey);
            if (preset) {
              openEditor(null, preset.tokens, preset.name);
            }
          });
        });
      }
      
      // Render custom themes
      function renderCustomThemes() {
        if (themes.length === 0) {
          customGrid.style.display = 'none';
          noCustomThemes.style.display = 'block';
          return;
        }
        
        customGrid.style.display = 'grid';
        noCustomThemes.style.display = 'none';
        
        customGrid.innerHTML = themes.map(theme => {
          const tokens = typeof theme.tokens === 'string' ? JSON.parse(theme.tokens) : theme.tokens;
          const isActive = activeThemeId === theme.id;
          return `
            <div class="custom-theme-card ${isActive ? 'active' : ''}" data-theme-id="${theme.id}">
              <div class="custom-theme-header">
                <span class="custom-theme-name">${escapeHtml(theme.name)}</span>
                ${isActive ? '<span class="custom-theme-badge">Active</span>' : ''}
              </div>
              <div class="custom-theme-colors">
                <div class="preset-theme-color" style="background: ${tokens.primary}"></div>
                <div class="preset-theme-color" style="background: ${tokens.accent}"></div>
                <div class="preset-theme-color" style="background: ${tokens.background}"></div>
                <div class="preset-theme-color" style="background: ${tokens.headerBackground}"></div>
              </div>
              <div class="custom-theme-actions">
                <button class="btn btn-secondary btn-sm edit-theme-btn">${themesT.editTheme}</button>
                ${isActive ? '' : `
                  <button class="btn btn-primary btn-sm activate-theme-btn">${themesT.activateTheme}</button>
                  <button class="btn btn-ghost btn-sm delete-theme-btn" title="${themesT.deleteTheme}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3,6 5,6 21,6"></polyline>
                      <path d="M19,6v14a2,2 0 0,1-2,2H7a2,2 0 0,1-2-2V6m3,0V4a2,2 0 0,1 2-2h4a2,2 0 0,1 2,2v2"></path>
                    </svg>
                  </button>
                `}
              </div>
            </div>
          `;
        }).join('');
        
        // Add event handlers
        customGrid.querySelectorAll('.edit-theme-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const card = btn.closest('.custom-theme-card');
            const themeId = card.dataset.themeId;
            const theme = themes.find(t => t.id === themeId);
            if (theme) {
              const tokens = typeof theme.tokens === 'string' ? JSON.parse(theme.tokens) : theme.tokens;
              openEditor(theme.id, tokens, theme.name, theme.description, theme.logo_url, theme.logo_light_url);
            }
          });
        });
        
        customGrid.querySelectorAll('.activate-theme-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const card = btn.closest('.custom-theme-card');
            const themeId = card.dataset.themeId;
            await activateTheme(themeId);
          });
        });
        
        customGrid.querySelectorAll('.delete-theme-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const card = btn.closest('.custom-theme-card');
            const themeId = card.dataset.themeId;
            const theme = themes.find(t => t.id === themeId);
            if (theme) {
              const confirmed = await window.gryffi.modal.confirm(themesT.deleteConfirm, {
                title: themesT.deleteTheme,
                okText: <%-safeJson(t("common.delete"))%>,
                type: 'warning',
                danger: true
              });
              if (confirmed) {
                await deleteTheme(themeId);
              }
            }
          });
        });
      }
      
      // Delete theme
      async function deleteTheme(themeId) {
        try {
          const response = await fetch(`/api/themes/${themeId}`, { method: 'DELETE' });
          const data = await response.json();
          if (data.success) {
            window.gryffi.toast.success(themesT.deleted);
            loadThemes();
          } else {
            window.gryffi.toast.error(data.error || 'Failed to delete theme');
          }
        } catch (err) {
          console.error('Failed to delete theme:', err);
          window.gryffi.toast.error('Failed to delete theme');
        }
      }
      
      // Update active theme display
      function updateActiveThemeDisplay() {
        if (activeThemeId) {
          const theme = themes.find(t => t.id === activeThemeId);
          activeThemeName.textContent = theme ? theme.name : themesT.gryffiDefault;
          useDefaultBtn.style.display = 'inline-flex';
        } else {
          activeThemeName.textContent = themesT.gryffiDefault;
          useDefaultBtn.style.display = 'none';
        }
      }
      
      // Open editor
      function openEditor(themeId = null, tokens = null, name = '', description = '', logoUrl = null, logoLightUrl = null) {
        editingThemeId = themeId;
        currentTokens = tokens ? { ...tokens } : { ...defaultTokens };
        currentLogoUrl = logoUrl;
        currentLogoLightUrl = logoLightUrl;
        currentLogoFile = null;
        
        // Set form values
        document.getElementById('themeName').value = name;
        document.getElementById('themeDescription').value = description || '';
        
        // Set color values
        Object.keys(currentTokens).forEach(key => {
          const colorInput = document.getElementById('token' + key.charAt(0).toUpperCase() + key.slice(1));
          const hexInput = document.getElementById('token' + key.charAt(0).toUpperCase() + key.slice(1) + 'Hex');
          if (colorInput && typeof currentTokens[key] === 'string' && currentTokens[key].startsWith('#')) {
            colorInput.value = currentTokens[key];
            if (hexInput) hexInput.value = currentTokens[key];
          }
        });
        
        // Set advanced values
        document.getElementById('tokenBorderRadius').value = currentTokens.borderRadius || 12;
        document.getElementById('borderRadiusValue').textContent = (currentTokens.borderRadius || 12) + 'px';
        document.getElementById('tokenShadowStrength').value = currentTokens.shadowStrength || 'medium';
        
        // Set logo
        const logoPlaceholder = document.getElementById('themeLogoPlaceholder');
        const logoPreview = document.getElementById('themeLogoPreview');
        const logoImg = document.getElementById('themeLogoImg');
        const logoPreviewSection = document.getElementById('themeLogoPreviewSection');
        
        if (logoUrl) {
          logoPlaceholder.style.display = 'none';
          logoPreview.style.display = 'block';
          logoImg.src = logoUrl;
          
          // Show logo preview section with both versions
          logoPreviewSection.style.display = 'block';
          document.getElementById('themeLogoPreviewLight').src = logoUrl;
          // Use light version if available, otherwise use CSS filter fallback
          const darkImg = document.getElementById('themeLogoPreviewDark');
          if (logoLightUrl) {
            darkImg.src = logoLightUrl;
            darkImg.style.filter = 'none';
          } else {
            // Fallback: use CSS filter to simulate white logo
            darkImg.src = logoUrl;
            darkImg.style.filter = 'brightness(0) invert(1)';
          }
        } else {
          logoPlaceholder.style.display = 'flex';
          logoPreview.style.display = 'none';
          logoPreviewSection.style.display = 'none';
        }
        
        // Update preview
        updatePreview();
        
        // Show modal
        modal.classList.add('active');
      }
      
      // Close editor
      function closeEditor() {
        modal.classList.remove('active');
        editingThemeId = null;
        currentTokens = {};
        currentLogoFile = null;
        currentLogoUrl = null;
        currentLogoLightUrl = null;
      }
      
      // Update preview
      function updatePreview() {
        const activeTab = document.querySelector('.theme-preview-tab.active');
        const previewType = activeTab ? activeTab.dataset.preview : 'space';
        
        const t = currentTokens;
        const shadow = t.shadowStrength === 'none' ? 'none' : 
                       t.shadowStrength === 'light' ? '0 2px 8px rgba(0,0,0,0.08)' :
                       t.shadowStrength === 'strong' ? '0 8px 24px rgba(0,0,0,0.15)' :
                       '0 4px 12px rgba(0,0,0,0.1)';
        
        let previewHtml = `
          <div class="theme-preview-frame" style="background: ${t.background}; padding: 20px;">
            ${currentLogoUrl || currentLogoFile ? `
              <div style="text-align: center; margin-bottom: 16px;">
                <img src="${currentLogoFile ? URL.createObjectURL(currentLogoFile) : currentLogoUrl}" 
                     style="max-height: 40px; max-width: 150px;" alt="Logo">
              </div>
            ` : ''}
            <div style="background: ${t.headerBackground}; color: ${t.buttonText}; padding: 12px 16px; border-radius: ${t.borderRadius}px ${t.borderRadius}px 0 0; font-weight: 600;">
              ${previewType === 'space' ? 'Conference Room A' : previewType === 'guide' ? 'AI Assistant' : 'Welcome'}
            </div>
            <div style="background: ${t.cardBackground}; border: 1px solid ${t.cardBorder}; border-top: none; padding: 20px; border-radius: 0 0 ${t.borderRadius}px ${t.borderRadius}px; box-shadow: ${shadow};">
        `;
        
        if (previewType === 'space') {
          previewHtml += `
              <p style="color: ${t.textPrimary}; margin-bottom: 16px;">This is a sample space description showing how text appears in your theme.</p>
              <div style="background: ${t.background}; height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: ${t.textSecondary};">
                [Space Image]
              </div>
              <div style="margin-top: 16px;">
                <button style="background: ${t.primary}; color: ${t.buttonText}; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; width: 100%;">
                  Continue to next step →
                </button>
              </div>
          `;
        } else if (previewType === 'guide') {
          previewHtml += `
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; justify-content: flex-end;">
                  <div style="background: ${t.chatBubbleUser}; color: ${t.buttonText}; padding: 10px 14px; border-radius: 16px 16px 4px 16px; max-width: 80%;">
                    How do I get started?
                  </div>
                </div>
                <div style="display: flex; justify-content: flex-start;">
                  <div style="background: ${t.chatBubbleGuide}; color: ${t.textPrimary}; padding: 10px 14px; border-radius: 16px 16px 16px 4px; max-width: 80%;">
                    Welcome! I'm here to help you navigate through this journey. What would you like to know?
                  </div>
                </div>
              </div>
              <div style="margin-top: 16px; display: flex; gap: 8px;">
                <input type="text" placeholder="Type a message..." style="flex: 1; padding: 10px 14px; border: 1px solid ${t.cardBorder}; border-radius: 8px; background: ${t.cardBackground}; color: ${t.textPrimary};">
                <button style="background: ${t.accent}; color: ${t.buttonText}; padding: 10px 16px; border: none; border-radius: 8px; cursor: pointer;">Send</button>
              </div>
          `;
        } else if (previewType === 'content') {
          previewHtml += `
              <h3 style="color: ${t.textPrimary}; font-size: 18px; margin-bottom: 12px;">Welcome to Your Journey</h3>
              <p style="color: ${t.textSecondary}; margin-bottom: 16px;">This content shows how information is displayed using your custom theme colors.</p>
              <div style="background: ${t.background}; padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                <div style="height: 8px; background: ${t.cardBorder}; border-radius: 4px; overflow: hidden;">
                  <div style="width: 60%; height: 100%; background: ${t.progressBar};"></div>
                </div>
                <p style="color: ${t.textSecondary}; font-size: 12px; margin-top: 8px;">Progress: 60%</p>
              </div>
              <button style="background: ${t.primary}; color: ${t.buttonText}; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer;">
                Continue
              </button>
          `;
        } else if (previewType === 'email') {
          // Email preview - completely different layout mimicking actual Gryffi emails
          const logoSrc = currentLogoFile ? URL.createObjectURL(currentLogoFile) : (currentLogoUrl || '/images/logos/Logo---illustration-only-cropped-transparant.png');
          previewHtml = `
            <div class="theme-preview-frame" style="background: ${t.background}; padding: 20px; min-height: 400px; display: flex; flex-direction: column; align-items: center;">
              <!-- Logo -->
              <div style="text-align: center; margin-bottom: 16px; width: 100%;">
                <img src="${logoSrc}" style="max-height: 48px; max-width: 48px; object-fit: contain; display: block; margin: 0 auto;" alt="Logo">
              </div>
              
              <!-- Email Card -->
              <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.08); max-width: 360px; margin: 0 auto;">
                <!-- Gradient Accent Bar -->
                <div style="height: 4px; background: linear-gradient(90deg, ${t.primary} 0%, ${t.accent} 100%);"></div>
                
                <!-- Email Content -->
                <div style="padding: 24px 20px;">
                  <!-- Greeting -->
                  <p style="margin: 0 0 16px 0; color: ${t.primary}; font-size: 14px; font-weight: 600;">
                    Hello Sarah,
                  </p>
                  
                  <!-- Body -->
                  <p style="margin: 0 0 12px 0; color: #334155; font-size: 13px; line-height: 1.6;">
                    You've been invited to participate in "<strong>Onboarding 2026</strong>" at Acme Corp.
                  </p>
                  <p style="margin: 0 0 20px 0; color: #334155; font-size: 13px; line-height: 1.6;">
                    Click the button below to start your journey.
                  </p>
                  
                  <!-- CTA Button -->
                  <div style="text-align: center; margin: 20px 0;">
                    <button style="display: inline-block; background: ${t.primary}; color: ${t.buttonText}; padding: 10px 24px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                      Start Journey
                    </button>
                  </div>
                </div>
                
                <!-- Divider -->
                <div style="margin: 0 20px;">
                  <div style="height: 1px; background: #e2e8f0;"></div>
                </div>
                
                <!-- Footer -->
                <div style="padding: 16px 20px;">
                  <p style="margin: 0 0 4px 0; color: #64748b; font-size: 11px; text-align: center;">
                    Part of your journey: <strong>Onboarding 2026</strong>
                  </p>
                  <p style="margin: 0; color: #94a3b8; font-size: 10px; text-align: center;">
                    Sent via Acme Corp
                  </p>
                </div>
              </div>
              
              <!-- Powered by -->
              <div style="text-align: center; margin-top: 16px;">
                <p style="margin: 0; color: #64748b; font-size: 10px;">
                  Powered by <span style="color: ${t.primary}; font-weight: 500;">Gryffi</span> · Interactive Journey Builder
                </p>
              </div>
            </div>
          `;
          previewContainer.innerHTML = previewHtml;
          return;
        }
        
        previewHtml += `
            </div>
          </div>
        `;
        
        previewContainer.innerHTML = previewHtml;
      }
      
      // Activate theme
      async function activateTheme(themeId) {
        try {
          const response = await fetch(`/api/themes/${themeId}/activate`, { method: 'POST' });
          const data = await response.json();
          if (data.success) {
            activeThemeId = themeId;
            renderCustomThemes();
            updateActiveThemeDisplay();
            window.gryffi.toast.success(themesT.saved);
          }
        } catch (err) {
          console.error('Failed to activate theme:', err);
        }
      }
      
      // Use default theme
      async function useDefaultTheme() {
        try {
          const response = await fetch('/api/themes/deactivate', { method: 'POST' });
          const data = await response.json();
          if (data.success) {
            activeThemeId = null;
            renderPresets();
            renderCustomThemes();
            updateActiveThemeDisplay();
            window.gryffi.toast.success(themesT.saved);
          }
        } catch (err) {
          console.error('Failed to deactivate theme:', err);
        }
      }
      
      // Save theme
      async function saveTheme() {
        const name = document.getElementById('themeName').value.trim();
        if (!name) {
          window.gryffi.toast.error('Theme name is required');
          return;
        }
        
        const formData = new FormData();
        formData.append('name', name);
        formData.append('description', document.getElementById('themeDescription').value.trim());
        formData.append('tokens', JSON.stringify(currentTokens));
        
        if (currentLogoFile) {
          formData.append('logo', currentLogoFile);
        }
        
        try {
          const url = editingThemeId ? `/api/themes/${editingThemeId}` : '/api/themes';
          const method = editingThemeId ? 'PUT' : 'POST';
          
          const response = await fetch(url, { method, body: formData });
          const data = await response.json();
          
          if (data.success) {
            window.gryffi.toast.success(themesT.saved);
            closeEditor();
            loadThemes();
          } else {
            window.gryffi.toast.error(data.error || themesT.saveError);
          }
        } catch (err) {
          console.error('Failed to save theme:', err);
          window.gryffi.toast.error(themesT.saveError);
        }
      }
      
      // Event listeners
      console.log('[Themes] Setting up event listeners...');
      console.log('[Themes] createBtn:', createBtn);
      console.log('[Themes] modal:', modal);
      
      createBtn?.addEventListener('click', () => {
        console.log('[Themes] Create button clicked!');
        openEditor();
      });
      closeBtn?.addEventListener('click', closeEditor);
      cancelBtn?.addEventListener('click', closeEditor);
      saveBtn?.addEventListener('click', saveTheme);
      useDefaultBtn?.addEventListener('click', useDefaultTheme);
      
      // Color picker sync
      // Helper function to sync primary-dependent colors
      function syncPrimaryDependentColors(newPrimaryColor) {
        // Sync chatBubbleUser with primary color
        const chatBubbleUserInput = document.getElementById('tokenChatBubbleUser');
        const chatBubbleUserHex = document.getElementById('tokenChatBubbleUserHex');
        if (chatBubbleUserInput && chatBubbleUserHex) {
          chatBubbleUserInput.value = newPrimaryColor;
          chatBubbleUserHex.value = newPrimaryColor;
          currentTokens.chatBubbleUser = newPrimaryColor;
        }
        
        // Sync headerBackground with primary color
        const headerBgInput = document.getElementById('tokenHeaderBackground');
        const headerBgHex = document.getElementById('tokenHeaderBackgroundHex');
        if (headerBgInput && headerBgHex) {
          headerBgInput.value = newPrimaryColor;
          headerBgHex.value = newPrimaryColor;
          currentTokens.headerBackground = newPrimaryColor;
        }
      }
      
      document.querySelectorAll('.theme-color-picker').forEach(picker => {
        const colorInput = picker.querySelector('input[type="color"]');
        const hexInput = picker.querySelector('input[type="text"]');
        
        if (colorInput && hexInput) {
          const tokenKey = colorInput.id.replace('token', '');
          const tokenKeyLower = tokenKey.charAt(0).toLowerCase() + tokenKey.slice(1);
          
          colorInput.addEventListener('input', () => {
            hexInput.value = colorInput.value;
            currentTokens[tokenKeyLower] = colorInput.value;
            
            // Auto-sync when primary color changes
            if (tokenKeyLower === 'primary') {
              syncPrimaryDependentColors(colorInput.value);
            }
            
            updatePreview();
          });
          
          hexInput.addEventListener('input', () => {
            if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
              colorInput.value = hexInput.value;
              currentTokens[tokenKeyLower] = hexInput.value;
              
              // Auto-sync when primary color changes
              if (tokenKeyLower === 'primary') {
                syncPrimaryDependentColors(hexInput.value);
              }
              
              updatePreview();
            }
          });
        }
      });
      
      // Border radius slider
      document.getElementById('tokenBorderRadius')?.addEventListener('input', (e) => {
        const value = e.target.value;
        document.getElementById('borderRadiusValue').textContent = value + 'px';
        currentTokens.borderRadius = value;
        updatePreview();
      });
      
      // Shadow strength
      document.getElementById('tokenShadowStrength')?.addEventListener('change', (e) => {
        currentTokens.shadowStrength = e.target.value;
        updatePreview();
      });
      
      // Preview tabs
      document.querySelectorAll('.theme-preview-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.theme-preview-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          updatePreview();
        });
      });
      
      // Logo upload
      const logoUpload = document.getElementById('themeLogoUpload');
      const logoInput = document.getElementById('themeLogoInput');
      const removeLogoBtn = document.getElementById('removeLogoBtn');
      
      logoUpload?.addEventListener('click', () => logoInput?.click());
      
      logoInput?.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          if (file.type !== 'image/png') {
            window.gryffi.toast.error(<%-safeJson(t("systemSettings.themes.editor.pngOnly"))%>);
            return;
          }
          currentLogoFile = file;
          currentLogoLightUrl = null; // Will be generated server-side on save
          
          const logoPlaceholder = document.getElementById('themeLogoPlaceholder');
          const logoPreview = document.getElementById('themeLogoPreview');
          const logoImg = document.getElementById('themeLogoImg');
          const logoPreviewSection = document.getElementById('themeLogoPreviewSection');
          const fileUrl = URL.createObjectURL(file);
          
          logoPlaceholder.style.display = 'none';
          logoPreview.style.display = 'block';
          logoImg.src = fileUrl;
          
          // Show preview section with CSS filter for dark background (until server generates light version)
          logoPreviewSection.style.display = 'block';
          document.getElementById('themeLogoPreviewLight').src = fileUrl;
          const darkImg = document.getElementById('themeLogoPreviewDark');
          darkImg.src = fileUrl;
          darkImg.style.filter = 'brightness(0) invert(1)'; // CSS filter preview
          
          updatePreview();
        }
      });
      
      removeLogoBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentLogoFile = null;
        currentLogoUrl = null;
        currentLogoLightUrl = null;
        const logoPlaceholder = document.getElementById('themeLogoPlaceholder');
        const logoPreview = document.getElementById('themeLogoPreview');
        const logoPreviewSection = document.getElementById('themeLogoPreviewSection');
        logoPlaceholder.style.display = 'flex';
        logoPreview.style.display = 'none';
        logoPreviewSection.style.display = 'none';
        updatePreview();
      });
      
      // Close modal on backdrop click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeEditor();
      });
      
      // Load themes on page load
      loadThemes();
    })();
    <% } %>
  </script>
</body>
</html>

