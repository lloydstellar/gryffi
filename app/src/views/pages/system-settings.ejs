      <div class="card-header" style="border-bottom: 1px solid #e57373;">
        <div>
          <h2 style="color: #c62828;"><%= t('systemSettings.dangerZone.title') %></h2>
          <p class="text-sm mt-1" style="color: #c62828; opacity: 0.8;"><%= t('systemSettings.dangerZone.description') %></p>
        </div>
      </div>
      <div class="card-body">
        <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;"><%= t('systemSettings.dangerZone.warning') %></p>
        <button type="button" class="btn" id="deleteOrgBtn" style="background-color: #c62828; color: white; border: none; padding: 8px 20px; border-radius: 6px; cursor: pointer;">
          <%= t('systemSettings.dangerZone.buttonText') %>
        </button>
      </div>
    </div>
    <% } %>

    </div><!-- End Tab Panel: General -->
    
    <!-- Tab Panel: Users -->
