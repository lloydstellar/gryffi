<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('systemSettings.title') %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .warning-banner {
      background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
      border: 1px solid #f59e0b;
      border-radius: 12px;
      padding: 20px 24px;
      margin-bottom: 32px;
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .warning-banner-icon {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      color: #b45309;
    }
    .warning-banner-content h3 {
      font-size: 15px;
      font-weight: 600;
      color: #92400e;
      margin-bottom: 4px;
    }
    .warning-banner-content p {
      font-size: 14px;
      color: #a16207;
      line-height: 1.5;
    }
    
    .card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      margin-bottom: 24px;
    }
    .card-header {
      padding: 20px 24px;
      border-bottom: 1px solid #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .card-header h2 {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
    }
    .card-body {
      padding: 24px;
    }
    
    .import-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .import-option {
      padding: 16px;
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
    }
    .import-option:hover:not(.disabled) {
      border-color: #78c503;
      background: rgba(120, 197, 3, 0.04);
    }
    .import-option.active {
      border-color: #78c503;
      background: rgba(120, 197, 3, 0.08);
    }
    .import-option.disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .import-option-icon {
      width: 40px;
      height: 40px;
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f3f4f6;
      border-radius: 10px;
      color: #6b7280;
    }
    .import-option.active .import-option-icon {
      background: rgba(120, 197, 3, 0.15);
      color: #0b4b34;
    }
    .import-option h4 {
      font-size: 14px;
      font-weight: 600;
      color: #111827;
      margin-bottom: 4px;
    }
    .import-option p {
      font-size: 12px;
      color: #6b7280;
    }
    .import-option .coming-soon {
      display: inline-block;
      margin-top: 8px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 3px 8px;
      background: #e5e7eb;
      color: #6b7280;
      border-radius: 4px;
    }
    
    /* Import Dropzone */
    .import-dropzone {
      border: 2px dashed #d1d5db;
      border-radius: 12px;
      padding: 40px 24px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
      background: #fafafa;
      margin-bottom: 20px;
    }
    .import-dropzone:hover {
      border-color: #78c503;
      background: rgba(120, 197, 3, 0.04);
    }
    .import-dropzone.dragover {
      border-color: #78c503;
      background: rgba(120, 197, 3, 0.08);
      border-style: solid;
    }
    .import-dropzone.processing {
      opacity: 0.7;
      pointer-events: none;
    }
    .import-dropzone-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 16px;
      background: #f3f4f6;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
    }
    .import-dropzone h4 {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
      margin-bottom: 6px;
    }
    .import-dropzone p {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 4px;
    }
    .import-dropzone .formats {
      font-size: 12px;
      color: #9ca3af;
    }
    
    /* Import Instructions */
    .import-instructions {
      background: #f0fdf4;
      border: 1px solid #86efac;
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 20px;
    }
    .import-instructions h5 {
      font-size: 13px;
      font-weight: 600;
      color: #166534;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .import-instructions ul {
      margin: 0;
      padding-left: 20px;
      font-size: 13px;
      color: #15803d;
      line-height: 1.8;
    }
    .import-instructions .note {
      margin-top: 10px;
      font-size: 12px;
      color: #22c55e;
      font-style: italic;
    }
    
    /* Import Preview */
    .import-preview {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 20px;
    }
    .import-preview-header {
      padding: 16px 20px;
      background: #f9fafb;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .import-preview-header h4 {
      font-size: 14px;
      font-weight: 600;
      color: #111827;
    }
    .import-preview-stats {
      display: flex;
      gap: 16px;
      font-size: 13px;
    }
    .import-preview-stats .stat {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .import-preview-stats .stat.success {
      color: #16a34a;
    }
    .import-preview-stats .stat.warning {
      color: #d97706;
    }
    .import-preview-stats .stat.info {
      color: #6b7280;
    }
    .import-preview-body {
      padding: 16px 20px;
    }
    .import-preview-sample {
      margin-bottom: 16px;
    }
    .import-preview-sample h5 {
      font-size: 12px;
      font-weight: 600;
      color: #6b7280;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .import-preview-sample ul {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 13px;
      color: #374151;
    }
    .import-preview-sample li {
      padding: 6px 0;
      border-bottom: 1px solid #f3f4f6;
    }
    .import-preview-sample li:last-child {
      border-bottom: none;
    }
    .import-preview-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      padding-top: 16px;
      border-top: 1px solid #f3f4f6;
    }
    
    /* Import Errors */
    .import-errors {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 20px;
    }
    .import-errors h5 {
      font-size: 13px;
      font-weight: 600;
      color: #dc2626;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .import-errors ul {
      margin: 0;
      padding-left: 20px;
      font-size: 13px;
      color: #b91c1c;
      line-height: 1.8;
    }
    .import-errors .solution {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #fecaca;
      font-size: 12px;
      color: #dc2626;
    }
    .import-errors .solution strong {
      display: block;
      margin-bottom: 4px;
    }
    
    .form-section {
      background: #f9fafb;
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .form-section h3 {
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 16px;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group label {
      font-size: 13px;
      font-weight: 500;
      color: #374151;
    }
    .form-group input {
      padding: 10px 14px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      color: #111827;
      background: white;
      transition: all 0.15s;
    }
    .form-group input:focus {
      outline: none;
      border-color: #78c503;
      box-shadow: 0 0 0 3px rgba(120, 197, 3, 0.1);
    }
    .form-group input::placeholder {
      color: #9ca3af;
    }
    .form-group select {
      padding: 10px 14px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      color: #111827;
      background: white;
      transition: all 0.15s;
    }
    .form-group select:focus {
      outline: none;
      border-color: #78c503;
      box-shadow: 0 0 0 3px rgba(120, 197, 3, 0.1);
    }
    
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: #0b4b34;
      color: white;
    }
    .btn-primary:hover {
      background: #0a3f2d;
    }
    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .btn-secondary {
      background: white;
      color: #374151;
      border-color: #d1d5db;
    }
    .btn-secondary:hover {
      background: #f9fafb;
    }
    .btn-icon {
      padding: 8px;
      background: transparent;
      color: #6b7280;
      border: none;
    }
    .btn-icon:hover {
      color: #111827;
      background: #f3f4f6;
    }
    .btn-icon.danger:hover {
      color: #dc2626;
      background: #fef2f2;
    }
    
    .users-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .users-count {
      font-size: 14px;
      color: #6b7280;
    }
    .users-count strong {
      color: #111827;
      font-weight: 600;
    }
    .search-box {
      position: relative;
      width: 280px;
    }
    .search-box input {
      width: 100%;
      padding: 10px 14px 10px 40px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      background: white;
    }
    .search-box input:focus {
      outline: none;
      border-color: #78c503;
      box-shadow: 0 0 0 3px rgba(120, 197, 3, 0.1);
    }
    .search-box svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: #9ca3af;
    }
    
    .users-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .users-table th {
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #6b7280;
      padding: 12px 16px;
      background: #f9fafb;
      border-bottom: 1px solid #e5e7eb;
    }
    .users-table th:first-child {
      border-radius: 8px 0 0 0;
    }
    .users-table th:last-child {
      border-radius: 0 8px 0 0;
    }
    .users-table td {
      padding: 14px 16px;
      border-bottom: 1px solid #f3f4f6;
      font-size: 14px;
      color: #111827;
      vertical-align: middle;
    }
    .users-table tr:hover td {
      background: #f9fafb;
    }
    .users-table .user-name {
      font-weight: 500;
    }
    .users-table .user-email {
      color: #6b7280;
      font-size: 13px;
    }
    .source-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .source-badge.manual {
      background: rgba(120, 197, 3, 0.12);
      color: #0b4b34;
    }
    .source-badge.csv {
      background: rgba(59, 130, 246, 0.12);
      color: #1d4ed8;
    }
    .source-badge.microsoft {
      background: rgba(0, 120, 212, 0.12);
      color: #0078d4;
    }
    .source-badge.google {
      background: rgba(234, 67, 53, 0.12);
      color: #c5221f;
    }
    .source-badge.api {
      background: rgba(249, 115, 22, 0.12);
      color: #c2410c;
    }
    .actions-cell {
      display: flex;
      gap: 4px;
      justify-content: flex-end;
    }
    
    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid #f3f4f6;
    }
    .pagination button {
      padding: 8px 14px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      background: white;
      font-size: 13px;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      transition: all 0.15s;
    }
    .pagination button:hover:not(:disabled) {
      border-color: #78c503;
      color: #0b4b34;
    }
    .pagination button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .pagination .page-info {
      font-size: 13px;
      color: #6b7280;
      padding: 0 12px;
    }
    
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: #6b7280;
    }
    .empty-state svg {
      width: 48px;
      height: 48px;
      margin: 0 auto 16px;
      color: #d1d5db;
    }
    .empty-state h3 {
      font-size: 15px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 4px;
    }
    .empty-state p {
      font-size: 14px;
    }
    
    /* Modal - Backdrop style (used with display: none/flex toggle) */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 16px;
    }
    .modal-backdrop .modal {
      position: relative;
      background: white;
      border-radius: 16px;
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow: auto;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      animation: modalSlideIn 0.2s ease-out;
    }
    @keyframes modalSlideIn {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(-10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    .modal-header {
      padding: 20px 24px;
      border-bottom: 1px solid #f3f4f6;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .modal-header h3 {
      font-size: 18px;
      font-weight: 600;
      color: #111827;
      margin: 0;
    }
    .modal-close {
      background: none;
      border: none;
      padding: 6px;
      cursor: pointer;
      color: #9ca3af;
      border-radius: 8px;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-close:hover {
      background: #f3f4f6;
      color: #6b7280;
    }
    .modal-body {
      padding: 24px;
    }
    .modal-footer {
      padding: 16px 24px;
      border-top: 1px solid #f3f4f6;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }
    .modal-backdrop .modal.modal-large {
      max-width: 640px;
    }
    .modal-backdrop .modal.modal-small {
      max-width: 400px;
    }
    
    /* Legacy modal-overlay support */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s;
    }
    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .modal-overlay .modal {
      background: white;
      border-radius: 16px;
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow: auto;
      transform: scale(0.95);
      transition: transform 0.2s;
    }
    .modal-overlay.active .modal {
      transform: scale(1);
    }
    
    /* Groups Table Styles (consistent with users-table) */
    .groups-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .groups-table th {
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #6b7280;
      padding: 12px 16px;
      background: #f9fafb;
      border-bottom: 1px solid #e5e7eb;
    }
    .groups-table th:first-child {
      border-radius: 8px 0 0 0;
    }
    .groups-table th:last-child {
      border-radius: 0 8px 0 0;
    }
    .groups-table td {
      padding: 14px 16px;
      border-bottom: 1px solid #f3f4f6;
      font-size: 14px;
      color: #111827;
      vertical-align: middle;
    }
    .groups-table tr:hover td {
      background: #f9fafb;
    }
    .groups-table .group-name {
      font-weight: 500;
    }
    .groups-table .group-description {
      color: #6b7280;
      font-size: 13px;
      max-width: 300px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .group-source-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-left: 8px;
    }
    .group-source-badge.manual {
      background: rgba(120, 197, 3, 0.12);
      color: #0b4b34;
    }
    .group-source-badge.microsoft {
      background: rgba(0, 120, 212, 0.12);
      color: #0078d4;
    }
    .group-source-badge.google {
      background: rgba(234, 67, 53, 0.12);
      color: #c5221f;
    }
    
    /* Members List Styles */
    .member-select-list {
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .member-select-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-bottom: 1px solid #f3f4f6;
      cursor: pointer;
      transition: background 0.15s;
    }
    .member-select-item:last-child {
      border-bottom: none;
    }
    .member-select-item:hover {
      background: #f9fafb;
    }
    .member-select-item.selected {
      background: rgba(120, 197, 3, 0.08);
    }
    .member-select-item input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: #0b4b34;
    }
    .member-select-info {
      flex: 1;
      min-width: 0;
    }
    .member-select-name {
      font-size: 14px;
      font-weight: 500;
      color: #111827;
    }
    .member-select-email {
      font-size: 12px;
      color: #6b7280;
    }
    .member-select-empty {
      padding: 24px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }
    
    .members-list {
      max-height: 300px;
      overflow-y: auto;
    }
    .member-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #f3f4f6;
    }
    .member-item:last-child {
      border-bottom: none;
    }
    .member-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .member-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--gryffi-primary, #0b4b34);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 12px;
      font-weight: 600;
    }
    .member-details {
      min-width: 0;
    }
    .member-name {
      font-size: 14px;
      font-weight: 500;
      color: #111827;
    }
    .member-email {
      font-size: 12px;
      color: #6b7280;
    }
    .btn-remove-member {
      padding: 6px;
      color: #6b7280;
      background: transparent;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-remove-member:hover {
      color: #dc2626;
      background: #fef2f2;
    }
    .members-empty {
      padding: 24px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }
    
    .add-members-section h4,
    .current-members-section h4 {
      font-size: 14px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 12px;
    }
    
