            <% if (syncLocked) { %>
              <div class="tier-lock-badge" title="<%= t('subscription.limits.syncLocked') %>">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
            <% } %>
            <div class="import-option-icon">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
              </svg>
            </div>
            <h4><%= t('systemSettings.endUsers.methods.microsoft.title') %></h4>
            <p><%= t('systemSettings.endUsers.methods.microsoft.description') %></p>
            <% if (syncLocked) { %>
              <span class="tier-lock-inline">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <%= t('subscription.limits.upgradeToUnlock') %>
              </span>
            <% } %>
          </div>
          
          <div class="import-option <%= syncLocked ? 'disabled tier-locked-feature' : '' %>" data-method="google" id="googleImportOption">
            <% if (syncLocked) { %>
              <div class="tier-lock-badge" title="<%= t('subscription.limits.syncLocked') %>">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
            <% } %>
            <div class="import-option-icon">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </div>
            <h4><%= t('systemSettings.endUsers.methods.google.title') %></h4>
            <p><%= t('systemSettings.endUsers.methods.google.description') %></p>
            <% if (syncLocked) { %>
              <span class="tier-lock-inline">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <%= t('subscription.limits.upgradeToUnlock') %>
              </span>
            <% } %>
          </div>
        </div>
        
        <% if (syncLocked) { %>
          <div class="tier-upgrade-notice">
            <div class="tier-upgrade-notice-text">
              <strong><%= t('subscription.limits.syncLocked') %></strong>
            </div>
            <a href="/dashboard/subscription" class="tier-upgrade-link"><%= t('subscription.cta.upgradeNow') %></a>
          </div>
        <% } %>
        
        <!-- Manual Entry Form -->
        <div class="form-section" id="manualEntryForm">
          <h3><%= t('systemSettings.endUsers.addManually') %></h3>
          <% if (subscriptionUsage && subscriptionUsage.endUsers) { %>
            <div class="tier-usage-inline" style="margin-bottom: 16px;">
              <span><%= subscriptionUsage.endUsers.used %> / <%= subscriptionUsage.endUsers.isUnlimited ? '∞' : subscriptionUsage.endUsers.limit %> <%= t('subscription.features.endUsers').toLowerCase() %></span>
              <% if (!subscriptionUsage.endUsers.isUnlimited) { %>
                <div class="tier-usage-bar">
                  <div class="tier-usage-bar-fill <%= subscriptionUsage.endUsers.percentage >= 90 ? 'danger' : (subscriptionUsage.endUsers.percentage >= 70 ? 'warning' : '') %>" style="width: <%= subscriptionUsage.endUsers.percentage %>%"></div>
                </div>
              <% } %>
            </div>
          <% } %>
          <% if (endUsersAtLimit) { %>
            <div class="tier-upgrade-notice" style="margin-bottom: 16px;">
              <div class="tier-upgrade-notice-text">
                <strong><%= t('subscription.limits.limitReached') %></strong><br>
                <%= t('subscription.limits.endUserLimitInfo', { limit: subscriptionUsage.endUsers.limit }) %>
              </div>
              <a href="/dashboard/subscription" class="tier-upgrade-link"><%= t('subscription.cta.upgradeNow') %></a>
            </div>
          <% } %>
          <form id="addUserForm" class="<%= endUsersAtLimit ? 'tier-disabled-field' : '' %>">
            <div class="form-grid">
              <div class="form-group">
                <label for="firstName"><%= t('systemSettings.endUsers.fields.firstName') %> *</label>
                <input type="text" id="firstName" name="first_name" placeholder="<%= t('systemSettings.endUsers.placeholders.firstName') %>" required <%= endUsersAtLimit ? 'disabled' : '' %>>
              </div>
              <div class="form-group">
                <label for="lastName"><%= t('systemSettings.endUsers.fields.lastName') %> *</label>
                <input type="text" id="lastName" name="last_name" placeholder="<%= t('systemSettings.endUsers.placeholders.lastName') %>" required <%= endUsersAtLimit ? 'disabled' : '' %>>
              </div>
              <div class="form-group">
                <label for="email"><%= t('systemSettings.endUsers.fields.email') %> *</label>
                <input type="email" id="email" name="email" placeholder="<%= t('systemSettings.endUsers.placeholders.email') %>" required <%= endUsersAtLimit ? 'disabled' : '' %>>
              </div>
              <div class="form-group" style="align-self: flex-end;">
                <button type="submit" class="btn btn-primary <%= endUsersAtLimit ? 'btn-disabled' : '' %>" id="addUserBtn" <%= endUsersAtLimit ? 'disabled' : '' %>>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                  <%= t('systemSettings.endUsers.addUser') %>
                </button>
              </div>
            </div>
          </form>
        </div>
        
        <!-- CSV Import Form -->
        <div class="form-section" id="csvImportForm" style="display: none;">
          <h3><%= t('systemSettings.import.title') %></h3>
          
          <% if (endUsersAtLimit) { %>
            <div class="tier-upgrade-notice" style="margin-bottom: 16px;">
              <div class="tier-upgrade-notice-text">
                <strong><%= t('subscription.limits.limitReached') %></strong><br>
                <%= t('subscription.limits.endUserLimitInfo', { limit: subscriptionUsage.endUsers.limit }) %>
              </div>
              <a href="/dashboard/subscription" class="tier-upgrade-link"><%= t('subscription.cta.upgradeNow') %></a>
            </div>
          <% } %>
          
          <div class="import-instructions">
            <h5>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= t('systemSettings.import.instructions.title') %>
            </h5>
            <ul>
              <li><%= t('systemSettings.import.instructions.format') %></li>
              <li><%= t('systemSettings.import.instructions.columns') %>
                <ul style="margin-top: 4px;">
                  <li><strong><%= t('systemSettings.import.instructions.columnA') %></strong></li>
                  <li><strong><%= t('systemSettings.import.instructions.columnB') %></strong></li>
                  <li><strong><%= t('systemSettings.import.instructions.columnC') %></strong></li>
                </ul>
              </li>
            </ul>
            <p class="note"><%= t('systemSettings.import.instructions.headerNote') %></p>
          </div>
          
          <div class="import-dropzone <%= endUsersAtLimit ? 'tier-disabled-field' : '' %>" id="importDropzone">
            <input type="file" id="importFileInput" accept=".csv,.xlsx,.xls,.ods" style="display: none;" <%= endUsersAtLimit ? 'disabled' : '' %>>
            <div class="import-dropzone-icon">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
            </div>
            <h4><%= endUsersAtLimit ? t('subscription.limits.limitReached') : t('systemSettings.import.dropzone.title') %></h4>
            <p><%= endUsersAtLimit ? t('subscription.limits.endUserLimitInfo', { limit: subscriptionUsage.endUsers.limit }) : t('systemSettings.import.dropzone.subtitle') %></p>
            <% if (!endUsersAtLimit) { %>
              <p class="formats"><%= t('systemSettings.import.dropzone.formats') %></p>
            <% } %>
          </div>
          
          <!-- Import Errors -->
          <div class="import-errors" id="importErrors" style="display: none;">
            <h5>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span id="importErrorsTitle"></span>
            </h5>
            <ul id="importErrorsList"></ul>
          </div>
          
          <!-- Import Preview -->
