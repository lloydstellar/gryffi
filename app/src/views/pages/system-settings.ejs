                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                  </svg>
                  <%= t('systemSettings.import.confirm.importBtn') %>
                </button>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Google Workspace Form -->
        <div class="form-section" id="googleWorkspaceForm" style="display: none;">
          <h3><%= t('systemSettings.google.title') %></h3>
          
