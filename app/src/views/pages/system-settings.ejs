      <div class="warning-banner-content">
        <h3><%= t('systemSettings.warning.title') %></h3>
        <p><%= t('systemSettings.warning.description') %></p>
      </div>
    </div>
    
    <!-- End Users Section -->
    <div class="card" id="endUsersCard">
      <div class="card-header">
        <h2><%= t('systemSettings.endUsers.title') %></h2>
      </div>
