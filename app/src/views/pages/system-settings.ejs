  <script>
    // ============================================
    // TAB NAVIGATION
    // ============================================
    
    function initTabs() {
      const tabs = document.querySelectorAll('.settings-tab');
      const panels = document.querySelectorAll('.settings-tab-panel');
      
      // Handle tab clicks
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const tabId = tab.dataset.tab;
          switchToTab(tabId);
          // Update URL hash - preserve import method if on users tab
          let hashValue = tabId;
          if (tabId === 'users') {
            const savedImportMethod = localStorage.getItem('gryffi_import_method') || 'manual';
            hashValue = 'users/' + savedImportMethod;
          }
          history.replaceState(null, null, '#' + hashValue);
          // Save to localStorage
          localStorage.setItem('gryffi_settings_tab', tabId);
        });
      });
      
      // Check for OAuth callback parameters FIRST (highest priority)
      const urlParams = new URLSearchParams(window.location.search);
      const googleConnected = urlParams.get('google_connected') === 'true';
      const googleError = urlParams.get('google_error');
      const microsoftConnected = urlParams.get('microsoft_connected') === 'true';
      const microsoftError = urlParams.get('microsoft_error');
      
      if (googleConnected || googleError) {
        // Google OAuth callback - switch to users/google
        switchToUsersImportMethod('google');
        if (googleConnected) {
          toastSuccess(<%-safeJson(t("systemSettings.google.connected"))%>);
        } else if (googleError) {
          toastError(googleError === 'access_denied' 
            ? <%-safeJson(t("systemSettings.google.accessDenied"))%> 
            : <%-safeJson(t("systemSettings.google.connectFailed"))%>);
        }
        // Clean URL but keep the hash for navigation state
        window.history.replaceState({}, document.title, window.location.pathname + '#users/google');
        return; // Don't process further - we've handled navigation
      }
      
      if (microsoftConnected || microsoftError) {
        // Microsoft OAuth callback - switch to users/microsoft
        switchToUsersImportMethod('microsoft');
        if (microsoftConnected) {
          toastSuccess(<%-safeJson(t("systemSettings.microsoft.connected"))%>);
        } else if (microsoftError) {
          toastError(microsoftError === 'consent_denied'
            ? <%-safeJson(t("systemSettings.microsoft.accessDenied"))%>
            : microsoftError === 'tenant_in_use'
              ? <%-safeJson(t("systemSettings.microsoft.tenantInUse"))%>
              : <%-safeJson(t("systemSettings.microsoft.connectFailed"))%>);
        }
        // Clean URL but keep the hash for navigation state
        window.history.replaceState({}, document.title, window.location.pathname + '#users/microsoft');
        return; // Don't process further - we've handled navigation
      }
      
      // Check for hash on page load (format: #tab or #tab/subtab)
      const hash = window.location.hash.slice(1);
      let targetTab = null;
      let targetImportMethod = null;
      
      if (hash) {
        const hashParts = hash.split('/');
        const mainHash = hashParts[0];
        const subHash = hashParts[1];
        
        // Map old hash names to new tab names
        const hashToTab = {
          'general': 'general',
          'users': 'users',
          'api': 'api',
          'themes': 'themes',
          'endUsersCard': 'users',
          'groupsCard': 'users',
          'apiAccessCard': 'api'
        };
        targetTab = hashToTab[mainHash] || mainHash;
        
        // Check for import method in hash (e.g. #users/google)
        if (targetTab === 'users' && subHash) {
          const validMethods = ['manual', 'csv', 'google', 'microsoft'];
          if (validMethods.includes(subHash)) {
            targetImportMethod = subHash;
          }
        }
      }
      
      // Fall back to localStorage if no hash
      if (!targetTab) {
        targetTab = localStorage.getItem('gryffi_settings_tab') || 'general';
      }
      if (!targetImportMethod && targetTab === 'users') {
        targetImportMethod = localStorage.getItem('gryffi_import_method');
      }
      
      // Switch to target tab
      if (document.querySelector(`[data-tab="${targetTab}"]`)) {
        switchToTab(targetTab);
        
        // If users tab, also switch to saved import method
        if (targetTab === 'users' && targetImportMethod) {
          // Use setTimeout to ensure DOM is ready
          setTimeout(() => {
            const importOption = document.querySelector(`[data-method="${targetImportMethod}"]`);
            if (importOption && !importOption.classList.contains('disabled')) {
              importOption.click();
            }
          }, 50);
        }
      }
    }
    
    function switchToTab(tabId) {
      const tabs = document.querySelectorAll('.settings-tab');
      const panels = document.querySelectorAll('.settings-tab-panel');
      
      // Update tab buttons
      tabs.forEach(t => {
        t.classList.toggle('active', t.dataset.tab === tabId);
      });
      
      // Update panels
      panels.forEach(p => {
        p.classList.toggle('active', p.id === 'tab-' + tabId);
      });
      
      // Save to localStorage
      localStorage.setItem('gryffi_settings_tab', tabId);
    }
    
    // Helper function to switch to users tab with specific import method
    function switchToUsersImportMethod(method) {
      switchToTab('users');
      const importOption = document.querySelector(`[data-method="${method}"]`);
      if (importOption && !importOption.classList.contains('disabled')) {
        importOption.click();
      }
      // Update hash
      history.replaceState(null, null, '#users/' + method);
    }
    
    // Initialize tabs on DOM ready
    document.addEventListener('DOMContentLoaded', initTabs);
    
