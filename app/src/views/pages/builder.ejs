              </div>
              <h3 id="identifyTitle" class="text-xl font-semibold text-zen-900"><%= t('journeys.public.identify.title') %></h3>
              <p id="identifyDescription" class="text-zen-600 text-sm mt-1"><%= t('journeys.public.identify.description') %></p>
            </div>
            
            <form id="publicIdentifyForm" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-zen-700 mb-1"><%= t('journeys.public.identify.firstName') %></label>
                <input type="text" name="firstName" required class="w-full px-4 py-3 rounded-lg border border-zen-200 focus:border-gryffi-primary focus:ring-2 focus:ring-gryffi-accent/20 outline-none transition-colors text-base">
              </div>
              <div>
                <label class="block text-sm font-medium text-zen-700 mb-1"><%= t('journeys.public.identify.lastName') %></label>
                <input type="text" name="lastName" required class="w-full px-4 py-3 rounded-lg border border-zen-200 focus:border-gryffi-primary focus:ring-2 focus:ring-gryffi-accent/20 outline-none transition-colors text-base">
              </div>
              <div>
                <label class="block text-sm font-medium text-zen-700 mb-1"><%= t('journeys.public.identify.email') %></label>
                <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-zen-200 focus:border-gryffi-primary focus:ring-2 focus:ring-gryffi-accent/20 outline-none transition-colors text-base">
              </div>
              
              <div id="identifyError" class="hidden text-red-500 text-sm text-center p-3 bg-red-50 rounded-lg"></div>
              
              <!-- Remember me checkbox -->
              <label class="flex items-start gap-3 cursor-pointer select-none mt-2">
                <input type="checkbox" id="rememberMeCheckbox" class="w-5 h-5 mt-0.5 rounded border-zen-300 text-gryffi-primary focus:ring-gryffi-accent cursor-pointer" style="accent-color: var(--theme-primary, #0b4b34);">
                <span class="text-sm text-zen-600 leading-tight"><%= t('journeys.public.identify.rememberMe') %></span>
              </label>
              
              <button type="submit" class="w-full py-3 px-4 rounded-lg font-medium transition-colors" style="background: var(--theme-primary, #0b4b34); color: var(--theme-button-text, white);">
                <%= t('journeys.public.identify.submit') %>
              </button>
              
              <% if (typeof previewMode !== 'undefined' && previewMode) { %>
              <!-- Skip option only visible in preview mode -->
              <button type="button" id="skipIdentifyBtn" class="w-full py-2 mt-2 text-sm text-zen-400 hover:text-zen-600 transition-colors">
                <%= t('journeys.public.identify.skipPreview') %>
              </button>
              <% } %>
            </form>
          </div>
          
          <!-- Verify Step -->
          <div id="verifyStep" class="hidden">
            <div class="text-center mb-6">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: color-mix(in srgb, var(--theme-accent, #78c503) 10%, white);">
                <svg class="w-8 h-8" style="color: var(--theme-accent, #78c503);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-zen-900"><%= t('journeys.public.verify.title') %></h3>
              <p class="text-zen-600 text-sm mt-1" id="verifyEmailText"></p>
            </div>
            
            <form id="publicVerifyForm" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-zen-700 mb-1"><%= t('journeys.public.verify.code') %></label>
                <input type="text" name="code" required pattern="[0-9]{6}" maxlength="6" class="w-full px-4 py-3 rounded-lg border border-zen-200 focus:border-gryffi-primary focus:ring-2 focus:ring-gryffi-accent/20 outline-none transition-colors text-center text-2xl tracking-widest font-mono">
              </div>
              
              <div id="verifyError" class="hidden text-red-500 text-sm text-center p-3 bg-red-50 rounded-lg"></div>
              
              <button type="submit" class="w-full py-3 px-4 rounded-lg font-medium transition-colors" style="background: var(--theme-primary, #0b4b34); color: var(--theme-button-text, white);">
                <%= t('journeys.public.verify.submit') %>
              </button>
              
              <button type="button" id="resendCodeBtn" class="w-full py-2 text-sm text-zen-500 hover:text-zen-700 transition-colors">
                <%= t('journeys.public.verify.resend') %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    // Public Journey Identification System
    (function() {
      const modal = document.getElementById('publicIdentifyModal');
      const identifyStep = document.getElementById('identifyStep');
      const verifyStep = document.getElementById('verifyStep');
      const identifyForm = document.getElementById('publicIdentifyForm');
      const verifyForm = document.getElementById('publicVerifyForm');
      const identifyError = document.getElementById('identifyError');
      const verifyError = document.getElementById('verifyError');
      const verifyEmailText = document.getElementById('verifyEmailText');
      const resendBtn = document.getElementById('resendCodeBtn');
      const identifyTitle = document.getElementById('identifyTitle');
      const identifyDescription = document.getElementById('identifyDescription');
      const identifyIcon = document.getElementById('identifyIcon');
      
      if (!modal) return;
      
      let pendingAction = null; // Store the pending action to execute after verification
      let userEmail = '';
      let stepType = '';
      let stepId = '';
      
      // Get theme accent color for icons
      const themeAccent = getComputedStyle(document.documentElement).getPropertyValue('--theme-accent').trim() || '#78c503';
      
      // Context-specific content for different step types
      const stepContent = {
        poll: {
          title: <%-safeJson(t('journeys.public.identify.poll.title'))%>,
          description: <%-safeJson(t('journeys.public.identify.poll.description'))%>,
          icon: `<svg class="w-8 h-8" style="color: ${themeAccent};" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`
        },
        reward: {
          title: <%-safeJson(t('journeys.public.identify.reward.title'))%>,
          description: <%-safeJson(t('journeys.public.identify.reward.description'))%>,
          icon: `<svg class="w-8 h-8" style="color: ${themeAccent};" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>`
        },
        form: {
          title: <%-safeJson(t('journeys.public.identify.form.title'))%>,
          description: <%-safeJson(t('journeys.public.identify.form.description'))%>,
          icon: `<svg class="w-8 h-8" style="color: ${themeAccent};" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`
        }
      };
      
      // Default content (fallback)
      const defaultContent = {
        title: <%-safeJson(t('journeys.public.identify.title'))%>,
        description: <%-safeJson(t('journeys.public.identify.description'))%>,
        icon: `<svg class="w-8 h-8" style="color: ${themeAccent};" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>`
      };
      
      // LocalStorage key for remembered user details
      const STORAGE_KEY = 'gryffi_public_user';
      const rememberMeCheckbox = document.getElementById('rememberMeCheckbox');
      
      // Load saved user details from localStorage
      function loadSavedUserDetails() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            return JSON.parse(saved);
          }
        } catch (e) {
          console.log('Could not load saved user details:', e);
        }
        return null;
      }
      
      // Save user details to localStorage (with rememberMe flag)
      function saveUserDetails(firstName, lastName, email) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ 
            firstName, 
            lastName, 
            email,
            rememberMe: true,
            savedAt: Date.now()
          }));
        } catch (e) {
          console.log('Could not save user details:', e);
        }
      }
      
      // Keep the secret "remember me" token next to the saved details. Without
      // it the server will not auto-login (an email address alone is not enough).
      function storeRememberToken(rememberToken) {
        try {
          const saved = loadSavedUserDetails();
          if (!saved || !saved.rememberMe || !rememberToken) return;
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...saved, rememberToken }));
        } catch (e) {
          console.log('Could not save remember token:', e);
        }
      }
      
      // Remove saved user details
      function clearSavedUserDetails() {
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (e) {
          console.log('Could not clear saved user details:', e);
        }
      }
      
      // Try auto-login with saved credentials
      async function tryAutoLogin() {
        const savedDetails = loadSavedUserDetails();
        if (!savedDetails || !savedDetails.rememberMe || !savedDetails.email || !savedDetails.rememberToken) {
          return false;
        }
        
        const token = window.GRYFFI?.publicPlayer?.token;
        if (!token) {
          return false;
        }
        
        try {
          console.log('[AutoLogin] Attempting auto-login for:', savedDetails.email);
          const response = await fetch(`/p/${token}/auto-login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: savedDetails.email,
              rememberToken: savedDetails.rememberToken
            })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Auto-login successful - update public player state
            window.GRYFFI.publicPlayer = window.GRYFFI.publicPlayer || {};
            window.GRYFFI.publicPlayer.firstName = data.participant.firstName;
            window.GRYFFI.publicPlayer.lastName = data.participant.lastName;
            window.GRYFFI.publicPlayer.email = data.participant.email;
            window.GRYFFI.publicPlayer.participantId = data.participant.id;
            window.GRYFFI.publicPlayer.isIdentified = true;
            window.GRYFFI.publicPlayer.isVerified = true;
            storeRememberToken(data.rememberToken);
            
            console.log('[AutoLogin] Success! User is now verified.');
            return true;
          } else {
            console.log('[AutoLogin] Not verified yet, will need identification flow');
            return false;
          }
        } catch (err) {
          console.log('[AutoLogin] Error:', err);
          return false;
        }
      }
      
      // Try auto-login on page load (for public journeys)
      if (window.GRYFFI?.publicMode && window.GRYFFI?.publicPlayer?.token && !window.GRYFFI?.previewMode) {
        tryAutoLogin().then(success => {
          if (success) {
            console.log('[AutoLogin] User automatically authenticated from saved credentials');
          }
        });
      }
      
      // Public journey close button handler
      // Save the original referrer and history length at page load (before journey navigation adds history items)
      const originalReferrer = document.referrer;
      const journeyUrl = window.location.href;
      const initialHistoryLength = window.history.length;
      
      const publicCloseBtn = document.getElementById('publicJourneyCloseBtn');
      if (publicCloseBtn) {
        publicCloseBtn.addEventListener('click', function() {
          // Try to go back to the page that opened this journey
          if (originalReferrer && originalReferrer !== journeyUrl && !originalReferrer.includes(window.location.pathname)) {
            // If there's a referrer that's different from current journey, go there directly
            window.location.href = originalReferrer;
          } else {
            // No valid referrer - calculate how many history items were added by journey navigation
            // and go back past all of them in one step
            const historyItemsAdded = window.history.length - initialHistoryLength;
            
            if (historyItemsAdded > 0) {
              // Go back past all journey history items plus one more to exit the journey
              window.history.go(-(historyItemsAdded + 1));
            } else if (window.history.length > 1) {
              // No items were added but there's history - just go back once
              window.history.back();
            } else {
              // No history at all - try to close the window/tab
              window.close();
              // If window.close() didn't work (e.g., not opened by script), show message
              setTimeout(() => {
                alert(<%-safeJson(t('journeys.public.closeWindowMessage'))%>);
              }, 100);
            }
          }
        });
      }
      
      // Expose the identify function globally for the builder
      window.GRYFFI = window.GRYFFI || {};
      window.GRYFFI.publicIdentify = async function(action, type, id) {
        return new Promise((resolve, reject) => {
          pendingAction = { action, resolve, reject };
          stepType = type;
          stepId = id;
          
          // Check if already identified and verified
          if (window.GRYFFI.publicPlayer?.isVerified) {
            resolve(true);
            return;
          }
          
          // Update modal content based on step type
          const content = stepContent[type] || defaultContent;
          identifyTitle.textContent = content.title;
          identifyDescription.textContent = content.description;
          identifyIcon.innerHTML = content.icon;
          
          // Show modal
          modal.classList.remove('hidden');
          identifyStep.classList.remove('hidden');
          verifyStep.classList.add('hidden');
          identifyError.classList.add('hidden');
          
          // Reset checkbox
          if (rememberMeCheckbox) {
            rememberMeCheckbox.checked = false;
          }
          
          // Pre-fill from session first, then from localStorage
          const savedDetails = loadSavedUserDetails();
          
          if (window.GRYFFI.publicPlayer?.firstName) {
            identifyForm.querySelector('[name="firstName"]').value = window.GRYFFI.publicPlayer.firstName;
          } else if (savedDetails?.firstName) {
            identifyForm.querySelector('[name="firstName"]').value = savedDetails.firstName;
            if (rememberMeCheckbox) rememberMeCheckbox.checked = true;
          }
          
          if (window.GRYFFI.publicPlayer?.lastName) {
            identifyForm.querySelector('[name="lastName"]').value = window.GRYFFI.publicPlayer.lastName;
          } else if (savedDetails?.lastName) {
            identifyForm.querySelector('[name="lastName"]').value = savedDetails.lastName;
          }
          
          if (window.GRYFFI.publicPlayer?.email) {
            identifyForm.querySelector('[name="email"]').value = window.GRYFFI.publicPlayer.email;
          } else if (savedDetails?.email) {
            identifyForm.querySelector('[name="email"]').value = savedDetails.email;
          }
        });
      };
      
      // Skip identification (preview mode only)
      const skipBtn = document.getElementById('skipIdentifyBtn');
      if (skipBtn) {
        skipBtn.addEventListener('click', () => {
          // Set fake identification for preview mode
          window.GRYFFI.publicPlayer = window.GRYFFI.publicPlayer || {};
          window.GRYFFI.publicPlayer.firstName = 'Preview';
          window.GRYFFI.publicPlayer.lastName = 'User';
          window.GRYFFI.publicPlayer.email = 'preview@example.com';
          window.GRYFFI.publicPlayer.isIdentified = true;
          window.GRYFFI.publicPlayer.isVerified = true;
          
          // Hide modal
          modal.classList.add('hidden');
          
          // Resolve pending action
          pendingAction?.resolve(true);
          pendingAction = null;
        });
      }
      
      // Handle identify form submission
      identifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        identifyError.classList.add('hidden');
        
        const formData = new FormData(identifyForm);
        const firstName = formData.get('firstName').trim();
        const lastName = formData.get('lastName').trim();
        const email = formData.get('email').trim().toLowerCase();
        
        userEmail = email;
        
        // Handle remember me preference
        if (rememberMeCheckbox && rememberMeCheckbox.checked) {
          saveUserDetails(firstName, lastName, email);
        } else {
          clearSavedUserDetails();
        }
        
        // Check if this is preview mode (no real token)
        const token = window.GRYFFI.publicPlayer?.token;
        const isPreviewMode = window.GRYFFI?.previewMode && !token;
        
        if (isPreviewMode) {
          // Simulate successful identification in preview mode (skip verification)
          window.GRYFFI.publicPlayer = window.GRYFFI.publicPlayer || {};
          window.GRYFFI.publicPlayer.firstName = firstName;
          window.GRYFFI.publicPlayer.lastName = lastName;
          window.GRYFFI.publicPlayer.email = email;
          window.GRYFFI.publicPlayer.isIdentified = true;
          window.GRYFFI.publicPlayer.isVerified = true;
          
          // Hide modal
          modal.classList.add('hidden');
          
          // Resolve pending action
          pendingAction?.resolve(true);
          pendingAction = null;
          return;
        }
        
        try {
          const response = await fetch(`/p/${token}/identify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              firstName, 
              lastName, 
              email,
              stepType,
              stepId
            })
          });
          
          const data = await response.json();
          
          if (data.success && data.alreadyVoted) {
            // User already voted - close modal and resolve with the poll results
            modal.classList.add('hidden');
            pendingAction?.resolve({ 
              alreadyVoted: true, 
              userVote: data.userVote,
              results: data.results,
              totalVotes: data.totalVotes,
              message: data.message
            });
            pendingAction = null;
          } else if (data.success && data.needsVerification) {
            // Show verification step
            identifyStep.classList.add('hidden');
            verifyStep.classList.remove('hidden');
            verifyEmailText.textContent = <%-safeJson(t('journeys.public.verify.description'))%>.replace('{{email}}', email);
          } else if (!data.success) {
            identifyError.textContent = data.error || 'Failed to identify';
            identifyError.classList.remove('hidden');
            
            if (data.code === 'ALREADY_VOTED' || data.code === 'ALREADY_CLAIMED' || data.code === 'ALREADY_PARTICIPATED') {
              // Close modal and reject
              modal.classList.add('hidden');
              pendingAction?.reject(new Error(data.error));
            }
          }
        } catch (err) {
          console.error('Identify error:', err);
          identifyError.textContent = 'An error occurred. Please try again.';
          identifyError.classList.remove('hidden');
        }
      });
      
      // Handle verify form submission
      verifyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        verifyError.classList.add('hidden');
        
        const code = verifyForm.querySelector('[name="code"]').value.trim();
        
        try {
          const token = window.GRYFFI.publicPlayer?.token;
          const response = await fetch(`/p/${token}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Update public player state
            window.GRYFFI.publicPlayer.email = data.participant.email;
            window.GRYFFI.publicPlayer.firstName = data.participant.firstName;
            window.GRYFFI.publicPlayer.lastName = data.participant.lastName;
            window.GRYFFI.publicPlayer.isIdentified = true;
            window.GRYFFI.publicPlayer.isVerified = true;
            storeRememberToken(data.rememberToken);
            
            // Hide modal
            modal.classList.add('hidden');
            
            // Resolve pending action
            pendingAction?.resolve(true);
          } else {
            verifyError.textContent = data.error || 'Invalid code';
            verifyError.classList.remove('hidden');
          }
        } catch (err) {
          console.error('Verify error:', err);
          verifyError.textContent = 'An error occurred. Please try again.';
          verifyError.classList.remove('hidden');
        }
      });
      
      // Handle resend code
      resendBtn.addEventListener('click', async () => {
        try {
          const token = window.GRYFFI.publicPlayer?.token;
          const firstName = identifyForm.querySelector('[name="firstName"]').value;
          const lastName = identifyForm.querySelector('[name="lastName"]').value;
          
          const response = await fetch(`/p/${token}/identify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              firstName, 
              lastName, 
              email: userEmail,
              stepType,
              stepId
            })
          });
          
          const data = await response.json();
          
          if (data.success) {
            if (window.gryffi?.toast) {
              window.gryffi.toast.success(<%-safeJson(t('journeys.public.verify.codeSent'))%>);
            }
          }
        } catch (err) {
          console.error('Resend error:', err);
        }
      });
      
      // Close modal on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
          pendingAction?.reject(new Error('Cancelled'));
        }
      });
    })();
  </script>
  <% } %>
  
  <% if (journey.is_public && journey.public_token && !(typeof publicMode !== 'undefined' && publicMode)) { %>
  <script>
    // Public Link Dropdown (for builder view, not player view)
    (function() {
      const btn = document.getElementById('publicLinkBtn');
      const dropdown = document.getElementById('publicLinkDropdown');
      const closeBtn = document.getElementById('closePublicLinkDropdown');
      const copyBtn = document.getElementById('copyPublicLinkBtn');
      const input = document.getElementById('publicLinkInput');
      
      if (!btn || !dropdown) return;
      
      // Toggle dropdown
      btn.addEventListener('click', () => {
        dropdown.classList.toggle('hidden');
      });
      
      // Close dropdown
      closeBtn?.addEventListener('click', () => {
        dropdown.classList.add('hidden');
      });
      
      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#publicLinkContainer')) {
          dropdown.classList.add('hidden');
        }
      });
      
      // Copy link
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(input.value);
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.linkCopied'))%>);
        } catch (err) {
          // Fallback for older browsers
          input.select();
          document.execCommand('copy');
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.linkCopied'))%>);
        }
      });
    })();
  </script>
  <% } %>
  
