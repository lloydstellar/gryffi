        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      .source-drawer-excerpt {
        font-size: 13px;
        padding: 12px;
      }
      
      /* Quiz Options - Larger touch targets */
      .quiz-wizard-option,
      .preview-option {
        padding: 16px;
        min-height: 54px;
      }
      .option-letter {
        width: 36px;
        height: 36px;
        font-size: 14px;
      }
      
      /* Navigation Buttons - Full width on mobile */
      .preview-nav-buttons {
        padding: 0 20px 20px;
      }
      .preview-nav-btn,
      .btn-primary,
      .btn-secondary {
        width: 100%;
        padding: 14px 20px;
        font-size: 15px;
      }
      
      /* Chat messages - Better spacing */
      .chat-message,
      .guide-chat-message {
        max-width: 90%;
        font-size: 15px;
      }
      
      /* Citation badge - Larger touch target */
      .citation-badge {
        padding: 4px 8px;
        font-size: 12px;
      }
      
      /* Form inputs - Prevent iOS zoom */
      .form-input,
      .form-textarea,
      .chat-input,
      input[type="text"],
      input[type="email"],
      textarea,
      select {
        font-size: 16px !important;
      }
    }
    
    /* Extra small screens (iPhone SE, etc) */
    @media (max-width: 375px) {
      .player-header {
        padding: 8px 12px;
      }
      .player-title {
        font-size: 13px;
      }
      .player-header-right {
        font-size: 12px;
      }
      .preview-card {
        margin: 12px;
      }
      .preview-content,
      .preview-options {
        padding: 16px;
      }
      .guide-chat-fab-name {
        display: none; /* Only show avatar on very small screens */
      }
      .guide-chat-fab {
        padding: 10px;
        border-radius: 50%;
      }
    }
    
    /* Landscape mode adjustments */
    @media (max-width: 640px) and (orientation: landscape) {
      .guide-chat-panel {
        max-height: 90vh;
      }
      .guide-chat-messages {
        max-height: calc(90vh - 140px);
        min-height: 120px;
      }
      .source-drawer-content {
        max-height: 85vh;
      }
      .source-drawer-body {
        max-height: calc(85vh - 70px);
      }
    }
    
    /* Safe area insets for notched phones */
    @supports (padding: max(0px)) {
      @media (max-width: 640px) {
        .player-header {
          padding-left: max(16px, env(safe-area-inset-left));
          padding-right: max(16px, env(safe-area-inset-right));
        }
        .preview-card {
          margin-left: max(16px, env(safe-area-inset-left));
          margin-right: max(16px, env(safe-area-inset-right));
        }
        .guide-chat-panel,
        .source-drawer-content {
          padding-bottom: env(safe-area-inset-bottom);
        }
      }
    }
  </style>

<% if (typeof playerMode === 'undefined' || !playerMode) { %>
  <%- include('../partials/help-modal') %>
<% } %>
</body>
</html>
