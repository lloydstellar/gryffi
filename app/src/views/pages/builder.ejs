  <% if (typeof publicMode !== 'undefined' && publicMode) { %>
  <!-- Public Journey Identification Modal -->
  <div id="publicIdentifyModal" class="fixed inset-0 hidden" style="background: rgba(0,0,0,0.5); z-index: 99999;">
    <div class="min-h-screen flex items-center justify-center p-4" style="position: relative; z-index: 99999;">
      <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden" style="animation: modalSlideIn 0.2s ease-out; position: relative; z-index: 100000;">
        <div class="p-6">
          <!-- Identify Step -->
          <div id="identifyStep">
            <div class="text-center mb-6">
              <div id="identifyIcon" class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: color-mix(in srgb, var(--theme-accent, #78c503) 10%, white);">
                <!-- Default icon - will be updated by JS -->
                <svg class="w-8 h-8" style="color: var(--theme-accent, #78c503);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
