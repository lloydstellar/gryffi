<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('auth.forgotPassword') %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="min-h-screen bg-gryffi-bg flex items-center justify-center p-4">
  <!-- Background decoration -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-gryffi-accent/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute -bottom-1/2 -left-1/2 w-full h-full bg-gradient-to-tr from-gryffi-primary/10 to-transparent rounded-full blur-3xl"></div>
  </div>
  
  <div class="w-full max-w-md relative">
    <!-- Logo and title -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center gap-3 mb-4">
        <img src="/images/logos/Logo---illustration-only-cropped-transparant.png" alt="Gryffi" class="w-16 h-16">
      </div>
      <h1 class="text-3xl font-display font-bold text-gryffi-primary"><%= t('auth.resetPassword') %></h1>
      <p class="text-zen-500 mt-2"><%= t('auth.tagline') %></p>
    </div>
    
    <!-- Reset card -->
    <div class="glass-card-solid p-8">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error animate-fade-in mb-4">
          <%= error %>
        </div>
      <% } %>
      
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-success animate-fade-in mb-4">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= success %></span>
          </div>
        </div>
      <% } else { %>
        <form action="/forgot-password" method="POST" class="space-y-5">
          <div>
            <label for="email" class="input-label"><%= t('auth.email') %></label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="input"
              placeholder="<%= t('auth.emailPlaceholder') %>"
              required
              autofocus
            >
          </div>
          
          <button type="submit" class="btn-primary w-full py-3">
            <%= t('auth.sendResetLink') %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>
        </form>
      <% } %>
      
      <div class="mt-6 pt-6 border-t border-zen-200">
        <a href="/login" class="flex items-center justify-center gap-2 text-sm text-zen-500 hover:text-gryffi-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <%= t('auth.backToLogin') %>
        </a>
      </div>
    </div>
    
    <!-- Footer -->
    <p class="text-center text-zen-400 text-sm mt-6">
      Gryffi - <%= t('footer.tagline') %>
    </p>
  </div>
</body>
</html>
