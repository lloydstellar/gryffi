    // Format date
    function formatDate(dateStr) {
      if (!dateStr) return '-';
      return new Date(dateStr).toLocaleDateString(language, { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      });
    }
    
    // Format average time (days to human readable)
    function formatAvgTime(avgDays) {
      const days = parseFloat(avgDays);
      if (!days || isNaN(days) || days <= 0) return '-';
      
      if (days >= 1) {
        return `${Math.round(days * 10) / 10} ${translations.days}`;
      }
      
      const hours = days * 24;
      if (hours >= 1) {
        return `${Math.round(hours * 10) / 10}h`;
      }
      
      const minutes = Math.round(hours * 60);
      if (minutes >= 1) {
        return `${minutes} min`;
      }
      
      const seconds = Math.round(hours * 3600);
      return seconds > 0 ? `${seconds} sec` : '< 1 sec';
    }
    
    // Render Journey Report
    function renderJourneyReport(report, generatedAt) {
      destroyCharts();
      
      const stats = report.statistics;
      // Format average time: show days for >24h, hours for >1h, minutes for shorter times
      let avgTime = '-';
      if (stats.avgHoursToComplete && stats.avgHoursToComplete > 0) {
        if (stats.avgHoursToComplete >= 24) {
          avgTime = `${Math.round(stats.avgHoursToComplete / 24 * 10) / 10} ${translations.days}`;
        } else if (stats.avgHoursToComplete >= 1) {
          avgTime = `${Math.round(stats.avgHoursToComplete * 10) / 10}h`;
        } else {
          const minutes = Math.round(stats.avgHoursToComplete * 60);
          avgTime = minutes > 0 ? `${minutes} min` : '< 1 min';
        }
      }
      
      let html = `
        <div class="report-preview" id="reportContent">
          <div class="report-header">
            <div class="report-header-left">
              <h1>${escapeHtml(report.journey.title)}</h1>
              <div class="report-header-meta">
                ${translations.journeyPerformance} · ${formatDate(generatedAt)}
              </div>
            </div>
            <img src="/images/logos/Logo---transparant-white-cropped.png" class="report-header-logo" alt="Gryffi">
          </div>
          
          <div class="report-kpi-grid">
            <div class="report-kpi">
              <div class="report-kpi-value">${stats.totalInvitations}</div>
              <div class="report-kpi-label">${translations.invitations}</div>
            </div>
            <div class="report-kpi">
              <div class="report-kpi-value">${stats.completed}</div>
              <div class="report-kpi-label">${translations.completed}</div>
            </div>
            <div class="report-kpi">
              <div class="report-kpi-value">${stats.completionRate}%</div>
              <div class="report-kpi-label">${translations.completionRate}</div>
            </div>
            <div class="report-kpi">
              <div class="report-kpi-value">${avgTime}</div>
              <div class="report-kpi-label">${translations.avgTime}</div>
            </div>
          </div>
      `;
      
      // Funnel Section
      if (report.funnel && report.funnel.length > 0) {
        html += `
          <div class="report-section">
            <h3 class="report-section-title">${translations.funnel}</h3>
            <div class="report-funnel">
        `;
        
        report.funnel.forEach((step, idx) => {
          // Only show bar if there's actual data, minimum 5% width for visibility when > 0
          const barWidth = step.reachedCount > 0 ? Math.max(step.reachedPercent, 5) : 0;
          html += `
            <div class="report-funnel-step">
              <span class="report-funnel-label">${idx + 1}. ${escapeHtml(step.title)}</span>
              <div class="report-funnel-bar-container">
                <div class="report-funnel-bar" style="width: ${barWidth}%;">
                  ${step.reachedCount > 0 ? `<span class="report-funnel-value">${step.reachedCount}</span>` : ''}
                </div>
              </div>
              <span class="report-funnel-percent">${step.reachedPercent}%</span>
            </div>
          `;
        });
        
        html += `
            </div>
          </div>
        `;
      }
      
      // Poll Results
      if (report.polls && report.polls.length > 0) {
        html += `
          <div class="report-section">
            <h3 class="report-section-title">${translations.pollResults}</h3>
        `;
        
        report.polls.forEach((poll, pollIdx) => {
          const options = poll.basic_props?.options || [];
          const totalVotes = parseInt(poll.total_votes) || 0;
          
          html += `
            <div style="margin-bottom: 24px;">
              <h4 style="font-size: 14px; font-weight: 500; color: #334155; margin: 0 0 12px 0;">
                ${escapeHtml(poll.basic_props?.question || poll.step_title)}
              </h4>
              <div class="report-chart-container" style="height: 200px;">
                <canvas id="pollChart${pollIdx}"></canvas>
              </div>
            </div>
          `;
        });
        
        html += `</div>`;
      }
      
      // Participants Table
      if (report.participants && report.participants.length > 0) {
        html += `
          <div class="report-section">
            <h3 class="report-section-title">${translations.participants}</h3>
            <table class="report-table">
              <thead>
                <tr>
