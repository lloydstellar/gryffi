    // ========================================
    // PROFESSIONAL PDF GENERATION WITH jsPDF
    // ========================================
    
    // Load logo as base64 for PDF
    // Uses custom theme logo (light version for dark PDF headers) if available, otherwise Gryffi default
    let cachedLogoBase64 = null;
    let cachedLogoUrl = null;
    
    async function loadLogoForPDF() {
      // Determine which logo to use: theme light logo > theme logo > default Gryffi logo
      const logoUrl = activeThemeLogoLightUrl || activeThemeLogoUrl || '/images/logos/Logo---transparant-white-cropped.png';
      
      // Return cached version if same URL
      if (cachedLogoBase64 && cachedLogoUrl === logoUrl) {
        return cachedLogoBase64;
      }
      
      try {
        const response = await fetch(logoUrl);
        const blob = await response.blob();
        return new Promise((resolve) => {
          const reader = new FileReader();
          reader.onloadend = () => {
            cachedLogoBase64 = reader.result;
            cachedLogoUrl = logoUrl;
            resolve(cachedLogoBase64);
          };
          reader.readAsDataURL(blob);
        });
      } catch (err) {
        console.error('Failed to load logo:', err);
        return null;
      }
    }
    
    // Get image dimensions from base64 data - returns promise with { width, height, aspectRatio }
    function getImageDimensions(base64Data) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          resolve({
            width: img.naturalWidth,
            height: img.naturalHeight,
            aspectRatio: img.naturalWidth / img.naturalHeight
          });
        };
        img.onerror = () => {
          // Fallback to default Gryffi logo aspect ratio
          resolve({ width: 693, height: 292, aspectRatio: 2.37 });
        };
        img.src = base64Data;
      });
    }
    
    // PDF Helper class for consistent styling
    class PDFReport {
      constructor(title, subtitle, logoBase64 = null, logoDimensions = null, trans = translations) {
        const { jsPDF } = window.jspdf;
        this.pdf = new jsPDF('p', 'mm', 'a4');
        this.pageWidth = this.pdf.internal.pageSize.getWidth();
        this.pageHeight = this.pdf.internal.pageSize.getHeight();
        this.margin = 15;
        this.contentWidth = this.pageWidth - (this.margin * 2);
        this.y = this.margin;
        this.pageNum = 1;
        this.title = title;
        this.subtitle = subtitle;
        this.logoBase64 = logoBase64;
        // Logo dimensions for maintaining aspect ratio (default to Gryffi logo ratio)
        this.logoDimensions = logoDimensions || { width: 693, height: 292, aspectRatio: 2.37 };
        this.trans = trans;
        this.generatedDate = new Date().toLocaleDateString(language, { year: 'numeric', month: 'long', day: 'numeric' });
        
        // Colors - use theme colors if available
        this.colors = getPdfColors();
        
        // Use NotoSans for Unicode support (Turkish, Arabic, Chinese, etc.)
        // Falls back to Helvetica if NotoSans not loaded
        this.fontFamily = this.pdf.getFontList()['NotoSans'] ? 'NotoSans' : 'helvetica';
        console.log('[Analytics PDF] Using font:', this.fontFamily);
      }
      
      // Check if we need a new page
      checkNewPage(neededHeight = 30) {
        if (this.y + neededHeight > this.pageHeight - 20) {
          this.addPage();
          return true;
        }
        return false;
      }
      
      // Add a new page
      addPage() {
        this.pdf.addPage();
        this.pageNum++;
        this.y = this.margin;
        this.addPageFooter();
      }
      
      // Add header with logo and title
      addHeader() {
        // Green header bar
        this.pdf.setFillColor(...this.colors.primary);
        this.pdf.rect(0, 0, this.pageWidth, 35, 'F');
        
        // Title (left side)
        this.pdf.setTextColor(...this.colors.white);
        this.pdf.setFontSize(18);
        this.pdf.setFont(this.fontFamily, 'bold');
        this.pdf.text(this.title, this.margin, 14);
        
        // Subtitle with date
        this.pdf.setFontSize(10);
        this.pdf.setFont(this.fontFamily, 'normal');
        this.pdf.text(`${this.subtitle} · ${this.generatedDate}`, this.margin, 23);
        
        // Logo (right side) - calculate dimensions maintaining aspect ratio
        // Max height is 16mm, max width is 50mm (to leave room for header text)
        const maxLogoHeight = 16;
        const maxLogoWidth = 50;
        
        let logoWidth, logoHeight;
        if (this.logoDimensions.aspectRatio > (maxLogoWidth / maxLogoHeight)) {
          // Width-constrained: logo is wider than max ratio
          logoWidth = maxLogoWidth;
          logoHeight = logoWidth / this.logoDimensions.aspectRatio;
        } else {
          // Height-constrained: logo is taller than max ratio
          logoHeight = maxLogoHeight;
          logoWidth = logoHeight * this.logoDimensions.aspectRatio;
        }
        
        const logoX = this.pageWidth - this.margin - logoWidth;
        const logoY = (35 - logoHeight) / 2; // Center vertically in header
        
        if (this.logoBase64) {
          try {
            this.pdf.addImage(this.logoBase64, 'PNG', logoX, logoY, logoWidth, logoHeight);
          } catch (e) {
            // Fallback to text if logo fails
            this.pdf.setTextColor(...this.colors.white);
            this.pdf.setFontSize(14);
            this.pdf.setFont(this.fontFamily, 'bold');
            this.pdf.text('Gryffi', this.pageWidth - this.margin - 25, 20);
          }
        } else {
          // Fallback text logo
          this.pdf.setTextColor(...this.colors.white);
          this.pdf.setFontSize(14);
          this.pdf.setFont(this.fontFamily, 'bold');
          this.pdf.text('Gryffi', this.pageWidth - this.margin - 25, 20);
        }
        
        this.y = 45;
        this.addPageFooter();
      }
      
      // Add page footer
      addPageFooter() {
        this.pdf.setFontSize(8);
        this.pdf.setTextColor(...this.colors.gray);
        this.pdf.setFont(this.fontFamily, 'normal');
        this.pdf.text(`${this.trans.reportFooter} - ${this.trans.page} ${this.pageNum}`, this.margin, this.pageHeight - 8);
        this.pdf.text('gryffi.com', this.pageWidth - this.margin - 20, this.pageHeight - 8);
      }
      
      // Add section title
      addSectionTitle(title) {
        this.checkNewPage(20);
        this.y += 5;
        
        // Section line
        this.pdf.setDrawColor(...this.colors.primary);
        this.pdf.setLineWidth(0.5);
        this.pdf.line(this.margin, this.y, this.margin + 30, this.y);
        
        this.y += 6;
        this.pdf.setTextColor(...this.colors.dark);
        this.pdf.setFontSize(14);
        this.pdf.setFont(this.fontFamily, 'bold');
        this.pdf.text(title, this.margin, this.y);
        this.y += 10;
      }
      
      // Add KPI cards row
      addKPIRow(kpis) {
        this.checkNewPage(45);
        
        const cardWidth = (this.contentWidth - 15) / 4;
        const cardHeight = 35;
        let x = this.margin;
        
        kpis.forEach((kpi, i) => {
          // Card background
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(x, this.y, cardWidth, cardHeight, 3, 'F');
          
          // Value
          this.pdf.setTextColor(...this.colors.primary);
          this.pdf.setFontSize(22);
          this.pdf.setFont(this.fontFamily, 'bold');
          const valueText = String(kpi.value);
          const valueWidth = this.pdf.getTextWidth(valueText);
          this.pdf.text(valueText, x + (cardWidth - valueWidth) / 2, this.y + 15);
          
          // Label
          this.pdf.setTextColor(...this.colors.gray);
          this.pdf.setFontSize(9);
          this.pdf.setFont(this.fontFamily, 'normal');
          const labelWidth = this.pdf.getTextWidth(kpi.label);
          this.pdf.text(kpi.label, x + (cardWidth - labelWidth) / 2, this.y + 23);
          
          // Trend (if exists) - use text instead of UTF-8 arrows for PDF compatibility
          if (kpi.trend !== undefined && kpi.trend !== null) {
            const trendArrow = kpi.trend > 0 ? '+' : kpi.trend < 0 ? '-' : '';
            const trendText = `${trendArrow}${Math.abs(kpi.trend)}%`;
            const trendColor = kpi.trend > 0 ? this.colors.success : kpi.trend < 0 ? this.colors.danger : this.colors.gray;
            this.pdf.setTextColor(...trendColor);
            this.pdf.setFontSize(8);
            const trendWidth = this.pdf.getTextWidth(trendText);
            this.pdf.text(trendText, x + (cardWidth - trendWidth) / 2, this.y + 30);
          }
          
          x += cardWidth + 5;
        });
        
        this.y += cardHeight + 10;
      }
      
      // Rounded rectangle helper
      roundedRect(x, y, w, h, r, style) {
        this.pdf.roundedRect(x, y, w, h, r, r, style);
      }
      
      // Add funnel chart
      addFunnel(steps, totalInvitations) {
        this.checkNewPage(steps.length * 14 + 20);
        
        const labelWidth = 70;
        const barMaxWidth = this.contentWidth - labelWidth - 35;
        
        steps.forEach((step, i) => {
          const percent = totalInvitations > 0 ? (step.reachedCount / totalInvitations) * 100 : 0;
          const barWidth = Math.max((percent / 100) * barMaxWidth, 3);
          
          // Step label (longer text allowed)
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(8);
          this.pdf.setFont(this.fontFamily, 'normal');
          const label = `${i + 1}. ${step.title}`.substring(0, 40);
          this.pdf.text(label, this.margin, this.y + 5);
          
          // Bar background
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(this.margin + labelWidth, this.y, barMaxWidth, 8, 2, 'F');
          
          // Bar fill
          this.pdf.setFillColor(...this.colors.primary);
          if (barWidth > 3) {
            this.roundedRect(this.margin + labelWidth, this.y, barWidth, 8, 2, 'F');
          }
          
          // Value and percentage
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(8);
          this.pdf.setFont(this.fontFamily, 'bold');
          const valueText = `${step.reachedCount} (${Math.round(percent)}%)`;
          this.pdf.text(valueText, this.margin + labelWidth + barMaxWidth + 3, this.y + 5.5);
          
          this.y += 13;
        });
        
        this.y += 5;
      }
      
      // Add horizontal bar chart for polls
      addPollChart(question, options, votes, totalVotes) {
        this.checkNewPage(options.length * 10 + 25);
        
        // Question
        this.pdf.setTextColor(...this.colors.dark);
        this.pdf.setFontSize(10);
        this.pdf.setFont(this.fontFamily, 'bold');
        this.pdf.text(question.substring(0, 80), this.margin, this.y);
        this.y += 8;
        
        const barMaxWidth = this.contentWidth - 50;
        
        options.forEach((option, i) => {
          const voteCount = votes[i] || 0;
          const percent = totalVotes > 0 ? (voteCount / totalVotes) * 100 : 0;
          const barWidth = Math.max((percent / 100) * barMaxWidth, 3);
          
          // Option label (truncated)
          this.pdf.setTextColor(...this.colors.gray);
          this.pdf.setFontSize(8);
          this.pdf.setFont(this.fontFamily, 'normal');
          const optLabel = option.text.substring(0, 25);
          this.pdf.text(optLabel, this.margin, this.y + 4);
          
          // Bar
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(this.margin + 45, this.y, barMaxWidth, 6, 1.5, 'F');
          
          this.pdf.setFillColor(...this.colors.accent);
          if (barWidth > 3) {
            this.roundedRect(this.margin + 45, this.y, barWidth, 6, 1.5, 'F');
          }
          
          // Value
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(8);
          this.pdf.setFont(this.fontFamily, 'bold');
          this.pdf.text(`${voteCount} (${Math.round(percent)}%)`, this.margin + 45 + barMaxWidth + 3, this.y + 4);
          
          this.y += 9;
        });
        
        this.y += 5;
      }
      
      // Add data table
      addTable(headers, rows, colWidths) {
        this.checkNewPage(40);
        
        const rowHeight = 8;
        let x = this.margin;
        
        // Header background
        this.pdf.setFillColor(...this.colors.lightGray);
        this.pdf.rect(this.margin, this.y, this.contentWidth, rowHeight + 2, 'F');
        
        // Headers
        this.pdf.setTextColor(...this.colors.dark);
        this.pdf.setFontSize(9);
        this.pdf.setFont(this.fontFamily, 'bold');
        headers.forEach((header, i) => {
          this.pdf.text(header, x + 2, this.y + 6);
          x += colWidths[i];
        });
        
        this.y += rowHeight + 4;
        
        // Rows
        this.pdf.setFont(this.fontFamily, 'normal');
        this.pdf.setTextColor(...this.colors.dark);
        
        rows.forEach((row, rowIdx) => {
          if (this.checkNewPage(rowHeight + 5)) {
            // Redraw header on new page
            x = this.margin;
            this.pdf.setFillColor(...this.colors.lightGray);
            this.pdf.rect(this.margin, this.y, this.contentWidth, rowHeight + 2, 'F');
            this.pdf.setFont(this.fontFamily, 'bold');
            headers.forEach((header, i) => {
              this.pdf.text(header, x + 2, this.y + 6);
              x += colWidths[i];
            });
            this.y += rowHeight + 4;
            this.pdf.setFont(this.fontFamily, 'normal');
          }
          
          x = this.margin;
          
          // Alternating row background
          if (rowIdx % 2 === 1) {
            this.pdf.setFillColor(250, 250, 250);
            this.pdf.rect(this.margin, this.y - 2, this.contentWidth, rowHeight, 'F');
          }
          
          this.pdf.setTextColor(...this.colors.dark);
          row.forEach((cell, i) => {
            const cellText = String(cell || '-').substring(0, Math.floor(colWidths[i] / 2));
            this.pdf.text(cellText, x + 2, this.y + 4);
            x += colWidths[i];
          });
          
          this.y += rowHeight;
        });
        
        this.y += 8;
      }
      
      // Add status badge - use simple text for PDF compatibility
      getStatusText(status) {
        const statusMap = {
          'completed': 'Completed',
          'active': 'Active',
          'pending': 'Pending',
          'expired': 'Expired',
          'revoked': 'Revoked'
        };
        return statusMap[status] || status;
      }
      
      // Add dual line chart for activity (invitations + completed)
      addDualLineChart(datasets, labels) {
        this.checkNewPage(85);
        
        const yAxisWidth = 20; // Space for Y-axis labels
        const chartWidth = this.contentWidth - yAxisWidth;
        const chartHeight = 55;
        const chartX = this.margin + yAxisWidth;
        const chartY = this.y;
        
        // Chart background
        this.pdf.setFillColor(...this.colors.white);
        this.pdf.rect(chartX, chartY, chartWidth, chartHeight, 'F');
        
        // Find max value across all datasets
        const allValues = datasets.flatMap(d => d.data);
        const maxVal = Math.max(...allValues, 1);
        
        // Grid lines and Y-axis labels
        this.pdf.setDrawColor(230, 230, 230);
        this.pdf.setLineWidth(0.2);
        this.pdf.setTextColor(...this.colors.gray);
        this.pdf.setFontSize(8);
        
        for (let i = 0; i <= 4; i++) {
          const y = chartY + (chartHeight / 4) * i;
          this.pdf.line(chartX, y, chartX + chartWidth, y);
          
          // Y-axis label (right-aligned with space before chart)
          const yValue = Math.round(maxVal - (maxVal / 4) * i);
          const yText = String(yValue);
          const textWidth = this.pdf.getTextWidth(yText);
          this.pdf.text(yText, chartX - textWidth - 5, y + 2);
        }
        
        const stepX = chartWidth / Math.max(labels.length - 1, 1);
        
        // Draw each dataset
        datasets.forEach((dataset, dsIdx) => {
          const color = dsIdx === 0 ? this.colors.primary : this.colors.accent;
          
          if (dataset.data.length > 1) {
            // Draw line
            this.pdf.setDrawColor(...color);
            this.pdf.setLineWidth(1.5);
            
            for (let i = 0; i < dataset.data.length - 1; i++) {
              const x1 = chartX + i * stepX;
              const y1 = chartY + chartHeight - (dataset.data[i] / maxVal) * chartHeight;
              const x2 = chartX + (i + 1) * stepX;
              const y2 = chartY + chartHeight - (dataset.data[i + 1] / maxVal) * chartHeight;
              this.pdf.line(x1, y1, x2, y2);
            }
            
            // Draw points
            this.pdf.setFillColor(...color);
            for (let i = 0; i < dataset.data.length; i++) {
              const x = chartX + i * stepX;
              const y = chartY + chartHeight - (dataset.data[i] / maxVal) * chartHeight;
              this.pdf.circle(x, y, 2, 'F');
            }
          }
        });
        
        // Legend
        let legendX = chartX;
        const legendY = chartY + chartHeight + 12;
        datasets.forEach((dataset, dsIdx) => {
          const color = dsIdx === 0 ? this.colors.primary : this.colors.accent;
          this.pdf.setFillColor(...color);
          this.pdf.rect(legendX, legendY - 3, 8, 3, 'F');
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(8);
          this.pdf.text(dataset.label, legendX + 10, legendY);
          legendX += this.pdf.getTextWidth(dataset.label) + 25;
        });
        
        // X-axis labels (show first, middle, last)
        this.pdf.setTextColor(...this.colors.gray);
        this.pdf.setFontSize(7);
        const labelY = chartY + chartHeight + 5;
        if (labels.length > 0) {
          this.pdf.text(labels[0], chartX, labelY);
          if (labels.length > 2) {
            const midIdx = Math.floor(labels.length / 2);
            this.pdf.text(labels[midIdx], chartX + chartWidth / 2 - 10, labelY);
          }
          this.pdf.text(labels[labels.length - 1], chartX + chartWidth - 25, labelY);
        }
        
        this.y += chartHeight + 20;
      }
      
      // Add simple line chart (single dataset)
      addLineChart(data, labels, title) {
        this.checkNewPage(70);
        
        const chartWidth = this.contentWidth;
        const chartHeight = 50;
        const chartX = this.margin;
        const chartY = this.y;
        
        // Chart background
        this.pdf.setFillColor(...this.colors.white);
        this.pdf.rect(chartX, chartY, chartWidth, chartHeight, 'F');
        
        // Grid lines
        this.pdf.setDrawColor(230, 230, 230);
        this.pdf.setLineWidth(0.2);
        for (let i = 0; i <= 4; i++) {
          const y = chartY + (chartHeight / 4) * i;
          this.pdf.line(chartX, y, chartX + chartWidth, y);
        }
        
        if (data.length > 1) {
          const maxVal = Math.max(...data, 1);
          const stepX = chartWidth / (data.length - 1);
          
          // Draw line
          this.pdf.setDrawColor(...this.colors.primary);
          this.pdf.setLineWidth(1.5);
          
          for (let i = 0; i < data.length - 1; i++) {
            const x1 = chartX + i * stepX;
            const y1 = chartY + chartHeight - (data[i] / maxVal) * chartHeight;
            const x2 = chartX + (i + 1) * stepX;
            const y2 = chartY + chartHeight - (data[i + 1] / maxVal) * chartHeight;
            this.pdf.line(x1, y1, x2, y2);
          }
          
          // Draw points
          this.pdf.setFillColor(...this.colors.primary);
          for (let i = 0; i < data.length; i++) {
            const x = chartX + i * stepX;
            const y = chartY + chartHeight - (data[i] / maxVal) * chartHeight;
            this.pdf.circle(x, y, 2, 'F');
          }
        }
        
        // X-axis labels (show first, middle, last)
        this.pdf.setTextColor(...this.colors.gray);
        this.pdf.setFontSize(7);
        if (labels.length > 0) {
          this.pdf.text(labels[0], chartX, chartY + chartHeight + 5);
          if (labels.length > 2) {
            const midIdx = Math.floor(labels.length / 2);
            const midX = chartX + midIdx * (chartWidth / (labels.length - 1));
            this.pdf.text(labels[midIdx], midX - 5, chartY + chartHeight + 5);
          }
          this.pdf.text(labels[labels.length - 1], chartX + chartWidth - 15, chartY + chartHeight + 5);
        }
        
        this.y += chartHeight + 15;
      }
      
      // Add horizontal bar chart
      addBarChart(items, options = {}) {
        const maxItems = options.maxItems || 10;
        const barHeight = options.barHeight || 10;
        const labelWidth = options.labelWidth || 60;
        const showValues = options.showValues !== false;
        
        this.checkNewPage(maxItems * (barHeight + 4) + 10);
        
        const barMaxWidth = this.contentWidth - labelWidth - 40;
        const displayItems = items.slice(0, maxItems);
        const maxValue = Math.max(...displayItems.map(i => i.value), 1);
        
        displayItems.forEach((item, idx) => {
          const barWidth = Math.max((item.value / maxValue) * barMaxWidth, 3);
          
          // Label
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(9);
          this.pdf.setFont(this.fontFamily, 'normal');
          const label = String(item.label).substring(0, 30);
          this.pdf.text(label, this.margin, this.y + barHeight / 2 + 2);
          
          // Bar background
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(this.margin + labelWidth, this.y, barMaxWidth, barHeight, 2, 'F');
          
          // Bar fill
          const barColor = item.color || this.colors.primary;
          this.pdf.setFillColor(...barColor);
          if (barWidth > 3) {
            this.roundedRect(this.margin + labelWidth, this.y, barWidth, barHeight, 2, 'F');
          }
          
          // Value
          if (showValues) {
            this.pdf.setTextColor(...this.colors.dark);
            this.pdf.setFontSize(9);
            this.pdf.setFont(this.fontFamily, 'bold');
            const valueText = item.suffix ? `${item.value}${item.suffix}` : String(item.value);
            this.pdf.text(valueText, this.margin + labelWidth + barMaxWidth + 5, this.y + barHeight / 2 + 2);
          }
          
          this.y += barHeight + 4;
        });
        
        this.y += 5;
      }
      
      // Add user journey timeline
      addUserTimeline(steps, maxDuration) {
        this.checkNewPage(steps.length * 18 + 20);
        
        const timelineX = this.margin + 8;
        const barWidth = this.contentWidth - 100;
        
        steps.forEach((step, idx) => {
          // Timeline dot
          this.pdf.setFillColor(...(step.completed ? this.colors.primary : this.colors.gray));
          this.pdf.circle(timelineX, this.y + 6, 3, 'F');
          
          // Timeline line (except last)
          if (idx < steps.length - 1) {
            this.pdf.setDrawColor(...this.colors.lightGray);
            this.pdf.setLineWidth(1);
            this.pdf.line(timelineX, this.y + 9, timelineX, this.y + 18);
          }
          
          // Step info
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(10);
          this.pdf.setFont(this.fontFamily, 'bold');
          const stepTitle = String(step.title || `Step ${idx + 1}`).substring(0, 35);
          this.pdf.text(stepTitle, timelineX + 10, this.y + 5);
          
          // Step type and time
          this.pdf.setFontSize(8);
          this.pdf.setFont(this.fontFamily, 'normal');
          this.pdf.setTextColor(...this.colors.gray);
          const typeText = step.type || '';
          this.pdf.text(typeText, timelineX + 10, this.y + 11);
          
          // Duration bar
          if (step.duration_ms && maxDuration > 0) {
            const durationPercent = Math.min((step.duration_ms / maxDuration) * 100, 100);
            const durationBarWidth = (durationPercent / 100) * 50;
            
            // Bar background
            this.pdf.setFillColor(...this.colors.lightGray);
            this.roundedRect(this.margin + barWidth, this.y + 2, 50, 6, 2, 'F');
            
            // Bar fill
            this.pdf.setFillColor(...this.colors.accent);
            if (durationBarWidth > 2) {
              this.roundedRect(this.margin + barWidth, this.y + 2, durationBarWidth, 6, 2, 'F');
            }
            
            // Duration text
            this.pdf.setTextColor(...this.colors.dark);
            this.pdf.setFontSize(8);
            const durationText = this.formatDuration(step.duration_ms);
            this.pdf.text(durationText, this.margin + barWidth + 55, this.y + 7);
          }
          
          // Badges for quiz/video/chat
          let badgeX = timelineX + 10;
          this.pdf.setFontSize(7);
          
          if (step.quiz) {
            const quizColor = step.quiz.passed ? this.colors.success : this.colors.danger;
            this.pdf.setTextColor(...quizColor);
            this.pdf.text(`Quiz: ${Math.round(step.quiz.score_percentage || 0)}%`, badgeX, this.y + 16);
            badgeX += 35;
          }
          
          if (step.ai_chat && step.ai_chat.total_messages > 0) {
            this.pdf.setTextColor(...this.colors.primary);
            this.pdf.text(`Chat: ${step.ai_chat.total_messages} msgs`, badgeX, this.y + 16);
            badgeX += 35;
          }
          
          if (step.video) {
            this.pdf.setTextColor(...this.colors.accent);
            this.pdf.text(`Video: ${step.video.watch_percentage || 0}%`, badgeX, this.y + 16);
          }
          
          this.y += 18;
        });
        
        this.y += 5;
      }
      
      // Format duration helper
      formatDuration(ms) {
        if (!ms) return '-';
        if (ms < 1000) return ms + 'ms';
        if (ms < 60000) return Math.round(ms / 1000) + 's';
        if (ms < 3600000) return Math.round(ms / 60000) + 'm';
        return Math.round(ms / 3600000) + 'h ' + Math.round((ms % 3600000) / 60000) + 'm';
      }
      
      // Add engagement metrics grid
      addEngagementGrid(metrics) {
        this.checkNewPage(60);
        
        const colWidth = this.contentWidth / 3;
        const rowHeight = 45;
        let x = this.margin;
        let y = this.y;
        let col = 0;
        
        metrics.forEach((metric, idx) => {
          // Card background
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(x, y, colWidth - 5, rowHeight, 4, 'F');
          
          // Icon/Label area
          this.pdf.setFillColor(...this.colors.primary);
          this.roundedRect(x + 5, y + 5, 6, 6, 1, 'F');
          
          // Metric label
          this.pdf.setTextColor(...this.colors.gray);
          this.pdf.setFontSize(9);
          this.pdf.setFont(this.fontFamily, 'normal');
          this.pdf.text(metric.label, x + 15, y + 10);
          
          // Metric value
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(18);
          this.pdf.setFont(this.fontFamily, 'bold');
          this.pdf.text(String(metric.value), x + 10, y + 28);
          
          // Metric sublabel
          if (metric.sublabel) {
            this.pdf.setTextColor(...this.colors.gray);
            this.pdf.setFontSize(8);
            this.pdf.setFont(this.fontFamily, 'normal');
            this.pdf.text(metric.sublabel, x + 10, y + 36);
          }
          
          x += colWidth;
          col++;
          
          if (col >= 3) {
            col = 0;
            x = this.margin;
            y += rowHeight + 5;
          }
        });
        
        // Calculate final y position
        const rows = Math.ceil(metrics.length / 3);
        this.y += rows * (rowHeight + 5) + 5;
      }
      
      // Add progress bar with label
      addProgressBar(label, value, maxValue, options = {}) {
        this.checkNewPage(20);
        
        const percent = maxValue > 0 ? Math.round((value / maxValue) * 100) : 0;
        const barWidth = this.contentWidth - 80;
        const barHeight = 8;
        
        // Label
        this.pdf.setTextColor(...this.colors.dark);
        this.pdf.setFontSize(10);
        this.pdf.setFont(this.fontFamily, 'normal');
        this.pdf.text(label, this.margin, this.y + 5);
        
        // Bar background
        this.pdf.setFillColor(...this.colors.lightGray);
        this.roundedRect(this.margin + 70, this.y, barWidth, barHeight, 3, 'F');
        
        // Bar fill
        const fillWidth = (percent / 100) * barWidth;
        const barColor = options.color || this.colors.primary;
        this.pdf.setFillColor(...barColor);
        if (fillWidth > 3) {
          this.roundedRect(this.margin + 70, this.y, fillWidth, barHeight, 3, 'F');
        }
        
        // Value text
        this.pdf.setTextColor(...this.colors.dark);
        this.pdf.setFontSize(10);
        this.pdf.setFont(this.fontFamily, 'bold');
        const valueText = options.suffix ? `${value}${options.suffix}` : `${percent}%`;
        this.pdf.text(valueText, this.margin + 70 + barWidth + 5, this.y + 6);
        
        this.y += 15;
      }
      
      // Add text paragraph
      addParagraph(text, options = {}) {
        this.checkNewPage(20);
        
        this.pdf.setTextColor(...(options.color || this.colors.dark));
        this.pdf.setFontSize(options.fontSize || 10);
        this.pdf.setFont('helvetica', options.bold ? 'bold' : 'normal');
        
        const lines = this.pdf.splitTextToSize(text, this.contentWidth);
        lines.forEach(line => {
          if (this.checkNewPage(10)) {
            // Continue on new page
          }
          this.pdf.text(line, this.margin, this.y);
          this.y += 5;
        });
        
        this.y += 5;
      }
      
      // Add score distribution chart
      addScoreDistribution(distribution) {
        this.checkNewPage(50);
        
        const ranges = ['90-100%', '70-89%', '50-69%', '30-49%', '0-29%'];
        const barHeight = 8;
        const barMaxWidth = this.contentWidth - 70;
        const maxCount = Math.max(...Object.values(distribution), 1);
        
        ranges.forEach((range, idx) => {
          const count = distribution[range] || 0;
          const barWidth = (count / maxCount) * barMaxWidth;
          
          // Range label
          this.pdf.setTextColor(...this.colors.dark);
          this.pdf.setFontSize(9);
          this.pdf.setFont(this.fontFamily, 'normal');
          this.pdf.text(range, this.margin, this.y + 6);
          
          // Bar background
          this.pdf.setFillColor(...this.colors.lightGray);
          this.roundedRect(this.margin + 50, this.y, barMaxWidth, barHeight, 2, 'F');
          
          // Bar fill - color based on score range
          const colors = [this.colors.success, this.colors.accent, this.colors.warning, this.colors.warning, this.colors.danger];
          this.pdf.setFillColor(...colors[idx]);
          if (barWidth > 2) {
            this.roundedRect(this.margin + 50, this.y, barWidth, barHeight, 2, 'F');
          }
          
          // Count
          this.pdf.setFontSize(9);
          this.pdf.setFont(this.fontFamily, 'bold');
          this.pdf.text(String(count), this.margin + 50 + barMaxWidth + 5, this.y + 6);
          
          this.y += barHeight + 4;
        });
        
        this.y += 5;
      }
      
      // Save the PDF
      save(filename) {
        this.pdf.save(filename);
      }
    }
    
    // Generate Journey Performance PDF
    async function generateJourneyPDF(report) {
      // Load logo and get its dimensions for correct aspect ratio
      const logoBase64 = await loadLogoForPDF();
      const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : null;
      
      const stats = report.statistics;
      // Format average time: show days for >24h, hours for >1h, minutes for shorter times
      let avgTime = '-';
      if (stats.avgHoursToComplete && stats.avgHoursToComplete > 0) {
        if (stats.avgHoursToComplete >= 24) {
          avgTime = `${Math.round(stats.avgHoursToComplete / 24 * 10) / 10} ${translations.days}`;
        } else if (stats.avgHoursToComplete >= 1) {
          avgTime = `${Math.round(stats.avgHoursToComplete * 10) / 10}h`;
        } else {
          // Less than 1 hour - show minutes
          const minutes = Math.round(stats.avgHoursToComplete * 60);
          avgTime = minutes > 0 ? `${minutes} min` : '< 1 min';
        }
      }
      
      const pdf = new PDFReport(
        report.journey.title,
        translations.journeyPerformance,
        logoBase64,
        logoDimensions
      );
      
      pdf.addHeader();
      
      // KPIs
      pdf.addKPIRow([
        { value: stats.totalInvitations, label: translations.invitations },
        { value: stats.completed, label: translations.completed },
        { value: `${stats.completionRate}%`, label: translations.completionRate },
        { value: avgTime, label: translations.avgTime }
      ]);
      
      // Funnel
      if (report.funnel && report.funnel.length > 0) {
        pdf.addSectionTitle(translations.funnel);
        pdf.addFunnel(report.funnel, stats.totalInvitations);
      }
      
      // Poll Results
      if (report.polls && report.polls.length > 0) {
        pdf.addSectionTitle(translations.pollResults);
        report.polls.forEach(poll => {
          const options = poll.basic_props?.options || [];
          const totalVotes = parseInt(poll.total_votes) || 0;
          const question = poll.basic_props?.question || poll.step_title || 'Poll';
          pdf.addPollChart(question, options, poll.votes, totalVotes);
        });
      }
      
      // Participants
      if (report.participants && report.participants.length > 0) {
        pdf.addSectionTitle(translations.participants);
        const headers = [translations.name, 'Email', translations.status, translations.completedAt];
        const colWidths = [40, 70, 30, 40];
        const rows = report.participants.slice(0, 15).map(p => {
          const name = `${p.first_name || ''} ${p.last_name || ''}`.trim() || '-';
          const effectiveStatus = p.completions_count > 0 ? 'completed' : p.status;
          return [
            name.substring(0, 20),
            p.email.substring(0, 30),
            pdf.getStatusText(effectiveStatus),
            formatDate(p.completed_at)
          ];
        });
        pdf.addTable(headers, rows, colWidths);
      }
      
      // Save
      const date = new Date().toISOString().split('T')[0];
      const filename = `gryffi-journey-${report.journey.title.replace(/[^a-z0-9]/gi, '-').toLowerCase()}-${date}.pdf`;
      pdf.save(filename);
    }
    
    // Generate Overview PDF
    async function generateOverviewPDF(report) {
      // Load logo and get its dimensions for correct aspect ratio
      const logoBase64 = await loadLogoForPDF();
      const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : null;
      
      const kpis = report.kpis;
      const periodLabel = {
        7: translations.period7,
        30: translations.period30,
        90: translations.period90,
        365: translations.period365
      }[report.period.days] || `${report.period.days} days`;
      
      // Format average time - use same logic as Journey report
      let avgTimeValue = '-';
      const avgDays = parseFloat(kpis.avgDaysToComplete.current);
      if (avgDays && !isNaN(avgDays) && avgDays > 0) {
        if (avgDays >= 1) {
          avgTimeValue = `${Math.round(avgDays * 10) / 10} ${translations.days}`;
        } else {
          // Less than 1 day - convert to hours or minutes
          const hours = avgDays * 24;
          if (hours >= 1) {
            avgTimeValue = `${Math.round(hours * 10) / 10}h`;
          } else {
            const minutes = Math.round(hours * 60);
            if (minutes >= 1) {
              avgTimeValue = `${minutes} min`;
            } else {
              // Less than 1 minute - show seconds
              const seconds = Math.round(hours * 3600);
              avgTimeValue = seconds > 0 ? `${seconds} sec` : '< 1 sec';
            }
          }
        }
      }
      
      const pdf = new PDFReport(
        translations.periodOverview,
        periodLabel,
        logoBase64,
        logoDimensions
      );
      
      pdf.addHeader();
      
      // Main KPIs
      pdf.addKPIRow([
        { value: kpis.invitations.current, label: translations.invitations, trend: kpis.invitations.trend },
        { value: kpis.completed.current, label: translations.completed, trend: kpis.completed.trend },
        { value: `${kpis.completionRate.current}%`, label: translations.completionRate },
        { value: avgTimeValue, label: translations.avgTime }
      ]);
      
      // Activity Chart with dual lines
      if (report.activity && report.activity.length > 0) {
        pdf.addSectionTitle(translations.activity);
        const chartLabels = report.activity.map(a => formatDate(a.date));
        pdf.addDualLineChart([
          { label: translations.invitations, data: report.activity.map(a => a.invitations) },
          { label: translations.completed, data: report.activity.map(a => a.completed) }
        ], chartLabels);
      }
      
      // Top Journeys
      if (report.topJourneys && report.topJourneys.length > 0) {
        pdf.addSectionTitle(translations.topJourneys);
        const headers = [translations.journey, translations.invitations, translations.completed, translations.completionRate];
        const colWidths = [70, 35, 35, 40];
        const rows = report.topJourneys.map(j => [
          j.title.substring(0, 35),
          j.invitations,
          j.completed,
          `${j.completionRate}%`
        ]);
        pdf.addTable(headers, rows, colWidths);
      }
      
      // Summary KPIs
      pdf.addSectionTitle('Summary');
      pdf.addKPIRow([
        { value: report.endUsers.newInPeriod, label: translations.newUsers },
        { value: report.endUsers.total, label: translations.totalUsers },
        { value: report.pollResponses, label: translations.pollResponses },
        { value: kpis.engaged.current, label: translations.engaged }
      ]);
      
      // Save
      const date = new Date().toISOString().split('T')[0];
      const filename = `gryffi-overview-${report.period.days}days-${date}.pdf`;
      pdf.save(filename);
    }
    
    // Generate User Progress PDF
    async function generateUserProgressPDF(userId, userName) {
      const logoBase64 = await loadLogoForPDF();
      const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : null;
      
      // Fetch user data
      const res = await fetch(`/api/analytics/user/${userId}`);
      const data = await res.json();
      
      if (!data.success) {
        showToast(translations.reports?.exportError || 'Failed to export user report', 'error');
        return;
      }
      
      const user = data.user;
      const pdf = new PDFReport(
        `${user.first_name || ''} ${user.last_name || ''}`.trim() || user.email,
        translations.reports?.userProgress || 'User Progress Report',
        logoBase64,
        logoDimensions
      );
      
      pdf.addHeader();
      
      // User info section
      pdf.addSectionTitle(translations.reports?.userInfo || 'User Information');
      pdf.addParagraph(`Email: ${user.email}`);
      if (user.groups && user.groups.length > 0) {
        pdf.addParagraph(`${translations.group || 'Group'}: ${user.groups.map(g => g.name).join(', ')}`);
      }
      pdf.addParagraph(`${translations.reports?.firstSeen || 'First seen'}: ${formatDate(user.created_at)}`);
      
      // Journey activity KPIs
      const journeyStats = user.journey_stats || {};
      pdf.addKPIRow([
        { value: journeyStats.total_journeys || 0, label: translations.journeys || 'Journeys' },
        { value: journeyStats.completed_journeys || 0, label: translations.completed || 'Completed' },
        { value: `${journeyStats.completion_rate || 0}%`, label: translations.completionRate || 'Completion Rate' },
        { value: journeyStats.avg_score ? `${Math.round(journeyStats.avg_score)}%` : '-', label: translations.avgScore || 'Avg Score' }
      ]);
      
      // Journey details table
      if (user.journeys && user.journeys.length > 0) {
        pdf.addSectionTitle(translations.reports?.journeyActivity || 'Journey Activity');
        const headers = [translations.journey || 'Journey', translations.status || 'Status', translations.score || 'Score', translations.completedAt || 'Completed'];
        const colWidths = [70, 40, 30, 40];
        const rows = user.journeys.slice(0, 10).map(j => [
          (j.title || 'Untitled').substring(0, 35),
          j.completed ? translations.completed || 'Completed' : translations.inProgress || 'In Progress',
          j.score ? `${Math.round(j.score)}%` : '-',
          formatDate(j.completed_at)
        ]);
        pdf.addTable(headers, rows, colWidths);
      }
      
      // Quiz performance
      if (user.quiz_stats && user.quiz_stats.total_attempts > 0) {
        pdf.addSectionTitle(translations.reports?.quizPerformance || 'Quiz Performance');
        pdf.addKPIRow([
          { value: user.quiz_stats.total_attempts, label: translations.reports?.attempts || 'Attempts' },
          { value: `${Math.round(user.quiz_stats.avg_score || 0)}%`, label: translations.avgScore || 'Avg Score' },
          { value: `${Math.round(user.quiz_stats.pass_rate || 0)}%`, label: translations.reports?.passRate || 'Pass Rate' },
          { value: user.quiz_stats.best_score ? `${Math.round(user.quiz_stats.best_score)}%` : '-', label: translations.reports?.bestScore || 'Best Score' }
        ]);
      }
      
      // Video engagement
      if (user.video_stats && user.video_stats.total_videos > 0) {
        pdf.addSectionTitle(translations.reports?.videoEngagement || 'Video Engagement');
        pdf.addProgressBar(translations.reports?.avgWatched || 'Average Watched', 
          Math.round(user.video_stats.avg_watch_percentage || 0), 100, { suffix: '%' });
        pdf.addParagraph(`${translations.reports?.videosWatched || 'Videos watched'}: ${user.video_stats.total_videos}`);
        if (user.video_stats.total_watch_time_ms) {
          pdf.addParagraph(`${translations.reports?.totalWatchTime || 'Total watch time'}: ${pdf.formatDuration(user.video_stats.total_watch_time_ms)}`);
        }
      }
      
      // AI Guide usage
      if (user.chat_stats && user.chat_stats.total_sessions > 0) {
        pdf.addSectionTitle(translations.reports?.aiGuideUsage || 'AI Guide Usage');
        pdf.addKPIRow([
          { value: user.chat_stats.total_sessions, label: translations.reports?.sessions || 'Sessions' },
          { value: user.chat_stats.total_messages, label: translations.reports?.messages || 'Messages' },
          { value: pdf.formatDuration(user.chat_stats.total_duration_ms), label: translations.reports?.totalTime || 'Total Time' },
          { value: user.chat_stats.avg_messages_per_session ? Math.round(user.chat_stats.avg_messages_per_session) : '-', label: translations.reports?.avgPerSession || 'Avg/Session' }
        ]);
      }
      
      // Save
      const date = new Date().toISOString().split('T')[0];
      const safeName = (user.first_name || user.email.split('@')[0]).replace(/[^a-z0-9]/gi, '-').toLowerCase();
      const filename = `gryffi-user-${safeName}-${date}.pdf`;
      pdf.save(filename);
    }
    
    // Generate Group Progress PDF
    async function generateGroupProgressPDF(groupId, groupName) {
      const logoBase64 = await loadLogoForPDF();
      const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : null;
      
      // Fetch group data
      const res = await fetch(`/api/analytics/group/${groupId}`);
      const data = await res.json();
      
      if (!data.success) {
        showToast(translations.reports?.exportError || 'Failed to export group report', 'error');
        return;
      }
      
      const group = data.group || {};
      const stats = data.stats || {};
      
      const pdf = new PDFReport(
        groupName,
        translations.reports?.groupProgress || 'Group Progress Report',
        logoBase64,
        logoDimensions
      );
      
      pdf.addHeader();
      
      // Group info section
      pdf.addSectionTitle(translations.reports?.groupInfo || 'Group Information');
      pdf.addParagraph(`${translations.members || 'Members'}: ${group.member_count || data.memberCount || 0}`);
      if (group.created_at) {
        pdf.addParagraph(`${translations.createdAt || 'Created'}: ${formatDate(group.created_at)}`);
      }
      
      // Performance KPIs
      pdf.addSectionTitle(translations.reports?.groupPerformance || 'Group Performance');
      pdf.addKPIRow([
        { value: stats.journeys_started || 0, label: translations.journeysStarted || 'Journeys Started' },
        { value: stats.journeys_completed || 0, label: translations.journeysCompleted || 'Journeys Completed' },
        { value: `${Math.round(stats.completion_rate || 0)}%`, label: translations.completionRate || 'Completion Rate' },
        { value: stats.avg_quiz_score ? `${Math.round(stats.avg_quiz_score)}%` : '-', label: translations.avgQuizScore || 'Avg Quiz Score' }
      ]);
      
      // Additional stats
      if (stats.total_time_ms) {
        pdf.addSectionTitle(translations.reports?.engagementMetrics || 'Engagement Metrics');
        pdf.addKPIRow([
          { value: pdf.formatDuration(stats.total_time_ms), label: translations.totalTime || 'Total Time' },
          { value: stats.active_users || 0, label: translations.activeUsers || 'Active Users' },
          { value: stats.quiz_attempts || 0, label: translations.quizAttempts || 'Quiz Attempts' },
          { value: stats.video_views || 0, label: translations.videoViews || 'Video Views' }
        ]);
      }
      
      // Top performers
      if (data.topPerformers && data.topPerformers.length > 0) {
        pdf.addSectionTitle(translations.reports?.topPerformers || 'Top Performers');
        const headers = [translations.name || 'Name', translations.journeysCompleted || 'Journeys', translations.avgScore || 'Avg Score'];
        const colWidths = [80, 50, 50];
        const rows = data.topPerformers.slice(0, 5).map(p => [
          p.name || p.email || 'Unknown',
          String(p.completed_journeys || 0),
          p.avg_score ? `${Math.round(p.avg_score)}%` : '-'
        ]);
        pdf.addTable(headers, rows, colWidths);
      }
      
      // Save
      const date = new Date().toISOString().split('T')[0];
      const safeName = groupName.replace(/[^a-z0-9]/gi, '-').toLowerCase();
      const filename = `gryffi-group-${safeName}-${date}.pdf`;
      pdf.save(filename);
    }
    
    // Generate Engagement Report PDF
    async function generateEngagementPDF(days = 30) {
      const logoBase64 = await loadLogoForPDF();
      const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : null;
      
      // Fetch engagement data from multiple endpoints
      const [quizRes, videoRes, chatRes] = await Promise.all([
        fetch(`/api/analytics/quiz-stats?days=${days}`),
        fetch(`/api/analytics/video-stats?days=${days}`),
        fetch(`/api/analytics/guide-chat-stats?days=${days}`)
      ]);
      
      const quizData = await quizRes.json();
      const videoData = await videoRes.json();
      const chatData = await chatRes.json();
      
      const periodLabel = {
        7: translations.period7,
        30: translations.period30,
        90: translations.period90,
        365: translations.period365
      }[days] || `${days} ${translations.days || 'days'}`;
      
      const pdf = new PDFReport(
        translations.reports?.engagementReport || 'Engagement Report',
        periodLabel,
        logoBase64,
        logoDimensions
      );
      
      pdf.addHeader();
      
      // Overview engagement metrics
      pdf.addEngagementGrid([
        { label: translations.reports?.quizAttempts || 'Quiz Attempts', value: quizData.stats?.total_attempts || 0, sublabel: translations.reports?.inPeriod || 'in period' },
        { label: translations.reports?.videosWatched || 'Videos Watched', value: videoData.stats?.total_sessions || 0, sublabel: translations.reports?.inPeriod || 'in period' },
        { label: translations.reports?.aiChats || 'AI Chats', value: chatData.stats?.total_sessions || 0, sublabel: translations.reports?.inPeriod || 'in period' },
        { label: translations.reports?.avgQuizScore || 'Avg Quiz Score', value: `${Math.round(quizData.stats?.avg_score || 0)}%`, sublabel: translations.reports?.allAttempts || 'all attempts' },
        { label: translations.reports?.videoCompletion || 'Video Completion', value: `${Math.round(videoData.stats?.avg_watch_percentage || 0)}%`, sublabel: translations.reports?.avgWatched || 'avg watched' },
        { label: translations.reports?.avgChatDuration || 'Avg Chat Duration', value: formatDurationShort(chatData.stats?.avg_duration_ms), sublabel: translations.reports?.perSession || 'per session' }
      ]);
      
      // Quiz Statistics
      if (quizData.stats && quizData.stats.total_attempts > 0) {
        pdf.addSectionTitle(translations.reports?.quizStatistics || 'Quiz Statistics');
        
        pdf.addKPIRow([
          { value: quizData.stats.total_attempts, label: translations.reports?.totalAttempts || 'Total Attempts' },
          { value: `${Math.round(quizData.stats.avg_score || 0)}%`, label: translations.avgScore || 'Avg Score' },
          { value: `${Math.round(quizData.stats.pass_rate || 0)}%`, label: translations.reports?.passRate || 'Pass Rate' },
          { value: quizData.stats.unique_users || 0, label: translations.reports?.uniqueUsers || 'Unique Users' }
        ]);
        
        // Score distribution
        if (quizData.distribution) {
          pdf.addSectionTitle(translations.reports?.scoreDistribution || 'Score Distribution');
          pdf.addScoreDistribution(quizData.distribution);
        }
        
        // Top quizzes by attempts
        if (quizData.topQuizzes && quizData.topQuizzes.length > 0) {
          pdf.addSectionTitle(translations.reports?.topQuizzes || 'Most Attempted Quizzes');
          pdf.addBarChart(quizData.topQuizzes.map(q => ({
            label: q.step_title || 'Quiz',
            value: q.attempts
          })), { labelWidth: 80, maxItems: 5 });
        }
      }
      
      // Video Statistics
      if (videoData.stats && videoData.stats.total_sessions > 0) {
        pdf.addSectionTitle(translations.reports?.videoStatistics || 'Video Statistics');
        
        pdf.addKPIRow([
          { value: videoData.stats.total_sessions, label: translations.reports?.totalViews || 'Total Views' },
          { value: `${Math.round(videoData.stats.avg_watch_percentage || 0)}%`, label: translations.reports?.avgWatched || 'Avg Watched' },
          { value: `${Math.round(videoData.stats.completion_rate || 0)}%`, label: translations.reports?.completionRate || 'Completion Rate' },
          { value: formatDurationShort(videoData.stats.total_watch_time_ms), label: translations.reports?.totalWatchTime || 'Total Time' }
        ]);
        
        // Top videos
        if (videoData.topVideos && videoData.topVideos.length > 0) {
          pdf.addSectionTitle(translations.reports?.topVideos || 'Most Watched Videos');
          pdf.addBarChart(videoData.topVideos.map(v => ({
            label: v.step_title || 'Video',
            value: v.views
          })), { labelWidth: 80, maxItems: 5 });
        }
      }
      
      // AI Guide Statistics
      if (chatData.stats && chatData.stats.total_sessions > 0) {
        pdf.addSectionTitle(translations.reports?.aiGuideStatistics || 'AI Guide Statistics');
        
        pdf.addKPIRow([
          { value: chatData.stats.total_sessions, label: translations.reports?.totalSessions || 'Total Sessions' },
          { value: chatData.stats.total_messages || 0, label: translations.reports?.totalMessages || 'Total Messages' },
          { value: formatDurationShort(chatData.stats.avg_duration_ms), label: translations.reports?.avgDuration || 'Avg Duration' },
          { value: chatData.stats.unique_users || 0, label: translations.reports?.uniqueUsers || 'Unique Users' }
        ]);
        
        // Top steps where AI Guide is used
        if (chatData.topSteps && chatData.topSteps.length > 0) {
          pdf.addSectionTitle(translations.reports?.topAiGuideSteps || 'Most Active AI Guide Steps');
          pdf.addBarChart(chatData.topSteps.map(s => ({
            label: s.step_title || 'Step',
            value: s.sessions
          })), { labelWidth: 80, maxItems: 5 });
        }
      }
      
      // Save
      const date = new Date().toISOString().split('T')[0];
      const filename = `gryffi-engagement-${days}days-${date}.pdf`;
      pdf.save(filename);
    }
    
    // Helper function for short duration format
    function formatDurationShort(ms) {
      if (!ms) return '-';
      if (ms < 60000) return Math.round(ms / 1000) + 's';
      if (ms < 3600000) return Math.round(ms / 60000) + 'm';
      return Math.round(ms / 3600000) + 'h';
    }
    
    // ============================================
    // REWARDS FUNCTIONALITY
    // ============================================
    
    const rewardTranslations = {
      codesTitle: <%-safeJson(t("analytics.rewards.codesTitle"))%>,
      code: <%-safeJson(t("analytics.rewards.code"))%>,
      status: <%-safeJson(t("analytics.rewards.status"))%>,
      claimedBy: <%-safeJson(t("analytics.rewards.claimedBy"))%>,
      claimedAt: <%-safeJson(t("analytics.rewards.claimedAt"))%>,
      notClaimedYet: <%-safeJson(t("analytics.rewards.notClaimedYet"))%>,
      emailSent: <%-safeJson(t("analytics.rewards.emailSent"))%>,
      claimed: <%-safeJson(t("analytics.rewards.claimed"))%>,
      redeemAt: <%-safeJson(t("analytics.rewards.redeemAt"))%>,
      validUntil: <%-safeJson(t("analytics.rewards.validUntil"))%>,
      terms: <%-safeJson(t("analytics.rewards.terms"))%>
    };
    
    // View codes button handler
    document.querySelectorAll('.btn-view-codes').forEach(btn => {
      btn.addEventListener('click', async () => {
        const rewardId = btn.dataset.rewardId;
        await loadRewardCodes(rewardId);
      });
    });
    
    // Download codes PDF button handler
    document.querySelectorAll('.btn-download-codes').forEach(btn => {
      btn.addEventListener('click', async () => {
        const rewardId = btn.dataset.rewardId;
        const rewardTitle = btn.dataset.rewardTitle;
        await downloadRewardCodesPDF(rewardId, rewardTitle);
      });
    });
    
    // Close modal
    document.getElementById('closeRewardCodesModal')?.addEventListener('click', () => {
      document.getElementById('rewardCodesModal').style.display = 'none';
    });
    
    // Close modal on backdrop click
    document.getElementById('rewardCodesModal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        e.currentTarget.style.display = 'none';
      }
    });
    
    async function loadRewardCodes(rewardId) {
      try {
        const res = await fetch(`/api/rewards/${rewardId}/codes`);
        const data = await res.json();
        
        if (!data.success) {
          console.error('Failed to load codes:', data.error);
          return;
        }
        
        const modal = document.getElementById('rewardCodesModal');
        const title = document.getElementById('rewardCodesModalTitle');
        const content = document.getElementById('rewardCodesContent');
        
        title.textContent = `${rewardTranslations.codesTitle}: ${data.reward.title}`;
        
        let html = `
          <div style="margin-bottom: 16px; padding: 12px; background: #f8fafc; border-radius: 8px;">
            ${data.reward.redemptionLocation ? `<p style="margin: 0 0 4px;"><strong>${rewardTranslations.redeemAt}:</strong> ${data.reward.redemptionLocation}</p>` : ''}
            ${data.reward.validUntil ? `<p style="margin: 0 0 4px;"><strong>${rewardTranslations.validUntil}:</strong> ${new Date(data.reward.validUntil).toLocaleDateString(language)}</p>` : ''}
            ${data.reward.termsConditions ? `<p style="margin: 0; font-size: 12px; color: #64748b;"><strong>${rewardTranslations.terms}:</strong> ${data.reward.termsConditions}</p>` : ''}
          </div>
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.code}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.status}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.claimedBy}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.claimedAt}</th>
              </tr>
            </thead>
            <tbody>
        `;
        
        data.codes.forEach(code => {
          const statusStyle = code.isClaimed 
            ? 'background: #dcfce7; color: #166534; padding: 4px 8px; border-radius: 4px; font-size: 12px;'
            : 'background: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 4px; font-size: 12px;';
          
          html += `
            <tr style="border-bottom: 1px solid #e5e7eb;">
              <td style="padding: 12px; font-family: monospace; font-weight: 600;">${escapeHtml(code.code)}</td>
              <td style="padding: 12px;">
                <span style="${statusStyle}">${code.isClaimed ? rewardTranslations.claimed : rewardTranslations.notClaimedYet}</span>
              </td>
              <td style="padding: 12px; color: #374151;">
                ${code.claimer ? `${escapeHtml(code.claimer.name)}<br><span style="font-size: 12px; color: #64748b;">${escapeHtml(code.claimer.email)}</span>` : '-'}
              </td>
              <td style="padding: 12px; color: #64748b; font-size: 13px;">
                ${code.claimedAt ? new Date(code.claimedAt).toLocaleString(language) : '-'}
              </td>
            </tr>
          `;
        });
        
        html += '</tbody></table>';
        content.innerHTML = html;
        modal.style.display = 'flex';
        
      } catch (err) {
        console.error('Error loading reward codes:', err);
      }
    }
    
    async function downloadRewardCodesPDF(rewardId, rewardTitle) {
      try {
        // Load logo and get its dimensions for correct aspect ratio
        const logoBase64 = await loadLogoForPDF();
        const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : { aspectRatio: 2.37 };
        
        const res = await fetch(`/api/rewards/${rewardId}/codes`);
        const data = await res.json();
        
        if (!data.success) {
          console.error('Failed to load codes for PDF:', data.error);
          return;
        }
        
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF('p', 'mm', 'a4');
        const pageWidth = 210;
        const margin = 15;
        
        // Use NotoSans for Unicode support (Turkish, Arabic, etc.)
        const fontFamily = pdf.getFontList()['NotoSans'] ? 'NotoSans' : 'helvetica';
        
        // Get theme colors for PDF
        const pdfColors = getPdfColors();
        
        // Header - use theme primary color
        pdf.setFillColor(...pdfColors.primary);
        pdf.rect(0, 0, pageWidth, 30, 'F');
        
        pdf.setTextColor(255, 255, 255);
        pdf.setFontSize(18);
        pdf.setFont(fontFamily, 'bold');
        pdf.text(rewardTranslations.codesTitle, margin, 15);
        
        // Subtitle
        pdf.setFontSize(11);
        pdf.setFont(fontFamily, 'normal');
        pdf.text(rewardTitle || data.reward.title, margin, 24);
        
        // Logo (right side) - calculate dimensions maintaining aspect ratio
        // Max height is 12mm, max width is 40mm (smaller header)
        const maxLogoHeight = 12;
        const maxLogoWidth = 40;
        
        let logoWidth, logoHeight;
        if (logoDimensions.aspectRatio > (maxLogoWidth / maxLogoHeight)) {
          // Width-constrained
          logoWidth = maxLogoWidth;
          logoHeight = logoWidth / logoDimensions.aspectRatio;
        } else {
          // Height-constrained
          logoHeight = maxLogoHeight;
          logoWidth = logoHeight * logoDimensions.aspectRatio;
        }
        
        const logoX = pageWidth - margin - logoWidth;
        const logoY = (30 - logoHeight) / 2;
        
        if (logoBase64) {
          try {
            pdf.addImage(logoBase64, 'PNG', logoX, logoY, logoWidth, logoHeight);
          } catch (e) {
            // Fallback to text if logo fails
            pdf.setTextColor(255, 255, 255);
            pdf.setFontSize(12);
            pdf.text('Gryffi', pageWidth - margin - 20, 18);
          }
        }
        
        let yPos = 45;
        
        // Reward info
        pdf.setTextColor(100, 100, 100);
        pdf.setFontSize(10);
        
        if (data.reward.redemptionLocation) {
          pdf.text(`${rewardTranslations.redeemAt}: ${data.reward.redemptionLocation}`, 15, yPos);
          yPos += 6;
        }
        if (data.reward.validUntil) {
          pdf.text(`${rewardTranslations.validUntil}: ${new Date(data.reward.validUntil).toLocaleDateString(language)}`, 15, yPos);
          yPos += 6;
        }
        if (data.reward.termsConditions) {
          const termsLines = pdf.splitTextToSize(`${rewardTranslations.terms}: ${data.reward.termsConditions}`, 180);
          pdf.text(termsLines, 15, yPos);
          yPos += termsLines.length * 5 + 5;
        }
        
        yPos += 5;
        
        // Table header
        pdf.setFillColor(248, 250, 252);
        pdf.rect(15, yPos, 180, 10, 'F');
        
        pdf.setTextColor(55, 65, 81);
        pdf.setFontSize(10);
        pdf.setFont(fontFamily, 'bold');
        pdf.text(rewardTranslations.code, 20, yPos + 7);
        pdf.text(rewardTranslations.status, 70, yPos + 7);
        pdf.text(rewardTranslations.claimedBy, 110, yPos + 7);
        pdf.text(rewardTranslations.claimedAt, 160, yPos + 7);
        
        yPos += 12;
        
        // Table rows
        pdf.setFont(fontFamily, 'normal');
        pdf.setFontSize(9);
        
        data.codes.forEach((code, index) => {
          if (yPos > 270) {
            pdf.addPage();
            yPos = 20;
          }
          
          // Alternating row background
          if (index % 2 === 0) {
            pdf.setFillColor(252, 252, 252);
            pdf.rect(15, yPos - 3, 180, 8, 'F');
          }
          
          pdf.setTextColor(55, 65, 81);
          pdf.setFont('courier', 'normal');
          pdf.text(code.code, 20, yPos + 3);
          
          pdf.setFont(fontFamily, 'normal');
          if (code.isClaimed) {
            pdf.setTextColor(22, 101, 52);
          } else {
            pdf.setTextColor(146, 64, 14);
          }
          pdf.text(code.isClaimed ? rewardTranslations.claimed : rewardTranslations.notClaimedYet, 70, yPos + 3);
          
          pdf.setTextColor(100, 100, 100);
          pdf.text(code.claimer?.name || '-', 110, yPos + 3);
          pdf.text(code.claimedAt ? new Date(code.claimedAt).toLocaleDateString(language) : '-', 160, yPos + 3);
          
          yPos += 8;
        });
        
        // Footer
        pdf.setTextColor(150, 150, 150);
        pdf.setFontSize(9);
        pdf.text(`gryffi.com · ${new Date().toLocaleDateString(language)}`, pageWidth / 2, 287, { align: 'center' });
        
        // Save
        const date = new Date().toISOString().split('T')[0];
        const filename = `reward-codes-${rewardTitle?.replace(/[^a-z0-9]/gi, '-') || rewardId}-${date}.pdf`;
        pdf.save(filename);
        
      } catch (err) {
        console.error('Error generating reward codes PDF:', err);
      }
    }
    
  </script>
</body>
</html>
