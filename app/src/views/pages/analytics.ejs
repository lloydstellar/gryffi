                        <p style="font-size: 24px; font-weight: 700; color: var(--gryffi-primary);"><%= reward.claimed_count %></p>
                        <p style="font-size: 12px; color: #64748b;"><%= t('analytics.rewards.claimed') %></p>
                      </div>
                      <div style="text-align: center; padding: 16px; background: #f8fafc; border-radius: 8px;">
                        <p style="font-size: 24px; font-weight: 700; color: #64748b;">
                          <% if (reward.max_recipients) { %>
                            <%= reward.max_recipients - reward.claimed_count %>
                          <% } else if (reward.is_random_codes) { %>
                            ∞
                          <% } else { %>
                            <%= reward.total_codes - reward.claimed_count %>
                          <% } %>
                        </p>
                        <p style="font-size: 12px; color: #64748b;"><%= t('analytics.rewards.remaining') %></p>
                      </div>
                      <% if (reward.valid_until) { %>
                        <div style="text-align: center; padding: 16px; background: #f8fafc; border-radius: 8px;">
                          <p style="font-size: 12px; color: #64748b; margin-bottom: 4px;"><%= t('analytics.rewards.validUntil') %></p>
                          <p style="font-size: 14px; font-weight: 600; color: #64748b;"><%= new Date(reward.valid_until).toLocaleDateString(language) %></p>
                        </div>
                      <% } %>
                    </div>
                    
                    <% if (reward.redemption_location) { %>
                      <p style="font-size: 13px; color: #64748b; margin-bottom: 8px;">
                        <strong><%= t('analytics.rewards.redeemAt') %>:</strong> <%= reward.redemption_location %>
                      </p>
                    <% } %>
                    <% if (reward.terms_conditions) { %>
                      <p style="font-size: 12px; color: #94a3b8; margin-bottom: 16px;">
                        <strong><%= t('analytics.rewards.terms') %>:</strong> <%= reward.terms_conditions %>
                      </p>
