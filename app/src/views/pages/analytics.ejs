      // Poll details
      if (step.poll && step.poll.voted) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title">📊 <%= t("analytics.replay.pollVote") %></div>
            <div class="detail-grid">
              <div class="detail-item">
