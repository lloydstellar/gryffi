      // Form details
      if (step.form) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title">📝 <%= t("analytics.replay.formSubmission") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.form.fields_filled}/${step.form.total_fields}</div>
                <div class="detail-item-label"><%= t("analytics.replay.fieldsFilled") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${formatDuration(step.form.completion_time_ms)}</div>
                <div class="detail-item-label"><%= t("analytics.replay.fillTime") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value" style="color: ${step.form.submitted ? '#10b981' : '#6b7280'}">${step.form.submitted ? <%-safeJson(t("analytics.replay.submitted"))%> : <%-safeJson(t("analytics.replay.notSubmitted"))%>}</div>
                <div class="detail-item-label"><%= t("analytics.replay.status") %></div>
              </div>
