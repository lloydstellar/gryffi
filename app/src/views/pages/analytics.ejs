    // Groups Overview
    async function loadGroupsOverview() {
      const days = document.getElementById('groupsDateRange')?.value || 30;
      
      try {
        const res = await fetch(`/api/analytics/groups-overview?days=${days}`);
        const data = await res.json();
        
        if (data.success) {
          groupsData = data.groups;
          
          // Update benchmarks
          document.getElementById('orgAvgQuizScore').textContent = 
            data.org_benchmarks.avg_quiz_score !== null ? data.org_benchmarks.avg_quiz_score + '%' : '-';
          document.getElementById('orgCompletionRate').textContent = 
            data.org_benchmarks.completion_rate !== null ? data.org_benchmarks.completion_rate + '%' : '-';
          
          // Render groups table
          renderGroupsTable(data.groups, data.org_benchmarks);
          
          // Update comparison selectors
          updateGroupComparisonSelectors(data.groups);
        }
      } catch (err) {
        console.error('Failed to load groups overview:', err);
      }
    }
    
    function renderGroupsTable(groups, benchmarks) {
      const tbody = document.getElementById('groupsTableBody');
      if (!tbody) return;
      
      if (groups.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="loading-cell"><%= t("analytics.groups.noGroups") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = groups.map(g => {
        const quizDiff = g.avg_quiz_score !== null && benchmarks.avg_quiz_score !== null 
          ? g.avg_quiz_score - benchmarks.avg_quiz_score : null;
        const benchmarkClass = quizDiff === null ? '' : quizDiff >= 0 ? 'badge-success' : 'badge-danger';
        const benchmarkText = quizDiff === null ? '-' : (quizDiff >= 0 ? '+' : '') + quizDiff + '%';
        
        return `
          <tr>
            <td><strong>${escapeHtml(g.name)}</strong></td>
            <td>${g.member_count}</td>
            <td>${g.active_users}</td>
            <td>
              <span class="badge ${g.completion_rate >= 70 ? 'badge-success' : g.completion_rate >= 40 ? 'badge-warning' : 'badge-danger'}">
                ${g.completion_rate}%
              </span>
            </td>
            <td>${g.avg_quiz_score !== null ? g.avg_quiz_score + '%' : '-'}</td>
            <td><span class="badge ${benchmarkClass}">${benchmarkText}</span></td>
            <td>
              <button class="table-action-btn" data-action="view-group" data-group-id="${g.id}" data-group-name="${escapeHtml(g.name)}">
                <%= t("analytics.actions.viewDetails") %>
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }
    
    function updateGroupComparisonSelectors(groups) {
      const select1 = document.getElementById('compareGroup1');
      const select2 = document.getElementById('compareGroup2');
      if (!select1 || !select2) return;
      
      // Clear existing options except first
      select1.innerHTML = '<option value=""><%= t("analytics.groups.selectGroup") %></option>';
      select2.innerHTML = '<option value=""><%= t("analytics.groups.selectGroup") %></option>';
      
      groups.forEach(g => {
        select1.innerHTML += `<option value="${g.id}">${escapeHtml(g.name)}</option>`;
        select2.innerHTML += `<option value="${g.id}">${escapeHtml(g.name)}</option>`;
      });
      
      // Show comparison section if we have groups
      document.getElementById('groupComparisonSection').style.display = groups.length >= 2 ? 'block' : 'none';
    }
    
    function updateGroupComparison() {
      const group1Id = document.getElementById('compareGroup1')?.value;
      const group2Id = document.getElementById('compareGroup2')?.value;
      
      if (!group1Id || !group2Id || group1Id === group2Id) return;
      
      const group1 = groupsData.find(g => g.id === group1Id);
      const group2 = groupsData.find(g => g.id === group2Id);
      
      if (!group1 || !group2) return;
      
      const ctx = document.getElementById('groupComparisonChart');
      if (!ctx) return;
      
      if (groupComparisonChart) {
        groupComparisonChart.destroy();
      }
      
      groupComparisonChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: [<%-safeJson(t("analytics.groups.completionRate"))%>, <%-safeJson(t("analytics.groups.avgQuizScore"))%>, <%-safeJson(t("analytics.groups.activeUsers"))%>],
          datasets: [
            {
              label: group1.name,
              data: [group1.completion_rate || 0, group1.avg_quiz_score || 0, group1.active_users || 0],
              backgroundColor: 'rgba(11, 75, 52, 0.7)'
            },
            {
              label: group2.name,
              data: [group2.completion_rate || 0, group2.avg_quiz_score || 0, group2.active_users || 0],
              backgroundColor: 'rgba(120, 197, 3, 0.7)'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'top' } },
          scales: { y: { beginAtZero: true } }
        }
      });
    }
    
