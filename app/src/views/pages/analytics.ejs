    // Store users and groups for search
    let usersAndGroups = { users: [], groups: [] };
    
    // Load users and groups for search
    async function loadUsersAndGroups() {
      try {
        const [usersRes, groupsRes] = await Promise.all([
          fetch('/api/analytics/users-overview'),
          fetch('/api/groups')
        ]);
        
        const usersData = await usersRes.json();
        const groupsData = await groupsRes.json();
        
        if (usersData.success && usersData.users) {
          usersAndGroups.users = usersData.users.map(u => ({
            id: u.id,
            type: 'user',
            name: `${u.first_name || ''} ${u.last_name || ''}`.trim() || u.email,
            email: u.email,
            meta: u.email
          }));
        }
        
        if (groupsData.success && groupsData.groups) {
          usersAndGroups.groups = groupsData.groups.map(g => ({
            id: g.id,
            type: 'group',
            name: g.name,
            meta: `${g.member_count || 0} ${translations.members || 'members'}`
          }));
        }
      } catch (err) {
        console.error('Failed to load users and groups:', err);
      }
    }
    
    // Search users and groups
    function searchUsersAndGroups(query) {
      const q = query.toLowerCase().trim();
      if (!q) return [];
      
      const matchedUsers = usersAndGroups.users.filter(u => 
        u.name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)
      ).slice(0, 5);
      
      const matchedGroups = usersAndGroups.groups.filter(g =>
        g.name.toLowerCase().includes(q)
      ).slice(0, 5);
      
      return [...matchedGroups, ...matchedUsers];
    }
    
