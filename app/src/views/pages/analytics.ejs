  <script>
    // i18n translations for JavaScript
    const translations = {
      journeyPerformance: <%-safeJson(t("analytics.reports.journeyPerformance.title"))%>,
      periodOverview: <%-safeJson(t("analytics.reports.periodOverview.title"))%>,
      invitations: <%-safeJson(t("analytics.reports.labels.invitations"))%>,
