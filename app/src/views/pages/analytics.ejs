      avgTime: <%-safeJson(t("analytics.reports.labels.avgTime"))%>,
      days: <%-safeJson(t("analytics.reports.labels.days"))%>,
      hours: <%-safeJson(t("analytics.reports.labels.hours"))%>,
      funnel: <%-safeJson(t("analytics.reports.labels.funnel"))%>,
      activity: <%-safeJson(t("analytics.reports.labels.activity"))%>,
      topJourneys: <%-safeJson(t("analytics.reports.labels.topJourneys"))%>,
      pollResults: <%-safeJson(t("analytics.reports.labels.pollResults"))%>,
      participants: <%-safeJson(t("analytics.reports.labels.participants"))%>,
      name: <%-safeJson(t("analytics.reports.labels.name"))%>,
      status: <%-safeJson(t("analytics.reports.labels.status"))%>,
      completedAt: <%-safeJson(t("analytics.reports.labels.completedAt"))%>,
      generatedAt: <%-safeJson(t("analytics.reports.labels.generatedAt"))%>,
      noData: <%-safeJson(t("analytics.reports.noData"))%>,
      trend: <%-safeJson(t("analytics.reports.labels.trend"))%>,
      newUsers: <%-safeJson(t("analytics.reports.labels.newUsers"))%>,
      totalUsers: <%-safeJson(t("analytics.reports.labels.totalUsers"))%>,
      pollResponses: <%-safeJson(t("analytics.reports.labels.pollResponses"))%>,
      journey: <%-safeJson(t("analytics.reports.labels.journey"))%>,
      period7: <%-safeJson(t("analytics.reports.periods.week"))%>,
      period30: <%-safeJson(t("analytics.reports.periods.month"))%>,
      period90: <%-safeJson(t("analytics.reports.periods.quarter"))%>,
      period365: <%-safeJson(t("analytics.reports.periods.year"))%>,
      vsPrevious: <%-safeJson(t("analytics.reports.labels.vsPrevious"))%>,
      page: <%-safeJson(t("analytics.reports.labels.page"))%>,
      reportFooter: <%-safeJson(t("analytics.reports.labels.reportFooter"))%>,
      engaged: <%-safeJson(t("analytics.reports.labels.engaged"))%>,
      // Search functionality
      user: <%-safeJson(t("analytics.reports.user"))%>,
      group: <%-safeJson(t("analytics.reports.group"))%>,
      members: <%-safeJson(t("analytics.reports.members"))%>,
      noResults: <%-safeJson(t("analytics.reports.noResults"))%>,
      // Report types
      userProgress: <%-safeJson(t("analytics.reports.userProgress.title"))%>,
      groupProgress: <%-safeJson(t("analytics.reports.groupProgress"))%>,
      engagementReport: <%-safeJson(t("analytics.reports.engagement.title"))%>,
      // Report sections
      userInfo: <%-safeJson(t("analytics.reports.userInfo"))%>,
      groupInfo: <%-safeJson(t("analytics.reports.groupInfo"))%>,
      groupPerformance: <%-safeJson(t("analytics.reports.groupPerformance"))%>,
      topPerformers: <%-safeJson(t("analytics.reports.topPerformers"))%>,
      engagementMetrics: <%-safeJson(t("analytics.reports.engagementMetrics"))%>,
      firstSeen: <%-safeJson(t("analytics.reports.firstSeen"))%>,
      lastActive: <%-safeJson(t("analytics.users.lastActivity"))%>,
      journeyActivity: <%-safeJson(t("analytics.reports.journeyActivity"))%>,
      started: <%-safeJson(t("analytics.kpi.started"))%>,
      journeysStarted: <%-safeJson(t("analytics.groups.journeysStarted"))%>,
      journeysCompleted: <%-safeJson(t("analytics.groups.journeysCompleted"))%>,
      quizPerformance: <%-safeJson(t("analytics.reports.quizPerformance"))%>,
      attempts: <%-safeJson(t("analytics.reports.attempts"))%>,
      avgScore: <%-safeJson(t("analytics.groups.avgQuizScore"))%>,
      passRate: <%-safeJson(t("analytics.reports.passRate"))%>,
      // Engagement stats
      quizStatistics: <%-safeJson(t("analytics.reports.quizStatistics"))%>,
      totalAttempts: <%-safeJson(t("analytics.reports.totalAttempts"))%>,
      uniqueUsers: <%-safeJson(t("analytics.reports.uniqueUsers"))%>,
      videoStatistics: <%-safeJson(t("analytics.reports.videoStatistics"))%>,
      totalViews: <%-safeJson(t("analytics.reports.totalViews"))%>,
      avgWatched: <%-safeJson(t("analytics.reports.avgWatched"))%>,
      aiGuideStatistics: <%-safeJson(t("analytics.reports.aiGuideStatistics"))%>,
      totalSessions: <%-safeJson(t("analytics.reports.totalSessions"))%>,
      totalMessages: <%-safeJson(t("analytics.reports.totalMessages"))%>,
      avgDuration: <%-safeJson(t("analytics.reports.avgDuration"))%>,
      // Period labels
      week: <%-safeJson(t("analytics.reports.periods.week"))%>,
      month: <%-safeJson(t("analytics.reports.periods.month"))%>,
      quarter: <%-safeJson(t("analytics.reports.periods.quarter"))%>,
      year: <%-safeJson(t("analytics.reports.periods.year"))%>
    };
    
    const language = '<%= language %>';
    let currentReportType = null;
    let currentReportData = null;
    let chartInstances = [];
    
    // Theme colors - will be updated with custom theme if available
    let activeThemeColors = null;
    let activeThemeLogoUrl = null;      // Original logo
    let activeThemeLogoLightUrl = null; // White/light version for dark backgrounds
    
    // Default Gryffi colors (fallback)
    const defaultColors = {
      primary: '#0b4b34',
      accent: '#78c503',
      bg: '#ecf2eb',
      success: '#22c55e',
      warning: '#f59e0b',
      danger: '#ef4444'
    };
    
    // Current colors (will use theme colors if available)
    let colors = { ...defaultColors };
    
    // Load active theme
    async function loadActiveTheme() {
      try {
        const response = await fetch('/api/themes');
        const data = await response.json();
        
        if (data.success && data.activeThemeId) {
          const activeTheme = data.themes.find(t => t.id === data.activeThemeId);
          
          if (activeTheme && !activeTheme.is_default) {
            const tokens = typeof activeTheme.tokens === 'string' 
              ? JSON.parse(activeTheme.tokens) 
              : activeTheme.tokens;
            
            activeThemeColors = {
              primary: tokens.primary || defaultColors.primary,
              accent: tokens.accent || defaultColors.accent,
              background: tokens.background || defaultColors.bg,
              // Keep semantic colors as-is
              success: defaultColors.success,
              warning: defaultColors.warning,
              danger: defaultColors.danger
            };
            
            // Store theme logo URLs for PDF generation
            activeThemeLogoUrl = activeTheme.logo_url || null;
            activeThemeLogoLightUrl = activeTheme.logo_light_url || null;
            
            // Update colors object
            colors = {
              primary: activeThemeColors.primary,
              accent: activeThemeColors.accent,
              bg: activeThemeColors.background,
              success: defaultColors.success,
              warning: defaultColors.warning,
              danger: defaultColors.danger
            };
            
            console.log('[Analytics] Custom theme loaded:', activeTheme.name, activeThemeColors);
            console.log('[Analytics] Theme logos:', activeThemeLogoUrl, activeThemeLogoLightUrl);
          }
        }
      } catch (err) {
        console.warn('[Analytics] Could not load theme, using defaults:', err);
      }
    }
    
    // Helper to convert hex to RGB array for PDF
    function hexToRgb(hex) {
      hex = hex.replace(/^#/, '');
      const bigint = parseInt(hex, 16);
      return [(bigint >> 16) & 255, (bigint >> 8) & 255, bigint & 255];
    }
    
    // Get PDF colors based on current theme
    function getPdfColors() {
      return {
        primary: hexToRgb(colors.primary),
        accent: hexToRgb(colors.accent),
        background: hexToRgb(colors.bg),
        dark: [15, 23, 42],
        gray: [100, 116, 139],
        lightGray: [241, 245, 249],
        white: [255, 255, 255],
        success: [34, 197, 94],
        warning: [245, 158, 11],
        danger: [239, 68, 68]
      };
    }
    
    // ============================================
    // ANALYTICS DATA FUNCTIONS
    // ============================================
    
    let overviewTrendChart = null;
    let journeyTrendChart = null;
    let groupComparisonChart = null;
    let userSearchTimeout = null;
    let usersCurrentPage = 0;
    let groupsData = [];
    
    // Format duration in human readable format
    function formatDuration(ms) {
      if (!ms) return '-';
      if (ms < 1000) return ms + 'ms';
      if (ms < 60000) return Math.round(ms / 1000) + 's';
      if (ms < 3600000) return Math.round(ms / 60000) + 'm';
      return Math.round(ms / 3600000) + 'h ' + Math.round((ms % 3600000) / 60000) + 'm';
    }
    
    // Format date relative
    function formatRelativeDate(dateStr) {
      if (!dateStr) return '-';
      const date = new Date(dateStr);
      const now = new Date();
      const diffMs = now - date;
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      
      if (diffDays === 0) return <%-safeJson(t("analytics.time.today"))%>;
      if (diffDays === 1) return <%-safeJson(t("analytics.time.yesterday"))%>;
      if (diffDays < 7) return diffDays + ' <%= t("analytics.time.daysAgo") %>';
      return date.toLocaleDateString();
    }
    
    // Load Overview Data
    async function loadOverviewData() {
      const days = document.getElementById('overviewDateRange')?.value || 30;
      console.log('[Analytics] Loading overview data for', days, 'days');
      
      try {
        // Load summary data
        const summaryRes = await fetch(`/api/analytics/summary?days=${days}`);
        const summaryData = await summaryRes.json();
        console.log('[Analytics] Summary response:', summaryData);
        
        if (summaryData.success) {
          const s = summaryData.summary;
          document.getElementById('kpiJourneysStarted').textContent = s.journeys_started || 0;
          document.getElementById('kpiCompletionRate').textContent = (s.completion_rate || 0) + '%';
          document.getElementById('kpiAvgDuration').textContent = formatDuration(s.avg_step_duration_ms);
          document.getElementById('kpiActiveUsers').textContent = s.unique_users || 0;
          
          // Update trend chart
          updateOverviewTrendChart(s.daily_trend || []);
        }
        
        // Load top journeys
        const journeysRes = await fetch(`/api/analytics/top-journeys?days=${days}&limit=5`);
        const journeysData = await journeysRes.json();
        
        if (journeysData.success) {
          renderTopJourneys(journeysData.journeys || []);
        }
        
      } catch (err) {
        console.error('Failed to load overview data:', err);
      }
    }
    
    // Helper function to fill in missing dates in trend data
    function fillMissingDates(dailyTrend, daysCount) {
      const days = parseInt(daysCount) || 30;
      const now = new Date();
      now.setHours(0, 0, 0, 0);
      
      // Create a map of existing data by date string
      const dataMap = {};
      dailyTrend.forEach(d => {
        const dateKey = new Date(d.date).toISOString().split('T')[0];
        dataMap[dateKey] = d;
      });
      
      // Generate all dates in the period
      const filledData = [];
      for (let i = days - 1; i >= 0; i--) {
        const date = new Date(now);
        date.setDate(date.getDate() - i);
        const dateKey = date.toISOString().split('T')[0];
        
        if (dataMap[dateKey]) {
          filledData.push(dataMap[dateKey]);
        } else {
          filledData.push({
            date: dateKey,
            started: 0,
            completed: 0,
            unique_users: 0
          });
        }
      }
      
      return filledData;
    }
    
    function updateOverviewTrendChart(dailyTrend) {
      const ctx = document.getElementById('overviewTrendChart');
      if (!ctx) return;
      
      // Fill in missing dates for complete visualization
      const days = document.getElementById('overviewDateRange')?.value || 30;
      const filledTrend = fillMissingDates(dailyTrend, days);
      
      const labels = filledTrend.map(d => {
        const date = new Date(d.date);
        return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      });
      
      const startedData = filledTrend.map(d => parseInt(d.started) || 0);
      const completedData = filledTrend.map(d => parseInt(d.completed) || 0);
      
      if (overviewTrendChart) {
        overviewTrendChart.destroy();
      }
      
      overviewTrendChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: <%-safeJson(t("analytics.chart.started"))%>,
              data: startedData,
              borderColor: '#3b82f6',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              fill: true,
              tension: 0.3
            },
            {
              label: <%-safeJson(t("analytics.chart.completed"))%>,
              data: completedData,
              borderColor: '#059669',
              backgroundColor: 'rgba(5, 150, 105, 0.1)',
              fill: true,
              tension: 0.3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top' }
          },
          scales: {
            y: { beginAtZero: true }
          }
        }
      });
    }
    
    function renderTopJourneys(journeys) {
      const tbody = document.getElementById('topJourneysBody');
      if (!tbody) return;
      
      if (journeys.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="loading-cell"><%= t("analytics.overview.noJourneyData") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = journeys.map(j => `
        <tr>
          <td><strong>${escapeHtml(j.title)}</strong></td>
          <td>${j.started}</td>
          <td>${j.completed}</td>
          <td>
            <span class="badge ${j.completion_rate >= 70 ? 'badge-success' : j.completion_rate >= 40 ? 'badge-warning' : 'badge-danger'}">
              ${j.completion_rate}%
            </span>
          </td>
          <td>
            <button class="table-action-btn" data-action="view-journey" data-journey-id="${j.id}">
              <%= t("analytics.actions.viewDetails") %>
            </button>
          </td>
        </tr>
      `).join('');
    }
    
    function viewJourneyAnalytics(journeyId) {
      document.getElementById('journeySelector').value = journeyId;
      switchToTab('journeys');
      history.replaceState(null, null, '#journeys');
      loadJourneyFunnel();
    }
    
    // Load Journey Funnel Data
    async function loadJourneyFunnel() {
      const journeyId = document.getElementById('journeySelector')?.value;
      const days = document.getElementById('journeyDateRange')?.value || 30;
      console.log('[Analytics] Loading journey funnel for:', journeyId, 'days:', days);
      
      const contentEl = document.getElementById('journeyAnalyticsContent');
      const emptyEl = document.getElementById('journeyEmptyState');
      
      if (!journeyId) {
        console.log('[Analytics] No journey selected');
        contentEl.style.display = 'none';
        emptyEl.style.display = 'block';
        return;
      }
      
      contentEl.style.display = 'block';
      emptyEl.style.display = 'none';
      
      try {
        const res = await fetch(`/api/analytics/journey-funnel/${journeyId}?days=${days}`);
        const data = await res.json();
        console.log('[Analytics] Journey funnel response:', data);
        
        if (data.success) {
          // Update KPIs
          document.getElementById('journeyKpiStarted').textContent = data.overall.started;
          document.getElementById('journeyKpiCompleted').textContent = data.overall.completed;
          document.getElementById('journeyKpiRate').textContent = data.overall.completion_rate + '%';
          
          // Render funnel
          renderFunnel(data.funnel, data.overall.started);
          
          // Render step heatmap
          renderStepHeatmap(data.funnel);
          
          // Update daily trend chart
          updateJourneyTrendChart(data.daily_trend || []);
        }
      } catch (err) {
        console.error('Failed to load journey funnel:', err);
      }
    }
    
    function renderFunnel(funnel, totalStarted) {
      const container = document.getElementById('funnelContainer');
      if (!container || funnel.length === 0) {
        container.innerHTML = '<p class="text-center text-gray-500"><%= t("analytics.journeys.noStepData") %></p>';
        return;
      }
      
      const maxUsers = Math.max(totalStarted, ...funnel.map(s => s.users_reached));
      
      container.innerHTML = funnel.map(step => {
        const percentage = maxUsers > 0 ? Math.round((step.users_reached / maxUsers) * 100) : 0;
        return `
          <div class="funnel-step">
            <div class="funnel-label" title="${escapeHtml(step.step_title)}">${escapeHtml(step.step_title)}</div>
            <div class="funnel-bar-container">
              <div class="funnel-bar" style="width: ${percentage}%">
                <span>${percentage}%</span>
              </div>
            </div>
            <div class="funnel-value">${step.users_reached}</div>
          </div>
        `;
      }).join('');
    }
    
    function renderStepHeatmap(funnel) {
      const tbody = document.getElementById('stepHeatmapBody');
      if (!tbody) return;
      
      if (funnel.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="loading-cell"><%= t("analytics.journeys.noStepData") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = funnel.map(step => {
        const dropOffClass = step.drop_off_rate >= 30 ? 'bad' : step.drop_off_rate >= 15 ? 'warning' : 'good';
        const completionClass = step.completion_rate >= 80 ? 'good' : step.completion_rate >= 50 ? 'warning' : 'bad';
        
        return `
          <tr>
            <td><strong>${escapeHtml(step.step_title)}</strong></td>
            <td><span class="badge badge-info">${escapeHtml(step.step_type)}</span></td>
            <td>${step.users_reached}</td>
            <td><span class="heatmap-cell ${completionClass}">${step.users_completed}</span></td>
            <td>${formatDuration(step.avg_duration_ms)}</td>
            <td><span class="heatmap-cell ${dropOffClass}">${step.drop_off_rate}%</span></td>
          </tr>
        `;
      }).join('');
    }
    
    function updateJourneyTrendChart(dailyTrend) {
      const ctx = document.getElementById('journeyTrendChart');
      if (!ctx) return;
      
      // Fill in missing dates for complete visualization
      const days = document.getElementById('journeyDateRange')?.value || 30;
      const filledTrend = fillMissingDates(dailyTrend, days);
      
      const labels = filledTrend.map(d => {
        const date = new Date(d.date);
        return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      });
      
      const startedData = filledTrend.map(d => parseInt(d.started) || 0);
      const completedData = filledTrend.map(d => parseInt(d.completed) || 0);
      
      if (journeyTrendChart) {
        journeyTrendChart.destroy();
      }
      
      journeyTrendChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: <%-safeJson(t("analytics.chart.started"))%>,
              data: startedData,
              backgroundColor: 'rgba(59, 130, 246, 0.7)'
            },
            {
              label: <%-safeJson(t("analytics.chart.completed"))%>,
              data: completedData,
              backgroundColor: 'rgba(5, 150, 105, 0.7)'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'top' } },
          scales: { y: { beginAtZero: true } }
        }
      });
    }
    
    // Users Overview
    function debounceUserSearch() {
      clearTimeout(userSearchTimeout);
      userSearchTimeout = setTimeout(() => {
        usersCurrentPage = 0;
        loadUsersOverview();
      }, 300);
    }
    
    async function loadUsersOverview() {
      const search = document.getElementById('userSearch')?.value || '';
      const groupId = document.getElementById('userGroupFilter')?.value || '';
      const limit = 20;
      const offset = usersCurrentPage * limit;
      
      try {
        const params = new URLSearchParams({ limit, offset });
        if (search) params.append('search', search);
        if (groupId) params.append('group_id', groupId);
        
        const res = await fetch(`/api/analytics/users-overview?${params}`);
        const data = await res.json();
        
        if (data.success) {
          renderUsersTable(data.users);
          renderUsersPagination(data.total, limit);
          
          // Populate group filter if not already done
          const groupFilter = document.getElementById('userGroupFilter');
          if (groupFilter && groupFilter.options.length <= 1 && data.groups) {
            data.groups.forEach(g => {
              const opt = document.createElement('option');
              opt.value = g.id;
              opt.textContent = `${g.name} (${g.member_count})`;
              groupFilter.appendChild(opt);
            });
          }
        }
      } catch (err) {
        console.error('Failed to load users overview:', err);
      }
    }
    
    function renderUsersTable(users) {
      const tbody = document.getElementById('usersTableBody');
      if (!tbody) return;
      
      if (users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="loading-cell"><%= t("analytics.users.noUsers") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = users.map(u => {
        const groups = u.groups || [];
        const groupsHtml = groups.length > 0 
          ? groups.map(g => `<span class="group-tag">${escapeHtml(g.name)}</span>`).join(' ')
          : '-';
        
        const journeys = u.journeys || [];
        const hasJourneys = journeys.length > 0;
        const firstJourney = journeys[0];
        
        let replayButton = '';
        if (hasJourneys) {
          if (journeys.length === 1) {
            replayButton = `<button class="table-action-btn" data-action="view-replay-direct" data-user-id="${u.id}" data-journey-id="${firstJourney.id}" data-journey-title="${escapeHtml(firstJourney.title)}">
              <svg style="width:14px;height:14px;margin-right:4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Replay
            </button>`;
          } else {
            const journeyOptions = journeys.map(j => 
              `<option value="${j.id}" data-title="${escapeHtml(j.title)}">${escapeHtml(j.title)}</option>`
            ).join('');
            replayButton = `<select class="replay-select" data-action="replay-select" data-user-id="${u.id}">
              <option value="">Replay...</option>
              ${journeyOptions}
            </select>`;
          }
        }
        
        return `
        <tr>
          <td>
            <div style="display: flex; align-items: center; gap: 10px;">
              <div class="user-avatar" style="width: 32px; height: 32px; font-size: 12px;">${(u.name || u.email || '?')[0].toUpperCase()}</div>
              <div>
                <div style="font-weight: 500;">${escapeHtml(u.name || '-')}</div>
                <div style="font-size: 12px; color: #6b7280;">${escapeHtml(u.email || '-')}</div>
              </div>
            </div>
          </td>
          <td>${groupsHtml}</td>
          <td>${u.journeys_completed || 0}</td>
          <td>${u.avg_quiz_score !== null ? u.avg_quiz_score + '%' : '-'}</td>
          <td>${formatRelativeDate(u.last_activity)}</td>
          <td>
            <div style="display: flex; gap: 8px; align-items: center;">
              <button class="table-action-btn" data-action="view-user" data-user-id="${u.id}" data-user-name="${escapeHtml(u.name || u.email)}">
                <%= t("analytics.actions.viewDetails") %>
              </button>
              ${replayButton}
            </div>
          </td>
        </tr>
      `}).join('');
    }
    
    function renderUsersPagination(total, limit) {
      const container = document.getElementById('usersPagination');
      if (!container) return;
      
      const totalPages = Math.ceil(total / limit);
      if (totalPages <= 1) {
        container.innerHTML = '';
        return;
      }
      
      let html = '';
      html += `<button ${usersCurrentPage === 0 ? 'disabled' : ''} data-action="page-prev">&laquo;</button>`;
      
      for (let i = 0; i < Math.min(totalPages, 5); i++) {
        const page = usersCurrentPage < 3 ? i : usersCurrentPage - 2 + i;
        if (page >= totalPages) break;
        html += `<button class="${page === usersCurrentPage ? 'active' : ''}" data-action="page-goto" data-page="${page}">${page + 1}</button>`;
      }
      
      html += `<button ${usersCurrentPage >= totalPages - 1 ? 'disabled' : ''} data-action="page-next">&raquo;</button>`;
      
      container.innerHTML = html;
    }
    
    async function viewUserDetail(userId, userName) {
      document.getElementById('userDetailName').textContent = userName;
      document.getElementById('userDetailModal').style.display = 'flex';
      document.getElementById('userDetailContent').innerHTML = '<div class="loading-spinner"></div>';
      
      try {
        const res = await fetch(`/api/analytics/user/${userId}`);
        const data = await res.json();
        
        if (data.success) {
          renderUserDetail(data);
        } else {
          document.getElementById('userDetailContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.users.loadError") %></p>';
        }
      } catch (err) {
        console.error('Failed to load user detail:', err);
        document.getElementById('userDetailContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.users.loadError") %></p>';
      }
    }
    
    // Store current user ID for journey replay
    let currentDetailUserId = null;
    
    function renderUserDetail(data) {
      const user = data.user;
      const analytics = data.analytics;
      const groups = user.groups || [];
      const groupsHtml = groups.length > 0 
        ? groups.map(g => `<span class="group-tag">${escapeHtml(g.name)}</span>`).join(' ')
        : '';
      
      // Store user ID for journey replay
      currentDetailUserId = user.id;
      
      let html = `
        <div class="user-detail-header">
          <div class="user-avatar">${(user.name || user.email || '?')[0].toUpperCase()}</div>
          <div class="user-info">
            <h4>${escapeHtml(user.name || '-')}</h4>
            <p>${escapeHtml(user.email || '-')}</p>
            ${groupsHtml ? '<div style="margin-top: 8px;">' + groupsHtml + '</div>' : ''}
          </div>
        </div>
      `;
      
      // Journey Activity with Replay button
      if (analytics.journey_activity && analytics.journey_activity.length > 0) {
        html += `<h4 style="margin: 20px 0 12px; font-size: 14px; font-weight: 600;"><%= t("analytics.users.journeyActivity") %></h4>`;
        html += '<div class="user-timeline">';
        analytics.journey_activity.forEach(ja => {
          const statusClass = ja.completions > 0 ? 'completed' : 'started';
          html += `
            <div class="timeline-item ${statusClass}">
              <div class="timeline-date">${formatRelativeDate(ja.last_activity)}</div>
              <div class="timeline-content" style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <strong>${escapeHtml(ja.journey_title)}</strong><br>
                  <span style="font-size: 12px; color: #6b7280;">
                    ${ja.steps_completed || 0} <%= t("analytics.users.stepsCompleted") %>
                    ${ja.completions > 0 ? ' • <span class="badge badge-success"><%= t("analytics.users.completed") %></span>' : ''}
                  </span>
                </div>
                <button class="table-action-btn" data-action="view-journey-replay" data-journey-id="${ja.journey_id}" data-journey-title="${escapeHtml(ja.journey_title)}" style="flex-shrink: 0; margin-left: 12px;">
                  <svg style="width: 14px; height: 14px; margin-right: 4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <%= t("analytics.replay.viewReplay") %>
                </button>
              </div>
            </div>
          `;
        });
        html += '</div>';
      }
      
      // Quiz Performance
      if (analytics.quiz_performance && analytics.quiz_performance.length > 0) {
        html += `<h4 style="margin: 24px 0 12px; font-size: 14px; font-weight: 600;"><%= t("analytics.users.quizPerformance") %></h4>`;
        html += '<table class="analytics-table" style="font-size: 13px;">';
        html += '<thead><tr><th><%= t("analytics.table.quiz") %></th><th><%= t("analytics.table.attempts") %></th><th><%= t("analytics.table.bestScore") %></th><th><%= t("analytics.table.avgScore") %></th></tr></thead>';
        html += '<tbody>';
        analytics.quiz_performance.forEach(q => {
          html += `
            <tr>
              <td>${escapeHtml(q.step_title)}</td>
              <td>${q.attempts}</td>
              <td>${q.best_score ? Math.round(q.best_score) + '%' : '-'}</td>
              <td>${q.avg_score ? Math.round(q.avg_score) + '%' : '-'}</td>
            </tr>
          `;
        });
        html += '</tbody></table>';
      }
      
      document.getElementById('userDetailContent').innerHTML = html;
    }
    
    function closeUserDetail() {
      document.getElementById('userDetailModal').style.display = 'none';
    }
    
    // Journey Replay
    async function viewJourneyReplay(userId, journeyId, journeyTitle) {
      document.getElementById('journeyReplayTitle').textContent = journeyTitle + ' - <%= t("analytics.replay.timeline") %>';
      document.getElementById('journeyReplayModal').style.display = 'flex';
      document.getElementById('journeyReplayContent').innerHTML = '<div class="loading-spinner"></div>';
      
      try {
        const res = await fetch(`/api/analytics/user/${userId}/journey/${journeyId}/replay`);
        const data = await res.json();
        
        if (data.success) {
          renderJourneyReplay(data);
        } else {
          document.getElementById('journeyReplayContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.replay.loadError") %></p>';
        }
      } catch (err) {
        console.error('Failed to load journey replay:', err);
        document.getElementById('journeyReplayContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.replay.loadError") %></p>';
      }
    }
    
    function renderJourneyReplay(data) {
      const { user, journey, summary, timeline } = data;
      
      const stepTypeIcons = {
        content: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>',
        challenge: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        quiz: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        form: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
        video: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
        guide: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>',
        poll: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
        reward: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>',
        space: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>',
        nested_journey: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 10v2a2 2 0 002 2h2m6-4v-2a2 2 0 00-2-2h-2"></path></svg>',
        default: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>'
      };
      
      let html = `
        <div class="journey-replay-header">
          <div class="journey-replay-title">
            <h3>${escapeHtml(journey.title)}</h3>
            <p>${escapeHtml(user.name)} • ${escapeHtml(user.email)}</p>
          </div>
          <div class="journey-replay-summary">
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.total_steps}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.steps") %></div>
            </div>
            <div class="replay-stat">
              <div class="replay-stat-value">${formatDuration(summary.total_duration_ms)}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.totalTime") %></div>
            </div>
            ${summary.quiz_attempts > 0 ? `
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.quiz_attempts}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.quizzes") %></div>
            </div>` : ''}
            ${summary.chat_sessions > 0 ? `
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.chat_sessions}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.chats") %></div>
            </div>` : ''}
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.is_completed ? '✓' : '...'}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.status") %></div>
            </div>
          </div>
        </div>
      `;
      
      if (timeline.length === 0) {
        html += '<p class="text-center text-gray-500" style="padding: 40px;"><%= t("analytics.replay.noData") %></p>';
      } else {
        html += '<div class="journey-timeline">';
        
        timeline.forEach((step, index) => {
          const icon = stepTypeIcons[step.step_type] || stepTypeIcons.default;
          const durationPercent = summary.max_step_duration_ms > 0 ? Math.round((step.duration_ms || 0) / summary.max_step_duration_ms * 100) : 0;
          const isCompleted = !!step.completed_at;
          
          // Build badges
          let badges = '';
          if (step.quiz) {
            const quizClass = step.quiz.passed ? 'quiz-pass' : 'quiz-fail';
            badges += `<span class="step-badge ${quizClass}">${step.quiz.passed ? '✓' : '✗'} ${Math.round(step.quiz.score_percentage || 0)}%</span>`;
          }
          if (step.ai_chat && step.ai_chat.total_messages > 0) {
            badges += `<span class="step-badge chat"><svg style="width:12px;height:12px;margin-right:3px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>${step.ai_chat.total_messages}</span>`;
          }
          if (step.video) {
            badges += `<span class="step-badge video"><svg style="width:12px;height:12px;margin-right:3px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>${step.video.watch_percentage || 0}%</span>`;
          }
          if (step.form && step.form.submitted) {
            badges += `<span class="step-badge form">✓ <%= t("analytics.replay.submitted") %></span>`;
          }
          if (step.poll && step.poll.voted) {
            badges += `<span class="step-badge poll">✓ <%= t("analytics.replay.voted") %></span>`;
          }
          
          html += `
            <div class="timeline-step ${isCompleted ? 'completed' : ''}" data-step-index="${index}">
              <div class="step-header" data-action="toggle-step" data-step-idx="${index}">
                <div class="step-info">
                  <div class="step-type-icon ${escapeHtml(step.step_type)}">${icon}</div>
                  <div class="step-title-area">
                    <h4>${escapeHtml(step.step_title || 'Step ' + (index + 1))}</h4>
                    <span>${escapeHtml(step.step_type)} • ${formatTime(step.entered_at)}</span>
                  </div>
                </div>
                <div class="step-badges">${badges}</div>
                <div class="step-duration-bar">
                  <div class="duration-label">${formatDuration(step.duration_ms)}</div>
                  <div class="duration-bar-bg">
                    <div class="duration-bar-fill" style="width: ${durationPercent}%"></div>
                  </div>
                </div>
                <svg class="step-expand-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
              <div class="step-details">
                ${renderStepDetails(step)}
              </div>
            </div>
          `;
        });
        
        html += '</div>';
      }
      
      document.getElementById('journeyReplayContent').innerHTML = html;
    }
    
    function renderStepDetails(step) {
      let html = '';
      
      // Timing details
      html += `
        <div class="detail-section">
          <div class="detail-section-title">⏱️ <%= t("analytics.replay.timing") %></div>
          <div class="detail-grid">
            <div class="detail-item">
              <div class="detail-item-value">${formatTime(step.entered_at)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.started") %></div>
            </div>
            ${step.completed_at ? `
            <div class="detail-item">
              <div class="detail-item-value">${formatTime(step.completed_at)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.completed") %></div>
            </div>` : ''}
            <div class="detail-item">
              <div class="detail-item-value">${formatDuration(step.duration_ms)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.duration") %></div>
            </div>
          </div>
        </div>
      `;
      
      // Quiz details
      if (step.quiz) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title">❓ <%= t("analytics.replay.quizResults") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.quiz.correct_count}/${step.quiz.total_questions}</div>
                <div class="detail-item-label"><%= t("analytics.replay.correctAnswers") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${Math.round(step.quiz.score_percentage || 0)}%</div>
