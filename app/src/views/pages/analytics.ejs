    // Download functions
    async function downloadJourneyReport() {
      const journeyId = document.getElementById('journeyReportSelect').value;
      if (!journeyId) return;
      
      // Fetch data if not already loaded
      if (!currentReportData || currentReportType !== 'journey') {
        try {
          const response = await fetch(`/api/reports/journey/${journeyId}`);
          const data = await response.json();
          if (data.success) {
            currentReportData = data.report;
            currentReportType = 'journey';
          }
        } catch (err) {
          console.error('Failed to fetch report:', err);
          return;
        }
      }
      
      await generateJourneyPDF(currentReportData);
    }
    
