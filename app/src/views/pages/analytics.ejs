    const SHOW_DELETED = <%- safeJson(!!showDeleted) %>;
    const DELETED_T = <%- safeJson(t('analytics.deleted', { returnObjects: true })) %>;
    // Charts per day count in the viewer's time zone (the server groups by it)
    const VIEWER_TZ = (() => {
      try { return encodeURIComponent(Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'); } catch { return 'UTC'; }
    })();
    // A day from the server ("2026-10-29", or that day at midnight UTC) as the
    // same calendar day here; new Date() would make it the day before west of UTC
    function calendarDay(value) {
      const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(value));
      return match ? new Date(+match[1], +match[2] - 1, +match[3]) : new Date(value);
    }
    function withDeleted(url) {
      if (!SHOW_DELETED) return url;
      return url + (url.includes('?') ? '&' : '?') + 'include_deleted=1';
    }
    function deletedBadge(isDeleted) {
      return isDeleted ? `<span class="deleted-badge">${escapeHtml(DELETED_T.badge)}</span>` : '';
    }
    function deletedSuffix(isDeleted) {
      return isDeleted ? ` (${DELETED_T.badge})` : '';
