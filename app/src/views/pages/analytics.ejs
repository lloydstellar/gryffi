    // Close the codes modal: button, backdrop or Escape; focus goes back to the button that opened it
    let rewardCodesOpener = null;
    function closeRewardCodesModal() {
      const modal = document.getElementById('rewardCodesModal');
      if (!modal || modal.style.display === 'none') return;
      modal.style.display = 'none';
      rewardCodesOpener?.focus();
      rewardCodesOpener = null;
    }
    document.getElementById('closeRewardCodesModal')?.addEventListener('click', closeRewardCodesModal);
    document.getElementById('rewardCodesModal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeRewardCodesModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeRewardCodesModal();
    });
    
    async function loadRewardCodes(rewardId) {
      try {
        const res = await fetch(`/api/rewards/${rewardId}/codes`);
        const data = await res.json();
        
        if (!data.success) {
          console.error('Failed to load codes:', data.error);
          return;
        }
        
        const modal = document.getElementById('rewardCodesModal');
        const title = document.getElementById('rewardCodesModalTitle');
        const content = document.getElementById('rewardCodesContent');
        
        title.textContent = `${rewardTranslations.codesTitle}: ${data.reward.title}`;
        
        let html = `
          <div style="margin-bottom: 16px; padding: 12px; background: #f8fafc; border-radius: 8px;">
            ${data.reward.redemptionLocation ? `<p style="margin: 0 0 4px;"><strong>${rewardTranslations.redeemAt}:</strong> ${escapeHtml(data.reward.redemptionLocation)}</p>` : ''}
            ${data.reward.validUntil ? `<p style="margin: 0 0 4px;"><strong>${rewardTranslations.validUntil}:</strong> ${new Date(data.reward.validUntil).toLocaleDateString(dateLocale, DATE_OPTS)}</p>` : ''}
            ${data.reward.termsConditions ? `<p style="margin: 0; font-size: 12px; color: #5b6b80;"><strong>${rewardTranslations.terms}:</strong> ${escapeHtml(data.reward.termsConditions)}</p>` : ''}
          </div>
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="background: #f8fafc; border-bottom: 2px solid #e5e7eb;">
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.code}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.status}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.claimedBy}</th>
                <th style="padding: 12px; text-align: left; font-weight: 600; color: #374151;">${rewardTranslations.claimedAt}</th>
              </tr>
            </thead>
            <tbody>
        `;
        
        data.codes.forEach(code => {
          const statusStyle = code.isClaimed 
            ? 'background: #dcfce7; color: #166534; padding: 4px 8px; border-radius: 4px; font-size: 12px;'
            : 'background: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 4px; font-size: 12px;';
          
          html += `
            <tr style="border-bottom: 1px solid #e5e7eb;">
              <td style="padding: 12px; font-family: monospace; font-weight: 600;">${escapeHtml(code.code)}</td>
              <td style="padding: 12px;">
                <span style="${statusStyle}">${code.isClaimed ? rewardTranslations.claimed : rewardTranslations.notClaimedYet}</span>
              </td>
              <td style="padding: 12px; color: #374151;">
                ${code.claimer ? `${escapeHtml(code.claimer.name)}<br><span style="font-size: 12px; color: #5b6b80;">${escapeHtml(code.claimer.email)}</span>` : '-'}
              </td>
              <td style="padding: 12px; color: #5b6b80; font-size: 13px;">
                ${code.claimedAt ? new Date(code.claimedAt).toLocaleString(dateLocale, DATE_TIME_OPTS) : '-'}
              </td>
            </tr>
          `;
        });
        
        html += '</tbody></table>';
        content.innerHTML = html;
        rewardCodesOpener = document.activeElement;
        modal.style.display = 'flex';
        document.getElementById('closeRewardCodesModal')?.focus();
        
      } catch (err) {
        console.error('Error loading reward codes:', err);
      }
    }
    
    async function downloadRewardCodesPDF(rewardId, rewardTitle) {
      try {
        // Load logo and get its dimensions for correct aspect ratio
        const logoBase64 = await loadLogoForPDF();
        const logoDimensions = logoBase64 ? await getImageDimensions(logoBase64) : { aspectRatio: 2.37 };
        
        const res = await fetch(`/api/rewards/${rewardId}/codes`);
        const data = await res.json();
        
        if (!data.success) {
          console.error('Failed to load codes for PDF:', data.error);
          return;
        }
        
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF('p', 'mm', 'a4');
        const pageWidth = 210;
        const margin = 15;
        
        // Use NotoSans for Unicode support (Turkish, Arabic, etc.)
        const fontFamily = pdf.getFontList()['NotoSans'] ? 'NotoSans' : 'helvetica';
        
        // Get theme colors for PDF
        const pdfColors = getPdfColors();
        
        // Header - use theme primary color
        pdf.setFillColor(...pdfColors.primary);
        pdf.rect(0, 0, pageWidth, 30, 'F');
        
        pdf.setTextColor(255, 255, 255);
        pdf.setFontSize(18);
        pdf.setFont(fontFamily, 'bold');
        pdf.text(rewardTranslations.codesTitle, margin, 15);
        
        // Subtitle
        pdf.setFontSize(11);
        pdf.setFont(fontFamily, 'normal');
        pdf.text(rewardTitle || data.reward.title, margin, 24);
        
        // Logo (right side) - calculate dimensions maintaining aspect ratio
        // Max height is 12mm, max width is 40mm (smaller header)
        const maxLogoHeight = 12;
        const maxLogoWidth = 40;
        
        let logoWidth, logoHeight;
        if (logoDimensions.aspectRatio > (maxLogoWidth / maxLogoHeight)) {
          // Width-constrained
          logoWidth = maxLogoWidth;
          logoHeight = logoWidth / logoDimensions.aspectRatio;
        } else {
          // Height-constrained
          logoHeight = maxLogoHeight;
          logoWidth = logoHeight * logoDimensions.aspectRatio;
        }
        
        const logoX = pageWidth - margin - logoWidth;
        const logoY = (30 - logoHeight) / 2;
        
        if (logoBase64) {
          try {
            pdf.addImage(logoBase64, 'PNG', logoX, logoY, logoWidth, logoHeight);
          } catch (e) {
            // Fallback to text if logo fails
            pdf.setTextColor(255, 255, 255);
            pdf.setFontSize(12);
            pdf.text('Gryffi', pageWidth - margin - 20, 18);
          }
        }
        
        let yPos = 45;
        
        // Reward info
        pdf.setTextColor(100, 100, 100);
        pdf.setFontSize(10);
        
        if (data.reward.redemptionLocation) {
          pdf.text(`${rewardTranslations.redeemAt}: ${data.reward.redemptionLocation}`, 15, yPos);
          yPos += 6;
        }
        if (data.reward.validUntil) {
          pdf.text(`${rewardTranslations.validUntil}: ${new Date(data.reward.validUntil).toLocaleDateString(dateLocale, DATE_OPTS)}`, 15, yPos);
          yPos += 6;
        }
        if (data.reward.termsConditions) {
          const termsLines = pdf.splitTextToSize(`${rewardTranslations.terms}: ${data.reward.termsConditions}`, 180);
          pdf.text(termsLines, 15, yPos);
          yPos += termsLines.length * 5 + 5;
        }
        
        yPos += 5;
        
        // Table header
        pdf.setFillColor(248, 250, 252);
        pdf.rect(15, yPos, 180, 10, 'F');
        
        pdf.setTextColor(55, 65, 81);
        pdf.setFontSize(10);
        pdf.setFont(fontFamily, 'bold');
        pdf.text(rewardTranslations.code, 20, yPos + 7);
        pdf.text(rewardTranslations.status, 70, yPos + 7);
        pdf.text(rewardTranslations.claimedBy, 110, yPos + 7);
        pdf.text(rewardTranslations.claimedAt, 160, yPos + 7);
        
        yPos += 12;
        
        // Table rows
        pdf.setFont(fontFamily, 'normal');
        pdf.setFontSize(9);
        
        data.codes.forEach((code, index) => {
          if (yPos > 270) {
            pdf.addPage();
            yPos = 20;
          }
          
          // Alternating row background
          if (index % 2 === 0) {
            pdf.setFillColor(252, 252, 252);
            pdf.rect(15, yPos - 3, 180, 8, 'F');
          }
          
          pdf.setTextColor(55, 65, 81);
          pdf.setFont('courier', 'normal');
          pdf.text(code.code, 20, yPos + 3);
          
          pdf.setFont(fontFamily, 'normal');
          if (code.isClaimed) {
            pdf.setTextColor(22, 101, 52);
          } else {
            pdf.setTextColor(146, 64, 14);
          }
          pdf.text(code.isClaimed ? rewardTranslations.claimed : rewardTranslations.notClaimedYet, 70, yPos + 3);
          
          pdf.setTextColor(100, 100, 100);
          pdf.text(code.claimer?.name || '-', 110, yPos + 3);
          pdf.text(code.claimedAt ? new Date(code.claimedAt).toLocaleDateString(dateLocale, DATE_OPTS) : '-', 160, yPos + 3);
          
          yPos += 8;
        });
        
        // Footer
        pdf.setTextColor(150, 150, 150);
        pdf.setFontSize(9);
        pdf.text(`gryffi.com · ${new Date().toLocaleDateString(dateLocale, DATE_OPTS)}`, pageWidth / 2, 287, { align: 'center' });
        
        // Save
        const date = new Date().toISOString().split('T')[0];
        const filename = `reward-codes-${rewardTitle?.replace(/[^a-z0-9]/gi, '-') || rewardId}-${date}.pdf`;
        pdf.save(filename);
        
      } catch (err) {
        console.error('Error generating reward codes PDF:', err);
      }
    }

  </script>
  <script>
    // "Show deleted journeys and steps": reload with or without ?deleted=1,
    // on the same tab
    (function () {
      const toggle = document.getElementById('showDeletedToggle');
      if (toggle) {
        toggle.addEventListener('change', () => {
          const url = new URL(window.location.href);
          if (toggle.checked) url.searchParams.set('deleted', '1');
          else url.searchParams.delete('deleted');
          window.location.assign(url.toString());
        });
      }
      if (!SHOW_DELETED) return;

      const body = document.getElementById('deletedResultsBody');
      const language = <%- safeJson(typeof language !== 'undefined' ? language : 'en') %>;
      const fill = (text, values) => String(text).replace(/\{\{(\w+)\}\}/g, (match, key) => (key in values ? values[key] : match));
      const formatDate = (value) => (value ? new Date(value).toLocaleDateString(language === 'en' ? 'en-GB' : language, { day: 'numeric', month: 'short', year: 'numeric' }) : '');

      function itemHtml(kind, item, meta, canDelete) {
        const title = item.title || (kind === 'journey' ? DELETED_T.journeyFallback : DELETED_T.stepFallback);
        const button = canDelete
          ? `<button type="button" data-delete-kind="${kind}" data-delete-id="${escapeHtml(item.id)}" data-delete-title="${escapeHtml(title)}" aria-label="${escapeHtml(fill(DELETED_T.deleteButtonLabel, { title }))}">${escapeHtml(DELETED_T.deleteButton)}</button>`
          : '';
        return `<li>
          <div>
            <div class="deleted-item-title">${escapeHtml(title)}</div>
            <div class="deleted-item-meta">${escapeHtml(meta)}</div>
          </div>
          ${button}
        </li>`;
      }

      async function load() {
        if (!body) return;
        try {
          const res = await fetch('/api/analytics/deleted');
          const data = await res.json();
          if (!data.success) throw new Error(data.error || 'load failed');
          if (data.journeys.length === 0 && data.steps.length === 0) {
            body.innerHTML = `<p class="deleted-intro" style="margin-top: 12px;">${escapeHtml(DELETED_T.empty)}</p>`;
            return;
          }
          let html = '';
          if (data.journeys.length > 0) {
            html += `<h3>${escapeHtml(DELETED_T.journeysHeading)}</h3><ul class="deleted-results-list">`;
            html += data.journeys.map((j) => {
              const people = fill(j.participant_count === 1 ? DELETED_T.participants_one : DELETED_T.participants_other, { count: j.participant_count });
              return itemHtml('journey', j, `${people} · ${fill(DELETED_T.deletedOn, { date: formatDate(j.purged_at) })}`, data.canDelete);
            }).join('');
            html += '</ul>';
          }
          if (data.steps.length > 0) {
            html += `<h3>${escapeHtml(DELETED_T.stepsHeading)}</h3><ul class="deleted-results-list">`;
            html += data.steps.map((st) => itemHtml('step', st,
              `${fill(DELETED_T.stepIn, { journey: st.journey_title || '' })} · ${fill(DELETED_T.deletedOn, { date: formatDate(st.deleted_at) })}`,
              data.canDelete)).join('');
            html += '</ul>';
          }
          if (!data.canDelete) {
            html += `<p class="deleted-intro" style="margin-top: 8px;">${escapeHtml(DELETED_T.onlyAdmins)}</p>`;
          }
          body.innerHTML = html;
        } catch (err) {
          console.error('[Analytics] Deleted results:', err);
          body.innerHTML = `<p class="deleted-intro" style="margin-top: 12px;">${escapeHtml(DELETED_T.loadError)}</p>`;
        }
      }

      body?.addEventListener('click', async (event) => {
        const button = event.target.closest('button[data-delete-kind]');
        if (!button) return;
        const kind = button.dataset.deleteKind;
        const title = button.dataset.deleteTitle;
        const message = fill(kind === 'journey' ? DELETED_T.confirmJourney : DELETED_T.confirmStep, { title });
        const confirmed = await window.gryffi.modal.confirm(message, { confirmText: DELETED_T.confirmButton });
        if (!confirmed) return;
        button.disabled = true;
        try {
          const res = await fetch(`/api/analytics/deleted/${kind === 'journey' ? 'journeys' : 'steps'}/${encodeURIComponent(button.dataset.deleteId)}`, { method: 'DELETE' });
          const data = await res.json();
          if (!data.success) {
            window.gryffi.toast.show(data.error || DELETED_T.deleteError, 'error');
            button.disabled = false;
            return;
          }
          window.gryffi.toast.show(DELETED_T.deletedSuccess, 'success');
          // The numbers on the page include these results: start fresh
          window.location.reload();
        } catch (err) {
          console.error('[Analytics] Delete results:', err);
          window.gryffi.toast.show(DELETED_T.deleteError, 'error');
          button.disabled = false;
        }
      });

      load();
    })();
  </script>
</body>
</html>
