                      </svg>
                      <%= reward.journey_title %>
                    </span>
                    <h3 class="poll-question" style="color: var(--gryffi-primary);"><%= reward.title || reward.step_title %></h3>
                    <% if (reward.description) { %>
                      <p style="color: #64748b; font-size: 14px; margin-top: 4px;"><%= reward.description %></p>
                    <% } %>
                  </div>
