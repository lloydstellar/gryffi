      createdAt: <%-safeJson(t("analytics.reports.createdAt"))%>,
      videoViews: <%-safeJson(t("analytics.reports.videoViews"))%>,
      avgChatDuration: <%-safeJson(t("analytics.reports.avgChatDuration"))%>,
      avgQuizScore: <%-safeJson(t("analytics.reports.avgQuizScore"))%>,
      bestScore: <%-safeJson(t("analytics.reports.bestScore"))%>,
      quizAttempts: <%-safeJson(t("analytics.reports.quizAttempts"))%>,
      topAiGuideSteps: <%-safeJson(t("analytics.reports.topAiGuideSteps"))%>,
      topQuizzes: <%-safeJson(t("analytics.reports.topQuizzes"))%>,
      topVideos: <%-safeJson(t("analytics.reports.topVideos"))%>,
      videoCompletion: <%-safeJson(t("analytics.reports.videoCompletion"))%>,
      videoEngagement: <%-safeJson(t("analytics.reports.videoEngagement"))%>,
      videosWatched: <%-safeJson(t("analytics.reports.videosWatched"))%>,
      reports: <%- safeJson({
        aiChats: t('analytics.replay.chats'),
        aiGuideStatistics: t('analytics.reports.aiGuideStatistics'),
        aiGuideUsage: t('analytics.reports.aiGuideUsage'),
