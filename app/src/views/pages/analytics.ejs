        if (chatData.topSteps && chatData.topSteps.length > 0) {
          pdf.addSectionTitle(translations.reports?.topAiGuideSteps || 'Most Active AI Guide Steps', Math.min(chatData.topSteps.length, 5) * 12 + 6);
          pdf.addBarChart(chatData.topSteps.map(s => ({
