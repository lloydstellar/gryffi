<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('analytics.title') %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <!-- Chart.js for modern charts (served locally) -->
  <script src="/js/vendor/chart.umd.js"></script>
  <!-- jsPDF for PDF generation (served locally) -->
  <script src="/js/vendor/jspdf.umd.min.js"></script>
  <!-- Noto Sans font for jsPDF (Unicode support for Turkish, Arabic, etc.) -->
  <script src="/fonts/noto-sans-jspdf.js"></script>
  <!-- html2canvas for capturing charts (served locally) -->
  <script src="/js/vendor/html2canvas.min.js"></script>
  <style>
    :root {
      --gryffi-bg: #ecf2eb;
      --gryffi-primary: #0b4b34;
      --gryffi-accent: #78c503;
    }
    
    /* Analytics Tabs - Consistent with System Settings */
    .analytics-tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 24px;
      padding: 4px;
      background: white;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
    }
    .analytics-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      color: #6b7280;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.15s;
    }
    .analytics-tab:hover {
      color: #0b4b34;
      background: rgba(11, 75, 52, 0.04);
    }
    .analytics-tab.active {
      background: #0b4b34;
      color: white;
    }
    .analytics-tab svg {
      width: 18px;
      height: 18px;
    }
    .analytics-tab .tab-count {
      font-size: 12px;
      padding: 2px 6px;
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.1);
      margin-left: 4px;
    }
    .analytics-tab.active .tab-count {
      background: rgba(255, 255, 255, 0.2);
    }
    .analytics-tab-panel {
      display: none;
    }
    .analytics-tab-panel.active {
      display: block;
    }
    
    @media (max-width: 767px) {
      .analytics-tabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
      }
      .analytics-tabs::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
      }
      .analytics-tab {
        flex-shrink: 0;
        padding: 10px 14px;
        font-size: 13px;
      }
      .analytics-tab svg {
        width: 16px;
        height: 16px;
      }
      .analytics-tab .tab-count {
        font-size: 11px;
        padding: 1px 5px;
      }
    }
    
    /* Empty State - Improved */
    .empty-state-improved {
      text-align: center;
      padding: 60px 24px;
    }
    .empty-state-improved .empty-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 20px;
      color: #d1d5db;
    }
    .empty-state-improved h3 {
      font-size: 18px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }
    .empty-state-improved p {
      font-size: 14px;
      color: #6b7280;
      max-width: 360px;
      margin: 0 auto 20px;
      line-height: 1.5;
    }
    .empty-state-improved .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: var(--gryffi-primary);
      color: white;
      font-size: 14px;
      font-weight: 500;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.15s;
    }
    .empty-state-improved .btn-action:hover {
      background: #063d2a;
    }
    .empty-state-improved .btn-action svg {
      width: 16px;
      height: 16px;
    }
    
    .card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
    }
    .card-header {
      padding: 20px 24px;
      border-bottom: 1px solid #f3f4f6;
    }
    .card-body {
      padding: 24px;
    }
    
    .poll-card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      margin-bottom: 20px;
      overflow: hidden;
    }
    
    .poll-header {
      padding: 16px 20px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
    }
    
    .poll-journey-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0;
      background: transparent;
      color: #64748b;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
    }
    
    .poll-journey-badge svg {
      width: 16px;
      height: 16px;
      color: var(--gryffi-primary);
      flex-shrink: 0;
    }
    
    .poll-question {
      font-size: 18px;
      font-weight: 600;
      color: #0f172a;
      margin: 0;
    }
    
    .poll-body {
      padding: 20px;
    }
    
    .poll-option {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: #f8fafc;
      border-radius: 8px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    
    .poll-option-bar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      background: linear-gradient(90deg, rgba(120, 197, 3, 0.25), rgba(120, 197, 3, 0.1));
      z-index: 0;
      transition: width 0.5s ease-out;
    }
    
    .poll-option-text {
      flex: 1;
      font-size: 14px;
      color: #334155;
      z-index: 1;
    }
    
    .poll-option-count {
      font-size: 14px;
      font-weight: 600;
      color: #0f172a;
      z-index: 1;
      min-width: 80px;
      text-align: right;
    }
    
    .poll-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 16px;
      border-top: 1px solid #e5e7eb;
      margin-top: 16px;
    }
    
    .poll-meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #64748b;
    }
    
    .poll-meta-item svg {
      width: 16px;
      height: 16px;
    }
    
    /* Form submissions tab (reuses the poll card look & feel) */
    .form-submission-card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      margin-bottom: 16px;
      overflow: hidden;
    }
    
    .form-submission-header {
      padding: 14px 20px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    
    .form-submission-title {
      font-size: 15px;
      font-weight: 600;
      color: #1e293b;
    }
    
    .form-submission-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    
    .form-submission-badge.private {
      background: rgba(11, 75, 52, 0.08);
      color: var(--gryffi-primary, #0b4b34);
    }
    
    .form-submission-badge.public {
      background: rgba(59, 130, 246, 0.1);
      color: #2563eb;
    }
    
    .form-submission-responses {
      width: 100%;
      border-collapse: collapse;
    }
    
    .form-submission-responses td {
      padding: 10px 12px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 13px;
      vertical-align: top;
    }
    
    .form-submission-responses td:first-child {
      font-weight: 600;
      color: #475569;
      width: 35%;
    }
    
    .form-submission-responses td:last-child {
      color: #1f2937;
      word-break: break-word;
    }
    
    .form-submission-file {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 12px;
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      margin-top: 8px;
    }
    
    .form-submission-file-name {
      font-size: 13px;
      color: #1f2937;
      font-weight: 500;
      word-break: break-all;
    }
    
    .form-submission-file-meta {
      font-size: 12px;
      color: #94a3b8;
    }
    
    .form-file-download-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: var(--gryffi-primary, #0b4b34);
      color: white;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: opacity 0.15s;
    }
    
    .form-file-download-btn:hover {
      opacity: 0.9;
    }
    
    .form-file-download-btn svg {
      width: 14px;
      height: 14px;
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }
    
    .empty-state-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      color: #cbd5e1;
    }
    
    .empty-state-title {
      font-size: 18px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 8px;
    }
    
    .empty-state-text {
      font-size: 14px;
      color: #64748b;
    }
    
    /* Usage Section - same style as subscription page */
    .usage-section {
      background: white;
      border-radius: 16px;
      border: 1px solid #e5e7eb;
      padding: 24px;
      margin-bottom: 32px;
    }
    
    .usage-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    
    .usage-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }
    
    .usage-item {
      padding: 16px;
      background: var(--gryffi-bg);
      border-radius: 12px;
    }
    
    .usage-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    
    .usage-item-label {
      font-size: 14px;
      font-weight: 500;
      color: #334155;
    }
    
    .usage-item-value {
      font-size: 13px;
      color: #64748b;
    }
    
    .usage-bar {
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
    }
    
    .usage-bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.3s ease;
    }
    
    .usage-bar-fill.ok { background: var(--gryffi-primary); }
    .usage-bar-fill.warning { background: #f59e0b; }
    .usage-bar-fill.danger { background: #ef4444; }
    
    /* Reports Section Styles */
    .reports-section {
      margin-bottom: 32px;
    }
    
    .reports-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 24px;
      margin-bottom: 24px;
    }
    
    @media (max-width: 900px) {
      .reports-grid {
        grid-template-columns: 1fr;
      }
    }
    
    .report-card {
      background: white;
      border-radius: 16px;
      border: 1px solid #e5e7eb;
      overflow: visible;
      transition: box-shadow 0.2s ease;
    }
    
    .report-card:hover {
      box-shadow: 0 4px 20px rgba(11, 75, 52, 0.08);
    }
    
    .report-card-header {
      padding: 20px 24px;
      background: white;
      border-bottom: 1px solid #e5e7eb;
      border-radius: 16px 16px 0 0;
    }
    
    .report-card-icon {
      width: 40px;
      height: 40px;
      background: var(--gryffi-bg);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
      color: var(--gryffi-primary);
    }
    
    .report-card-icon svg {
      width: 22px;
      height: 22px;
    }
    
    .report-card-title {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 4px 0;
      color: var(--gryffi-primary);
    }
    
    .report-card-desc {
      font-size: 14px;
      color: #64748b;
      margin: 0;
    }
    
    .report-card-body {
      padding: 24px;
      overflow: visible;
      background: white;
      border-radius: 0 0 16px 16px;
    }
    
    .report-select-group {
      margin-bottom: 20px;
      overflow: visible;
    }
    
    .report-select-label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: #64748b;
      margin-bottom: 8px;
    }
    
    .report-select {
      width: 100%;
      padding: 12px 16px;
      font-size: 14px;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      background: white;
      color: #0f172a;
      cursor: pointer;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    
    .report-select:focus {
      outline: none;
      border-color: var(--gryffi-primary);
      box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.1);
    }
    
    .report-search-container {
      position: relative;
    }
    
    .report-search-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    
    .report-search-input-wrapper svg {
      position: absolute;
      left: 14px;
      width: 18px;
      height: 18px;
      color: #94a3b8;
      pointer-events: none;
    }
    
    .report-search-input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      font-size: 14px;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      background: white;
      color: #0f172a;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    
    .report-search-input:focus {
      outline: none;
      border-color: var(--gryffi-primary);
      box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.1);
    }
    
    .report-search-input::placeholder {
      color: #94a3b8;
    }
    
    .report-search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      margin-top: 4px;
      max-height: 280px;
      overflow-y: auto;
      z-index: 9999;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2);
    }
    
    .search-result-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    
    .search-result-item:hover {
      background: var(--gryffi-bg);
    }
    
    .search-result-item:first-child {
      border-radius: 10px 10px 0 0;
    }
    
    .search-result-item:last-child {
      border-radius: 0 0 10px 10px;
    }
    
    .search-result-item:only-child {
      border-radius: 10px;
    }
    
    .search-result-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    
    .search-result-icon.user-icon {
      background: var(--gryffi-bg);
      color: var(--gryffi-primary);
    }
    
    .search-result-icon.group-icon {
      background: rgba(120, 197, 3, 0.1);
      color: var(--gryffi-accent);
    }
    
    .search-result-icon svg {
      width: 16px;
      height: 16px;
    }
    
    .search-result-info {
      flex: 1;
      min-width: 0;
    }
    
    .search-result-name {
      font-size: 14px;
      font-weight: 500;
      color: #0f172a;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .search-result-meta {
      font-size: 12px;
      color: #94a3b8;
    }
    
    .search-result-type {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 500;
    }
    
    .search-result-type.type-user {
      background: var(--gryffi-bg);
      color: var(--gryffi-primary);
    }
    
    .search-result-type.type-group {
      background: rgba(120, 197, 3, 0.1);
      color: #4d7c0f;
    }
    
    .search-no-results {
      padding: 20px 16px;
      text-align: center;
      color: #94a3b8;
      font-size: 14px;
    }
    
    .selected-user-group {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: var(--gryffi-bg);
      border-radius: 10px;
      margin-top: 10px;
    }
    
    .selected-user-group span {
      flex: 1;
      font-size: 14px;
      font-weight: 500;
      color: var(--gryffi-primary);
    }
    
    .clear-selection-btn {
      background: none;
      border: none;
      padding: 4px;
      cursor: pointer;
      color: #94a3b8;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease;
    }
    
    .clear-selection-btn:hover {
      color: #ef4444;
    }
    
    .clear-selection-btn svg {
      width: 16px;
      height: 16px;
    }
    
    .report-actions {
      display: flex;
      gap: 12px;
    }
    
    .btn-report {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 500;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-report-preview {
      background: var(--gryffi-bg);
      border: 1px solid #e5e7eb;
      color: var(--gryffi-primary);
    }
    
    .btn-report-preview:hover {
      background: #dde8db;
    }
    
    .btn-report-download {
      background: var(--gryffi-primary);
      border: 1px solid var(--gryffi-primary);
      color: white;
    }
    
    .btn-report-download:hover {
      background: #0d5c40;
    }
    
    .btn-report:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .btn-report svg {
      width: 18px;
      height: 18px;
    }
    
    /* Export PDF Button for tabs */
    .btn-export-pdf {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 500;
      background: var(--gryffi-primary);
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-export-pdf:hover {
      background: #0d5c40;
    }
    .btn-export-pdf:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .btn-export-pdf svg {
      flex-shrink: 0;
    }
    
    /* Small export button for modals */
    .btn-export-pdf-small {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      background: rgba(11, 75, 52, 0.1);
      color: var(--gryffi-primary);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-export-pdf-small:hover {
      background: var(--gryffi-primary);
      color: white;
    }
    
    /* Modal header actions */
    .modal-header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    /* Report Preview Modal */
    .report-modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      padding: 24px;
      overflow-y: auto;
    }
    
    .report-modal.active {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }
    
    .report-modal-content {
      background: white;
      border-radius: 16px;
      width: 100%;
      max-width: 900px;
      margin: 24px 0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }
    
    .report-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      border-bottom: 1px solid #e5e7eb;
    }
    
    .report-modal-title {
      font-size: 18px;
      font-weight: 600;
      color: #0f172a;
      margin: 0;
    }
    
    .report-modal-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: #f1f5f9;
      border-radius: 8px;
      cursor: pointer;
      color: #64748b;
      transition: all 0.2s ease;
    }
    
    .report-modal-close:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    
    .report-modal-body {
      padding: 24px;
      max-height: 70vh;
      overflow-y: auto;
    }
    
    .report-modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      padding: 16px 24px;
      border-top: 1px solid #e5e7eb;
      background: #f8fafc;
      border-radius: 0 0 16px 16px;
    }
    
    /* Report Preview Content */
    #reportPreviewContent {
      background: white;
    }
    
    .report-preview {
