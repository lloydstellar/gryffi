                    <div class="reward-header" style="padding: 12px 16px; background: #f1f5f9; border-bottom: 1px solid #e5e7eb;">
                      <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;">
                        <% if (rewardIsRestorable) { %>
                          <span style="font-size: 10px; padding: 2px 8px; background: #dcfce7; color: #166534; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px;">
                            <svg style="width: 10px; height: 10px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            <%= t('analytics.rewards.restorable') %>
                          </span>
                        <% } else { %>
                          <span class="poll-journey-badge" style="background: #e2e8f0; color: #64748b; font-size: 10px;">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 10px; height: 10px;">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                            </svg>
                            <%= t('analytics.rewards.permanent') %>
                          </span>
                        <% } %>
                        <span style="font-size: 11px; color: #94a3b8;"><%= reward.journey_title %></span>
                      </div>
                      <h3 style="font-size: 15px; font-weight: 600; color: #64748b;"><%= reward.title || reward.step_title %></h3>
                      <% if (reward.archived_at) { %>
                        <p style="font-size: 11px; color: #94a3b8; margin-top: 4px;">
                          <%= t('analytics.rewards.archivedOn') %> <%= new Date(reward.archived_at).toLocaleDateString(language) %>
                          <% if (rewardIsRestorable) { %>
                            <span style="color: #166534;">• <%= t('analytics.rewards.willRestoreWith') %></span>
                          <% } %>
                        </p>
                      <% } %>
                    </div>
                    <div class="reward-body" style="padding: 16px;">
                      <div style="display: flex; gap: 24px; margin-bottom: 12px;">
                        <div>
                          <p style="font-size: 20px; font-weight: 700; color: #64748b;"><%= reward.claimed_count %></p>
                          <p style="font-size: 11px; color: #94a3b8;"><%= t('analytics.rewards.totalClaimed') %></p>
                        </div>
                        <% if (reward.valid_until) { %>
                          <div>
                            <p style="font-size: 11px; color: #94a3b8;"><%= t('analytics.rewards.wasValidUntil') %></p>
                            <p style="font-size: 13px; color: #64748b;"><%= new Date(reward.valid_until).toLocaleDateString(language) %></p>
                          </div>
                        <% } %>
                      </div>
                      
                      <div style="display: flex; gap: 8px;">
                        <button class="btn-view-codes" data-reward-id="<%= reward.id %>" style="padding: 6px 12px; background: #e2e8f0; color: #64748b; border: none; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                          <svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                          </svg>
                          <%= t('analytics.rewards.viewCodes') %>
                        </button>
                        <button class="btn-download-codes" data-reward-id="<%= reward.id %>" data-reward-title="<%= reward.title || '' %>" style="padding: 6px 12px; background: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                          <svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                          </svg>
                          <%= t('analytics.rewards.downloadPDF') %>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div><!-- End Tab Panel: Rewards -->
      
