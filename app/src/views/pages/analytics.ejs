        html += `
          <div class="detail-section">
            <div class="detail-section-title">🤖 <%= t("analytics.replay.aiGuide") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.ai_chat.total_messages}</div>
                <div class="detail-item-label"><%= t("analytics.replay.messages") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${formatDuration(step.ai_chat.total_duration_ms)}</div>
                <div class="detail-item-label"><%= t("analytics.replay.chatTime") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      // Video details
      if (step.video) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title">🎬 <%= t("analytics.replay.videoEngagement") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.video.watch_percentage || 0}%</div>
                <div class="detail-item-label"><%= t("analytics.replay.watched") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${step.video.watch_time_sec || 0}s</div>
                <div class="detail-item-label"><%= t("analytics.replay.watchTime") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${step.video.completed ? '✓' : '-'}</div>
                <div class="detail-item-label"><%= t("analytics.replay.completed") %></div>
              </div>
            </div>
          </div>
