    // Load Journey Funnel Data
    async function loadJourneyFunnel() {
      const journeyId = document.getElementById('journeySelector')?.value;
      const days = getPeriodDays();
      console.log('[Analytics] Loading journey funnel for:', journeyId, 'days:', days);
      
      const contentEl = document.getElementById('journeyAnalyticsContent');
      const emptyEl = document.getElementById('journeyEmptyState');
      
      if (!journeyId) {
        console.log('[Analytics] No journey selected');
        contentEl.style.display = 'none';
        emptyEl.style.display = 'block';
        return;
      }
      
      contentEl.style.display = 'block';
      emptyEl.style.display = 'none';
      
      try {
        const res = await fetch(withDeleted(`/api/analytics/journey-funnel/${journeyId}?days=${days}&tz=${VIEWER_TZ}`));
        const data = await res.json();
        console.log('[Analytics] Journey funnel response:', data);
        
        if (data.success) {
          // Update KPIs
          document.getElementById('journeyKpiStarted').textContent = data.overall.started;
          document.getElementById('journeyKpiCompleted').textContent = data.overall.completed;
          document.getElementById('journeyKpiRate').textContent = data.overall.completion_rate + '%';
          document.getElementById('journeyKpiContext').textContent = data.overall.started > 0
            ? fillText(T_CHART.completedOf, { completed: data.overall.completed, started: data.overall.started })
            : '';
          document.getElementById('funnelSentence').textContent = data.overall.started > 0
            ? fillText(T_CHART.funnelSentence, { started: data.overall.started, completed: data.overall.completed })
            : '';
          
          // Render funnel
          renderFunnel(data.funnel, data.overall.started);
          
          // Render step heatmap
          renderStepHeatmap(data.funnel);
          
          // Update daily trend chart
          updateJourneyTrendChart(data.daily_trend || []);
        }
      } catch (err) {
        console.error('Failed to load journey funnel:', err);
      }
    }
    
    // How far participants get, in the order of the journey. The share is
    // of the participants who started. Routes after a choice are indented
    // under a short note, so a route with fewer people is not read as a drop.
    function renderFunnel(funnel, totalStarted) {
      const container = document.getElementById('funnelContainer');
      if (!container) return;
      if (funnel.length === 0) {
        container.innerHTML = '<p class="text-center text-gray-500"><%= t("analytics.journeys.noStepData") %></p>';
        return;
      }
      const base = totalStarted > 0 ? totalStarted : Math.max(...funnel.map(s => s.users_reached), 1);
      let html = '';
      funnel.forEach((step, i) => {
        const share = Math.min(100, Math.round((step.users_reached / base) * 100));
        if (step.is_route && !funnel[i - 1]?.is_route) {
          html += `<div class="funnel-note">${escapeHtml(T_CHART.branchNote)}</div>`;
        }
        html += `
          <div class="funnel-row${step.is_route ? ' is-route' : ''}">
            <div class="funnel-name">${escapeHtml(step.step_title)}${deletedBadge(step.step_deleted)}</div>
            <div class="funnel-track" aria-hidden="true"><span style="width: ${share}%"></span></div>
            <div class="funnel-count"><strong>${step.users_reached}</strong> <span>${share}%</span></div>
          </div>
        `;
      });
      container.innerHTML = html;
    }
    
    // Per step: reached, completed, time, and how many stopped there. Only a
    // step where a real share of people stopped is marked.
    function renderStepHeatmap(funnel) {
      const tbody = document.getElementById('stepHeatmapBody');
      if (!tbody) return;
      
      if (funnel.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="loading-cell"><%= t("analytics.journeys.noStepData") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = funnel.map(step => {
        const stopped = step.drop_off_count ?? Math.max(0, step.users_reached - step.users_completed);
        const notable = stopped > 0 && step.drop_off_rate >= 20;
        return `
          <tr>
            <td><strong>${escapeHtml(step.step_title)}</strong>${deletedBadge(step.step_deleted)}</td>
            <td><span class="step-kind">${escapeHtml(stepTypeName(step.step_type))}</span></td>
            <td>${step.users_reached}</td>
            <td>${step.users_completed}</td>
            <td>${formatDuration(step.avg_duration_ms)}</td>
            <td>${notable ? `<span class="stopped-notable">${stopped}</span>` : stopped}</td>
          </tr>
        `;
      }).join('');
    }
    
    function updateJourneyTrendChart(dailyTrend) {
      const ctx = document.getElementById('journeyTrendChart');
      if (!ctx) return;
      journeyTrendChart = drawActivityChart(ctx, journeyTrendChart, activityBuckets(dailyTrend, getPeriodDays()));
    }
    
    // Users Overview
    function debounceUserSearch() {
      clearTimeout(userSearchTimeout);
      userSearchTimeout = setTimeout(() => {
        usersCurrentPage = 0;
        loadUsersOverview();
      }, 300);
    }
    
    async function loadUsersOverview() {
      const search = document.getElementById('userSearch')?.value || '';
      const groupId = document.getElementById('userGroupFilter')?.value || '';
      const limit = 20;
      const offset = usersCurrentPage * limit;
      
      try {
        const params = new URLSearchParams({ limit, offset });
        if (search) params.append('search', search);
        if (groupId) params.append('group_id', groupId);
        
        const res = await fetch(withDeleted(`/api/analytics/users-overview?${params}`));
        const data = await res.json();
        
        if (data.success) {
          renderUsersTable(data.users);
          renderUsersPagination(data.total, limit);
          
          // Populate group filter if not already done
          const groupFilter = document.getElementById('userGroupFilter');
          if (groupFilter && groupFilter.options.length <= 1 && data.groups) {
            data.groups.forEach(g => {
              const opt = document.createElement('option');
              opt.value = g.id;
              opt.textContent = `${g.name} (${g.member_count})`;
              groupFilter.appendChild(opt);
            });
          }
        }
      } catch (err) {
        console.error('Failed to load users overview:', err);
      }
    }
    
    function renderUsersTable(users) {
      const tbody = document.getElementById('usersTableBody');
      if (!tbody) return;
      
      if (users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="loading-cell"><%= t("analytics.users.noUsers") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = users.map(u => {
        const groups = u.groups || [];
        const groupsHtml = groups.length > 0 
          ? groups.map(g => `<span class="group-tag">${escapeHtml(g.name)}</span>`).join(' ')
          : '-';
        
        // The whole row opens the participant; the name is the button for
        // keyboard and screen reader users. Replays are in that window.
        const name = u.name || u.email || '-';
        return `
        <tr class="row-link" data-user-id="${u.id}" data-user-name="${escapeHtml(u.name || u.email)}">
          <td>
            <div style="display: flex; align-items: center; gap: 10px;">
              <div class="user-avatar" style="width: 32px; height: 32px; font-size: 12px;" aria-hidden="true">${escapeHtml((u.name || u.email || '?')[0].toUpperCase())}</div>
              <div>
                <button type="button" class="row-link-btn" data-action="view-user" data-user-id="${u.id}" data-user-name="${escapeHtml(u.name || u.email)}" aria-label="${escapeHtml(fillText(T_USERS.openDetails, { name }))}">${escapeHtml(u.name || '-')}</button>
                <div style="font-size: 12px; color: #5b6b80;">${escapeHtml(u.email || '-')}</div>
              </div>
            </div>
