    // Preview User/Group Progress Report
    async function previewUserGroupReport() {
      const id = document.getElementById('selectedUserGroupId').value;
      const type = document.getElementById('selectedUserGroupType').value;
      const name = document.getElementById('selectedUserGroupName').textContent;
      
      if (!id || !type) return;
      
      currentReportType = type === 'user' ? 'userProgress' : 'groupProgress';
      showReportModal(name);
      
      try {
        const endpoint = type === 'user' 
          ? `/api/analytics/user/${id}`
          : `/api/analytics/group/${id}`;
        
        const response = await fetch(endpoint);
        const data = await response.json();
        
        if (data.success) {
          currentReportData = { ...data, id, type, name };
          renderUserGroupReport(data, type, name);
        } else {
          showReportError(data.error);
        }
      } catch (err) {
        console.error('Failed to load report:', err);
        showReportError(err.message);
      }
    }
    
