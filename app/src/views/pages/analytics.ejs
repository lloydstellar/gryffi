    // ============================================
    // TAB FUNCTIONALITY
    // ============================================
    
    function initTabs() {
      const tabs = document.querySelectorAll('.analytics-tab');
      const panels = document.querySelectorAll('.analytics-tab-panel');
      
      // Handle tab clicks
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const tabId = tab.dataset.tab;
          switchToTab(tabId);
          // Update URL hash without scrolling
          history.replaceState(null, null, '#' + tabId);
        });
      });
      
      // Check for hash on page load
      const hash = window.location.hash.slice(1);
      if (hash) {
        // Map hash names to tab names
        const hashToTab = {
          'overview': 'overview',
          'journeys': 'journeys',
          'users': 'users',
          'groups': 'groups',
          'polls': 'polls',
          'rewards': 'rewards',
          'forms': 'forms',
          'reports': 'reports'
        };
        const targetTab = hashToTab[hash] || hash;
        if (document.querySelector(`[data-tab="${targetTab}"]`)) {
          switchToTab(targetTab);
        }
      }
    }
    
    function switchToTab(tabId) {
      const tabs = document.querySelectorAll('.analytics-tab');
      const panels = document.querySelectorAll('.analytics-tab-panel');
      
      // Update tab buttons
      tabs.forEach(t => {
        t.classList.toggle('active', t.dataset.tab === tabId);
      });
      
      // Update panels
      panels.forEach(p => {
        p.classList.toggle('active', p.id === 'tab-' + tabId);
      });
    }
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
      // Load theme first so PDF colors are ready
      await loadActiveTheme();
      
      initTabs();
      loadJourneysList();
      loadUsersAndGroups();
      
      // Load analytics data for new tabs
      loadOverviewData();
      loadUsersOverview();
      loadGroupsOverview();
      loadFormSubmissions();
      
      // Journey select change handler
      document.getElementById('journeyReportSelect').addEventListener('change', (e) => {
        const hasValue = e.target.value !== '';
        document.getElementById('btnPreviewJourney').disabled = !hasValue;
        document.getElementById('btnDownloadJourney').disabled = !hasValue;
      });
      
      // Button event listeners (CSP compliant - no inline handlers)
      document.getElementById('btnPreviewJourney').addEventListener('click', previewJourneyReport);
      document.getElementById('btnDownloadJourney').addEventListener('click', downloadJourneyReport);
      document.getElementById('btnPreviewOverview').addEventListener('click', previewOverviewReport);
      document.getElementById('btnDownloadOverview').addEventListener('click', downloadOverviewReport);
      document.getElementById('btnPreviewUser')?.addEventListener('click', previewUserGroupReport);
      document.getElementById('btnDownloadUser')?.addEventListener('click', downloadUserGroupReport);
      document.getElementById('btnPreviewEngagement')?.addEventListener('click', previewEngagementReport);
      document.getElementById('btnDownloadEngagement')?.addEventListener('click', downloadEngagementReport);
      document.getElementById('btnCloseModalX').addEventListener('click', closeReportModal);
      document.getElementById('btnCloseModal').addEventListener('click', closeReportModal);
      document.getElementById('btnModalDownload').addEventListener('click', downloadCurrentReport);
      
      // User/Group search handlers
      const userGroupSearch = document.getElementById('userGroupSearch');
      const userGroupSearchResults = document.getElementById('userGroupSearchResults');
      
      if (userGroupSearch) {
        let searchTimeout;
        userGroupSearch.addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          const query = e.target.value;
          
          if (query.length < 2) {
            userGroupSearchResults.style.display = 'none';
            return;
          }
          
          searchTimeout = setTimeout(() => {
            const results = searchUsersAndGroups(query);
            renderSearchResults(results);
          }, 150);
        });
        
        userGroupSearch.addEventListener('focus', (e) => {
          if (e.target.value.length >= 2) {
            const results = searchUsersAndGroups(e.target.value);
            renderSearchResults(results);
          }
        });
      }
      
      // Search results click handler
      if (userGroupSearchResults) {
        userGroupSearchResults.addEventListener('click', (e) => {
          const item = e.target.closest('.search-result-item');
          if (item) {
            selectUserGroup(item.dataset.id, item.dataset.type, item.dataset.name);
          }
        });
      }
      
      // Clear selection button
      document.getElementById('clearUserGroupSelection')?.addEventListener('click', clearUserGroupSelection);
      
      // Close search results on click outside
      document.addEventListener('click', (e) => {
        if (userGroupSearchResults && !e.target.closest('.report-search-container')) {
          userGroupSearchResults.style.display = 'none';
        }
      });
      
      // Close modal on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeReportModal();
      });
      
      // Close modal on backdrop click
      document.getElementById('reportModal').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeReportModal();
      });
      
      // Select change event listeners (CSP compliant)
      document.getElementById('overviewDateRange')?.addEventListener('change', loadOverviewData);
      document.getElementById('journeySelector')?.addEventListener('change', () => {
        loadJourneyFunnel();
        const hasJourney = document.getElementById('journeySelector').value !== '';
        document.getElementById('btnExportJourneyPdf').disabled = !hasJourney;
      });
      document.getElementById('journeyDateRange')?.addEventListener('change', loadJourneyFunnel);
      document.getElementById('userGroupFilter')?.addEventListener('change', loadUsersOverview);
      document.getElementById('groupsDateRange')?.addEventListener('change', loadGroupsOverview);
      document.getElementById('compareGroup1')?.addEventListener('change', updateGroupComparison);
      document.getElementById('compareGroup2')?.addEventListener('change', updateGroupComparison);
      
      // User search input (CSP compliant - no inline onkeyup)
      document.getElementById('userSearch')?.addEventListener('keyup', debounceUserSearch);
      
      // Export PDF buttons
      document.getElementById('btnExportJourneyPdf')?.addEventListener('click', exportCurrentJourneyPdf);
      document.getElementById('btnExportUserPdf')?.addEventListener('click', exportCurrentUserPdf);
      
      // Modal close buttons
      document.getElementById('closeUserDetailBtn')?.addEventListener('click', closeUserDetail);
      document.getElementById('closeGroupDetailBtn')?.addEventListener('click', closeGroupDetail);
      document.getElementById('closeJourneyReplayBtn')?.addEventListener('click', closeJourneyReplay);
      
      // Event delegation for select change (replay dropdown only - other
      // selects share the .replay-select class purely for styling)
      document.addEventListener('change', (e) => {
        const select = e.target.closest('.replay-select[data-action="replay-select"]');
        if (!select || !select.value) return;
        
        const userId = select.dataset.userId;
        const journeyId = select.value;
        const selectedOption = select.options[select.selectedIndex];
        const journeyTitle = selectedOption.dataset.title || '';
        
        viewJourneyReplay(userId, journeyId, journeyTitle);
        select.value = ''; // Reset selection
      });
      
      // Event delegation for dynamic content
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;
        
        const action = btn.dataset.action;
        
        switch(action) {
          case 'view-journey':
            viewJourneyAnalytics(btn.dataset.journeyId);
            break;
          case 'view-user':
            viewUserDetail(btn.dataset.userId, btn.dataset.userName);
            break;
          case 'view-group':
            viewGroupDetail(btn.dataset.groupId, btn.dataset.groupName);
            break;
          case 'view-journey-replay':
            if (currentDetailUserId) {
              viewJourneyReplay(currentDetailUserId, btn.dataset.journeyId, btn.dataset.journeyTitle);
            }
            break;
          case 'view-replay-direct':
            viewJourneyReplay(btn.dataset.userId, btn.dataset.journeyId, btn.dataset.journeyTitle);
            break;
          case 'toggle-step':
            toggleStepDetails(parseInt(btn.dataset.stepIdx, 10));
            break;
          case 'page-prev':
            if (usersCurrentPage > 0) {
              usersCurrentPage--;
              loadUsersOverview();
            }
            break;
          case 'page-next':
            usersCurrentPage++;
            loadUsersOverview();
            break;
          case 'page-goto':
            usersCurrentPage = parseInt(btn.dataset.page, 10);
            loadUsersOverview();
            break;
        }
      });
      
      // Archived polls bulk delete functionality
      initArchivedPollsHandlers();
    });
    
    // Initialize archived polls handlers
    function initArchivedPollsHandlers() {
      const selectAllCheckbox = document.getElementById('selectAllArchivedPolls');
      const deleteButton = document.getElementById('deleteSelectedPolls');
      const pollCheckboxes = document.querySelectorAll('.archived-poll-checkbox');
      
      if (!selectAllCheckbox || !deleteButton || pollCheckboxes.length === 0) return;
      
      // Update delete button visibility
      function updateDeleteButton() {
        const checkedCount = document.querySelectorAll('.archived-poll-checkbox:checked').length;
        deleteButton.style.display = checkedCount > 0 ? 'flex' : 'none';
      }
      
      // Select all checkbox
      selectAllCheckbox.addEventListener('change', (e) => {
        pollCheckboxes.forEach(cb => cb.checked = e.target.checked);
        updateDeleteButton();
      });
      
      // Individual checkboxes
      pollCheckboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const allChecked = document.querySelectorAll('.archived-poll-checkbox').length === 
                            document.querySelectorAll('.archived-poll-checkbox:checked').length;
          selectAllCheckbox.checked = allChecked;
          updateDeleteButton();
        });
      });
      
      // Delete button
      deleteButton.addEventListener('click', async () => {
        const selectedIds = Array.from(document.querySelectorAll('.archived-poll-checkbox:checked'))
          .map(cb => cb.dataset.pollId);
        
        if (selectedIds.length === 0) return;
        
        const confirmMsg = <%-safeJson(t("analytics.polls.deleteConfirm"))%>.replace('{{count}}', selectedIds.length);
        if (!(await window.gryffi.modal.confirm(confirmMsg))) return;
        
        try {
          const response = await fetch('/api/analytics/polls/archived', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pollIds: selectedIds })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Remove deleted cards from DOM
            selectedIds.forEach(id => {
              document.querySelector(`.archived-poll-card[data-poll-id="${id}"]`)?.remove();
            });
            
            // Reset checkboxes
            selectAllCheckbox.checked = false;
            updateDeleteButton();
            
            // Hide section if no more archived polls
            const remainingCards = document.querySelectorAll('.archived-poll-card').length;
            if (remainingCards === 0) {
              document.querySelector('.archived-polls-section')?.remove();
            }
            
            window.gryffi?.toast?.success(<%-safeJson(t("analytics.polls.deleteSuccess"))%>);
          } else {
            await window.gryffi.modal.alert(data.error || <%-safeJson(t("analytics.polls.deleteError"))%>, { type: 'error' });
          }
        } catch (err) {
          console.error('Delete archived polls error:', err);
          await window.gryffi.modal.alert(<%-safeJson(t("analytics.polls.deleteError"))%>, { type: 'error' });
        }
      });
    }
    
