    function renderJourneyReplay(data) {
      const { user, journey, summary, timeline } = data;
      
      const stepTypeIcons = {
        content: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>',
        challenge: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        quiz: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>',
        form: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>',
        video: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
        guide: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>',
        poll: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
        reward: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>',
        space: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>',
        nested_journey: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 10v2a2 2 0 002 2h2m6-4v-2a2 2 0 00-2-2h-2"></path></svg>',
        default: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>'
      };
      
      let html = `
        <div class="journey-replay-header">
          <div class="journey-replay-title">
            <h3>${escapeHtml(journey.title)}</h3>
            <p>${escapeHtml(user.name)} • ${escapeHtml(user.email)}</p>
          </div>
          <div class="journey-replay-summary">
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.total_steps}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.steps") %></div>
            </div>
            <div class="replay-stat">
              <div class="replay-stat-value">${formatDuration(summary.total_duration_ms)}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.totalTime") %></div>
            </div>
            ${summary.quiz_attempts > 0 ? `
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.quiz_attempts}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.quizzes") %></div>
            </div>` : ''}
            ${summary.chat_sessions > 0 ? `
            <div class="replay-stat">
              <div class="replay-stat-value">${summary.chat_sessions}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.chats") %></div>
            </div>` : ''}
            <div class="replay-stat">
              <div class="replay-stat-value replay-stat-text">${summary.is_completed ? <%-safeJson(t("analytics.replay.statusCompleted"))%> : <%-safeJson(t("analytics.replay.statusNotCompleted"))%>}</div>
              <div class="replay-stat-label"><%= t("analytics.replay.status") %></div>
            </div>
          </div>
        </div>
      `;
      
      if (timeline.length === 0) {
        html += '<p class="text-center text-gray-500" style="padding: 40px;"><%= t("analytics.replay.noData") %></p>';
      } else {
        html += '<div class="journey-timeline">';
        
        timeline.forEach((step, index) => {
          const icon = stepTypeIcons[step.step_type] || stepTypeIcons.default;
          const durationPercent = summary.max_step_duration_ms > 0 ? Math.round((step.duration_ms || 0) / summary.max_step_duration_ms * 100) : 0;
          const isCompleted = !!step.completed_at;
          
          // Build badges
          let badges = '';
          if (step.quiz) {
            const quizClass = step.quiz.passed ? 'quiz-pass' : 'quiz-fail';
            badges += `<span class="step-badge ${quizClass}">${step.quiz.passed ? '✓' : '✗'} ${Math.round(step.quiz.score_percentage || 0)}%</span>`;
          }
          if (step.ai_chat && step.ai_chat.total_messages > 0) {
            badges += `<span class="step-badge chat"><svg style="width:12px;height:12px;margin-right:3px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>${step.ai_chat.total_messages}</span>`;
          }
          if (step.video) {
            badges += `<span class="step-badge video"><svg style="width:12px;height:12px;margin-right:3px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>${step.video.watch_percentage || 0}%</span>`;
          }
          if (step.form && step.form.submitted) {
            badges += `<span class="step-badge form">✓ <%= t("analytics.replay.submitted") %></span>`;
          }
          if (step.poll && step.poll.voted) {
            badges += `<span class="step-badge poll">✓ <%= t("analytics.replay.voted") %></span>`;
          }
          
          html += `
            <div class="timeline-step ${isCompleted ? 'completed' : ''}" data-step-index="${index}">
              <div class="step-header" data-action="toggle-step" data-step-idx="${index}">
                <div class="step-info">
                  <div class="step-type-icon ${escapeHtml(step.step_type)}">${icon}</div>
                  <div class="step-title-area">
                    <h4>${escapeHtml(step.step_title || 'Step ' + (index + 1))}${deletedBadge(step.step_deleted)}</h4>
                    <span>${escapeHtml(stepTypeName(step.step_type))} • ${formatTime(step.entered_at)}</span>
                  </div>
                </div>
                <div class="step-badges">${badges}</div>
                <div class="step-duration-bar">
                  <div class="duration-label">${formatDuration(step.duration_ms)}</div>
                  <div class="duration-bar-bg">
                    <div class="duration-bar-fill" style="width: ${durationPercent}%"></div>
                  </div>
                </div>
                <svg class="step-expand-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
              <div class="step-details">
                ${renderStepDetails(step)}
              </div>
            </div>
          `;
        });
        
        html += '</div>';
      }
      
      document.getElementById('journeyReplayContent').innerHTML = html;
    }
    
    function renderStepDetails(step) {
      let html = '';
      
      // Timing details
      html += `
        <div class="detail-section">
          <div class="detail-section-title">⏱️ <%= t("analytics.replay.timing") %></div>
          <div class="detail-grid">
            <div class="detail-item">
              <div class="detail-item-value">${formatTime(step.entered_at)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.started") %></div>
            </div>
            ${step.completed_at ? `
            <div class="detail-item">
              <div class="detail-item-value">${formatTime(step.completed_at)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.completed") %></div>
            </div>` : ''}
            <div class="detail-item">
              <div class="detail-item-value">${formatDuration(step.duration_ms)}</div>
              <div class="detail-item-label"><%= t("analytics.replay.duration") %></div>
            </div>
          </div>
        </div>
      `;
      
      // Quiz details
      if (step.quiz) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title"><%= t("analytics.replay.quizResults") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.quiz.correct_count}/${step.quiz.total_questions}</div>
                <div class="detail-item-label"><%= t("analytics.replay.correctAnswers") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${Math.round(step.quiz.score_percentage || 0)}%</div>
                <div class="detail-item-label"><%= t("analytics.replay.score") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value" style="color: ${step.quiz.passed ? '#10b981' : '#ef4444'}">${step.quiz.passed ? <%-safeJson(t("analytics.replay.passed"))%> : <%-safeJson(t("analytics.replay.failed"))%>}</div>
                <div class="detail-item-label"><%= t("analytics.replay.result") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${formatDuration(step.quiz.duration_ms)}</div>
                <div class="detail-item-label"><%= t("analytics.replay.quizTime") %></div>
              </div>
            </div>
            ${step.quiz.question_results && step.quiz.question_results.length > 0 ? `
            <div class="quiz-questions">
              ${step.quiz.question_results.map((q, i) => `
                <div class="quiz-question-item ${q.correct ? 'correct' : 'incorrect'}">
                  <span class="quiz-question-icon">${q.correct ? '✓' : '✗'}</span>
                  <span><%= t("analytics.replay.question") %> ${i + 1}</span>
                </div>
              `).join('')}
            </div>` : ''}
          </div>
        `;
      }
      
      // AI Chat details
      if (step.ai_chat && step.ai_chat.total_messages > 0) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title"><%= t("analytics.replay.aiGuide") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.ai_chat.total_messages}</div>
                <div class="detail-item-label"><%= t("analytics.replay.messages") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${formatDuration(step.ai_chat.total_duration_ms)}</div>
                <div class="detail-item-label"><%= t("analytics.replay.chatTime") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      // Video details
      if (step.video) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title"><%= t("analytics.replay.videoEngagement") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.video.watch_percentage || 0}%</div>
                <div class="detail-item-label"><%= t("analytics.replay.watched") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${step.video.watch_time_sec || 0}s</div>
                <div class="detail-item-label"><%= t("analytics.replay.watchTime") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${step.video.completed ? '✓' : '-'}</div>
                <div class="detail-item-label"><%= t("analytics.replay.completed") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      // Form details
      if (step.form) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title"><%= t("analytics.replay.formSubmission") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">${step.form.fields_filled}/${step.form.total_fields}</div>
                <div class="detail-item-label"><%= t("analytics.replay.fieldsFilled") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value">${formatDuration(step.form.completion_time_ms)}</div>
                <div class="detail-item-label"><%= t("analytics.replay.fillTime") %></div>
              </div>
              <div class="detail-item">
                <div class="detail-item-value" style="color: ${step.form.submitted ? '#10b981' : '#5b6b80'}">${step.form.submitted ? <%-safeJson(t("analytics.replay.submitted"))%> : <%-safeJson(t("analytics.replay.notSubmitted"))%>}</div>
                <div class="detail-item-label"><%= t("analytics.replay.status") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      // Poll details
      if (step.poll && step.poll.voted) {
        html += `
          <div class="detail-section">
            <div class="detail-section-title"><%= t("analytics.replay.pollVote") %></div>
            <div class="detail-grid">
              <div class="detail-item">
                <div class="detail-item-value">✓</div>
                <div class="detail-item-label"><%= t("analytics.replay.voted") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      return html || '<p style="padding: 12px; color: #5b6b80; font-size: 13px;"><%= t("analytics.replay.noAdditionalData") %></p>';
    }
    
    function toggleStepDetails(index) {
      const step = document.querySelector(`.timeline-step[data-step-index="${index}"]`);
      if (step) {
        step.classList.toggle('expanded');
      }
    }
    
    function formatTime(dateStr) {
      if (!dateStr) return '-';
      const date = new Date(dateStr);
      return date.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' });
    }
    
    function closeJourneyReplay() {
      document.getElementById('journeyReplayModal').style.display = 'none';
    }
    
    // Groups Overview
    async function loadGroupsOverview() {
      const days = getPeriodDays();
      
      try {
        const res = await fetch(withDeleted(`/api/analytics/groups-overview?days=${days}`));
        const data = await res.json();
        
        if (data.success) {
          groupsData = data.groups;
          
          // Groups, with the whole organization as the last row
          renderGroupsTable(data.groups, data.org_benchmarks);
        }
      } catch (err) {
        console.error('Failed to load groups overview:', err);
      }
    }
    
    function renderGroupsTable(groups, benchmarks) {
      const tbody = document.getElementById('groupsTableBody');
      if (!tbody) return;
      
      if (groups.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="loading-cell"><%= t("analytics.groups.noGroups") %></td></tr>';
        return;
      }
      
      tbody.innerHTML = groups.map(g => {
        const quizDiff = g.avg_quiz_score !== null && benchmarks.avg_quiz_score !== null 
          ? g.avg_quiz_score - benchmarks.avg_quiz_score : null;
        const benchmarkClass = quizDiff === null || quizDiff === 0 ? '' : quizDiff > 0 ? 'badge-success' : 'badge-danger';
        // A group where nobody started yet has no rate: no red "0%"
        const rateCell = g.active_users > 0
          ? `<span class="badge ${g.completion_rate >= 70 ? 'badge-success' : g.completion_rate >= 40 ? 'badge-warning' : 'badge-danger'}">${g.completion_rate}%</span>`
          : '-';
        const benchmarkText = quizDiff === null ? '-' : (quizDiff >= 0 ? '+' : '') + quizDiff + '%';
        
        return `
          <tr>
            <td><strong>${escapeHtml(g.name)}</strong></td>
            <td>${g.member_count}</td>
            <td>${g.active_users}</td>
            <td>${rateCell}</td>
            <td>${g.avg_quiz_score !== null ? g.avg_quiz_score + '%' : '-'}</td>
            <td><span class="badge ${benchmarkClass}">${benchmarkText}</span></td>
            <td>
              <button class="table-action-btn" data-action="view-group" data-group-id="${g.id}" data-group-name="${escapeHtml(g.name)}">
                <%= t("analytics.actions.viewDetails") %>
              </button>
            </td>
          </tr>
        `;
      }).join('') + orgRow(benchmarks);
    }
    
    // The whole organization as the last row: the measure for "vs Benchmark"
    function orgRow(org) {
      if (!org) return '';
      return `
        <tr class="org-row">
          <td><%= t("analytics.groups.wholeOrganization") %></td>
          <td>${org.member_count ?? '-'}</td>
          <td>${org.active_users ?? '-'}</td>
          <td>${org.active_users > 0 && org.completion_rate !== null ? org.completion_rate + '%' : '-'}</td>
          <td>${org.avg_quiz_score !== null && org.avg_quiz_score !== undefined ? org.avg_quiz_score + '%' : '-'}</td>
          <td></td>
          <td></td>
        </tr>
      `;
    }
    
    let currentDetailGroup = null;
    
    async function viewGroupDetail(groupId, groupName) {
      // The PDF of this window uses the period the window shows
      const days = getPeriodDays();
      currentDetailGroup = { id: groupId, name: groupName, days, periodLabel: getPeriodLabel() };
      document.getElementById('groupDetailName').textContent = groupName;
      document.getElementById('groupDetailModal').style.display = 'flex';
      document.getElementById('groupDetailContent').innerHTML = '<div class="loading-spinner"></div>';
      
      try {
        const res = await fetch(withDeleted(`/api/analytics/group/${groupId}?days=${days}`));
        const data = await res.json();
        
        if (data.success) {
          renderGroupDetail(data);
        } else {
          document.getElementById('groupDetailContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.groups.loadError") %></p>';
        }
      } catch (err) {
        console.error('Failed to load group detail:', err);
        document.getElementById('groupDetailContent').innerHTML = '<p class="text-center text-red-500"><%= t("analytics.groups.loadError") %></p>';
      }
    }
    
    function renderGroupDetail(data) {
      const group = data.group;
      const analytics = data.analytics;
      
      let html = `
        <div style="margin-bottom: 20px;">
          <h4 style="font-size: 16px; font-weight: 600; margin: 0 0 4px;">${escapeHtml(group.name)}</h4>
          <p style="color: #5b6b80; font-size: 14px; margin: 0;">${group.total_users} <%= t("analytics.groups.members") %></p>
        </div>
      `;
      
      // Summary stats
      html += `
        <div class="kpi-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom: 20px;">
          <div class="kpi-card" style="padding: 16px;">
            <div class="kpi-content">
              <span class="kpi-value" style="font-size: 24px;">${analytics.summary.active_users || 0}</span>
              <span class="kpi-label"><%= t("analytics.groups.activeUsers") %></span>
            </div>
          </div>
          <div class="kpi-card" style="padding: 16px;">
            <div class="kpi-content">
              <span class="kpi-value" style="font-size: 24px;">${analytics.summary.journeys_completed || 0}</span>
              <span class="kpi-label"><%= t("analytics.groups.journeysCompleted") %></span>
            </div>
          </div>
        </div>
      `;
      
      // Quiz stats
      if (analytics.quiz_stats) {
        html += `
          <div style="background: #f9fafb; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
            <h5 style="font-size: 13px; font-weight: 600; margin: 0 0 12px; text-transform: none; color: #5b6b80;">
              <%= t("analytics.groups.quizStats") %>
            </h5>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: center;">
              <div>
                <div style="font-size: 20px; font-weight: 600; color: #0f172a;">${analytics.quiz_stats.avg_score ? Math.round(analytics.quiz_stats.avg_score) + '%' : '-'}</div>
                <div style="font-size: 12px; color: #5b6b80;"><%= t("analytics.groups.avgScore") %></div>
              </div>
              <div>
                <div style="font-size: 20px; font-weight: 600; color: #0f172a;">${analytics.quiz_stats.pass_rate ? Math.round(analytics.quiz_stats.pass_rate) + '%' : '-'}</div>
                <div style="font-size: 12px; color: #5b6b80;"><%= t("analytics.groups.passRate") %></div>
              </div>
              <div>
                <div style="font-size: 20px; font-weight: 600; color: #0f172a;">${analytics.quiz_stats.total_attempts || 0}</div>
                <div style="font-size: 12px; color: #5b6b80;"><%= t("analytics.groups.totalAttempts") %></div>
              </div>
            </div>
          </div>
        `;
      }
      
      // Leaderboard
      if (analytics.user_leaderboard && analytics.user_leaderboard.length > 0) {
        html += `<h5 style="font-size: 13px; font-weight: 600; margin: 0 0 12px; text-transform: none; color: #5b6b80;"><%= t("analytics.groups.topPerformers") %></h5>`;
        html += '<table class="analytics-table" style="font-size: 13px;">';
        html += '<thead><tr><th>#</th><th><%= t("analytics.table.user") %></th><th><%= t("analytics.table.completed") %></th><th><%= t("analytics.table.lastActivity") %></th></tr></thead>';
        html += '<tbody>';
        analytics.user_leaderboard.slice(0, 10).forEach((u, i) => {
          html += `
            <tr>
              <td><strong>${i + 1}</strong></td>
              <td>${escapeHtml(u.name || u.email || '-')}</td>
              <td>${u.completions || 0}</td>
              <td>${formatRelativeDate(u.last_activity)}</td>
            </tr>
          `;
        });
        html += '</tbody></table>';
      }
      
      document.getElementById('groupDetailContent').innerHTML = html;
    }
    
    function closeGroupDetail() {
      document.getElementById('groupDetailModal').style.display = 'none';
    }
    
    // Utility function for HTML escaping
    // Also escapes quotes, so the result is safe inside attribute values
    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
    
    // ============================================
    // FORM SUBMISSIONS TAB (admin/manager only)
    // ============================================
    
    let allFormSubmissions = [];
    
    async function loadFormSubmissions() {
      const list = document.getElementById('formSubmissionsList');
      if (!list) return; // Tab not rendered (no permission)
      
      const loading = document.getElementById('formSubmissionsLoading');
      
      try {
        const res = await fetch(withDeleted('/api/analytics/form-submissions'));
        const data = await res.json();
        
        if (!data.success) {
          throw new Error(data.error || 'Failed to load form submissions');
        }
        
        loading.style.display = 'none';
        allFormSubmissions = data.submissions || [];
        
        // Show count badge on the tab
        if (allFormSubmissions.length > 0) {
          const countBadge = document.getElementById('formsTabCount');
          if (countBadge) {
            countBadge.textContent = allFormSubmissions.length;
            countBadge.hidden = false;
          }
        }
        
        // Populate journey filter (client-side, based on loaded data)
        const journeyFilter = document.getElementById('formsJourneyFilter');
        const journeyTitles = [...new Set(allFormSubmissions.map(s => s.journey_title).filter(Boolean))].sort();
        if (journeyFilter && journeyTitles.length > 1) {
          journeyTitles.forEach(title => {
            const opt = document.createElement('option');
            opt.value = title;
            opt.textContent = title;
            journeyFilter.appendChild(opt);
          });
          journeyFilter.style.display = '';
          journeyFilter.addEventListener('change', renderFormSubmissions);
        }
        
        // Populate submitter filter so all submissions from one person can be
        // viewed together. Keyed on email (stable), labelled with the name.
        const submitterFilter = document.getElementById('formsSubmitterFilter');
        const submitters = new Map();
        allFormSubmissions.forEach(s => {
          const key = formSubmitterKey(s);
          if (key && !submitters.has(key)) {
            submitters.set(key, formSubmitterLabel(s));
          }
        });
        if (submitterFilter && submitters.size > 1) {
          [...submitters.entries()]
            .sort((a, b) => a[1].localeCompare(b[1]))
            .forEach(([key, label]) => {
              const opt = document.createElement('option');
              opt.value = key;
              opt.textContent = label;
              submitterFilter.appendChild(opt);
            });
          submitterFilter.style.display = '';
          submitterFilter.addEventListener('change', renderFormSubmissions);
        }
        
        // Sort order (visible whenever there is something to sort)
        const sortOrder = document.getElementById('formsSortOrder');
        if (sortOrder && allFormSubmissions.length > 1) {
          sortOrder.style.display = '';
          sortOrder.addEventListener('change', renderFormSubmissions);
        }
        
        renderFormSubmissions();
      } catch (err) {
        console.error('Failed to load form submissions:', err);
        if (loading) loading.textContent = '<%= t("analytics.forms.loadError") %>';
      }
    }
    
    function formSubmitterKey(s) {
      return (s.submitter_email || s.submitter_name || '').toLowerCase();
    }
    
    function formSubmitterLabel(s) {
      const name = (s.submitter_name || '').trim();
      const email = (s.submitter_email || '').trim();
      if (name && email) return name + ' (' + email + ')';
      return name || email;
    }
    
    function renderFormSubmissions() {
      const list = document.getElementById('formSubmissionsList');
      const emptyState = document.getElementById('formSubmissionsEmpty');
      const noResults = document.getElementById('formSubmissionsNoResults');
      if (!list || !emptyState) return;
      
      if (allFormSubmissions.length === 0) {
        emptyState.style.display = '';
        if (noResults) noResults.style.display = 'none';
        list.innerHTML = '';
        return;
      }
      emptyState.style.display = 'none';
      
      const journeyValue = document.getElementById('formsJourneyFilter')?.value || '';
      const submitterValue = document.getElementById('formsSubmitterFilter')?.value || '';
      const sortValue = document.getElementById('formsSortOrder')?.value || 'date_desc';
      
      let submissions = allFormSubmissions.filter(s =>
        (!journeyValue || s.journey_title === journeyValue) &&
        (!submitterValue || formSubmitterKey(s) === submitterValue)
      );
      
      // Sort a copy; ties fall back to newest first so the order stays stable
      const byDateDesc = (a, b) => new Date(b.created_at) - new Date(a.created_at);
      submissions = [...submissions];
      switch (sortValue) {
        case 'date_asc':
          submissions.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
          break;
        case 'submitter':
          submissions.sort((a, b) =>
            formSubmitterLabel(a).localeCompare(formSubmitterLabel(b)) || byDateDesc(a, b));
          break;
        case 'form':
          submissions.sort((a, b) =>
            (a.step_title || '').localeCompare(b.step_title || '') ||
            (a.journey_title || '').localeCompare(b.journey_title || '') ||
            byDateDesc(a, b));
          break;
        default: // date_desc
          submissions.sort(byDateDesc);
      }
      
      if (noResults) noResults.style.display = submissions.length === 0 ? '' : 'none';
      // One table per form: a row per submission, a column per question
      const forms = new Map();
      submissions.forEach(sub => {
        const key = `${sub.journey_id || sub.journey_title || ''}|${sub.step_id || sub.step_title || ''}`;
        if (!forms.has(key)) forms.set(key, []);
        forms.get(key).push(sub);
      });
      list.innerHTML = Array.from(forms.values()).map(renderFormTable).join('');
    }
    
    // Raw yes/no radio values in the maker's language
    function formDisplayValue(value) {
      if (typeof value === 'string') {
        const lower = value.toLowerCase();
        if (lower === 'yes') return '<%= t("common.yes") %>';
        if (lower === 'no') return '<%= t("common.no") %>';
      }
      return value;
    }
    
    function renderFormTable(rows) {
      const first = rows[0];
      // Columns in the order of the form; labels the form no longer has
      // (an older version of the step) go last. File fields have their own column.
      const fields = rows.find(row => (row.fields || []).length > 0)?.fields || [];
      const fileLabels = new Set(fields.filter(f => f.type === 'file').map(f => f.label));
      const questions = fields.filter(f => f.type !== 'file' && f.label).map(f => f.label)
        .filter((label, index, all) => all.indexOf(label) === index);
      rows.forEach(row => Object.keys(row.responses || {}).forEach(label => {
        if (!questions.includes(label) && !fileLabels.has(label)) questions.push(label);
      }));
      const hasFiles = rows.some(row => (row.files || []).length > 0);
      const head = `
        <tr>
          <th><%= t("analytics.table.user") %></th>
          <th><%= t("analytics.forms.submittedAt") %></th>
          ${questions.map(q => `<th>${escapeHtml(q)}</th>`).join('')}
          ${hasFiles ? '<th><%= t("analytics.forms.uploadedFiles") %></th>' : ''}
        </tr>`;
      const body = rows.map(row => {
        const responses = row.responses || {};
        const name = (row.submitter_name || '').trim();
        const email = (row.submitter_email || '').trim();
        const files = (row.files || []).map(f => `
          <a class="form-table-file" href="/api/analytics/form-submissions/files/${f.id}/download">${escapeHtml(f.original_name)}</a>
          <span class="form-table-muted">${escapeHtml(f.size_label || '')}</span>`).join('<br>');
        return `
          <tr>
            <td class="form-table-who">
              <span>${escapeHtml(name || email || '-')}</span>
              ${name && email ? `<span class="form-table-muted">${escapeHtml(email)}</span>` : ''}
              ${row.source === 'public' ? '<span class="form-submission-badge public"><%= t("analytics.forms.public") %></span>' : ''}
            </td>
            <td class="form-table-date">
              ${row.created_at ? escapeHtml(new Date(row.created_at).toLocaleString(dateLocale, DATE_TIME_OPTS)) : '-'}
              ${row.email_sent ? '' : '<span class="form-table-warn"><%= t("analytics.forms.emailNotSent") %></span>'}
            </td>
            ${questions.map(q => {
              const value = responses[q];
              return `<td class="form-table-answer">${value ? escapeHtml(formDisplayValue(value)) : '<span class="form-table-muted"><%= t("analytics.forms.notAnswered") %></span>'}</td>`;
            }).join('')}
            ${hasFiles ? `<td>${files || '<span class="form-table-muted">-</span>'}</td>` : ''}
          </tr>`;
      }).join('');
      return `
        <section class="form-table-section">
          <header class="form-table-header">
            <span class="poll-journey-badge">${escapeHtml(first.journey_title || '-')}</span>
            <h3 class="form-submission-title">${escapeHtml(first.step_title || '<%= t("analytics.forms.untitledForm") %>')}${deletedBadge(first.is_deleted)}</h3>
          </header>
          <div class="table-responsive">
            <table class="analytics-table form-table">
              <thead>${head}</thead>
              <tbody>${body}</tbody>
            </table>
          </div>
        </section>`;
    }
    
    // ============================================
    // TAB FUNCTIONALITY
    // ============================================
    
    // The period of the whole page, in days ("all" is everything)
    function getPeriodDays() {
      const value = document.getElementById('periodSelect')?.value || '30';
      return value === 'all' ? 36500 : (parseInt(value, 10) || 30);
    }
    
    function getPeriodLabel() {
      const select = document.getElementById('periodSelect');
      return select ? select.options[select.selectedIndex].textContent.trim() : '';
    }
    
    let activeAnalyticsTab = 'overview';
    // Tabs whose figures follow the period, and tabs with a PDF of what they show
    const PERIOD_TABS = ['overview', 'journeys', 'groups'];
    const PDF_TABS = ['overview', 'journeys'];
    // Older links (#polls, #forms, #rewards, #reports) still land in the right place
    const OLD_TAB_HASHES = { polls: ['answers', 'polls'], forms: ['answers', 'forms'], rewards: ['answers', 'rewards'], reports: ['overview'] };
    
    function initTabs() {
      const tabs = Array.from(document.querySelectorAll('.analytics-tab'));
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          switchToTab(tab.dataset.tab);
          history.replaceState(null, '', '#' + tab.dataset.tab);
        });
        // Arrow keys move between the tabs (WAI-ARIA tabs pattern)
        tab.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(tab);
          let next = null;
          if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
          else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
          else if (e.key === 'Home') next = tabs[0];
          else if (e.key === 'End') next = tabs[tabs.length - 1];
          if (!next) return;
          e.preventDefault();
          next.focus();
          next.click();
        });
      });
      
      document.querySelectorAll('.answers-switch-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          switchAnswers(btn.dataset.answers);
          history.replaceState(null, '', '#' + btn.dataset.answers);
        });
      });
      
      const hash = window.location.hash.slice(1);
      if (OLD_TAB_HASHES[hash]) {
        switchToTab(OLD_TAB_HASHES[hash][0]);
        if (OLD_TAB_HASHES[hash][1]) switchAnswers(OLD_TAB_HASHES[hash][1]);
      } else if (hash && document.querySelector(`.analytics-tab[data-tab="${hash}"]`)) {
        switchToTab(hash);
      } else {
        updateToolbar();
      }
    }
    
    function switchToTab(tabId) {
      activeAnalyticsTab = tabId;
      document.querySelectorAll('.analytics-tab').forEach(t => {
        const on = t.dataset.tab === tabId;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      document.querySelectorAll('.analytics-tab-panel').forEach(p => {
        p.classList.toggle('active', p.id === 'tab-' + tabId);
      });
      updateToolbar();
    }
    
    function switchAnswers(kind) {
      document.querySelectorAll('.answers-switch-btn').forEach(btn => {
        const on = btn.dataset.answers === kind;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      document.querySelectorAll('.answers-panel').forEach(panel => {
        panel.hidden = panel.id !== 'answers-' + kind;
      });
    }
    
    // The period applies to some tabs; the others always show all results.
    // The PDF button shows on the tabs that make one report of what they show.
    function updateToolbar() {
      const usesPeriod = PERIOD_TABS.includes(activeAnalyticsTab);
      document.getElementById('periodSelect').hidden = !usesPeriod;
      document.querySelector('label[for="periodSelect"]').hidden = !usesPeriod;
      document.getElementById('periodAllTime').hidden = usesPeriod;
      const pdfButton = document.getElementById('btnTabPdf');
      pdfButton.hidden = !PDF_TABS.includes(activeAnalyticsTab);
      pdfButton.disabled = activeAnalyticsTab === 'journeys' && !document.getElementById('journeySelector').value;
    }
    
    function reloadPeriodData() {
      loadOverviewData();
      loadGroupsOverview();
      if (document.getElementById('journeySelector').value) loadJourneyFunnel();
    }
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
      // Load theme first so PDF colors are ready
      await loadActiveTheme();
      
      initTabs();
      
      // Load analytics data for new tabs
      loadOverviewData();
      loadUsersOverview();
      loadGroupsOverview();
      loadFormSubmissions();
      
      // The report window
      document.getElementById('btnCloseModalX').addEventListener('click', closeReportModal);
      document.getElementById('btnCloseModal').addEventListener('click', closeReportModal);
      document.getElementById('btnModalDownload').addEventListener('click', downloadCurrentReport);
      
      // Period, PDF and the PDF buttons in the participant and group windows
      document.getElementById('periodSelect').addEventListener('change', reloadPeriodData);
      document.getElementById('btnTabPdf').addEventListener('click', downloadTabPdf);
      document.getElementById('btnExportGroupPdf')?.addEventListener('click', exportCurrentGroupPdf);
      
      // Close modal on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeReportModal();
      });
      
      // Close modal on backdrop click
      document.getElementById('reportModal').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeReportModal();
      });
      
      document.getElementById('journeySelector')?.addEventListener('change', () => {
        loadJourneyFunnel();
        updateToolbar();
      });
      document.getElementById('userGroupFilter')?.addEventListener('change', loadUsersOverview);
      
      // User search input (CSP compliant - no inline onkeyup)
      document.getElementById('userSearch')?.addEventListener('keyup', debounceUserSearch);
      
      document.getElementById('btnExportUserPdf')?.addEventListener('click', exportCurrentUserPdf);
      
      // Modal close buttons
      document.getElementById('closeUserDetailBtn')?.addEventListener('click', closeUserDetail);
      document.getElementById('closeGroupDetailBtn')?.addEventListener('click', closeGroupDetail);
      document.getElementById('closeJourneyReplayBtn')?.addEventListener('click', closeJourneyReplay);
      
      // A click anywhere on a participant row opens that participant
      document.getElementById('usersTableBody')?.addEventListener('click', (e) => {
        if (e.target.closest('button, a, select, input')) return;
        const row = e.target.closest('tr.row-link');
        if (row) viewUserDetail(row.dataset.userId, row.dataset.userName);
      });
      
      // Event delegation for dynamic content
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;
        
        const action = btn.dataset.action;
        
        switch(action) {
          case 'view-journey':
            viewJourneyAnalytics(btn.dataset.journeyId);
            break;
          case 'view-user':
            viewUserDetail(btn.dataset.userId, btn.dataset.userName);
            break;
          case 'view-group':
            viewGroupDetail(btn.dataset.groupId, btn.dataset.groupName);
            break;
          case 'view-journey-replay':
            if (currentDetailUserId) {
              viewJourneyReplay(currentDetailUserId, btn.dataset.journeyId, btn.dataset.journeyTitle);
            }
            break;
          case 'toggle-step':
            toggleStepDetails(parseInt(btn.dataset.stepIdx, 10));
            break;
          case 'page-prev':
            if (usersCurrentPage > 0) {
              usersCurrentPage--;
              loadUsersOverview();
            }
            break;
          case 'page-next':
            usersCurrentPage++;
            loadUsersOverview();
            break;
          case 'page-goto':
            usersCurrentPage = parseInt(btn.dataset.page, 10);
            loadUsersOverview();
            break;
        }
      });
      
      // Archived polls bulk delete functionality
      initArchivedPollsHandlers();
    });
    
    // Initialize archived polls handlers
    function initArchivedPollsHandlers() {
      const selectAllCheckbox = document.getElementById('selectAllArchivedPolls');
      const deleteButton = document.getElementById('deleteSelectedPolls');
      const pollCheckboxes = document.querySelectorAll('.archived-poll-checkbox');
      
      if (!selectAllCheckbox || !deleteButton || pollCheckboxes.length === 0) return;
      
      // Update delete button visibility
      function updateDeleteButton() {
        const checkedCount = document.querySelectorAll('.archived-poll-checkbox:checked').length;
        deleteButton.style.display = checkedCount > 0 ? 'flex' : 'none';
      }
      
      // Select all checkbox
      selectAllCheckbox.addEventListener('change', (e) => {
        pollCheckboxes.forEach(cb => cb.checked = e.target.checked);
        updateDeleteButton();
      });
      
      // Individual checkboxes
      pollCheckboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const allChecked = document.querySelectorAll('.archived-poll-checkbox').length === 
                            document.querySelectorAll('.archived-poll-checkbox:checked').length;
          selectAllCheckbox.checked = allChecked;
          updateDeleteButton();
        });
      });
      
      // Delete button
      deleteButton.addEventListener('click', async () => {
        const selectedIds = Array.from(document.querySelectorAll('.archived-poll-checkbox:checked'))
          .map(cb => cb.dataset.pollId);
        
        if (selectedIds.length === 0) return;
        
        const confirmMsg = (selectedIds.length === 1
          ? <%-safeJson(t("analytics.polls.deleteConfirm_one"))%>
          : <%-safeJson(t("analytics.polls.deleteConfirm_other"))%>).replace('{{count}}', selectedIds.length);
        if (!(await window.gryffi.modal.confirm(confirmMsg))) return;
        
        try {
          const response = await fetch('/api/analytics/polls/archived', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pollIds: selectedIds })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Remove deleted cards from DOM
            selectedIds.forEach(id => {
              document.querySelector(`.archived-poll-card[data-poll-id="${id}"]`)?.remove();
            });
            
            // Reset checkboxes
            selectAllCheckbox.checked = false;
            updateDeleteButton();
            
            // Hide section if no more archived polls
            const remainingCards = document.querySelectorAll('.archived-poll-card').length;
            if (remainingCards === 0) {
              document.querySelector('.archived-polls-section')?.remove();
            }
            
            window.gryffi?.toast?.success(<%-safeJson(t("analytics.polls.deleteSuccess"))%>);
          } else {
            await window.gryffi.modal.alert(data.error || <%-safeJson(t("analytics.polls.deleteError"))%>, { type: 'error' });
          }
        } catch (err) {
          console.error('Delete archived polls error:', err);
          await window.gryffi.modal.alert(<%-safeJson(t("analytics.polls.deleteError"))%>, { type: 'error' });
        }
      });
    }
    
    // ============================================
    // PDF REPORTS
    // One "Download PDF" per tab for what the tab shows, and the window
    // shows that same PDF: what you see is what you download.
    // ============================================
    
    function formatDate(dateStr) {
      if (!dateStr) return '-';
      return new Date(dateStr).toLocaleDateString(dateLocale, { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      });
    }
    
    let currentReport = null; // { pdf, filename }
    let currentReportUrl = null;
    let reportModalOpener = null;
    // Each report gets a number: a slow report that finishes after the window
    // was closed or another report was asked for is thrown away
    let reportRequest = 0;
    
    async function openPdfReport(title, build) {
      const request = ++reportRequest;
      // Phones and browsers without a PDF viewer get the file straight away
      const canShow = navigator.pdfViewerEnabled !== false && window.matchMedia('(min-width: 768px)').matches;
      if (!canShow) {
        try {
          const result = await build();
          if (result) result.pdf.save(result.filename);
        } catch (err) {
          console.error('[Reports] Could not make the PDF:', err);
          window.gryffi?.toast?.show(translations.reports?.exportError, 'error');
        }
        return;
      }
      showReportModal(title);
      try {
        const result = await build();
        if (request !== reportRequest) return;
        if (!result) { closeReportModal(); return; }
        currentReport = result;
        currentReportUrl = result.pdf.pdf.output('bloburl');
        const frame = document.getElementById('reportPdfFrame');
        frame.src = currentReportUrl;
        frame.hidden = false;
        document.getElementById('reportLoading').hidden = true;
        document.getElementById('btnModalDownload').disabled = false;
      } catch (err) {
        console.error('[Reports] Could not make the PDF:', err);
        if (request === reportRequest) showReportError();
      }
    }
    
    function showReportModal(title) {
      reportModalOpener = document.activeElement;
      document.getElementById('reportModalTitle').textContent = title;
      const loading = document.getElementById('reportLoading');
      loading.hidden = false;
      loading.classList.remove('is-error');
      loading.querySelector('span').textContent = translations.generating;
      const frame = document.getElementById('reportPdfFrame');
      frame.hidden = true;
      frame.removeAttribute('src');
      document.getElementById('btnModalDownload').disabled = true;
      document.getElementById('reportModal').classList.add('active');
      document.body.style.overflow = 'hidden';
      document.getElementById('btnCloseModalX').focus();
    }
    
    function closeReportModal() {
      const modal = document.getElementById('reportModal');
      if (!modal.classList.contains('active')) return;
      reportRequest++;
      modal.classList.remove('active');
      document.body.style.overflow = '';
      const frame = document.getElementById('reportPdfFrame');
      frame.hidden = true;
      frame.removeAttribute('src');
      if (currentReportUrl) URL.revokeObjectURL(currentReportUrl);
      currentReportUrl = null;
      currentReport = null;
      reportModalOpener?.focus?.();
    }
    
    function showReportError() {
      const loading = document.getElementById('reportLoading');
      loading.hidden = false;
      loading.classList.add('is-error');
      loading.querySelector('span').textContent = translations.reports?.exportError || '';
    }
    
    function downloadCurrentReport() {
      if (currentReport) currentReport.pdf.save(currentReport.filename);
    }
    
    // The PDF button above the tabs: a report of what the tab shows
    function downloadTabPdf() {
      if (activeAnalyticsTab === 'overview') {
        openPdfReport(translations.organisationReport, () => generateOrganisationPDF(getPeriodDays()));
      } else if (activeAnalyticsTab === 'journeys') {
        const select = document.getElementById('journeySelector');
        if (!select.value) return;
        const journeyId = select.value;
        openPdfReport(select.options[select.selectedIndex].textContent.trim(), async () => {
          const response = await fetch(withDeleted(`/api/reports/journey/${journeyId}?days=${getPeriodDays()}`));
          const data = await response.json();
          if (!data.success) throw new Error(data.error || 'report');
          return generateJourneyPDF(data.report);
        });
      }
    }
    
    function exportCurrentUserPdf() {
