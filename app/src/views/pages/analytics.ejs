    // Utility function for HTML escaping
    // Also escapes quotes, so the result is safe inside attribute values
    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
    
    // ============================================
    // FORM SUBMISSIONS TAB (admin/manager only)
    // ============================================
    
    let allFormSubmissions = [];
    
    async function loadFormSubmissions() {
      const list = document.getElementById('formSubmissionsList');
      if (!list) return; // Tab not rendered (no permission)
      
      const loading = document.getElementById('formSubmissionsLoading');
      
      try {
        const res = await fetch('/api/analytics/form-submissions');
        const data = await res.json();
        
        if (!data.success) {
          throw new Error(data.error || 'Failed to load form submissions');
        }
        
        loading.style.display = 'none';
        allFormSubmissions = data.submissions || [];
        
        // Show count badge on the tab
        if (allFormSubmissions.length > 0) {
          const countBadge = document.getElementById('formsTabCount');
          if (countBadge) {
            countBadge.textContent = allFormSubmissions.length;
            countBadge.style.display = '';
          }
        }
        
        // Populate journey filter (client-side, based on loaded data)
        const journeyFilter = document.getElementById('formsJourneyFilter');
        const journeyTitles = [...new Set(allFormSubmissions.map(s => s.journey_title).filter(Boolean))].sort();
        if (journeyFilter && journeyTitles.length > 1) {
          journeyTitles.forEach(title => {
            const opt = document.createElement('option');
            opt.value = title;
            opt.textContent = title;
            journeyFilter.appendChild(opt);
          });
          journeyFilter.style.display = '';
          journeyFilter.addEventListener('change', renderFormSubmissions);
        }
        
        // Populate submitter filter so all submissions from one person can be
        // viewed together. Keyed on email (stable), labelled with the name.
        const submitterFilter = document.getElementById('formsSubmitterFilter');
        const submitters = new Map();
        allFormSubmissions.forEach(s => {
          const key = formSubmitterKey(s);
          if (key && !submitters.has(key)) {
            submitters.set(key, formSubmitterLabel(s));
          }
        });
        if (submitterFilter && submitters.size > 1) {
          [...submitters.entries()]
            .sort((a, b) => a[1].localeCompare(b[1]))
            .forEach(([key, label]) => {
              const opt = document.createElement('option');
              opt.value = key;
              opt.textContent = label;
              submitterFilter.appendChild(opt);
            });
          submitterFilter.style.display = '';
          submitterFilter.addEventListener('change', renderFormSubmissions);
        }
        
        // Sort order (visible whenever there is something to sort)
        const sortOrder = document.getElementById('formsSortOrder');
        if (sortOrder && allFormSubmissions.length > 1) {
          sortOrder.style.display = '';
          sortOrder.addEventListener('change', renderFormSubmissions);
        }
        
        renderFormSubmissions();
      } catch (err) {
        console.error('Failed to load form submissions:', err);
        if (loading) loading.textContent = '<%= t("analytics.forms.loadError") %>';
      }
    }
    
    function formSubmitterKey(s) {
      return (s.submitter_email || s.submitter_name || '').toLowerCase();
    }
    
    function formSubmitterLabel(s) {
      const name = (s.submitter_name || '').trim();
      const email = (s.submitter_email || '').trim();
      if (name && email) return name + ' (' + email + ')';
      return name || email;
    }
    
    function renderFormSubmissions() {
      const list = document.getElementById('formSubmissionsList');
      const emptyState = document.getElementById('formSubmissionsEmpty');
      const noResults = document.getElementById('formSubmissionsNoResults');
      if (!list || !emptyState) return;
      
      if (allFormSubmissions.length === 0) {
        emptyState.style.display = '';
        if (noResults) noResults.style.display = 'none';
        list.innerHTML = '';
        return;
      }
      emptyState.style.display = 'none';
      
      const journeyValue = document.getElementById('formsJourneyFilter')?.value || '';
      const submitterValue = document.getElementById('formsSubmitterFilter')?.value || '';
      const sortValue = document.getElementById('formsSortOrder')?.value || 'date_desc';
      
      let submissions = allFormSubmissions.filter(s =>
        (!journeyValue || s.journey_title === journeyValue) &&
        (!submitterValue || formSubmitterKey(s) === submitterValue)
      );
      
      // Sort a copy; ties fall back to newest first so the order stays stable
      const byDateDesc = (a, b) => new Date(b.created_at) - new Date(a.created_at);
      submissions = [...submissions];
      switch (sortValue) {
        case 'date_asc':
          submissions.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
          break;
        case 'submitter':
          submissions.sort((a, b) =>
            formSubmitterLabel(a).localeCompare(formSubmitterLabel(b)) || byDateDesc(a, b));
          break;
        case 'form':
          submissions.sort((a, b) =>
            (a.step_title || '').localeCompare(b.step_title || '') ||
            (a.journey_title || '').localeCompare(b.journey_title || '') ||
            byDateDesc(a, b));
          break;
        default: // date_desc
          submissions.sort(byDateDesc);
      }
      
      if (noResults) noResults.style.display = submissions.length === 0 ? '' : 'none';
      list.innerHTML = submissions.map(renderFormSubmissionCard).join('');
    }
    
    function renderFormSubmissionCard(s) {
      const responses = s.responses || {};
      
      // Translate raw yes/no radio values
      const displayValue = (value) => {
        if (typeof value === 'string') {
          const lower = value.toLowerCase();
          if (lower === 'yes') return '<%= t("common.yes") %>';
          if (lower === 'no') return '<%= t("common.no") %>';
        }
        return value;
      };
      
      const responseRows = Object.entries(responses).map(([label, value]) => `
        <tr>
          <td>${escapeHtml(label)}</td>
          <td>${value ? escapeHtml(displayValue(value)) : '<em style="color: #9ca3af;"><%= t("analytics.forms.notAnswered") %></em>'}</td>
        </tr>
      `).join('');
      
      const files = s.files || [];
      const filesHtml = files.length > 0 ? `
        <div style="padding: 4px 12px 12px 12px;">
          <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; margin: 8px 0 2px 0;">
            📎 <%= t("analytics.forms.uploadedFiles") %>
          </div>
          ${files.map(f => `
            <div class="form-submission-file">
              <div>
                <div class="form-submission-file-name">${escapeHtml(f.original_name)}</div>
                <div class="form-submission-file-meta">${escapeHtml(f.size_label || '')}${f.field_label ? ' · ' + escapeHtml(f.field_label) : ''}</div>
              </div>
              <a class="form-file-download-btn" href="/api/analytics/form-submissions/files/${f.id}/download">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <%= t("analytics.forms.download") %>
              </a>
            </div>
          `).join('')}
        </div>
      ` : '';
      
      const submitter = [s.submitter_name, s.submitter_email ? `(${s.submitter_email})` : '']
        .filter(Boolean).join(' ').trim() || '-';
      const submittedAt = s.created_at ? new Date(s.created_at).toLocaleString('<%= language %>') : '-';
      const sourceBadge = s.source === 'public'
        ? '<span class="form-submission-badge public"><%= t("analytics.forms.public") %></span>'
        : '<span class="form-submission-badge private"><%= t("analytics.forms.private") %></span>';
      const emailStatus = s.email_sent
        ? '<span style="color: #16a34a;">✓ <%= t("analytics.forms.emailSent") %></span>'
        : '<span style="color: #d97706;">⚠ <%= t("analytics.forms.emailNotSent") %></span>';
      
      return `
        <div class="form-submission-card">
          <div class="form-submission-header">
            <div>
              <span class="poll-journey-badge">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:14px;height:14px;">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
                ${escapeHtml(s.journey_title || '-')}
              </span>
              <div class="form-submission-title">${escapeHtml(s.step_title || '<%= t("analytics.forms.untitledForm") %>')}</div>
            </div>
            ${sourceBadge}
          </div>
          <table class="form-submission-responses">
            ${responseRows}
          </table>
          ${filesHtml}
          <div class="poll-meta" style="padding: 12px; margin-top: 0; font-size: 13px;">
            <div class="poll-meta-item">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
