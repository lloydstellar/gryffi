    const T_USERS = { openDetails: <%-safeJson(t("analytics.users.openDetails"))%> };
    
    // Chart texts and colors: Gryffi green, "started" light and "completed" dark
    const T_CHART = {
      started: <%-safeJson(t("analytics.chart.started"))%>,
      completed: <%-safeJson(t("analytics.chart.completed"))%>,
      sentence: <%-safeJson(t("analytics.overview.trendSentence"))%>,
      empty: <%-safeJson(t("analytics.overview.trendEmpty"))%>,
      weekOf: <%-safeJson(t("analytics.overview.weekOf"))%>,
      completedOf: <%-safeJson(t("analytics.kpi.completedOf"))%>,
      funnelSentence: <%-safeJson(t("analytics.journeys.funnelSentence"))%>,
      branchNote: <%-safeJson(t("analytics.journeys.branchNote"))%>
    };
    const CHART_GREEN = '#0b4b34';
    const CHART_LIGHT = '#cfe6b8';
    const CHART_LIGHT_EDGE = '#6f9c56';
    const CHART_GRID = '#e3e9e4';
    const CHART_TEXT = '#4a5a51';
    
    function fillText(template, values) {
      return String(template).replace(/\{\{(\w+)\}\}/g, (match, key) => (key in values ? values[key] : match));
    }
    
    function dayKey(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }
    
    // Started and completed per day, per week or per month: days up to a
    // month, weeks up to about half a year, months for longer periods.
    // "All time" starts at the first activity.
    function activityBuckets(dailyTrend, days) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const rows = dailyTrend.map(d => ({ date: calendarDay(d.date), started: parseInt(d.started) || 0, completed: parseInt(d.completed) || 0 }));
      let start = new Date(today);
      start.setDate(start.getDate() - (days - 1));
      if (days > 3650) {
        const first = rows.reduce((min, r) => (r.date < min ? r.date : min), today);
        start = new Date(first);
        start.setHours(0, 0, 0, 0);
      }
      const spanDays = Math.round((today - start) / 86400000) + 1;
      const unit = spanDays <= 31 ? 'day' : spanDays <= 200 ? 'week' : 'month';
      const bucketStart = (date) => {
        const d = new Date(date);
        d.setHours(0, 0, 0, 0);
        if (unit === 'week') d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); // Monday
        if (unit === 'month') d.setDate(1);
        return d;
      };
      const buckets = new Map();
      for (let d = bucketStart(start); d <= today; ) {
        buckets.set(dayKey(d), { date: new Date(d), started: 0, completed: 0 });
        if (unit === 'day') d.setDate(d.getDate() + 1);
        else if (unit === 'week') d.setDate(d.getDate() + 7);
        else d.setMonth(d.getMonth() + 1);
      }
      rows.forEach(r => {
        const bucket = buckets.get(dayKey(bucketStart(r.date)));
        if (bucket) { bucket.started += r.started; bucket.completed += r.completed; }
      });
      return Array.from(buckets.values()).map(b => ({
        ...b,
        label: unit === 'month'
          ? b.date.toLocaleDateString(dateLocale, { month: 'short', year: 'numeric' })
          : b.date.toLocaleDateString(dateLocale, { day: 'numeric', month: 'short' }),
        tooltip: unit === 'week'
          ? fillText(T_CHART.weekOf, { date: b.date.toLocaleDateString(dateLocale, { day: 'numeric', month: 'long' }) })
          : undefined
      }));
    }
    
    // One bar per day, week or month: "completed" drawn inside "started",
    // so neither hides the other. Whole numbers, horizontal labels.
    function drawActivityChart(canvas, previous, buckets) {
      if (previous) previous.destroy();
      return new Chart(canvas, {
        type: 'bar',
        data: {
          labels: buckets.map(b => b.label),
          datasets: [
            {
              label: T_CHART.completed,
              data: buckets.map(b => b.completed),
              backgroundColor: CHART_GREEN,
              borderRadius: 3,
              grouped: false,
              order: 0,
              barPercentage: 0.5,
              maxBarThickness: 18
            },
            {
              label: T_CHART.started,
              data: buckets.map(b => b.started),
              backgroundColor: CHART_LIGHT,
              borderColor: CHART_LIGHT_EDGE,
              borderWidth: 1,
              borderRadius: 4,
              grouped: false,
              order: 1,
              barPercentage: 0.75,
              maxBarThickness: 28
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 300 },
          plugins: {
            legend: {
              position: 'top',
              align: 'start',
              reverse: true,
              labels: { boxWidth: 12, boxHeight: 12, color: CHART_TEXT, font: { size: 13 } }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                title: (items) => buckets[items[0].dataIndex].tooltip || items[0].label
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: CHART_TEXT, maxRotation: 0, autoSkip: true, maxTicksLimit: 8 }
            },
            y: {
              beginAtZero: true,
              border: { display: false },
              grid: { color: CHART_GRID },
              ticks: { color: CHART_TEXT, precision: 0, maxTicksLimit: 5 }
            }
          }
        }
      });
    }
    
    function updateOverviewTrendChart(dailyTrend) {
      const ctx = document.getElementById('overviewTrendChart');
      if (!ctx) return;
      overviewTrendChart = drawActivityChart(ctx, overviewTrendChart, activityBuckets(dailyTrend, getPeriodDays()));
    }
    
