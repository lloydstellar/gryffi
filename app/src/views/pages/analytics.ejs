          fetch(`/api/analytics/video-stats?days=${days}`),
          fetch(`/api/analytics/guide-chat-stats?days=${days}`)
        ]);
        
        const [quizData, videoData, chatData] = await Promise.all([
          quizRes.json(),
          videoRes.json(),
          chatRes.json()
        ]);
        
        currentReportData = {
          days,
          quiz: quizData.success ? quizData : null,
          video: videoData.success ? videoData : null,
          chat: chatData.success ? chatData : null
        };
        
        renderEngagementReport(currentReportData);
      } catch (err) {
        console.error('Failed to load engagement report:', err);
        showReportError(err.message);
      }
