    </div>
  </div>
  <% } %>
  
  <!-- Save Indicator -->
  <div id="saveIndicator" class="save-indicator">
    ✓ <%= t('guides.detail.changesSaved') %>
  </div>
  
  <script src="/js/app.js"></script>
  <script>
    (() => {
      // Escape text for use in HTML, including attribute values
      function escapeHtml(text) {
        if (text == null) return '';
        return String(text).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
      }

      const guideId = '<%= guide.id %>';
      const currentLanguage = '<%= language %>';
      let saveTimeout = null;
      const isReadOnly = <%- safeJson(!!isViewer) %>;
      const translations = <%- safeJson({
        added: t('guides.detail.added'),
        fileTooLarge: t('guides.detail.fileTooLarge', { max: 50 }),
        uploadFailed: t('guides.detail.uploadFailed'),
        status: {
          pending: t('guides.detail.status.pending'),
          processing: t('guides.detail.status.processing'),
          completed: t('guides.detail.status.completed'),
          failed: t('guides.detail.status.failed')
        }
      }) %>;
      let statusPollingIntervals = new Map(); // Track polling intervals per source

      // Helper function to translate status
      function translateStatus(status) {
        return translations.status[status] || status;
      }

      // Helper function to format date (English: mm/dd/yyyy, others: dd/mm/yyyy)
      function formatDate(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return currentLanguage === 'en' ? `${month}/${day}/${year}` : `${day}/${month}/${year}`;
      }

      // Helper function to update status in UI
      function updateSourceStatus(sourceId, status, chunksCount, errorMessage) {
        const item = document.querySelector(`.knowledge-item[data-id="${sourceId}"]`);
        if (!item) return;
        
        const statusEl = item.querySelector('.knowledge-status');
        const metaEl = item.querySelector('.knowledge-meta');
        
        if (statusEl) {
          statusEl.className = `knowledge-status status-${status}`;
          statusEl.dataset.status = status;
          statusEl.textContent = translateStatus(status);
        }
        
        if (metaEl && chunksCount !== undefined) {
          // Extract existing date from meta text, or use current date if not found
          const existingText = metaEl.textContent;
          let dateText = '';
          if (existingText.includes('·')) {
            const parts = existingText.split('·');
            if (parts.length > 1) {
              // Try to extract date from existing text (look for date pattern)
              const dateMatch = parts[1].trim().match(/\d{1,2}\/\d{1,2}\/\d{4}/);
              if (dateMatch) {
                dateText = dateMatch[0];
              } else {
                // If no date found, try to get it from the item's data attribute or use current date
                const itemDate = item.dataset.createdAt;
                dateText = itemDate ? formatDate(itemDate) : formatDate(new Date().toISOString());
              }
            } else {
              const itemDate = item.dataset.createdAt;
              dateText = itemDate ? formatDate(itemDate) : formatDate(new Date().toISOString());
            }
          } else {
            const itemDate = item.dataset.createdAt;
            dateText = itemDate ? formatDate(itemDate) : formatDate(new Date().toISOString());
          }
          const chunksText = chunksCount + ' chunks';
          metaEl.textContent = chunksText + ' · ' + translations.added + ' ' + dateText;
        }
        
        // Show why a source failed (for example: too large for the knowledge limit)
        if (status === 'failed' && errorMessage) {
          let errorEl = item.querySelector('.knowledge-error');
          if (!errorEl) {
            errorEl = document.createElement('p');
            errorEl.className = 'knowledge-error';
            item.querySelector('.knowledge-info')?.appendChild(errorEl);
          }
          errorEl.textContent = errorMessage;
        }
        
        // Stop polling if completed or failed
        if (status === 'completed' || status === 'failed') {
          const intervalId = statusPollingIntervals.get(sourceId);
          if (intervalId) {
            clearInterval(intervalId);
            statusPollingIntervals.delete(sourceId);
          }
        }
      }

      // Poll status for a knowledge source
      function pollSourceStatus(sourceId) {
        // Don't start multiple polls for the same source
        if (statusPollingIntervals.has(sourceId)) return;
        
        const intervalId = setInterval(async () => {
          try {
            const response = await fetch(`/api/guides/${guideId}/knowledge/${sourceId}/status`);
            const result = await response.json();
            
            if (result.success) {
              updateSourceStatus(sourceId, result.status, result.chunksCount, result.errorMessage);
              
              // Stop polling if completed or failed
              if (result.status === 'completed' || result.status === 'failed') {
                clearInterval(intervalId);
                statusPollingIntervals.delete(sourceId);
              }
            }
          } catch (err) {
            console.error('Status poll error:', err);
            // Stop polling on error
            clearInterval(intervalId);
            statusPollingIntervals.delete(sourceId);
          }
        }, 2000); // Poll every 2 seconds
        
        statusPollingIntervals.set(sourceId, intervalId);
      }

      // Start polling for all processing/pending items on page load
      document.querySelectorAll('.knowledge-item').forEach(item => {
        const sourceId = item.dataset.id;
        const statusEl = item.querySelector('.knowledge-status');
        if (statusEl) {
          const status = statusEl.dataset.status || statusEl.textContent.toLowerCase();
          if (status === 'processing' || status === 'pending') {
            pollSourceStatus(sourceId);
          }
        }
      });

      // Viewer: read-only mode (no autosave, uploads, deletes, avatar changes)
      if (isReadOnly) {
        document.getElementById('saveIndicator')?.remove();
        return;
      }
    
    // Auto-save on input changes (guideAvatar is handled by the avatar picker)
    ['guideName', 'guideRole', 'guidePersonality', 'guideLanguage', 'guideGreeting', 'guideInstructions'].forEach(id => {
      const el = document.getElementById(id);
      el.addEventListener('input', debounceAndSave);
      el.addEventListener('change', debounceAndSave);
    });
    
    function debounceAndSave() {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(saveGuide, 800);
    }
    
    async function saveGuide() {
      const data = {
        name: document.getElementById('guideName').value.trim(),
        role: document.getElementById('guideRole').value.trim() || null,
        avatar_url: document.getElementById('guideAvatar').value.trim() || null,
        personality: document.getElementById('guidePersonality').value,
        language: document.getElementById('guideLanguage').value,
        greeting: document.getElementById('guideGreeting').value.trim() || null,
        ai_instructions: document.getElementById('guideInstructions').value.trim() || null
      };
      
      if (!data.name) return;
      
      try {
        const response = await fetch(`/api/guides/${guideId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (result.success) {
          showSaveIndicator();
        }
      } catch (err) {
        console.error('Save error:', err);
      }
    }
    
    function showSaveIndicator() {
      const indicator = document.getElementById('saveIndicator');
      indicator.classList.add('show');
      setTimeout(() => indicator.classList.remove('show'), 2000);
    }
    
    // File upload
    const uploadZone = document.getElementById('uploadZone');
    const fileInput = document.getElementById('fileInput');
    
    ['dragenter', 'dragover'].forEach(event => {
      uploadZone.addEventListener(event, (e) => {
        e.preventDefault();
        uploadZone.classList.add('dragover');
      });
    });
    
    ['dragleave', 'drop'].forEach(event => {
      uploadZone.addEventListener(event, (e) => {
        e.preventDefault();
        uploadZone.classList.remove('dragover');
      });
    });
    
    uploadZone.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      handleFiles(files);
    });
    
    fileInput.addEventListener('change', (e) => {
      handleFiles(e.target.files);
    });
    
    async function handleFiles(files) {
      for (const file of files) {
        await uploadFile(file);
      }
    }
    
    // Same limit as the server (knowledgeUpload in routes/api.js)
    const MAX_KNOWLEDGE_FILE_BYTES = 50 * 1024 * 1024;

    async function uploadFile(file) {
      if (file.size > MAX_KNOWLEDGE_FILE_BYTES) {
        await window.gryffi.modal.alert(translations.fileTooLarge, { type: 'error' });
        return;
      }
      const formData = new FormData();
      formData.append('file', file);
      
      // Create temporary item in list
      const listContainer = document.querySelector('.knowledge-list') || createKnowledgeList();
      const tempItem = document.createElement('div');
      tempItem.className = 'knowledge-item';
      const uploadDate = new Date().toISOString();
      tempItem.dataset.createdAt = uploadDate;
      tempItem.innerHTML = `
        <div class="knowledge-icon file">
          <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
        <div class="knowledge-info">
          <p class="knowledge-name">${escapeHtml(file.name)}</p>
          <p class="knowledge-meta">Uploading...</p>
        </div>
        <span class="knowledge-status status-processing">uploading</span>
      `;
      listContainer.appendChild(tempItem);
      document.getElementById('emptyKnowledge')?.remove();
      
      try {
        const response = await fetch(`/api/guides/${guideId}/knowledge/file`, {
          method: 'POST',
          body: formData
        });
        
        // A proxy in front of Gryffi answers some refusals with an HTML page
        const result = await response.json().catch(() => ({
          success: false,
          error: response.status === 413 ? translations.fileTooLarge : translations.uploadFailed
        }));
        
        if (result.success) {
          tempItem.dataset.id = result.source.id;
          if (result.source.created_at) {
            tempItem.dataset.createdAt = result.source.created_at;
          }
          const currentDate = formatDate(tempItem.dataset.createdAt);
          tempItem.querySelector('.knowledge-meta').textContent = `0 chunks · ${translations.added} ${currentDate}`;
          const statusEl = tempItem.querySelector('.knowledge-status');
          statusEl.textContent = translateStatus('processing');
          statusEl.dataset.status = 'processing';
          
          // Start polling for this source
          pollSourceStatus(result.source.id);
          
          // Add delete button
          const deleteBtn = document.createElement('button');
          deleteBtn.className = 'btn-delete delete-knowledge-btn';
          deleteBtn.title = 'Delete';
          deleteBtn.dataset.sourceId = result.source.id;
          deleteBtn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>`;
          deleteBtn.addEventListener('click', handleDeleteKnowledge);
          tempItem.appendChild(deleteBtn);
        } else {
          const statusEl = tempItem.querySelector('.knowledge-status');
          statusEl.textContent = translateStatus('failed');
          statusEl.className = 'knowledge-status status-failed';
          statusEl.dataset.status = 'failed';
          if (result.error) {
            await window.gryffi.modal.alert(result.error, { type: 'error' });
          }
        }
      } catch (err) {
        console.error('Upload error:', err);
        const statusEl = tempItem.querySelector('.knowledge-status');
        statusEl.textContent = translateStatus('failed');
        statusEl.className = 'knowledge-status status-failed';
        statusEl.dataset.status = 'failed';
        await window.gryffi.modal.alert(translations.uploadFailed, { type: 'error' });
      }
    }
    
    function createKnowledgeList() {
      const container = document.createElement('div');
      container.className = 'knowledge-list';
      container.style.marginTop = '24px';
      document.querySelector('.upload-zone').after(container);
      return container;
    }
    
    // Text knowledge modal
    const addTextModal = document.getElementById('addTextModal');
    const addTextForm = document.getElementById('addTextForm');
    const textModalContent = document.getElementById('textModalContent');
    
    function openTextModal() {
      addTextModal.classList.add('active');
    }
    
    function closeTextModal() {
      addTextModal.classList.remove('active');
      addTextForm.reset();
    }
    
    async function addTextKnowledge(event) {
      event.preventDefault();
      
      const title = document.getElementById('textTitle').value.trim();
      const content = document.getElementById('textContent').value.trim();
      
      if (!content) {
        await window.gryffi.modal.alert('Please enter some content');
        return;
      }
      
      try {
        const response = await fetch(`/api/guides/${guideId}/knowledge/text`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, content })
        });
        
        const result = await response.json();
        
        if (result.success) {
          closeTextModal();
          
          // Add to list
          const listContainer = document.querySelector('.knowledge-list') || createKnowledgeList();
          document.getElementById('emptyKnowledge')?.remove();
          
          const item = document.createElement('div');
          item.className = 'knowledge-item';
          item.dataset.id = result.source.id;
          item.dataset.createdAt = result.source.created_at || new Date().toISOString();
          const currentDate = formatDate(item.dataset.createdAt);
          item.innerHTML = `
            <div class="knowledge-icon text">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </div>
            <div class="knowledge-info">
              <p class="knowledge-name">${escapeHtml(title || 'Text note')}</p>
              <p class="knowledge-meta">0 chunks · ${translations.added} ${currentDate}</p>
            </div>
            <span class="knowledge-status status-processing" data-status="processing">${translateStatus('processing')}</span>
            <div style="display: flex; gap: 4px;">
              <button class="btn-edit edit-knowledge-btn" data-source-id="${result.source.id}" data-source-name="${escapeHtml(title || 'Text note')}" data-raw-text="${escapeHtml(content).replace(/\n/g, '\\n')}" title="Edit">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </button>
              <button class="btn-delete delete-knowledge-btn" data-source-id="${result.source.id}" title="Delete">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          `;
          listContainer.prepend(item);
          
          // Start polling for this source
          pollSourceStatus(result.source.id);
          
          // Bind delete and edit events to new button
          bindDeleteKnowledgeButtons();
          bindEditKnowledgeButtons();
        } else {
          await window.gryffi.modal.alert(result.error || 'Failed to add text', { type: 'error' });
        }
      } catch (err) {
        console.error('Add text error:', err);
        await window.gryffi.modal.alert('An error occurred', { type: 'error' });
      }
    }
    
    async function deleteKnowledge(sourceId) {
      const confirmMessage = <%-safeJson(t("guides.detail.confirmDelete"))%>;
      if (!await window.gryffi.modal.confirm(confirmMessage)) return;
      
      try {
        const response = await fetch(`/api/guides/${guideId}/knowledge/${sourceId}`, {
          method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
          document.querySelector(`.knowledge-item[data-id="${sourceId}"]`)?.remove();
          
          // Show empty message if no items left
          const list = document.querySelector('.knowledge-list');
          if (list && list.children.length === 0) {
            list.remove();
            const emptyMsg = document.createElement('p');
            emptyMsg.className = 'text-center text-zen-500 mt-6';
            emptyMsg.id = 'emptyKnowledge';
            emptyMsg.textContent = 'No knowledge sources yet. Upload files or add text to teach your guide.';
            document.querySelector('.upload-zone').after(emptyMsg);
          }
        }
      } catch (err) {
        console.error('Delete error:', err);
      }
    }
    
    // Bind delete knowledge buttons (for existing and dynamically added)
    function bindDeleteKnowledgeButtons() {
      document.querySelectorAll('.delete-knowledge-btn').forEach(btn => {
        btn.removeEventListener('click', handleDeleteKnowledge);
        btn.addEventListener('click', handleDeleteKnowledge);
      });
    }
    
    // Bind edit knowledge buttons (for existing and dynamically added)
    function bindEditKnowledgeButtons() {
      document.querySelectorAll('.edit-knowledge-btn').forEach(btn => {
        btn.removeEventListener('click', handleEditKnowledge);
        btn.addEventListener('click', handleEditKnowledge);
      });
    }
    
    // Edit modal functions
    const editTextModal = document.getElementById('editTextModal');
    const editTextForm = document.getElementById('editTextForm');
    const editTextModalContent = document.getElementById('editTextModalContent');
    
    function openEditTextModal(sourceId, sourceName, rawText) {
      document.getElementById('editSourceId').value = sourceId;
      document.getElementById('editTextTitle').value = sourceName || '';
      document.getElementById('editTextContent').value = rawText || '';
      editTextModal.classList.add('active');
    }
    
    function closeEditTextModal() {
      editTextModal.classList.remove('active');
      editTextForm.reset();
    }
    
    function handleEditKnowledge(event) {
      const btn = event.currentTarget;
      const sourceId = btn.dataset.sourceId;
      const sourceName = btn.dataset.sourceName || '';
      const rawText = (btn.dataset.rawText || '').replace(/\\n/g, '\n').replace(/&quot;/g, '"');
      openEditTextModal(sourceId, sourceName, rawText);
    }
    
    async function updateTextKnowledge(event) {
      event.preventDefault();
      
      const sourceId = document.getElementById('editSourceId').value;
      const title = document.getElementById('editTextTitle').value.trim();
      const content = document.getElementById('editTextContent').value.trim();
      
      if (!content) {
        await window.gryffi.modal.alert('Please enter some content');
        return;
      }
      
      try {
        const response = await fetch(`/api/guides/${guideId}/knowledge/${sourceId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, content })
        });
        
        const result = await response.json();
        
        if (result.success) {
          closeEditTextModal();
          
          // Update the item in the list
          const item = document.querySelector(`.knowledge-item[data-id="${sourceId}"]`);
          if (item) {
            const nameEl = item.querySelector('.knowledge-name');
            const metaEl = item.querySelector('.knowledge-meta');
            const statusEl = item.querySelector('.knowledge-status');
            const editBtn = item.querySelector('.edit-knowledge-btn');
            
            if (nameEl) nameEl.textContent = title || 'Text note';
            if (metaEl) metaEl.textContent = 'Processing...';
            if (statusEl) {
              statusEl.className = 'knowledge-status status-processing';
              statusEl.dataset.status = 'processing';
              statusEl.textContent = translateStatus('processing');
            }
            if (editBtn) {
              editBtn.dataset.sourceName = title || '';
              editBtn.dataset.rawText = content.replace(/"/g, '&quot;').replace(/\n/g, '\\n');
            }
            
            // Start polling for this source
            pollSourceStatus(sourceId);
          }
        } else {
          await window.gryffi.modal.alert(result.error || 'Failed to update text', { type: 'error' });
        }
      } catch (err) {
        console.error('Update text error:', err);
        await window.gryffi.modal.alert('An error occurred', { type: 'error' });
      }
    }
    
    function handleDeleteKnowledge(e) {
      const sourceId = e.currentTarget.dataset.sourceId;
      deleteKnowledge(sourceId);
    }
    
    // Event listeners
    document.getElementById('addTextBtn')?.addEventListener('click', openTextModal);
    document.getElementById('cancelTextBtn')?.addEventListener('click', closeTextModal);
    uploadZone?.addEventListener('click', () => fileInput.click());
    
    // Modal backdrop click to close
    addTextModal?.addEventListener('click', (e) => {
      if (e.target === addTextModal) {
        closeTextModal();
      }
    });
    
    // Prevent modal content click from closing
    textModalContent?.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    
    // Form submit
    addTextForm?.addEventListener('submit', addTextKnowledge);
    editTextForm?.addEventListener('submit', updateTextKnowledge);
    
    // Edit modal event listeners
    document.getElementById('cancelEditTextBtn')?.addEventListener('click', closeEditTextModal);
    editTextModal?.addEventListener('click', (e) => {
      if (e.target === editTextModal) {
        closeEditTextModal();
      }
    });
    editTextModalContent?.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    
    // Bind delete and edit buttons
    bindDeleteKnowledgeButtons();
    bindEditKnowledgeButtons();
    
    // Close modal on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeTextModal();
        closeEditTextModal();
      }
    });
    
    // ========================================
    // Avatar Picker
    // ========================================
    const chooseAvatarBtn = document.getElementById('chooseAvatarBtn');
    const removeAvatarBtn = document.getElementById('removeAvatarBtn');
    const avatarPreview = document.getElementById('avatarPreview');
    const guideAvatarInput = document.getElementById('guideAvatar');
    const avatarBtnText = document.getElementById('avatarBtnText');
    
    chooseAvatarBtn?.addEventListener('click', () => {
      window.imagePicker?.open({
        stepType: 'avatar',
        stepTitle: document.getElementById('guideName')?.value || 'Guide',
        onSelect: (imageData) => {
          // Close image picker first to avoid double overlay
          window.imagePicker?.close();
          
          // Open cropper with the selected image
          window.avatarCropper?.open(imageData.url, (croppedData) => {
            // Update hidden input with cropped image URL
            guideAvatarInput.value = croppedData.url;
            
            // Update preview
            avatarPreview.innerHTML = `<img src="${croppedData.url}" alt="Avatar" id="avatarImage">`;
            
            // Update header avatar
            const headerAvatar = document.querySelector('.guide-avatar-large');
            if (headerAvatar) {
              headerAvatar.innerHTML = `<img src="${croppedData.url}" alt="Avatar">`;
            }
            
            // Update button text
            avatarBtnText.textContent = <%-safeJson(t("guides.detail.changeAvatar"))%>;
            
            // Show remove button
            removeAvatarBtn?.classList.remove('hidden');
            
            // Trigger save
            saveGuide();
          });
        }
      });
    });
    
    removeAvatarBtn?.addEventListener('click', () => {
      // Clear hidden input
      guideAvatarInput.value = '';
      
      // Reset preview to placeholder
      avatarPreview.innerHTML = `
        <div class="avatar-placeholder" id="avatarPlaceholder">
          <svg class="w-8 h-8 text-zen-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
      `;
      
      // Update button text
      avatarBtnText.textContent = <%-safeJson(t("guides.detail.chooseAvatar"))%>;
      
      // Hide remove button
      removeAvatarBtn?.classList.add('hidden');
      
      // Update header avatar
      const headerAvatar = document.querySelector('.guide-avatar-large');
      if (headerAvatar) {
        headerAvatar.innerHTML = document.getElementById('guideName')?.value?.charAt(0)?.toUpperCase() || 'G';
      }
      
      // Trigger save
      saveGuide();
    });
    })();
  </script>
  
  <!-- Translations for Image Picker -->
  <script>
    window.GRYFFI = window.GRYFFI || {};
    window.GRYFFI.translations = window.GRYFFI.translations || {};
    window.GRYFFI.translations.common = <%- safeJson(t('common', { returnObjects: true })) %>;
    window.GRYFFI.translations.imagePicker = <%- safeJson(t('imagePicker', { returnObjects: true })) %>;
    window.GRYFFI.translations.cropper = <%- safeJson(t('cropper', { returnObjects: true })) %>;
    
    // Global translation helper
    if (typeof window.t !== 'function') {
      window.t = function(key, params = {}) {
        const keys = key.split('.');
        let value = window.GRYFFI.translations;
        for (const k of keys) {
          if (value && typeof value === 'object' && k in value) {
            value = value[k];
          } else {
            return key;
          }
        }
        if (typeof value === 'string' && Object.keys(params).length > 0) {
          for (const [param, replacement] of Object.entries(params)) {
            value = value.replace(new RegExp(`{{${param}}}`, 'g'), replacement);
          }
        }
        return value;
      };
    }
  </script>
  
  <!-- Image Picker -->
  <script src="/js/image-picker.js"></script>
  
  <!-- Cropper.js -->
  <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>
  
  <!-- Avatar Cropper Modal -->
  <div id="avatarCropperModal" class="avatar-cropper-overlay hidden">
    <div class="avatar-cropper-modal">
      <div class="avatar-cropper-header">
        <div>
          <h3 id="cropperTitle"><%= t('cropper.title') %></h3>
          <p id="cropperSubtitle"><%= t('cropper.subtitle') %></p>
        </div>
        <button type="button" class="avatar-cropper-close" id="closeCropperBtn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="avatar-cropper-content">
        <div class="avatar-cropper-stage">
          <img id="cropperImage" src="" alt="Crop preview">
        </div>
        <div class="avatar-cropper-controls">
          <button type="button" class="avatar-cropper-btn" id="cropperZoomOut" title="<%= t('cropper.zoomOut') %>">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
            </svg>
          </button>
          <button type="button" class="avatar-cropper-btn" id="cropperZoomIn" title="<%= t('cropper.zoomIn') %>">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
            </svg>
          </button>
          <button type="button" class="avatar-cropper-btn" id="cropperRotateLeft" title="<%= t('cropper.rotateLeft') %>">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
            </svg>
          </button>
          <button type="button" class="avatar-cropper-btn" id="cropperRotateRight" title="<%= t('cropper.rotateRight') %>">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10h-10a8 8 0 00-8 8v2M21 10l-6 6m6-6l-6-6"></path>
            </svg>
          </button>
          <button type="button" class="avatar-cropper-btn" id="cropperReset" title="<%= t('cropper.reset') %>">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="avatar-cropper-footer">
        <button type="button" class="btn-secondary" id="cancelCropBtn"><%= t('cropper.cancel') %></button>
        <button type="button" class="btn-primary" id="applyCropBtn"><%= t('cropper.cropAndSave') %></button>
      </div>
    </div>
  </div>
  
  <script>
    // Avatar Cropper functionality
    (function() {
      let cropper = null;
      let pendingImageUrl = null;
      let onCropComplete = null;
      
      const cropperModal = document.getElementById('avatarCropperModal');
      const cropperImage = document.getElementById('cropperImage');
      const closeCropperBtn = document.getElementById('closeCropperBtn');
      const cancelCropBtn = document.getElementById('cancelCropBtn');
      const applyCropBtn = document.getElementById('applyCropBtn');
      const zoomInBtn = document.getElementById('cropperZoomIn');
      const zoomOutBtn = document.getElementById('cropperZoomOut');
      const rotateLeftBtn = document.getElementById('cropperRotateLeft');
      const rotateRightBtn = document.getElementById('cropperRotateRight');
      const resetBtn = document.getElementById('cropperReset');
      
      function openCropper(imageUrl, callback) {
        pendingImageUrl = imageUrl;
        onCropComplete = callback;
        
        // Set the image source
        cropperImage.src = imageUrl;
        
        // Show modal
        cropperModal.classList.remove('hidden');
        
        // Wait for image to load, then initialize cropper
        cropperImage.onload = function() {
          if (cropper) {
            cropper.destroy();
          }
          
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 0.9,
            restore: false,
            guides: false,
            center: true,
            highlight: false,
            cropBoxMovable: true,
            cropBoxResizable: true,
            toggleDragModeOnDblclick: false,
            minContainerWidth: 300,
            minContainerHeight: 300,
          });
        };
      }
      
      function closeCropper() {
        cropperModal.classList.add('hidden');
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
        cropperImage.src = '';
        pendingImageUrl = null;
        onCropComplete = null;
      }
      
      function applyCrop() {
        if (!cropper) return;
        
        // Get the cropped canvas
        const canvas = cropper.getCroppedCanvas({
          width: 400,
          height: 400,
          imageSmoothingEnabled: true,
          imageSmoothingQuality: 'high',
        });
        
        // Convert to blob and upload
        canvas.toBlob(async (blob) => {
          try {
            const formData = new FormData();
            formData.append('image', blob, 'avatar.png');
            
            const response = await fetch('/api/media/upload', {
              method: 'POST',
              body: formData
            });
            
            if (!response.ok) {
              throw new Error('Upload failed');
            }
            
            const data = await response.json();
            
            if (onCropComplete && data.url) {
              onCropComplete({ url: data.url });
            }
            
            closeCropper();
          } catch (error) {
            console.error('Failed to upload cropped image:', error);
            await window.gryffi.modal.alert(<%-safeJson(t("imagePicker.uploadFailed"))%>, { type: 'error' });
          }
        }, 'image/png', 0.9);
      }
      
      // Event listeners
      closeCropperBtn?.addEventListener('click', closeCropper);
      cancelCropBtn?.addEventListener('click', closeCropper);
      applyCropBtn?.addEventListener('click', applyCrop);
      
      zoomInBtn?.addEventListener('click', () => cropper?.zoom(0.1));
      zoomOutBtn?.addEventListener('click', () => cropper?.zoom(-0.1));
      rotateLeftBtn?.addEventListener('click', () => cropper?.rotate(-90));
      rotateRightBtn?.addEventListener('click', () => cropper?.rotate(90));
      resetBtn?.addEventListener('click', () => cropper?.reset());
      
      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !cropperModal.classList.contains('hidden')) {
          closeCropper();
        }
      });
      
      // Close on overlay click
      cropperModal?.addEventListener('click', (e) => {
        if (e.target === cropperModal) {
          closeCropper();
        }
      });
      
      // Expose to global scope
      window.avatarCropper = {
        open: openCropper,
        close: closeCropper
      };
    })();
  </script>
</body>
</html>


