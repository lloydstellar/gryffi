        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="cancelTextBtn"><%= t('common.cancel') %></button>
          <button type="submit" class="btn-primary"><%= t('guides.detail.addKnowledge') %></button>
        </div>
      </form>
    </div>
  </div>
  
  <!-- Edit Text Modal -->
  <div id="editTextModal" class="add-text-modal">
    <div class="modal-content" id="editTextModalContent">
      <div class="modal-header">
        <h2 class="text-xl font-semibold text-zen-900"><%= t('guides.detail.editTextTitle') %></h2>
        <p class="text-sm text-zen-500 mt-1"><%= t('guides.detail.editTextSubtitle') %></p>
      </div>
      
      <form id="editTextForm">
        <input type="hidden" id="editSourceId">
        <div class="modal-body">
          <div class="form-group">
            <label for="editTextTitle"><%= t('guides.detail.textTitle') %></label>
            <input type="text" id="editTextTitle" placeholder="<%= t('guides.detail.textTitlePlaceholder') %>">
          </div>
          <div class="form-group">
            <label for="editTextContent"><%= t('guides.detail.textContent') %> *</label>
            <textarea id="editTextContent" rows="8" placeholder="<%= t('guides.detail.textContentPlaceholder') %>" required></textarea>
          </div>
        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="cancelEditTextBtn"><%= t('common.cancel') %></button>
          <button type="submit" class="btn-primary"><%= t('common.save') %></button>
        </div>
