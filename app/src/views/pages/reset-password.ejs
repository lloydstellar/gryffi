<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('auth.passwordReset') %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/app.js"></script>
</head>
<body class="min-h-screen bg-gryffi-bg flex items-center justify-center p-4">
  <!-- Background decoration -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-gryffi-accent/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute -bottom-1/2 -left-1/2 w-full h-full bg-gradient-to-tr from-gryffi-primary/10 to-transparent rounded-full blur-3xl"></div>
  </div>
  
  <div class="w-full max-w-md relative">
    <!-- Logo and title -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center gap-3 mb-4">
        <img src="/images/logos/Logo---illustration-only-cropped-transparant.png" alt="Gryffi" class="w-16 h-16">
      </div>
      <h1 class="text-3xl font-display font-bold text-gryffi-primary"><%= t('auth.passwordReset') %></h1>
      <p class="text-zen-500 mt-2"><%= t('auth.enterNewPassword') %></p>
    </div>
    
    <!-- Reset card -->
    <div class="glass-card-solid p-8">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error animate-fade-in mb-4">
          <%= error %>
        </div>
      <% } %>
      
      <form action="/reset-password" method="POST" class="space-y-5">
        <input type="hidden" name="token" value="<%= token %>">
        
        <div>
          <label for="password" class="input-label"><%= t('auth.newPassword') %></label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="input"
            autocomplete="new-password"
            minlength="8"
            required
            autofocus
          >
        </div>
        
        <div>
          <label for="password_confirm" class="input-label"><%= t('auth.confirmPassword') %></label>
          <input 
            type="password" 
            id="password_confirm" 
            name="password_confirm" 
            class="input"
            autocomplete="new-password"
            minlength="8"
            required
          >
        </div>
        
        <button type="submit" class="btn-primary w-full py-3">
          <%= t('common.save') %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </form>
      
      <div class="mt-6 pt-6 border-t border-zen-200">
        <a href="/login" class="flex items-center justify-center gap-2 text-sm text-zen-500 hover:text-gryffi-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <%= t('auth.backToLogin') %>
        </a>
      </div>
    </div>
    
    <!-- Footer -->
    <p class="text-center text-zen-400 text-sm mt-6">
      Gryffi - <%= t('footer.tagline') %>
    </p>
  </div>
  
  <script>
    // Client-side password confirmation
    document.querySelector('form').addEventListener('submit', function(e) {
      const password = document.getElementById('password').value;
      const confirmPwd = document.getElementById('password_confirm').value;
      
      if (password !== confirmPwd) {
        e.preventDefault();
        window.gryffi.modal.alert(<%-safeJson(t("team.inviteAccept.passwordsDoNotMatch") || "Passwords do not match")%>, { type: 'error' });
      }
    });
  </script>
</body>
</html>
