<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }
    .verify-container {
      max-width: 420px;
      padding: 48px;
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      text-align: center;
    }
    .logo {
      margin-bottom: 32px;
    }
    .logo img {
      height: 48px;
      margin: 0 auto; /* Tailwind makes images block-level */
    }
    .shield-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      background: rgba(120, 197, 3, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .shield-icon svg {
      width: 32px;
      height: 32px;
      stroke: #78c503;
    }
    .verify-title {
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 8px;
      font-family: 'Outfit', sans-serif;
    }
    .verify-subtitle {
      font-size: 14px;
      color: #5b6b80;
      margin-bottom: 24px;
    }
    .verify-explanation {
      font-size: 14px;
      color: #374151;
      line-height: 1.6;
      margin-bottom: 32px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 8px;
    }
    .code-label {
      display: block;
      text-align: left;
      font-size: 14px;
      font-weight: 500;
      color: #374151;
      margin-bottom: 12px;
    }
    .code-input {
      display: block;
      width: 100%;
      height: 64px;
      margin-bottom: 24px;
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 0.5em;
      text-indent: 0.5em;
      text-align: center;
      color: #0f172a;
      transition: all 0.15s;
    }
    .code-input:focus {
      outline: none;
      border-color: #0b4b34;
      box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.1);
    }
    .code-input.error {
      border-color: #dc2626;
      animation: shake 0.3s ease-in-out;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .code-input.error, .error-message.show, .success-message.show { animation: none; }
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 14px 24px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      border: none;
    }
    .btn-primary {
      background: #0b4b34;
      color: white;
    }
    .btn-primary:hover {
      background: #083d2a;
    }
    .btn-primary:disabled {
      background: #d1d5db;
      cursor: not-allowed;
    }
    .resend-link {
      margin-top: 20px;
      font-size: 14px;
      color: #5b6b80;
    }
    .resend-link button {
      background: none;
      border: none;
      color: #0b4b34;
      font-weight: 600;
      cursor: pointer;
      padding: 0;
    }
    .resend-link button:hover {
      text-decoration: underline;
    }
    .resend-link button:focus-visible, .btn:focus-visible {
      outline: 3px solid #0b4b34;
      outline-offset: 2px;
    }
    .resend-link button:disabled {
      color: #5b6b80;
      cursor: not-allowed;
      text-decoration: none;
    }
    .error-message {
      margin: -8px 0 16px;
      padding: 12px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      color: #dc2626;
      font-size: 14px;
      display: none;
    }
    .error-message.show {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }
    .success-message {
      margin: -8px 0 16px;
      padding: 12px;
      background: rgba(120, 197, 3, 0.1);
      border: 1px solid rgba(120, 197, 3, 0.3);
      border-radius: 8px;
      color: #0b4b34;
      font-size: 14px;
      display: none;
    }
    .success-message.show {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .journey-info {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #e5e7eb;
      text-align: left;
    }
    .journey-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #5b6b80;
      margin-bottom: 4px;
    }
    .journey-title {
      font-size: 15px;
      font-weight: 600;
      color: #0f172a;
    }
  </style>
</head>
<body>
  <div class="verify-container">
    <div class="logo">
      <img src="/images/logos/Logo---cropped-transparant.png" alt="Gryffi">
    </div>
    
    <div class="shield-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
    </div>
    
    <h1 class="verify-title"><%= pt('magicLink.verification.title') %></h1>
    <p class="verify-subtitle"><%= pt('magicLink.verification.subtitle') %></p>
    
    <div class="verify-explanation">
      <%= pt('magicLink.verification.explanation') %>
    </div>
    
    <form id="verifyForm" novalidate>
      <label for="verificationCode" class="code-label"><%= pt('magicLink.verification.codeLabel') %></label>
      <input type="text" id="verificationCode" name="code" class="code-input" maxlength="<%= codeLength %>"
             inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{<%= codeLength %>}" aria-describedby="errorMessage">
      
      <div id="errorMessage" class="error-message" role="alert"></div>
      <div id="successMessage" class="success-message" role="status"></div>
      
      <button type="submit" class="btn btn-primary" id="verifyBtn">
        <%= pt('magicLink.verification.submit') %>
      </button>
    </form>
    
    <div class="resend-link">
      <button type="button" id="resendBtn">
        <%= pt('magicLink.verification.resend') %>
      </button>
    </div>
    
    <div class="journey-info">
      <div class="journey-label"><%= pt('magicLink.verification.journeyLabel') %></div>
      <div class="journey-title"><%= journeyTitle %></div>
    </div>
  </div>

  <script>
    const token = <%- safeJson(token) %>;
    const CODE_LENGTH = <%- safeJson(codeLength) %>;
    const T = <%- safeJson({
      submit: pt('magicLink.verification.submit'),
      verifying: pt('magicLink.verification.verifying'),
      invalid: pt('magicLink.verification.invalid'),
      resent: pt('magicLink.verification.resent'),
      error: pt('magicLink.error')
    }) %>;

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('verificationCode');
      const form = document.getElementById('verifyForm');
      const verifyBtn = document.getElementById('verifyBtn');
      const resendBtn = document.getElementById('resendBtn');
      const errorEl = document.getElementById('errorMessage');
      const successEl = document.getElementById('successMessage');
      let submitting = false;

      input.focus();

      input.addEventListener('input', () => {
        input.value = input.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
        input.classList.remove('error');
        input.removeAttribute('aria-invalid');
        errorEl.classList.remove('show');
        // Submit as soon as all digits are there (typed, pasted or filled in from the email)
        if (input.value.length === CODE_LENGTH) form.requestSubmit();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitting) return;
        const code = input.value;
        if (!new RegExp(`^\\d{${CODE_LENGTH}}$`).test(code)) {
          showError(T.invalid);
          return;
        }
        
        submitting = true;
        verifyBtn.disabled = true;
        verifyBtn.textContent = T.verifying;
        
        try {
          const response = await fetch(`/e/${encodeURIComponent(token)}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ code })
          });
          const data = await response.json();
          
          if (data.success) {
            window.location.href = data.redirect;
            return;
          }
          showError(data.error || T.error);
          input.select();
        } catch (err) {
          showError(T.error);
        }
        submitting = false;
        verifyBtn.disabled = false;
        verifyBtn.textContent = T.submit;
      });

      resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        
        try {
          const response = await fetch(`/e/${encodeURIComponent(token)}/resend`, {
            method: 'POST',
            credentials: 'same-origin'
          });
          const data = await response.json();
          
          if (data.success) {
            showSuccess(data.message || T.resent);
            input.value = '';
            input.classList.remove('error');
            input.removeAttribute('aria-invalid');
            input.focus();
          } else {
            showError(data.error || T.error);
          }
        } catch (err) {
          showError(T.error);
        }
        
        // Re-enable after 30 seconds
        setTimeout(() => {
          resendBtn.disabled = false;
        }, 30000);
      });

      function showError(message) {
        errorEl.textContent = message;
        errorEl.classList.add('show');
        successEl.classList.remove('show');
        input.classList.add('error');
        input.setAttribute('aria-invalid', 'true');
      }

      function showSuccess(message) {
        successEl.textContent = message;
        successEl.classList.add('show');
        errorEl.classList.remove('show');
      }
    });
  </script>
</body>
</html>
