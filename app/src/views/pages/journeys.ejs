    <% } %>
  </main>
  
  <script src="/js/app.js"></script>
  <script>
    // Escape text for use in HTML, including attribute values
    function escapeHtml(text) {
      if (text == null) return '';
      return String(text).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }

    // Helper function to decode HTML entities (including numeric entities like &#34;)
    function decodeHtmlEntities(text) {
      if (!text) return '';
      
      const str = String(text);
      
      // Create a temporary textarea element to decode all HTML entities
      // This handles both named entities (&quot;) and numeric entities (&#34;)
      const textarea = document.createElement('textarea');
      textarea.innerHTML = str;
      let decoded = textarea.value;
      
      // If textarea didn't decode numeric entities, manually decode them
      if (decoded.includes('&#')) {
        decoded = decoded
          .replace(/&#(\d+);/g, function(match, dec) {
            return String.fromCharCode(parseInt(dec, 10));
          })
          .replace(/&#x([a-f\d]+);/gi, function(match, hex) {
            return String.fromCharCode(parseInt(hex, 16));
          });
      }
      
      return decoded;
    }

    // Initialize journey actions after page load
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize Kebab Menus
      initKebabMenus();
    });

    // Kebab Menu Logic
    let activeMenu = null;

    function initKebabMenus() {
      // Toggle menu on button click
      document.querySelectorAll('.kebab-menu-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const container = this.closest('.kebab-menu-container');
          const dropdown = container.querySelector('.kebab-menu-dropdown');
          
          // Close any other open menus
          if (activeMenu && activeMenu !== dropdown) {
            activeMenu.classList.remove('show');
            activeMenu.previousElementSibling?.classList.remove('active');
          }
          
          // Toggle current menu
          dropdown.classList.toggle('show');
          this.classList.toggle('active');
          activeMenu = dropdown.classList.contains('show') ? dropdown : null;
        });
      });

      // Handle menu item clicks
      document.querySelectorAll('.kebab-menu-item').forEach(item => {
        item.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const dropdown = this.closest('.kebab-menu-dropdown');
          const journeyId = dropdown.getAttribute('data-journey-id');
          const journeyTitle = dropdown.getAttribute('data-journey-title');
          const action = this.getAttribute('data-action');
          
          // Close menu
          dropdown.classList.remove('show');
          dropdown.previousElementSibling?.classList.remove('active');
          activeMenu = null;
          
          // Execute action
          switch(action) {
            case 'preview':
              // Navigate to preview mode
              window.location.href = `/dashboard/preview/${journeyId}`;
              break;
            case 'publish':
              changeJourneyStatus(journeyId, journeyTitle, 'published');
              break;
            case 'unpublish':
              changeJourneyStatus(journeyId, journeyTitle, 'draft');
              break;
            case 'copy':
              copyJourney(journeyId, journeyTitle);
              break;
            case 'copy-translate':
              showCopyTranslateModal(journeyId, journeyTitle);
              break;
            case 'rename':
              renameJourney(journeyId, journeyTitle);
              break;
            case 'convert-public':
              showConvertToPublicModal(journeyId, journeyTitle);
              break;
            case 'convert-private':
              convertToPrivate(journeyId, journeyTitle);
              break;
            case 'delete':
              deleteJourney(journeyId, journeyTitle);
              break;
            case 'restore':
              restoreJourney(journeyId, journeyTitle);
              break;
            case 'delete-permanent':
              deleteJourneyPermanent(journeyId, journeyTitle);
              break;
          }
        });
      });

      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (activeMenu && !e.target.closest('.kebab-menu-container')) {
          activeMenu.classList.remove('show');
          activeMenu.previousElementSibling?.classList.remove('active');
          activeMenu = null;
        }
      });

      // Close menu on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && activeMenu) {
          activeMenu.classList.remove('show');
          activeMenu.previousElementSibling?.classList.remove('active');
          activeMenu = null;
        }
      });
    }
    
    // Copy public link from kebab menu
    document.querySelectorAll('.copy-public-link-menu').forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const link = this.dataset.link;
        
        try {
          await navigator.clipboard.writeText(link);
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.linkCopied'))%>);
          
          // Close the menu
          const menu = this.closest('.kebab-menu-dropdown');
          if (menu) {
            menu.classList.remove('show');
            menu.previousElementSibling?.classList.remove('active');
          }
        } catch (err) {
          // Fallback for older browsers
          const tempInput = document.createElement('input');
          tempInput.value = link;
          document.body.appendChild(tempInput);
          tempInput.select();
          document.execCommand('copy');
          document.body.removeChild(tempInput);
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.linkCopied'))%>);
        }
      });
    });

    // Change journey status (publish, unpublish)
    async function changeJourneyStatus(journeyId, journeyTitle, newStatus) {
      const title = decodeHtmlEntities(String(journeyTitle));
      
      // Get confirmation messages based on status
      let confirmTemplate;
      if (newStatus === 'published') {
        confirmTemplate = <%-safeJson(t('journeys.actions.confirmPublish'))%>;
      } else {
        confirmTemplate = <%-safeJson(t('journeys.actions.confirmUnpublish'))%>;
      }
      
      const confirmMessage = confirmTemplate.replace(/\{\{title\}\}/g, title);
      
      // Publish/unpublish/archive are not destructive actions
      if (!await window.gryffi.modal.confirm(confirmMessage, { danger: false })) {
        return false;
      }

      try {
        const response = await fetch(`/api/journeys/${journeyId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });

        const data = await response.json();

        if (data.success) {
          // Show success message based on new status
          let successMsg;
          if (newStatus === 'published') {
            successMsg = <%-safeJson(t('journeys.actions.publishedSuccess'))%>;
          } else {
            successMsg = <%-safeJson(t('journeys.actions.unpublishedSuccess'))%>;
          }
          window.gryffi.toast.success(successMsg);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          // Handle specific error codes
          if (data.code === 'NO_START_STEP') {
            await window.gryffi.modal.alert(<%-safeJson(t('journeys.publish.noStartStep'))%>, { type: 'error' });
          } else if (data.code === 'NO_END_STEP') {
            await window.gryffi.modal.alert(<%-safeJson(t('journeys.publish.noEndStep'))%>, { type: 'error' });
          } else {
            await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.actions.statusError'))%>, { type: 'error' });
          }
        }
      } catch (err) {
        console.error('Status change error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.actions.statusError'))%>, { type: 'error' });
      }
      
      return false;
    }

    // Delete journey (move to trash)
    async function deleteJourney(journeyId, journeyTitle) {
      const title = decodeHtmlEntities(String(journeyTitle));
      
      try {
        // First get impact analysis
        const impactResponse = await fetch(`/api/journeys/${journeyId}/impact`);
        const impactData = await impactResponse.json();
        
        if (!impactData.success) {
          await window.gryffi.modal.alert(impactData.error || <%-safeJson(t('journeys.delete.error'))%>, { type: 'error' });
          return false;
        }
        
        const impact = impactData.impact;
        
        // Check if journey is published - must unpublish first
        if (impact.mustUnpublishFirst) {
          showImpactModal({
            title: <%-safeJson(t('journeys.delete.cannotDelete'))%>,
            message: <%-safeJson(t('journeys.delete.mustUnpublishFirst'))%>,
            journeyTitle: title,
            showActions: false,
            icon: 'warning'
          });
          return false;
        }
        
        // Build impact message
        let impactItems = [];
        
        if (impact.activeInvitations > 0) {
          const invitationText = impact.activeInvitations === 1 
            ? <%-safeJson(t('journeys.delete.activeInvitations_one'))%>: <%-safeJson(t('journeys.delete.activeInvitations_other'))%>;
          impactItems.push(`• ${impact.activeInvitations} ${invitationText}`);
        }
        
        if (impact.hasActiveRewards) {
          const claimedText = impact.totalClaimedCodes === 1
            ? <%-safeJson(t('journeys.delete.claimedCodes_one'))%>: <%-safeJson(t('journeys.delete.claimedCodes_other'))%>;
          impactItems.push(`• ${impact.totalClaimedCodes} ${claimedText}`);
          if (impact.totalUnclaimedCodes > 0) {
            const unclaimedText = impact.totalUnclaimedCodes === 1
              ? <%-safeJson(t('journeys.delete.unclaimedCodesWillBeCancelled_one'))%>: <%-safeJson(t('journeys.delete.unclaimedCodesWillBeCancelled_other'))%>;
            impactItems.push(`• ${impact.totalUnclaimedCodes} ${unclaimedText}`);
          }
        }
        
        // Determine if we need to show modal
        const hasImpact = impactItems.length > 0 || impact.hasActiveRewards || impact.hasPolls;
        let archivePolls = false;
        
        // Show impact modal if there's any impact
        if (hasImpact) {
          const confirmMsgTemplate = <%-safeJson(t('journeys.delete.confirm'))%>;
          const confirmMsg = confirmMsgTemplate.replace(/\{\{title\}\}/g, title);
          const result = await showImpactModal({
            title: <%-safeJson(t('journeys.delete.confirmTitle'))%>,
            journeyTitle: title,
            message: impactItems.length > 0 
              ? <%-safeJson(t('journeys.delete.impactWarning'))%>: confirmMsg,
            impactItems: impactItems,
            rewards: impact.rewards.filter(r => r.claimedCount > 0),
            polls: impact.polls,
            totalPollResponses: impact.totalPollResponses,
            hasPolls: impact.hasPolls,
            showActions: true,
            confirmText: <%-safeJson(t('journeys.delete.confirmButton'))%>,
            cancelText: <%-safeJson(t('common.cancel'))%>,
            icon: (impact.hasActiveRewards || impact.hasPolls) ? 'warning' : 'info'
          });
          
          if (!result) return false;
          archivePolls = result.archivePolls || false;
        } else {
          // Simple confirmation for journeys without impact
          const confirmTemplate = <%-safeJson(t('journeys.delete.confirm'))%>;
          const confirmMessage = confirmTemplate.replace(/\{\{title\}\}/g, title);
          if (!await window.gryffi.modal.confirm(confirmMessage)) return false;
        }
        
        // Proceed with deletion
        const response = await fetch(`/api/journeys/${journeyId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            confirmRewardsArchive: true,
            archivePolls: archivePolls
          })
        });

        const data = await response.json();

        if (data.success) {
          let message = <%-safeJson(t('journeys.delete.movedToTrash'))%>;
          const archived = [];
          if (data.archivedRewards > 0) {
            const rewardsText = data.archivedRewards === 1
              ? <%-safeJson(t('journeys.delete.rewardsArchived_one'))%>: <%-safeJson(t('journeys.delete.rewardsArchived_other'))%>;
            archived.push(`${data.archivedRewards} ${rewardsText}`);
          }
          if (data.archivedPolls > 0) {
            const pollsText = data.archivedPolls === 1
              ? <%-safeJson(t('journeys.delete.pollsArchived_one'))%>: <%-safeJson(t('journeys.delete.pollsArchived_other'))%>;
            archived.push(`${data.archivedPolls} ${pollsText}`);
          }
          if (archived.length > 0) {
            message += ` (${archived.join(', ')})`;
          }
          window.gryffi.toast.success(message);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          if (data.code === 'MUST_UNPUBLISH_FIRST') {
            showImpactModal({
              title: <%-safeJson(t('journeys.delete.cannotDelete'))%>,
              message: data.error,
              journeyTitle: title,
              showActions: false,
              icon: 'warning'
            });
          } else {
            await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.delete.error'))%>, { type: 'error' });
          }
        }
      } catch (err) {
        console.error('Delete error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.delete.error'))%>, { type: 'error' });
      }
      
      return false;
    }
    
    // Show impact modal for journey deletion
    function showImpactModal(options) {
      return new Promise((resolve) => {
        // Remove existing modal if any
        document.getElementById('impactModal')?.remove();
        
        const iconSvg = options.icon === 'warning' 
          ? `<svg style="width: 24px; height: 24px; color: #f59e0b;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>`
          : `<svg style="width: 24px; height: 24px; color: var(--gryffi-primary, #0b4b34);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>`;
        
        let rewardsHtml = '';
        if (options.rewards && options.rewards.length > 0) {
          rewardsHtml = `
            <div style="margin-top: 12px;">
              <p style="font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;"><%= t('journeys.delete.activeRewards') %>:</p>
              ${options.rewards.map(r => `
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #ecf2eb; border-radius: 8px; font-size: 14px; margin-bottom: 4px;">
                  <span style="font-weight: 500; color: #374151;">${escapeHtml(r.title)}</span>
                  <span style="color: #64748b;">${r.claimedCount} <%= t('journeys.delete.claimed') %></span>
                </div>
              `).join('')}
              <p style="font-size: 12px; color: #64748b; margin-top: 8px;"><%= t('journeys.delete.rewardsWillBeArchivedNote') %></p>
            </div>
          `;
