    <% /* Demo Journey Card - Shown below user journeys */ %>
    <% if (typeof demoJourney !== 'undefined' && demoJourney && !(typeof isTrash !== 'undefined' && isTrash)) { %>
      <div class="mt-12">
        <div class="demo-journey-section">
          <div class="demo-journey-header">
            <div class="demo-journey-badge">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= t('onboarding.demoJourney.badge') %>
            </div>
            <p class="demo-journey-hint"><%= t('onboarding.demoJourney.hint') %></p>
          </div>
          <a href="/dashboard/builder/<%= demoJourney.id %>" class="demo-journey-card group">
            <div class="demo-journey-icon">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <div class="demo-journey-content">
              <h3 class="demo-journey-title"><%= demoJourney.title %></h3>
              <p class="demo-journey-description"><%= demoJourney.description || t('onboarding.demoJourney.defaultDescription') %></p>
              <div class="demo-journey-meta">
                <span><%= demoJourney.step_count %> <%= t('common.steps') %></span>
                <span class="demo-journey-cta"><%= t('onboarding.demoJourney.viewBuilder') %> →</span>
              </div>
