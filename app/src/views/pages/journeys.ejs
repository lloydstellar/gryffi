    <% } else { %>
      <div class="glass-card-solid p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gryffi-accent/20 flex items-center justify-center">
          <% if (typeof isTrash !== 'undefined' && isTrash) { %>
            <svg class="w-8 h-8 text-gryffi-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          <% } else { %>
            <svg class="w-8 h-8 text-gryffi-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
            </svg>
          <% } %>
        </div>
        <h3 class="text-lg font-semibold text-zen-900 mb-2">
          <%= (typeof isTrash !== 'undefined' && isTrash) ? t('journeys.trash.empty') : t('journeys.noJourneys') %>
        </h3>
        <p class="text-zen-500 mb-6 max-w-sm mx-auto">
          <%= (typeof isTrash !== 'undefined' && isTrash) ? t('journeys.trash.emptyDescription') : t('journeys.noJourneysDescription') %>
        </p>
        <% if (typeof isTrash !== 'undefined' && isTrash) { %>
          <a href="/dashboard/journeys" class="btn-secondary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <%= t('journeys.trash.backToJourneys') %>
          </a>
        <% } else { %>
          <% if (user && user.role === 'viewer') { %>
            <span class="btn-primary opacity-50 cursor-not-allowed" title="<%= t('team.messages.viewerReadOnlyGeneric') %>">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('journeys.createJourney') %>
            </span>
          <% } else if (subscriptionUsage && subscriptionUsage.journeys && subscriptionUsage.journeys.isAtLimit) { %>
            <!-- Journey limit reached - empty state -->
            <div class="tier-limit-block tier-limit-block-centered">
              <span class="btn-primary btn-disabled" title="<%= t('subscription.limits.limitReached') %>">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <%= t('journeys.createJourney') %>
              </span>
              <div class="tier-limit-message">
                <span><%= t('subscription.limits.journeyLimitInfo', { limit: subscriptionUsage.journeys.limit }) %></span>
                <a href="/dashboard/subscription" class="tier-upgrade-link"><%= t('subscription.limits.wantMore') %> <%= t('subscription.cta.upgradeNow') %> →</a>
              </div>
