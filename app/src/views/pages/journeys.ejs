            <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
              <p style="font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 8px;"><%= t('journeys.delete.pollsFound') %>:</p>
              ${options.polls.map(p => `
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #f8fafc; border-radius: 8px; font-size: 14px; margin-bottom: 4px;">
                  <span style="color: #374151;">${escapeHtml(p.question || p.stepTitle)}</span>
                  <span style="color: #64748b;">${p.responseCount} <%= t('journeys.delete.responses') %></span>
                </div>
              `).join('')}
              
              <div style="margin-top: 12px; padding: 12px; background: #f8fafc; border-radius: 8px;">
                <p style="font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 8px;"><%= t('journeys.delete.pollDataQuestion') %></p>
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; margin-bottom: 8px;">
                  <input type="radio" name="pollChoice" value="archive" checked style="margin-top: 3px; accent-color: var(--gryffi-primary, #0b4b34);">
                  <div>
                    <span style="font-size: 13px; font-weight: 500; color: #374151;"><%= t('journeys.delete.archivePolls') %></span>
                    <p style="font-size: 12px; color: #64748b; margin-top: 2px;"><%= t('journeys.delete.archivePollsDesc') %></p>
                  </div>
                </label>
                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                  <input type="radio" name="pollChoice" value="delete" style="margin-top: 3px; accent-color: var(--gryffi-primary, #0b4b34);">
                  <div>
                    <span style="font-size: 13px; font-weight: 500; color: #374151;"><%= t('journeys.delete.deletePolls') %></span>
                    <p style="font-size: 12px; color: #64748b; margin-top: 2px;"><%= t('journeys.delete.deletePollsDesc') %></p>
                  </div>
                </label>
              </div>
            </div>
          `;
        }
        
        const impactListHtml = options.impactItems && options.impactItems.length > 0
          ? `<ul style="margin-top: 12px; list-style: none; padding: 0;">${options.impactItems.map(item => `<li style="font-size: 14px; color: #4b5563; margin-bottom: 4px;">${escapeHtml(item)}</li>`).join('')}</ul>`
          : '';
        
        const actionsHtml = options.showActions
          ? `<div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
              <button id="impactModalCancel" style="padding: 8px 16px; color: #64748b; background: transparent; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
                ${options.cancelText || <%-safeJson(t('common.cancel'))%>}
              </button>
              <button id="impactModalConfirm" style="padding: 8px 16px; background: #dc2626; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
                ${options.confirmText || <%-safeJson(t('common.confirm'))%>}
              </button>
            </div>`
          : `<div style="display: flex; justify-content: flex-end; margin-top: 24px;">
              <button id="impactModalClose" style="padding: 8px 16px; background: var(--gryffi-primary, #0b4b34); color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500;">
                <%= t('common.ok') %>
              </button>
            </div>`;
        
        const modal = document.createElement('div');
        modal.id = 'impactModal';
        modal.style.cssText = 'position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5);';
        modal.innerHTML = `
          <div style="background: white; border-radius: 12px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); max-width: 28rem; width: calc(100% - 32px); margin: 16px; padding: 24px; max-height: 90vh; overflow-y: auto;">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
              <div style="flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; background: ${options.icon === 'warning' ? '#fef3c7' : '#ecf2eb'}; display: flex; align-items: center; justify-content: center;">
                ${iconSvg}
              </div>
              <div style="flex: 1; min-width: 0;">
                <h3 style="font-size: 18px; font-weight: 600; color: #1f2937;">${options.title}</h3>
                <p style="font-size: 14px; color: #4b5563; margin-top: 4px;">"${escapeHtml(options.journeyTitle)}"</p>
                <p style="font-size: 14px; color: #4b5563; margin-top: 12px;">${escapeHtml(options.message)}</p>
                ${impactListHtml}
                ${rewardsHtml}
                ${pollsHtml}
              </div>
            </div>
            ${actionsHtml}
          </div>
        `;
        
        document.body.appendChild(modal);
        
        // Event handlers
        document.getElementById('impactModalCancel')?.addEventListener('click', () => {
          modal.remove();
          resolve(false);
        });
        
        document.getElementById('impactModalConfirm')?.addEventListener('click', () => {
          // Get poll choice if polls exist
          const pollChoice = modal.querySelector('input[name="pollChoice"]:checked')?.value;
          modal.remove();
          resolve({ 
            confirmed: true, 
            archivePolls: pollChoice === 'archive' 
          });
        });
        
        document.getElementById('impactModalClose')?.addEventListener('click', () => {
          modal.remove();
          resolve(false);
        });
        
        // Close on backdrop click
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.remove();
            resolve(false);
          }
        });
      });
    }

    // Show limit exceeded modal with upgrade CTA
    async function showLimitExceededModal(limitType) {
      const resourceLabels = {
        journeys: <%-safeJson(t('subscription.features.journeys'))%>,
        guides: <%-safeJson(t('subscription.features.guides'))%>,
        endUsers: <%-safeJson(t('subscription.features.endUsers'))%>,
        makers: <%-safeJson(t('subscription.features.makers'))%>
      };
      
      const resourceName = resourceLabels[limitType] || limitType;
      const message = <%-safeJson(t('subscription.banner.limitReached'))%>.replace('{{resource}}', resourceName);
      
      const result = await window.gryffi.modal.confirm(
        `<div style="text-align: center;">
          <p style="margin: 0 0 16px; color: #4b5563;">${message}</p>
          <p style="margin: 0; font-size: 13px; color: #6b7280;">${<%-safeJson(t('subscription.limits.wantMore'))%>}</p>
        </div>`,
        {
          title: <%-safeJson(t('subscription.limits.limitReached'))%>,
          type: 'warning',
          danger: false,
          okText: <%-safeJson(t('subscription.cta.upgradeNow'))%>,
          cancelText: <%-safeJson(t('common.cancel'))%>
        }
      );
      
      if (result) {
        window.location.href = '/dashboard/subscription';
      }
      
      return result;
    }

    // Copy journey
    async function renameJourney(journeyId, journeyTitle) {
      const currentTitle = decodeHtmlEntities(String(journeyTitle));

      const newTitleRaw = await window.gryffi.modal.prompt(
        <%-safeJson(t('journeys.rename.message'))%>,
        {
          title: <%-safeJson(t('journeys.rename.title'))%>,
          defaultValue: currentTitle,
          placeholder: <%-safeJson(t('journeys.rename.placeholder'))%>
        }
      );

      // User cancelled (null) or closed via Esc/backdrop
      if (newTitleRaw === null || newTitleRaw === undefined) return false;

      const newTitle = String(newTitleRaw).trim();

      if (!newTitle) {
        await window.gryffi.modal.alert(
          <%-safeJson(t('journeys.rename.emptyError'))%>,
          { type: 'error' }
        );
        return false;
      }

      // No-op if unchanged
      if (newTitle === currentTitle) return false;

      try {
        const response = await fetch(`/api/journeys/${journeyId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: newTitle })
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok && data.success) {
          window.gryffi.toast.success(<%-safeJson(t('journeys.rename.success'))%>);
          setTimeout(() => window.location.reload(), 1000);
        } else {
          await window.gryffi.modal.alert(
            data.error || <%-safeJson(t('journeys.rename.error'))%>,
            { type: 'error' }
          );
        }
      } catch (err) {
        console.error('Rename error:', err);
        await window.gryffi.modal.alert(
          <%-safeJson(t('journeys.rename.error'))%>,
          { type: 'error' }
        );
      }

      return false;
    }

    async function copyJourney(journeyId, journeyTitle) {
      const title = decodeHtmlEntities(String(journeyTitle));
      const confirmTemplate = <%-safeJson(t('journeys.copy.confirm'))%>;
      const confirmMessage = confirmTemplate.replace(/\{\{title\}\}/g, title);
      
      // Copy is a positive action
      if (!await window.gryffi.modal.confirm(confirmMessage, { danger: false })) {
        return false;
      }

      try {
        const response = await fetch(`/api/journeys/${journeyId}/copy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok && data.success) {
          window.gryffi.toast.success(<%-safeJson(t('journeys.copy.success'))%>);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else if (data.code === 'LIMIT_EXCEEDED') {
          await showLimitExceededModal(data.limitType || 'journeys');
        } else {
          await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.copy.error'))%>, { type: 'error' });
        }
      } catch (err) {
        console.error('Copy error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.copy.error'))%>, { type: 'error' });
      }
      
      return false;
    }

    // Show copy & translate modal
    async function showCopyTranslateModal(journeyId, journeyTitle) {
      const title = decodeHtmlEntities(String(journeyTitle));
      
      // Fetch supported languages
      let languages = [];
      try {
