              <div class="flex items-center justify-between mt-4 pt-4 border-t border-zen-100">
                <span class="text-xs text-zen-400">
                  <%= t('common.by') %> <%= journey.created_by_name || t('common.unknown') %>
                  <% if (typeof isTrash !== 'undefined' && isTrash && journey.deleted_at) { %>
                    · <%= t('journeys.trash.deleted') %> <%= new Date(journey.deleted_at).toLocaleDateString(language) %>
                  <% } %>
                </span>
                <% if (typeof isTrash !== 'undefined' && isTrash && journey.deleted_at && trashRetentionDays > 0) { %>
                  <% 
                    const deletedDate = new Date(journey.deleted_at);
                    const permanentDeleteDate = new Date(deletedDate.getTime() + (trashRetentionDays * 24 * 60 * 60 * 1000));
                    const daysRemaining = Math.ceil((permanentDeleteDate - new Date()) / (24 * 60 * 60 * 1000));
                    const isUrgent = daysRemaining <= 3;
                  %>
                  <span class="text-xs <%= isUrgent ? 'text-red-500 font-medium' : 'text-zen-400' %>">
                    <%= t('journeys.trash.permanentDeleteOn') %> <%= permanentDeleteDate.toLocaleDateString(language) %>
                    <% if (daysRemaining > 0) { %>
                      (<%= daysRemaining %> <%= t('subscription.days') %>)
