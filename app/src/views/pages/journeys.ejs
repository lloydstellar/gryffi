<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('pages.journeys') %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .btn-secondary {
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid #d1d5db;
      background: white;
      color: #374151;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
    }

    #copyTranslateModal select:focus,
    #copyTranslateModal input:focus {
      outline: none;
      border-color: var(--gryffi-primary, #0b4b34);
      box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.1);
    }

    @keyframes ctSpin {
      to { transform: translateY(-50%) rotate(360deg); }
    }
    
    /* Kebab Menu Styles */
    .kebab-menu-container {
      position: relative;
      z-index: 1;
    }
    
    /* Ensure journey card with open menu is always on top */
    .journey-card:has(.kebab-menu-dropdown.show) {
      z-index: 100 !important;
      transform: none !important;
    }
    .kebab-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: #64748b;
      transition: all 0.15s;
    }
    .kebab-menu-btn:hover {
      background: rgba(11, 75, 52, 0.08);
      color: #0b4b34;
    }
    .kebab-menu-btn.active {
      background: rgba(11, 75, 52, 0.12);
      color: #0b4b34;
    }
    .kebab-menu-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      margin-top: 4px;
      min-width: 180px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(0, 0, 0, 0.06);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scale(0.95);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 1001;
      overflow: hidden;
    }
    .kebab-menu-dropdown.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }
    .kebab-menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 10px 14px;
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 14px;
      font-weight: 500;
      color: #334155;
      text-align: left;
      transition: all 0.1s;
    }
    .kebab-menu-item:hover {
      background: rgba(11, 75, 52, 0.06);
      color: #0b4b34;
    }
    .kebab-menu-item svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    .kebab-menu-item.publish-item {
      color: #0b4b34;
    }
    .kebab-menu-item.publish-item:hover {
      background: rgba(11, 75, 52, 0.1);
    }
    .kebab-menu-item.unpublish-item {
      color: #d97706;
    }
    .kebab-menu-item.unpublish-item:hover {
      background: rgba(217, 119, 6, 0.08);
    }
    .kebab-menu-item.delete-item {
      color: #dc2626;
    }
    .kebab-menu-item.delete-item:hover {
      background: rgba(220, 38, 38, 0.08);
    }
    .kebab-menu-item.restore-item {
      color: #0b4b34;
    }
    .kebab-menu-item.restore-item:hover {
      background: rgba(11, 75, 52, 0.1);
    }
    .kebab-menu-item.preview-item {
      color: #0b4b34;
    }
    .kebab-menu-item.preview-item:hover {
      background: rgba(11, 75, 52, 0.1);
    }
    .kebab-menu-divider {
      height: 1px;
      background: #e5e7eb;
      margin: 4px 0;
      gap: 8px;
    }
    .btn-secondary:hover {
      background: #f9fafb;
      border-color: #9ca3af;
    }
    
    /* Public Journey Badge */
    .badge-public {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: rgba(185, 70, 70, 0.12);
      color: #a94442;
      font-size: 12px;
      font-weight: 600;
      border-radius: 50px;
    }
    
    /* Kebab menu items for public/private */
    .kebab-menu-item.public-item {
      color: #5a9302;
    }
    .kebab-menu-item.public-item:hover {
      background: rgba(120, 197, 3, 0.1);
    }
    .kebab-menu-item.private-item {
      color: #6b7280;
    }
    .kebab-menu-item.private-item:hover {
      background: rgba(107, 114, 128, 0.08);
    }
    
    /* Demo Journey Section */
    .demo-journey-section {
      background: linear-gradient(135deg, rgba(11, 75, 52, 0.04) 0%, rgba(120, 197, 3, 0.06) 100%);
      border: 1px dashed rgba(11, 75, 52, 0.2);
      border-radius: 16px;
      padding: 20px;
    }
    
    .demo-journey-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    
    .demo-journey-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: rgba(11, 75, 52, 0.1);
      color: var(--theme-primary, #0b4b34);
      font-size: 12px;
      font-weight: 600;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .demo-journey-hint {
      font-size: 13px;
      color: var(--theme-primary, #0b4b34);
      opacity: 0.7;
      margin: 0;
    }
    
    .demo-journey-card {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
      background: rgba(255, 255, 255, 0.9);
      border-radius: 12px;
      border: 1px solid rgba(11, 75, 52, 0.1);
      text-decoration: none;
      transition: all 0.2s ease;
    }
    
    .demo-journey-card:hover {
      background: white;
      border-color: var(--theme-primary, #0b4b34);
      box-shadow: 0 4px 12px rgba(11, 75, 52, 0.1);
      transform: translateY(-2px);
    }
    
    .demo-journey-icon {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--theme-primary, #0b4b34);
      border-radius: 12px;
      color: white;
    }
    
    .demo-journey-content {
      flex: 1;
      min-width: 0;
    }
    
    .demo-journey-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--theme-primary, #0b4b34);
      margin: 0 0 6px 0;
    }
    
    .demo-journey-description {
      font-size: 14px;
      color: var(--theme-primary, #0b4b34);
      opacity: 0.7;
      margin: 0 0 12px 0;
      line-height: 1.5;
    }
    
    .demo-journey-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: var(--theme-primary, #0b4b34);
    }
    
    .demo-journey-meta span:first-child {
      opacity: 0.6;
    }
    
    .demo-journey-cta {
      font-weight: 600;
      color: var(--theme-accent, #78c503);
      opacity: 1 !important;
    }
    
    .demo-journey-card:hover .demo-journey-cta {
      color: var(--theme-primary, #0b4b34);
    }
    
    @media (max-width: 640px) {
      .demo-journey-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      
      .demo-journey-card {
        flex-direction: column;
        text-align: center;
      }
      
      .demo-journey-icon {
        margin: 0 auto;
      }
      
      .demo-journey-meta {
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>
  <%- include('../partials/tier-limit-styles') %>
</head>
<body class="bg-gryffi-bg">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/help-modal') %>
  <%- include('../partials/support-modal') %>
  
  <main class="main-content">
    <%- include('../partials/free-tier-banner') %>
    <%- include('../partials/ai-credits-banner') %>
    
    <div class="flex items-center justify-between mb-8">
      <div class="page-header mb-0">
        <h1 class="page-title"><%= (typeof isTrash !== 'undefined' && isTrash) ? t('journeys.trash.title') : t('journeys.title') %></h1>
        <p class="page-subtitle"><%= (typeof isTrash !== 'undefined' && isTrash) ? t('journeys.trash.subtitle') : t('journeys.subtitle') %></p>
      </div>
      <div class="flex items-center gap-3">
        <% if (typeof isTrash !== 'undefined' && isTrash) { %>
          <a href="/dashboard/journeys" class="btn-secondary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <%= t('journeys.trash.backToJourneys') %>
          </a>
        <% } else { %>
          <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
            <a href="/dashboard/journeys/trash" class="btn-secondary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <%= t('journeys.trash.viewTrash') %>
            </a>
          <% } %>
          <% if (user && user.role === 'viewer') { %>
            <span class="btn-primary opacity-50 cursor-not-allowed" title="<%= t('team.messages.viewerReadOnlyGeneric') %>">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('journeys.createJourney') %>
            </span>
          <% } else if (subscriptionUsage && subscriptionUsage.journeys && subscriptionUsage.journeys.isAtLimit) { %>
            <!-- Journey limit reached -->
            <div class="tier-limit-block">
              <span class="btn-primary btn-disabled" title="<%= t('subscription.limits.limitReached') %>">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <%= t('journeys.createJourney') %>
              </span>
              <div class="tier-limit-message">
                <span><%= t('subscription.limits.journeyLimitInfo', { limit: subscriptionUsage.journeys.limit }) %></span>
                <a href="/dashboard/subscription" class="tier-upgrade-link"><%= t('subscription.limits.wantMore') %> <%= t('subscription.cta.upgradeNow') %> →</a>
              </div>
            </div>
          <% } else { %>
            <button type="button" data-journey-create-trigger class="btn-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t('journeys.createJourney') %>
            </button>
          <% } %>
        <% } %>
      </div>
    </div>

    <% if (journeys && journeys.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <% journeys.forEach(journey => { %>
          <div class="journey-card group relative">
            <% if (typeof isTrash !== 'undefined' && isTrash) { %>
            <div class="block cursor-default">
            <% } else { %>
            <a href="/dashboard/builder/<%= journey.id %>" class="block">
            <% } %>
              <div class="flex items-start justify-between relative">
                <div class="flex-1 min-w-0">
                  <h3 class="journey-card-title group-hover:text-gryffi-primary transition-colors"><%= journey.title %></h3>
                  <p class="journey-card-meta">
                    <%= journey.step_count || 0 %> <%= t('common.steps') %>
                  </p>
                </div>
                <div class="flex items-start gap-2 flex-shrink-0 relative z-10">
                  <!-- Badges stacked vertically -->
                  <div class="flex flex-col items-end" style="gap: 6px;">
                    <span class="<%= journey.status === 'published' ? 'badge-published' : 'badge-draft' %>">
                      <%= t('journeys.status.' + (journey.status === 'archived' ? 'draft' : journey.status)) %>
                    </span>
                    <% if (journey.is_public) { %>
                      <span class="badge-public">
                        <svg style="width: 14px; height: 14px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <%= t('journeys.public.badge') %>
                      </span>
                    <% } %>
                  </div>
                  
                  <% if (typeof isTrash !== 'undefined' && isTrash) { %>
                    <!-- Trash view: Kebab menu for restore and delete -->
                    <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
                      <div class="kebab-menu-container">
                        <button type="button" class="kebab-menu-btn" title="<%= t('common.actions') %>">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                          </svg>
                        </button>
                        <div class="kebab-menu-dropdown" data-journey-id="<%= journey.id %>" data-journey-title="<%= journey.title %>" data-journey-status="<%= journey.status %>">
                          <button type="button" class="kebab-menu-item restore-item" data-action="restore">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            <%= t('journeys.trash.restore') %>
                          </button>
                          <div class="kebab-menu-divider"></div>
                          <button type="button" class="kebab-menu-item delete-item" data-action="delete-permanent">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            <%= t('journeys.trash.deletePermanent') %>
                          </button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <!-- Kebab Menu for regular journeys -->
                    <% if (user && user.role !== 'viewer') { %>
                      <div class="kebab-menu-container">
                        <button type="button" class="kebab-menu-btn" title="<%= t('common.actions') %>">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                          </svg>
                        </button>
                        <div class="kebab-menu-dropdown" data-journey-id="<%= journey.id %>" data-journey-title="<%= journey.title %>" data-journey-status="<%= journey.status %>" data-journey-public="<%= journey.is_public %>" data-journey-public-token="<%= journey.public_token || '' %>">
                          <!-- Preview option - available to all roles -->
                          <button type="button" class="kebab-menu-item preview-item" data-action="preview">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= t('journeys.actions.preview') %>
                          </button>
                          
                          <% if (journey.is_public && journey.public_token && journey.status === 'published') { %>
                          <!-- Copy public link - only for published public journeys -->
                          <button type="button" class="kebab-menu-item public-item copy-public-link-menu" data-action="copy-public-link" data-link="<%= typeof APP_URL !== 'undefined' ? APP_URL : '' %>/p/<%= journey.public_token %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                            </svg>
                            <%= t('journeys.public.copyLink') %>
                          </button>
                          <% } %>
                          
                          <div class="kebab-menu-divider"></div>
                          
                          <!-- Status change options -->
                          <% if (journey.status !== 'published') { %>
                            <% if (user.role === 'admin' || user.role === 'manager') { %>
                              <button type="button" class="kebab-menu-item publish-item" data-action="publish">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <%= t('journeys.actions.publish') %>
                              </button>
                            <% } %>
                          <% } %>
                          <% if (journey.status === 'published') { %>
                            <% if (user.role === 'admin' || user.role === 'manager') { %>
                              <button type="button" class="kebab-menu-item unpublish-item" data-action="unpublish">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <%= t('journeys.actions.unpublish') %>
                              </button>
                            <% } %>
                          <% } %>
                          <div class="kebab-menu-divider"></div>
                          
                          <!-- Copy -->
                          <button type="button" class="kebab-menu-item" data-action="copy">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                            </svg>
                            <%= t('journeys.actions.copy') %>
                          </button>
                          
                          <!-- Copy & Translate -->
                          <button type="button" class="kebab-menu-item" data-action="copy-translate">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                            </svg>
                            <%= t('journeys.copyTranslate.menuItem') %>
                          </button>
                          
                          <% if (user.role === 'admin' || user.role === 'manager') { %>
                          <!-- Rename -->
                          <button type="button" class="kebab-menu-item" data-action="rename">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            <%= t('journeys.actions.rename') %>
                          </button>
                          <% } %>
                          
                          <% /* Public journey conversion: tier feature public_journeys */ %>
                          <% if ((user.role === 'admin' || user.role === 'manager') && subscriptionTier && subscriptionTier.features?.publicJourneys) { %>
                            <div class="kebab-menu-divider"></div>
                            
                            <% if (journey.is_public) { %>
                              <!-- Convert to Private -->
                              <button type="button" class="kebab-menu-item private-item" data-action="convert-private">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                <%= t('journeys.public.convertToPrivate') %>
                              </button>
                            <% } else { %>
                              <!-- Convert to Public -->
                              <button type="button" class="kebab-menu-item public-item" data-action="convert-public">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
