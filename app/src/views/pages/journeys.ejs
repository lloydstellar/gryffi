                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-zen-900"><%= t('journeys.copyTranslate.title') %></h3>
                  <p class="text-sm text-zen-500">${escapeHtml(title)}</p>
                </div>
              </div>
              
              <!-- Form State -->
              <div id="copyTranslateForm">
                <div class="space-y-4">
                  <div>
                    <label for="targetLanguage" class="block text-sm font-medium text-zen-700 mb-1.5"><%= t('journeys.copyTranslate.selectLanguage') %></label>
                    <select id="targetLanguage" style="width:100%;padding:10px 14px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;color:#1f2937;background:white;transition:border-color 0.15s,box-shadow 0.15s;box-sizing:border-box;appearance:auto;">
                      ${languageOptionsHtml}
                    </select>
                  </div>
                  
                  <div>
                    <label for="newJourneyTitle" class="block text-sm font-medium text-zen-700 mb-1.5"><%= t('journeys.copyTranslate.newTitle') %></label>
                    <div style="position:relative;">
                      <input type="text" id="newJourneyTitle" value="${escapeHtml(title)}" style="width:100%;padding:10px 14px;padding-right:38px;border:1px solid #e5e7eb;border-radius:8px;font-size:14px;color:#1f2937;background:white;transition:border-color 0.15s,box-shadow 0.15s;box-sizing:border-box;" placeholder="<%= t('journeys.copyTranslate.newTitle') %>">
                      <div id="titleTranslateSpinner" style="display:none;position:absolute;right:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;border:2px solid #e5e7eb;border-top-color:var(--gryffi-primary,#0b4b34);border-radius:50%;animation:ctSpin .6s linear infinite;"></div>
                    </div>
                    <p id="titleTranslateHint" style="display:none;margin-top:4px;font-size:12px;color:#6b7280;"><%= t('journeys.copyTranslate.autoTranslatedHint') %></p>
                  </div>
                </div>
                
                <div class="flex gap-3 mt-6">
                  <button type="button" id="copyTranslateCancel" class="flex-1 btn-secondary">
                    <%= t('common.cancel') %>
                  </button>
                  <button type="button" id="copyTranslateConfirm" class="flex-1 btn-primary">
                    <%= t('journeys.copyTranslate.translate') %>
                  </button>
                </div>
              </div>
              
              <!-- Progress State (hidden initially) -->
              <div id="copyTranslateProgress" style="display: none;">
                <div class="mb-4">
                  <div class="flex justify-between text-sm mb-2">
                    <span id="progressStatus" class="text-zen-600"><%= t('journeys.copyTranslate.progress.starting') %></span>
                    <span id="progressPercent" class="font-medium text-zen-900">0%</span>
                  </div>
                  <div class="w-full bg-zen-100 rounded-full h-2.5 overflow-hidden">
                    <div id="progressBar" class="h-full rounded-full transition-all duration-300" style="width: 0%; background: var(--gryffi-primary, #0b4b34);"></div>
                  </div>
                </div>
                <p class="text-sm text-zen-500 text-center"><%= t('journeys.copyTranslate.progress.doNotClose') %></p>
              </div>
              
              <!-- Success State (hidden initially) -->
              <div id="copyTranslateSuccess" style="display: none;">
                <div class="text-center py-4">
                  <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(34, 197, 94, 0.1);">
                    <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <h4 class="text-lg font-semibold text-zen-900 mb-1"><%= t('journeys.copyTranslate.success') %></h4>
                  <p class="text-sm text-zen-500"><%= t('journeys.copyTranslate.successDescription') %></p>
                </div>
                <button type="button" id="copyTranslateClose" class="w-full btn-primary mt-4">
                  <%= t('common.close') %>
                </button>
              </div>
              
              <!-- Error State (hidden initially) -->
              <div id="copyTranslateError" style="display: none;">
                <div class="text-center py-4">
                  <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(239, 68, 68, 0.1);">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </div>
                  <h4 class="text-lg font-semibold text-zen-900 mb-1"><%= t('journeys.copyTranslate.error') %></h4>
                  <p id="errorMessage" class="text-sm text-zen-500"></p>
                </div>
                <button type="button" id="copyTranslateRetry" class="w-full btn-primary mt-4">
                  <%= t('common.tryAgain') %>
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
      
      document.body.insertAdjacentHTML('beforeend', modalHtml);
      const modal = document.getElementById('copyTranslateModal');
      
      const formState = document.getElementById('copyTranslateForm');
      const progressState = document.getElementById('copyTranslateProgress');
      const successState = document.getElementById('copyTranslateSuccess');
      const errorState = document.getElementById('copyTranslateError');
      
      const progressBar = document.getElementById('progressBar');
      const progressPercent = document.getElementById('progressPercent');
      const progressStatus = document.getElementById('progressStatus');
      
      // Status messages
      const statusMessages = {
        starting: <%-safeJson(t('journeys.copyTranslate.progress.starting'))%>,
        loading: <%-safeJson(t('journeys.copyTranslate.progress.loading'))%>,
        translating: <%-safeJson(t('journeys.copyTranslate.progress.translating'))%>,
        translating_guide: <%-safeJson(t('journeys.copyTranslate.progress.translatingGuide'))%>,
        creating: <%-safeJson(t('journeys.copyTranslate.progress.creating'))%>,
        creating_steps: <%-safeJson(t('journeys.copyTranslate.progress.creatingSteps'))%>,
        creating_paths: <%-safeJson(t('journeys.copyTranslate.progress.creatingPaths'))%>,
        finishing: <%-safeJson(t('journeys.copyTranslate.progress.finishing'))%>};
      
      // Handle cancel
      document.getElementById('copyTranslateCancel').addEventListener('click', () => {
        modal.remove();
      });
      
      // Handle backdrop click (only when in form state)
      modal.addEventListener('click', (e) => {
        if (e.target === modal && formState.style.display !== 'none') {
          modal.remove();
        }
      });

      // Auto-translate title when language changes
      let translateAbort = null;
      let userEditedTitle = false;
      const titleInput = document.getElementById('newJourneyTitle');
      const spinner = document.getElementById('titleTranslateSpinner');
      const hint = document.getElementById('titleTranslateHint');

      titleInput.addEventListener('input', () => { userEditedTitle = true; hint.style.display = 'none'; });

      document.getElementById('targetLanguage').addEventListener('change', async () => {
        if (userEditedTitle) return;
        const targetLang = document.getElementById('targetLanguage').value;
        if (translateAbort) translateAbort.abort();
        translateAbort = new AbortController();
        spinner.style.display = 'block';
        hint.style.display = 'none';
        try {
          const resp = await fetch('/api/translate-text', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: title, targetLang }),
            signal: translateAbort.signal
          });
          const data = await resp.json();
          if (data.success && data.translated && !userEditedTitle) {
            titleInput.value = data.translated;
            hint.style.display = 'block';
          }
        } catch (e) {
          if (e.name !== 'AbortError') console.warn('[CopyTranslate] Title translate failed:', e);
        } finally {
          spinner.style.display = 'none';
        }
      });
      
      // Handle confirm/translate
      document.getElementById('copyTranslateConfirm').addEventListener('click', async () => {
        const targetLanguage = document.getElementById('targetLanguage').value;
        const newTitle = document.getElementById('newJourneyTitle').value.trim();
        
        // Switch to progress state
        formState.style.display = 'none';
        progressState.style.display = 'block';
        
        let reader = null;
        let isCompleted = false;
        
        try {
          // Use fetch with streaming to get SSE updates
          const response = await fetch(`/api/journeys/${journeyId}/copy-translate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              target_language: targetLanguage,
              new_title: newTitle || null
            })
          });
          
          // Check for HTTP errors
          if (!response.ok && !response.headers.get('content-type')?.includes('text/event-stream')) {
            throw new Error(`HTTP error: ${response.status}`);
          }
          
          reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          
          console.log('[CopyTranslate] Starting to read SSE stream');
          
          while (true) {
            const { done, value } = await reader.read();
            if (done) {
              console.log('[CopyTranslate] SSE stream finished');
              break;
            }
            
            const chunk = decoder.decode(value, { stream: true });
            console.log('[CopyTranslate] Received chunk:', chunk);
            buffer += chunk;
            const lines = buffer.split('\n');
            buffer = lines.pop();
            
            console.log('[CopyTranslate] Processing', lines.length, 'lines');
            
            for (const line of lines) {
              console.log('[CopyTranslate] Line:', line);
              if (line.startsWith('data: ')) {
                try {
                  const data = JSON.parse(line.slice(6));
                  console.log('[CopyTranslate] Parsed data:', data);
                  
                  // Update progress
                  if (data.progress !== undefined) {
                    progressBar.style.width = data.progress + '%';
                    progressPercent.textContent = data.progress + '%';
                  }
                  
                  // Update status message
                  if (data.status && statusMessages[data.status]) {
                    progressStatus.textContent = statusMessages[data.status];
                  }
                  
                  // Handle completion
                  if (data.done) {
                    isCompleted = true;
                    progressState.style.display = 'none';
                    successState.style.display = 'block';
                    
                    // Cancel reader first
                    if (reader) {
                      try { reader.cancel(); } catch (e) {}
                      reader = null;
                    }
                    
                    // Navigate after delay - Connection: close header should prevent HTTP/2 reuse
                    setTimeout(() => {
                      window.location.href = '/dashboard/journeys';
                    }, 2000);
                    return; // Exit the handler
                  }
                  
                  // Handle error
                  if (data.status === 'error') {
                    if (reader) {
                      try { reader.cancel(); } catch (e) {}
                    }
                    
                    // Check for limit exceeded error
                    if (data.code === 'LIMIT_EXCEEDED') {
                      modal.remove();
                      await showLimitExceededModal(data.limitType || 'journeys');
                      return;
                    }
                    
                    progressState.style.display = 'none';
                    errorState.style.display = 'block';
                    document.getElementById('errorMessage').textContent = data.error || <%-safeJson(t('journeys.copyTranslate.error'))%>;
                    return; // Exit the handler
                  }
                } catch (parseError) {
                  console.error('[CopyTranslate] Failed to parse SSE data:', parseError, 'Line:', line);
                }
              }
            }
          }
          
          // Stream ended without done signal - show success anyway if completed
          if (!isCompleted) {
            console.log('[CopyTranslate] Stream ended without explicit done, showing success');
            progressState.style.display = 'none';
            successState.style.display = 'block';
            setTimeout(() => {
              window.location.href = '/dashboard/journeys';
            }, 2000);
          }
        } catch (err) {
          console.error('Copy translate error:', err);
          if (reader) {
            try { reader.cancel(); } catch (e) {}
          }
          progressState.style.display = 'none';
          errorState.style.display = 'block';
          document.getElementById('errorMessage').textContent = <%-safeJson(t('journeys.copyTranslate.error'))%>;
        }
      });
      
      // Handle close (success state)
      document.getElementById('copyTranslateClose').addEventListener('click', () => {
        window.location.href = '/dashboard/journeys';
      });
      
      // Handle retry (error state)
      document.getElementById('copyTranslateRetry').addEventListener('click', () => {
        errorState.style.display = 'none';
        formState.style.display = 'block';
        progressBar.style.width = '0%';
        progressPercent.textContent = '0%';
      });
      
      // Handle escape key (only when in form state)
      const escHandler = (e) => {
        if (e.key === 'Escape' && formState.style.display !== 'none') {
          modal.remove();
          document.removeEventListener('keydown', escHandler);
        }
      };
      document.addEventListener('keydown', escHandler);
    }

    // Show convert to public modal with warning
    async function showConvertToPublicModal(journeyId, journeyTitle) {
      const title = decodeHtmlEntities(String(journeyTitle));
      
      // Create custom modal with warning and checkbox
      const modalHtml = `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgba(0,0,0,0.5);" id="publicModal">
          <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden" style="animation: modalSlideIn 0.2s ease-out;">
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center" style="background: rgba(234, 179, 8, 0.1);">
                  <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-zen-900"><%= t('journeys.public.modal.title') %></h3>
                  <p class="text-sm text-zen-500">${escapeHtml(title)}</p>
                </div>
              </div>
              
              <div class="rounded-lg p-4 mb-4" style="background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.2);">
                <p class="text-sm font-medium text-yellow-800 mb-3"><%= t('journeys.public.modal.warning') %></p>
                <ul class="space-y-2 text-sm text-yellow-700">
                  <li class="flex items-start gap-2">
                    <svg style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= t('journeys.public.modal.warningItems.anyone') %></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= t('journeys.public.modal.warningItems.aiGuides') %></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= t('journeys.public.modal.warningItems.forms') %></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= t('journeys.public.modal.warningItems.rewards') %></span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= t('journeys.public.modal.warningItems.polls') %></span>
                  </li>
                </ul>
              </div>
              
              <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg border border-zen-200 hover:border-zen-300 transition-colors mb-4">
                <input type="checkbox" id="publicConfirmCheckbox" class="mt-0.5 w-5 h-5 rounded border-zen-300 text-gryffi-primary focus:ring-gryffi-primary">
                <span class="text-sm text-zen-700"><%= t('journeys.public.modal.checkbox') %></span>
              </label>
              
              <div class="flex gap-3">
                <button type="button" id="publicModalCancel" class="flex-1 btn-secondary">
                  <%= t('journeys.public.modal.cancel') %>
                </button>
                <button type="button" id="publicModalConfirm" disabled class="flex-1 btn-primary" style="opacity: 0.5; cursor: not-allowed;">
                  <%= t('journeys.public.modal.convert') %>
                </button>
              </div>
            </div>
          </div>
        </div>
        <style>
          @keyframes modalSlideIn {
            from { opacity: 0; transform: scale(0.95) translateY(-10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
          }
        </style>
      `;
      
      // Add modal to DOM
      document.body.insertAdjacentHTML('beforeend', modalHtml);
      const modal = document.getElementById('publicModal');
      const checkbox = document.getElementById('publicConfirmCheckbox');
      const confirmBtn = document.getElementById('publicModalConfirm');
      
      // Enable/disable confirm button based on checkbox
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          confirmBtn.disabled = false;
          confirmBtn.style.opacity = '1';
          confirmBtn.style.cursor = 'pointer';
        } else {
          confirmBtn.disabled = true;
          confirmBtn.style.opacity = '0.5';
          confirmBtn.style.cursor = 'not-allowed';
        }
      });
      
      // Handle cancel
      document.getElementById('publicModalCancel').addEventListener('click', () => {
        modal.remove();
      });
      
      // Handle backdrop click
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.remove();
        }
      });
      
      // Handle confirm
      confirmBtn.addEventListener('click', async () => {
        if (!checkbox.checked) return;
        
        modal.remove();
        await convertToPublic(journeyId, journeyTitle);
      });
      
      // Handle escape key
      const escHandler = (e) => {
        if (e.key === 'Escape') {
          modal.remove();
          document.removeEventListener('keydown', escHandler);
        }
      };
      document.addEventListener('keydown', escHandler);
    }

    // Convert journey to public
    async function convertToPublic(journeyId, journeyTitle) {
      try {
        const response = await fetch(`/api/journeys/${journeyId}/convert-public`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (data.success) {
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.convertedToPublic'))%>);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.public.convertError'))%>, { type: 'error' });
        }
      } catch (err) {
        console.error('Convert to public error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.public.convertError'))%>, { type: 'error' });
      }
    }

    // Convert journey to private
    async function convertToPrivate(journeyId, journeyTitle) {
      const title = decodeHtmlEntities(String(journeyTitle));
      
      if (!await window.gryffi.modal.confirm(`<%= t('journeys.public.convertToPrivate') %> "${title}"?`)) {
        return;
      }

      try {
        const response = await fetch(`/api/journeys/${journeyId}/convert-private`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (data.success) {
          window.gryffi.toast.success(<%-safeJson(t('journeys.public.convertedToPrivate'))%>);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.public.convertError'))%>, { type: 'error' });
        }
      } catch (err) {
        console.error('Convert to private error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.public.convertError'))%>, { type: 'error' });
      }
    }

    // Restore journey from trash
    async function restoreJourney(journeyId, journeyTitle) {
      // Decode HTML entities - getAttribute automatically decodes, but we need to handle numeric entities
      const title = decodeHtmlEntities(String(journeyTitle));
      // Get the translation string and replace the placeholder
      const confirmTemplate = <%-safeJson(t('journeys.restore.confirm'))%>;
      // Replace {{title}} with the decoded title
      const confirmMessage = confirmTemplate.replace(/\{\{title\}\}/g, title);
      
      // Restore is a positive action
      if (!await window.gryffi.modal.confirm(confirmMessage, { danger: false })) {
        return false;
      }

      try {
        const response = await fetch(`/api/journeys/${journeyId}/restore`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok && data.success) {
          // Show success message
          window.gryffi.toast.success(<%-safeJson(t('journeys.restore.success'))%>);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else if (data.code === 'LIMIT_EXCEEDED') {
          // Show special modal for limit exceeded
          await showLimitExceededModal(data.limitType || 'journeys');
        } else {
          await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.restore.error'))%>, { type: 'error' });
        }
      } catch (err) {
        console.error('Restore error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.restore.error'))%>, { type: 'error' });
      }
      
      return false;
    }

    // Permanently delete journey
    async function deleteJourneyPermanent(journeyId, journeyTitle) {
      // Decode HTML entities - getAttribute automatically decodes, but we need to handle numeric entities
      const title = decodeHtmlEntities(String(journeyTitle));
      // Get the translation string and replace the placeholder
      const confirmTemplate = <%-safeJson(t('journeys.delete.permanentConfirm'))%>;
      // Replace {{title}} with the decoded title
      const confirmMessage = confirmTemplate.replace(/\{\{title\}\}/g, title);
      
      if (!await window.gryffi.modal.confirm(confirmMessage)) {
        return false;
      }

      try {
        const response = await fetch(`/api/journeys/${journeyId}/permanent`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (data.success) {
          // Show success message
          window.gryffi.toast.success(<%-safeJson(t('journeys.delete.permanentSuccess'))%>);
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          await window.gryffi.modal.alert(data.error || <%-safeJson(t('journeys.delete.error'))%>, { type: 'error' });
        }
      } catch (err) {
        console.error('Permanent delete error:', err);
        await window.gryffi.modal.alert(<%-safeJson(t('journeys.delete.error'))%>, { type: 'error' });
      }
      
      return false;
    }
  </script>

  <%# Journey creation: choice modal + full wizard (non-viewer, no limit) %>
  <% if (user && user.role !== 'viewer' && !(subscriptionUsage && subscriptionUsage.journeys && subscriptionUsage.journeys.isAtLimit)) { %>
    <%- include('../partials/journey-create-choice-modal') %>
    <%- include('../partials/journey-wizard-modal') %>
    <script>
      // Deep link from the dashboard tip: /dashboard/journeys?create=1 opens the create dialog
      (function() {
        if (new URLSearchParams(window.location.search).get('create') !== '1') return;
        if (window.GryffiJourneyChoice && typeof window.GryffiJourneyChoice.open === 'function') {
          window.GryffiJourneyChoice.open();
        }
        history.replaceState(null, '', window.location.pathname);
      })();
    </script>
  <% } %>
</body>
</html>
