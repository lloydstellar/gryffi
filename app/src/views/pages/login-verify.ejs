<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ecf2eb;
    }
    .verify-container {
      max-width: 420px;
      padding: 48px;
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(11, 75, 52, 0.08);
      text-align: center;
    }
    .logo {
      margin-bottom: 32px;
    }
    .logo img {
      height: 48px;
      margin: 0 auto; /* Tailwind makes images block-level */
    }
    .shield-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      background: rgba(11, 75, 52, 0.08);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .shield-icon svg {
      width: 32px;
      height: 32px;
      stroke: #0b4b34;
    }
    .verify-title {
      font-size: 22px;
      font-weight: 700;
      color: #0b4b34;
      margin-bottom: 8px;
      font-family: 'Outfit', sans-serif;
    }
    .verify-subtitle {
      font-size: 14px;
      color: #5b6b80;
      margin-bottom: 24px;
    }
    .verify-explanation {
      font-size: 14px;
      color: #374151;
      line-height: 1.6;
      margin-bottom: 32px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 8px;
    }
    /* One field for the whole code: works with paste, password managers and
       the one-time-code suggestion of the phone keyboard */
    .code-input {
      display: block;
      width: 100%;
      height: 64px;
      margin-bottom: 24px;
      border: 2px solid #d1ddd0;
      border-radius: 10px;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 0.5em;
      text-indent: 0.5em;
      text-align: center;
      color: #0b4b34;
      transition: all 0.15s;
    }
    .code-input:focus {
      outline: none;
      border-color: #0b4b34;
      box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.1);
    }
    .code-input.error {
      border-color: #dc2626;
      animation: shake 0.3s ease-in-out;
    }
    @media (prefers-reduced-motion: reduce) {
      .code-input.error { animation: none; }
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 14px 24px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      border: none;
    }
    .btn-primary {
      background: #0b4b34;
      color: white;
    }
    .btn-primary:hover {
      background: #093d2a;
    }
    .btn-primary:disabled {
      background: #d1d5db;
      cursor: not-allowed;
    }
    .resend-link {
      margin-top: 20px;
      font-size: 14px;
      color: #5b6b80;
    }
    .resend-link button {
      background: none;
      border: none;
      color: #0b4b34;
      font-weight: 600;
      cursor: pointer;
      padding: 0;
    }
    .resend-link button:hover {
      text-decoration: underline;
    }
    .resend-link button:disabled {
      color: #9ca3af;
      cursor: not-allowed;
      text-decoration: none;
    }
    .error-message {
      margin-top: 16px;
      padding: 12px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      color: #dc2626;
      font-size: 14px;
      display: none;
    }
    .error-message.show {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }
    .success-message {
      margin-top: 16px;
      padding: 12px;
      background: rgba(11, 75, 52, 0.08);
      border: 1px solid rgba(11, 75, 52, 0.2);
      border-radius: 8px;
      color: #0b4b34;
      font-size: 14px;
      display: none;
    }
    .success-message.show {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .back-link {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid #e5e7eb;
    }
    .back-link a {
      color: #5b6b80;
      font-size: 14px;
      text-decoration: none;
    }
    .back-link a:hover {
      color: #0b4b34;
    }
    .email-hint {
      font-size: 13px;
      color: #5b6b80;
      margin-top: 8px;
    }
    .email-hint strong {
      color: #0b4b34;
    }
  </style>
</head>
<body>
  <div class="verify-container">
    <div class="logo">
      <img src="/images/logos/Logo---cropped-transparant.png" alt="Gryffi">
    </div>
    
    <div class="shield-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
    </div>
    
    <h1 class="verify-title"><%= t('auth.loginVerification.title') %></h1>
    <p class="verify-subtitle"><%= t('auth.loginVerification.subtitle') %></p>
    
    <div class="verify-explanation">
      <% if (reason === '2fa') { %>
        <%= t('auth.loginVerification.explanation2fa') %>
      <% } else if (reason === 'brute_force') { %>
        <%= t('auth.loginVerification.explanationBruteForce') %>
      <% } else { %>
        <%= t('auth.loginVerification.explanationDefault') %>
      <% } %>
    </div>
    
    <form id="verifyForm">
      <label for="verificationCode" style="display: block; text-align: left; font-size: 14px; font-weight: 500; color: #374151; margin-bottom: 12px;">
        <%= t('auth.loginVerification.codeLabel') %>
      </label>
      
      <input type="text" id="verificationCode" name="code" class="code-input" maxlength="<%= codeLength %>"
             inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{<%= codeLength %>}" aria-describedby="errorMessage">
      
      <p class="email-hint"><%= t('auth.loginVerification.sentTo') %> <strong><%= email %></strong></p>
      
      <div id="errorMessage" class="error-message" role="alert"></div>
      <div id="successMessage" class="success-message"></div>
      
      <button type="submit" class="btn btn-primary" id="verifyBtn">
        <%= t('auth.loginVerification.submit') %>
      </button>
    </form>
    
    <div class="resend-link">
      <%= t('auth.loginVerification.noCode') %>
      <button type="button" id="resendBtn">
        <%= t('auth.loginVerification.resend') %>
      </button>
    </div>
    
    <div class="back-link">
      <a href="/login">← <%= t('auth.loginVerification.backToLogin') %></a>
    </div>
  </div>

  <script>
    const t = {
      verifying: <%-safeJson(t("auth.loginVerification.verifying"))%>,
      submit: <%-safeJson(t("auth.loginVerification.submit"))%>,
      resent: <%-safeJson(t("auth.loginVerification.resent"))%>,
      invalid: <%-safeJson(t("auth.loginVerification.invalidCode"))%>,
      expired: <%-safeJson(t("auth.loginVerification.codeExpired"))%>
    };
    const CODE_LENGTH = <%- safeJson(codeLength) %>;

    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('verificationCode');
      const form = document.getElementById('verifyForm');
      const verifyBtn = document.getElementById('verifyBtn');
      const resendBtn = document.getElementById('resendBtn');
      const errorEl = document.getElementById('errorMessage');
      const successEl = document.getElementById('successMessage');

      input.focus();

      // Digits only; submit as soon as all digits are there (typed or pasted)
      input.addEventListener('input', () => {
        input.value = input.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
        input.classList.remove('error');
        input.removeAttribute('aria-invalid');
        errorEl.classList.remove('show');
        if (input.value.length === CODE_LENGTH) form.requestSubmit();
      });

      // Form submit
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        // Already checking a code (auto-submit plus Enter), or locked
        if (verifyBtn.disabled) return;
        
        const code = input.value;
        
        if (code.length !== CODE_LENGTH) {
          showError(t.invalid);
          return;
        }
        
        verifyBtn.disabled = true;
        verifyBtn.textContent = t.verifying;
        
        try {
          const response = await fetch('/login/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Redirect to dashboard
            window.location.href = data.redirect;
          } else {
            showError(data.error || t.invalid);
            input.classList.add('error');
            input.setAttribute('aria-invalid', 'true');
            verifyBtn.textContent = t.submit;
            if (data.restart) {
              // Code is no longer valid: only "Back to login" helps now
              input.disabled = true;
              verifyBtn.disabled = true;
            } else {
              // Empty the wrong code so the next try starts clean
              input.value = '';
              input.focus();
              verifyBtn.disabled = false;
            }
          }
        } catch (err) {
          console.error('Verify error:', err);
          showError('Something went wrong');
          verifyBtn.disabled = false;
          verifyBtn.textContent = t.submit;
        }
      });

      // Resend code
      resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        
        try {
          const response = await fetch('/login/verify/resend', {
            method: 'POST'
          });
          
          const data = await response.json();
          
          if (data.success) {
            showSuccess(t.resent);
            input.value = '';
            input.classList.remove('error');
            input.removeAttribute('aria-invalid');
            input.focus();
          } else {
            showError(data.error || 'Failed to resend');
          }
        } catch (err) {
          console.error('Resend error:', err);
          showError('Failed to resend');
        }
        
        // Re-enable after 30 seconds
        setTimeout(() => {
          resendBtn.disabled = false;
        }, 30000);
      });

      function showError(message) {
        errorEl.textContent = message;
        errorEl.classList.add('show');
        successEl.classList.remove('show');
      }

      function showSuccess(message) {
        successEl.textContent = message;
        successEl.classList.add('show');
        errorEl.classList.remove('show');
      }
    });
  </script>
</body>
</html>
