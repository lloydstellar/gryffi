<!DOCTYPE html>
<html lang="<%= language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    }
    .welcome-container {
      max-width: 480px;
      padding: 48px;
      text-align: center;
    }
    .welcome-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(120, 197, 3, 0.15);
    }
    .welcome-icon svg {
      width: 40px;
      height: 40px;
      stroke: #0b4b34;
    }
    .welcome-title {
      font-size: 24px;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 12px;
      font-family: 'Outfit', sans-serif;
    }
    .welcome-message {
      font-size: 16px;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 32px;
    }
    .logo {
      margin-bottom: 48px;
    }
    .logo img {
      height: 48px;
    }
    .button-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 24px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      border: none;
    }
    .btn-primary {
      background: #0b4b34;
      color: white;
    }
    .btn-primary:hover {
      background: #083d2a;
      transform: translateY(-1px);
    }
    .btn-secondary {
      background: white;
      color: #0b4b34;
      border: 2px solid #0b4b34;
    }
    .btn-secondary:hover {
      background: rgba(11, 75, 52, 0.05);
    }
    .btn svg {
      width: 20px;
      height: 20px;
    }
  </style>
</head>
<body>
  <div class="welcome-container">
    <div class="logo">
      <img src="/images/logos/Logo---transparant-lightgreen-cropped.png" alt="Gryffi">
    </div>
    
    <div class="welcome-icon">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    
    <h1 class="welcome-title"><%= welcomeTitle %></h1>
    <p class="welcome-message"><%= welcomeMessage %></p>
    
    <div class="button-group">
      <button type="button" id="restartBtn" class="btn btn-primary" style="width: 100%;">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        <span id="restartBtnText"><%= restartButton %></span>
      </button>
      
      <a href="/e/<%= token %>?review=1" class="btn btn-secondary">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        <%= reviewButton %>
      </a>
    </div>
  </div>
  
  <script>
    document.getElementById('restartBtn').addEventListener('click', async function() {
      const btn = this;
      const btnText = document.getElementById('restartBtnText');
      const originalText = btnText.textContent;
      
      // Disable button and show loading
      btn.disabled = true;
      btn.style.opacity = '0.7';
      btnText.textContent = '...';
      
      try {
        const response = await fetch('/e/<%= token %>/restart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Redirect to the journey (bypass welcome-back check by going directly)
          window.location.href = '/e/<%= token %>?restart=1';
        } else {
          alert(data.error || 'Er ging iets mis. Probeer opnieuw.');
          btn.disabled = false;
          btn.style.opacity = '1';
          btnText.textContent = originalText;
        }
      } catch (err) {
        console.error('Restart error:', err);
        alert('Er ging iets mis. Probeer opnieuw.');
        btn.disabled = false;
        btn.style.opacity = '1';
        btnText.textContent = originalText;
      }
    });
  </script>
</body>
</html>
