</style>

<script>
// Global help modal functions - defined immediately for availability
var _helpContext = '';
// The maker's interface language (in the builder, `language` is the journey's language)
var _helpCurrentLanguage = <%- safeJson(locals.interfaceLanguage || language || 'en') %>;
var _helpCacheKey = 'gryffi_help_last_search';
var _helpCacheMaxAge = 10 * 60 * 1000; // 10 minutes

// Save search result to session storage
function _saveHelpSearch(query, data) {
  try {
    sessionStorage.setItem(_helpCacheKey, JSON.stringify({ query: query, data: data, timestamp: Date.now() }));
  } catch (e) {
    // private mode or storage full: the answer is just not remembered
  }
}

// Get cached search if recent
function _getCachedHelpSearch() {
  try {
    var cached = sessionStorage.getItem(_helpCacheKey);
    if (!cached) return null;
    var parsed = JSON.parse(cached);
    if (Date.now() - parsed.timestamp > _helpCacheMaxAge) {
      sessionStorage.removeItem(_helpCacheKey);
      return null;
    }
    return parsed;
  } catch (e) {
    return null;
  }
}

// Open help modal - globally available
function openHelpModal(context) {
  _helpContext = context || window._detectHelpContext();
  var modal = document.getElementById('helpModal');
  if (!modal) return;
  var wasOpen = modal.style.display === 'flex';
  // Focus goes back here when the help closes
  if (!wasOpen) window._helpOpener = document.activeElement;
  modal.style.display = 'flex';
  // A panel next to the page: the page stays usable and makes room on a wide screen
  document.body.classList.add('help-open');
  if (!wasOpen) window._helpCount('panel', window._helpScreen().key);

  var input = document.getElementById('helpSearchInput');
  // Always clear the search input for a fresh question
  if (input) input.value = '';

  // The last answer comes back for 10 minutes, with the articles one click away
  var cached = _getCachedHelpSearch();
  if (cached && cached.data && cached.data.answer) {
    window._displayHelpAnswer(cached.data, cached.query);
  } else {
    window._resetHelpModal();
  }
  if (input) input.focus();
}

// Close help modal - globally available
function closeHelpModal() {
  var modal = document.getElementById('helpModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.classList.remove('help-open');
    var opener = window._helpOpener;
    window._helpOpener = null;
    if (opener && typeof opener.focus === 'function' && document.contains(opener)) opener.focus();
  }
}

// Also expose on window for compatibility
window.openHelpModal = openHelpModal;
window.closeHelpModal = closeHelpModal;

(function() {
  // Translation strings
  var helpTranslations = <%- safeJson({
    searching: t('help.searching'),
    error: t('help.error'),
    noResults: t('help.noResults'),
    readMore: t('help.readMore'),
    showLess: t('help.showLess'),
    enlargeScreenshot: t('help.enlargeScreenshot'),
    closeScreenshot: t('help.closeScreenshot'),
    showMarker: t('help.showMarker'),
    screenshotNumber: t('help.screenshotNumber'),
    markerCrop: t('help.markerCrop'),
    answerReady: t('help.answerReady'),
    openingArticle: t('help.openingArticle'),
    translatingArticle: t('help.translatingArticle'),
    showAll: t('help.showAll'),
    readArticle: t('help.readArticle'),
    backToAnswer: t('help.backToAnswer'),
    backToArticles: t('help.backToArticles'),
    categories: {
      gettingStarted: t('help.categories.gettingStarted'),
      journeys: t('help.categories.journeys'),
      steps: t('help.categories.steps'),
      guides: t('help.categories.guides'),
      participants: t('help.categories.participants'),
      analytics: t('help.categories.analytics'),
      team: t('help.categories.team'),
      account: t('help.categories.account'),
      plans: t('help.categories.plans'),
      other: t('help.categories.other')
    }
  }) %>;

  // Where the article view goes back to: the answer, or the list of articles
  var _helpLastAnswer = null;
  var _helpArticleFrom = 'home';
  var _helpCategories = null;
  var CATEGORY_PREVIEW = 5;

  function _esc(text) {
    return String(text == null ? '' : text)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // Initialize modal handlers - run immediately since HTML is already parsed
  (function initHelpModal() {
    var modal = document.getElementById('helpModal');

    if (modal) {
      var closeBtn = document.getElementById('helpModalClose');
      if (closeBtn) closeBtn.addEventListener('click', closeHelpModal);

      var overlay = modal.querySelector('.help-modal-overlay');
      if (overlay) overlay.addEventListener('click', closeHelpModal);

      // Contact support button - close help and open support modal
      var contactSupportBtn = document.getElementById('helpContactSupportBtn');
      if (contactSupportBtn) {
        contactSupportBtn.addEventListener('click', function() {
          closeHelpModal();
          if (typeof window.openSupportModal === 'function') window.openSupportModal();
        });
      }

      // Escape closes the panel when the focus is in it
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex' && modal.contains(document.activeElement)) closeHelpModal();
      });

      // "?" opens the help anywhere, except while typing
      document.addEventListener('keydown', function(e) {
        if (e.key !== '?' || e.ctrlKey || e.metaKey || e.altKey) return;
        var el = document.activeElement;
        if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
        if (document.querySelector('[role="dialog"][aria-modal="true"]:not([hidden])')) return;
        e.preventDefault();
        openHelpModal();
      });

      var searchInput = document.getElementById('helpSearchInput');
      var searchBtn = document.getElementById('helpSearchBtn');
      if (searchBtn) {
        searchBtn.addEventListener('click', function() { window._performHelpSearch(searchInput.value); });
      }
      if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') window._performHelpSearch(searchInput.value);
        });
      }

      var retryBtn = document.getElementById('helpRetryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() { window._performHelpSearch(retryBtn._query || searchInput.value); });
      }

      var browseBtn = document.getElementById('helpNoResultsBrowse');
      if (browseBtn) browseBtn.addEventListener('click', function() { window._resetHelpModal(); });

      var sourceBtn = document.getElementById('helpSourceBtn');
      if (sourceBtn) {
        sourceBtn.addEventListener('click', function() {
          if (sourceBtn._articleId) _openHelpArticle(sourceBtn._articleId, { from: 'answer' });
        });
      }

      var backBtn = document.getElementById('helpArticleBack');
      if (backBtn) {
        backBtn.addEventListener('click', function() {
          if (_helpArticleFrom === 'answer' && _helpLastAnswer) {
            window._displayHelpAnswer(_helpLastAnswer.data, _helpLastAnswer.query);
            var source = document.getElementById('helpSourceBtn');
            if (source && source.offsetParent !== null) source.focus();
          } else {
