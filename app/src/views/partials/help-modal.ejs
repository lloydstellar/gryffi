<!-- Help Assistant Modal -->
<div id="helpModal" class="help-modal" style="display: none;" data-dialog-manual>
  <div class="help-modal-overlay"></div>
  <div class="help-modal-content" role="dialog" aria-labelledby="helpModalTitle">
    <div class="help-modal-header">
      <div class="help-modal-header-content">
        <div class="help-modal-icon">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h2 id="helpModalTitle"><%= t('help.title') %></h2>
          <p><%= t('help.subtitle') %></p>
        </div>
      </div>
      <button type="button" class="help-modal-close" id="helpModalClose" aria-label="<%= t('common.close') %>">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="help-modal-body">
      <!-- Search Input -->
      <div class="help-search-container">
        <div class="help-search-wrapper">
          <svg class="help-search-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            id="helpSearchInput" 
            class="help-search-input" 
            placeholder="<%= t('help.searchPlaceholder') %>"
            autocomplete="off"
          >
          <button type="button" id="helpSearchBtn" class="help-search-btn" aria-label="<%= t('help.askButton') %>">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
        <p class="help-search-hint"><%= t('help.searchHint') %></p>
      </div>
      
      <!-- Results Area -->
      <div id="helpResults" class="help-results">
        <!-- Start: all help articles per category -->
        <div id="helpHome" class="help-home">
          <!-- Help on this screen: where the maker is, a few questions to ask and the articles about it -->
          <section id="helpScreen" class="help-screen" aria-labelledby="helpScreenTitle" hidden>
            <h3 class="help-screen-title" id="helpScreenTitle"><%= t('help.screen.title') %></h3>
            <p class="help-screen-here" id="helpScreenHere"></p>
            <p class="help-section-label" id="helpScreenAskLabel"><%= t('help.screen.ask') %></p>
            <div class="help-suggestions" id="helpScreenSuggestions" role="group" aria-labelledby="helpScreenAskLabel"></div>
            <p class="help-section-label" id="helpScreenReadLabel"><%= t('help.screen.read') %></p>
            <ul class="help-category-list" id="helpScreenArticles" aria-labelledby="helpScreenReadLabel"></ul>
          </section>
          <h3 class="help-section-label"><%= t('help.browseTitle') %></h3>
          <div id="helpCategories" class="help-categories"></div>
        </div>

        <!-- Loading State -->
        <div id="helpLoading" class="help-loading" style="display: none;">
          <div class="help-loading-spinner"></div>
          <p id="helpLoadingText"><%= t('help.searching') %></p>
        </div>

        <!-- Tells screen readers that an answer or article arrived -->
        <div id="helpStatus" class="sr-only" role="status" aria-live="polite"></div>

        <!-- Answer State -->
        <div id="helpAnswer" class="help-answer" style="display: none;">
          <p id="helpQuestion" class="help-question"></p>
          <div class="help-answer-content" id="helpAnswerContent">
            <div id="helpAnswerText"></div>
          </div>

          <!-- Read More Link (shown when content is truncated) -->
          <div id="helpReadMoreContainer" class="help-read-more-container" style="display: none;">
            <button type="button" id="helpReadMoreBtn" class="help-read-more-btn">
              <span id="helpReadMoreText"><%= t('help.readMore') %></span>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>

          <!-- Screenshots the answer points at -->
          <div id="helpScreenshots" class="help-screenshots" role="group" aria-label="<%= t('help.screenshots') %>" style="display: none;"></div>

          <!-- The help article the answer comes from -->
          <div id="helpSource" class="help-source" style="display: none;">
            <span class="help-source-label"><%= t('help.sourceLabel') %></span>
            <button type="button" id="helpSourceBtn" class="help-source-btn">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span id="helpSourceTitle"></span>
            </button>
          </div>

          <!-- Go to Page Button -->
          <div id="helpLinkContainer" class="help-link-container" style="display: none;">
            <a id="helpLink" href="#" class="help-link-btn">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              <span><%= t('help.goToPage') %></span>
            </a>
          </div>

          <!-- Related articles -->
          <div id="helpRelatedContainer" class="help-related-container" style="display: none;">
            <p class="help-section-label"><%= t('help.relatedArticles') %></p>
            <div id="helpRelatedTopics" class="help-related-topics"></div>
          </div>
        </div>

        <!-- Article State: one help page with its screenshots -->
        <div id="helpArticle" class="help-article" style="display: none;">
          <button type="button" id="helpArticleBack" class="help-back-btn">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <span id="helpArticleBackText"></span>
          </button>
          <p id="helpArticleNotice" class="help-article-notice" style="display: none;"><%= t('help.aiUnavailable') %></p>
          <h3 id="helpArticleTitle" class="help-article-title" tabindex="-1"></h3>
          <p id="helpArticleLanguage" class="help-article-language" style="display: none;"><%= t('help.articleEnglishOnly') %></p>
          <div id="helpArticleBody" class="help-article-body"></div>
          <div id="helpArticleLinkContainer" class="help-link-container" style="display: none;">
            <a id="helpArticleLink" href="#" class="help-link-btn">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              <span><%= t('help.goToPage') %></span>
            </a>
          </div>
          <div id="helpArticleRelated" class="help-related-container" style="display: none;">
            <p class="help-section-label"><%= t('help.relatedArticles') %></p>
            <div id="helpArticleRelatedList" class="help-related-topics"></div>
          </div>
        </div>

        <!-- No Results State -->
        <div id="helpNoResults" class="help-no-results" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p><%= t('help.noResults') %></p>
          <span><%= t('help.tryDifferent') %></span>
          <button type="button" id="helpNoResultsBrowse" class="help-retry-btn"><%= t('help.backToArticles') %></button>
        </div>
        
        <!-- Error State -->
        <div id="helpError" class="help-error" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <p><%= t('help.error') %></p>
          <button type="button" id="helpRetryBtn" class="help-retry-btn"><%= t('help.tryAgain') %></button>
        </div>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="help-modal-footer">
      <p><%= t('help.footerText') %></p>
      <button type="button" class="help-support-link" id="helpContactSupportBtn">
        <%= t('help.contactSupport') %>
      </button>
    </div>
  </div>
</div>

<style>
  /* Help Modal Styles */
  .help-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  
  .help-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    max-width: 680px;
    width: calc(100% - 32px);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    margin: 16px;
  }
  
  .help-modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-shrink: 0;
  }
  
  .help-modal-header-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  
  .help-modal-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ecf2eb 0%, #d4e6d0 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .help-modal-icon svg {
    color: #0b4b34;
  }
  
  .help-modal-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 2px;
  }
  
  .help-modal-header p {
    font-size: 13px;
    color: #5b6b80;
    margin: 0;
  }
  
  .help-modal-close {
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #5b6b80;
    border-radius: 8px;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  
  .help-modal-close:hover {
    color: #475569;
    background: #f1f5f9;
  }
  
  .help-modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
  }
  
  /* Search Container */
  .help-search-container {
    margin-bottom: 20px;
  }
  
  .help-search-wrapper {
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 4px 4px 4px 14px;
    transition: all 0.15s;
  }
  
  .help-search-wrapper:focus-within {
    border-color: #0b4b34;
    box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.08);
    background: #fff;
  }
  
  .help-search-icon {
    color: #5b6b80;
    flex-shrink: 0;
  }
  
  .help-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 10px 12px;
    font-size: 15px;
    color: #1f2937;
    outline: none;
  }
  
  .help-search-input::placeholder {
    color: #5b6b80;
  }
  
  .help-search-btn {
    background: #0b4b34;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-search-btn:hover {
    background: #083d2a;
  }
  
  .help-search-hint {
    font-size: 12px;
    color: #5b6b80;
    margin: 8px 0 0 0;
  }
  
  /* Results Area */
  .help-results {
    min-height: 200px;
  }
  
  .help-section-label {
    font-size: 12px;
    font-weight: 600;
    color: #5b6b80;
    text-transform: none;
    letter-spacing: 0.5px;
    margin: 0 0 12px 0;
  }
  
  /* Start: help articles per category */
  .help-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 28px;
  }

  .help-category-title {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 6px;
  }

  .help-category-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .help-article-link,
  .help-show-all {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 5px 0;
    text-align: left;
    font-size: 14px;
    line-height: 1.4;
    color: #0b4b34;
    cursor: pointer;
  }

  .help-article-link:hover {
    text-decoration: underline;
    text-decoration-color: #78c503;
    text-underline-offset: 3px;
  }

  .help-show-all {
    color: #5b6b80;
    font-size: 13px;
  }

  .help-show-all:hover {
    color: #0b4b34;
  }

  /* The question above the answer */
  .help-question {
    font-size: 15px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 10px;
  }

  /* The article the answer comes from */
  .help-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 16px;
    font-size: 13px;
    color: #5b6b80;
  }

  .help-source-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1px solid #d4e6d0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    color: #0b4b34;
    cursor: pointer;
  }

  .help-source-btn:hover {
    border-color: #0b4b34;
    background: #ecf2eb;
  }

  /* Article view */
  .help-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 6px 0;
    margin-bottom: 8px;
    font-size: 14px;
    color: #0b4b34;
    cursor: pointer;
  }

  .help-back-btn:hover {
    text-decoration: underline;
  }

  .help-article-notice {
    background: #fef3c7;
    border: 1px solid #fcd34d;
    color: #78350f;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    margin: 0 0 14px;
  }

  .help-article-title {
    font-size: 20px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 6px;
  }

  .help-article-title:focus {
    outline: none;
  }

  .help-article-language {
    font-size: 13px;
    color: #5b6b80;
    margin: 0 0 12px;
  }

  .help-article-body {
    font-size: 14px;
    line-height: 1.7;
    color: #1f2937;
    margin-bottom: 20px;
  }

  .help-article-body p {
    margin: 0 0 12px;
  }

  .help-article-body .help-numbered-list li {
    background: #f8fafc;
  }

  /* Numbers in the text point at the numbered markers in the screenshots */
  .help-article-body span.help-marker,
  .help-legend .help-marker {
    background: #c73d1a;
    color: #fff;
    box-shadow: none;
  }

  .help-article-figure {
    margin: 16px 0 20px;
  }

  .help-legend {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .help-legend li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 4px 0;
    font-size: 13px;
    line-height: 1.5;
    color: #374151;
  }

  .help-legend .help-marker {
    flex-shrink: 0;
    margin: 0;
  }

  .help-code {
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px;
    margin: 12px 0;
    overflow-x: auto;
    font-size: 12px;
    line-height: 1.5;
  }

  .help-article-link:focus-visible,
  .help-show-all:focus-visible,
  .help-source-btn:focus-visible,
  .help-back-btn:focus-visible,
  .help-related-tag:focus-visible,
  .help-link-btn:focus-visible,
  .help-read-more-btn:focus-visible,
  .help-retry-btn:focus-visible,
  .help-support-link:focus-visible,
  .help-modal-close:focus-visible,
  .help-search-btn:focus-visible {
    outline: 3px solid #78c503;
    outline-offset: 2px;
  }

  /* Loading State */
  .help-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }
  
  .help-loading-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #e5e7eb;
    border-top-color: #0b4b34;
    border-radius: 50%;
    animation: help-spin 0.8s linear infinite;
  }
  
  @keyframes help-spin {
    to { transform: rotate(360deg); }
  }
  
  .help-loading p {
    color: #5b6b80;
    font-size: 14px;
    margin: 16px 0 0 0;
  }
  
  /* Answer State */
  .help-answer {
    animation: help-fade-in 0.3s ease;
  }
  
  @keyframes help-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .help-answer-content {
    background: linear-gradient(135deg, #ecf2eb 0%, #f8fafc 100%);
    border: 1px solid #d4e6d0;
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 20px;
  }
  
  .help-answer-content p {
    color: #1f2937;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 12px 0;
  }
  
  .help-answer-content p:last-child {
    margin-bottom: 0;
  }
  
  /* Markdown headers */
  .help-heading-2 {
    font-size: 16px;
    font-weight: 600;
    color: #0b4b34;
    margin: 20px 0 12px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #78c503;
  }
  
  .help-heading-2:first-child {
    margin-top: 0;
  }
  
  .help-heading-3 {
    font-size: 14px;
    font-weight: 600;
    color: #0b4b34;
    margin: 16px 0 10px 0;
  }
  
  .help-heading-3:first-child {
    margin-top: 0;
  }
  
  .help-heading-4 {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin: 14px 0 8px 0;
  }
  
  .help-heading-4:first-child {
    margin-top: 0;
  }
  
  /* Tables */
  .help-table-wrapper {
    margin: 16px 0;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgba(11, 75, 52, 0.15);
  }
  
  .help-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }
  
  .help-table thead {
    background: rgba(11, 75, 52, 0.08);
  }
  
  .help-table th {
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: #0b4b34;
    border-bottom: 2px solid rgba(11, 75, 52, 0.15);
    white-space: nowrap;
  }
  
  .help-table td {
    padding: 10px 14px;
    color: #374151;
    border-bottom: 1px solid rgba(11, 75, 52, 0.08);
  }
  
  .help-table tbody tr:last-child td {
    border-bottom: none;
  }
  
  .help-table tbody tr:hover {
    background: rgba(120, 197, 3, 0.05);
  }
  
  .help-table code,
  .help-table .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Inline code */
  .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Numbered lists */
  .help-numbered-list {
    list-style: none;
    padding: 0;
    margin: 12px 0;
    counter-reset: none;
  }
  
  .help-numbered-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    margin: 8px 0;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #1f2937;
  }
  
  /* Plain step numbers: a round badge always means a marker in the screenshot */
  .help-list-number {
    min-width: 18px;
    color: #0b4b34;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .help-list-number::after {
    content: '.';
  }
  
  .help-step-content {
    flex: 1;
  }
  
  .help-step-title {
    display: block;
    font-weight: 600;
    color: #0b4b34;
    margin-bottom: 4px;
  }
  
  .help-step-desc {
    display: block;
    color: #4b5563;
  }

  .help-sub-list {
