<!-- Help Assistant Modal -->
<div id="helpModal" class="help-modal" style="display: none;">
  <div class="help-modal-overlay"></div>
  <div class="help-modal-content">
    <div class="help-modal-header">
      <div class="help-modal-header-content">
        <div class="help-modal-icon">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h2><%= t('help.title') %></h2>
          <p><%= t('help.subtitle') %></p>
        </div>
      </div>
      <button type="button" class="help-modal-close" id="helpModalClose">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="help-modal-body">
      <!-- Search Input -->
      <div class="help-search-container">
        <div class="help-search-wrapper">
          <svg class="help-search-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            id="helpSearchInput" 
            class="help-search-input" 
            placeholder="<%= t('help.searchPlaceholder') %>"
            autocomplete="off"
          >
          <button type="button" id="helpSearchBtn" class="help-search-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
        <p class="help-search-hint"><%= t('help.searchHint') %></p>
      </div>
      
      <!-- Results Area -->
      <div id="helpResults" class="help-results">
        <!-- Initial State - Quick Topics -->
        <div id="helpQuickTopics" class="help-quick-topics">
          <p class="help-section-label"><%= t('help.quickTopics') %></p>
          <div class="help-topics-grid" id="helpTopicsGrid">
            <!-- Topics will be loaded dynamically -->
          </div>
        </div>
        
        <!-- Loading State -->
        <div id="helpLoading" class="help-loading" style="display: none;">
          <div class="help-loading-spinner"></div>
          <p><%= t('help.searching') %></p>
        </div>
        
        <!-- Answer State -->
        <div id="helpAnswer" class="help-answer" style="display: none;">
          <div class="help-answer-content" id="helpAnswerContent">
            <p id="helpAnswerText"></p>
          </div>
          
          <!-- Read More Link (shown when content is truncated) -->
          <div id="helpReadMoreContainer" class="help-read-more-container" style="display: none;">
            <button type="button" id="helpReadMoreBtn" class="help-read-more-btn">
              <span id="helpReadMoreText"><%= t('help.readMore') || 'Read more' %></span>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>
          
          <!-- Go to Page Button -->
          <div id="helpLinkContainer" class="help-link-container" style="display: none;">
            <a id="helpLink" href="#" class="help-link-btn">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              <span><%= t('help.goToPage') %></span>
            </a>
          </div>
          
          <!-- Related Topics -->
          <div id="helpRelatedContainer" class="help-related-container" style="display: none;">
            <p class="help-section-label"><%= t('help.relatedTopics') %></p>
            <div id="helpRelatedTopics" class="help-related-topics"></div>
          </div>
        </div>
        
        <!-- No Results State -->
        <div id="helpNoResults" class="help-no-results" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p><%= t('help.noResults') %></p>
          <span><%= t('help.tryDifferent') %></span>
        </div>
        
        <!-- Error State -->
        <div id="helpError" class="help-error" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <p><%= t('help.error') %></p>
          <button type="button" id="helpRetryBtn" class="help-retry-btn"><%= t('help.tryAgain') %></button>
        </div>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="help-modal-footer">
      <p><%= t('help.footerText') %></p>
      <button type="button" class="help-support-link" id="helpContactSupportBtn">
        <%= t('help.contactSupport') %>
      </button>
    </div>
  </div>
</div>

<style>
  /* Help Modal Styles */
  .help-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  
  .help-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    max-width: 680px;
    width: calc(100% - 32px);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    margin: 16px;
  }
  
  .help-modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-shrink: 0;
  }
  
  .help-modal-header-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  
  .help-modal-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ecf2eb 0%, #d4e6d0 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .help-modal-icon svg {
    color: #0b4b34;
  }
  
  .help-modal-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 2px;
  }
  
  .help-modal-header p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }
  
  .help-modal-close {
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #94a3b8;
    border-radius: 8px;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  
  .help-modal-close:hover {
    color: #475569;
    background: #f1f5f9;
  }
  
  .help-modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
  }
  
  /* Search Container */
  .help-search-container {
    margin-bottom: 20px;
  }
  
  .help-search-wrapper {
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 4px 4px 4px 14px;
    transition: all 0.15s;
  }
  
  .help-search-wrapper:focus-within {
    border-color: #0b4b34;
    box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.08);
    background: #fff;
  }
  
  .help-search-icon {
    color: #94a3b8;
    flex-shrink: 0;
  }
  
  .help-search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 12px;
    font-size: 15px;
    color: #1f2937;
    outline: none;
  }
  
  .help-search-input::placeholder {
    color: #94a3b8;
  }
  
  .help-search-btn {
    background: #0b4b34;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-search-btn:hover {
    background: #083d2a;
  }
  
  .help-search-hint {
    font-size: 12px;
    color: #94a3b8;
    margin: 8px 0 0 0;
  }
  
  /* Results Area */
  .help-results {
    min-height: 200px;
  }
  
  .help-section-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 12px 0;
  }
  
  /* Quick Topics */
  .help-quick-topics {
    margin-top: 8px;
  }
  
  .help-topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  
  .help-topic-btn {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 12px 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s;
    font-size: 13px;
    color: #374151;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .help-topic-btn:hover {
    background: #ecf2eb;
    border-color: #0b4b34;
    color: #0b4b34;
  }
  
  .help-topic-btn svg {
    flex-shrink: 0;
    color: #78c503;
  }
  
  /* Loading State */
  .help-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }
  
  .help-loading-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #e5e7eb;
    border-top-color: #0b4b34;
    border-radius: 50%;
    animation: help-spin 0.8s linear infinite;
  }
  
  @keyframes help-spin {
    to { transform: rotate(360deg); }
  }
  
  .help-loading p {
    color: #64748b;
    font-size: 14px;
    margin: 16px 0 0 0;
  }
  
  /* Answer State */
  .help-answer {
    animation: help-fade-in 0.3s ease;
  }
  
  @keyframes help-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .help-answer-content {
    background: linear-gradient(135deg, #ecf2eb 0%, #f8fafc 100%);
    border: 1px solid #d4e6d0;
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 20px;
  }
  
  .help-answer-content p {
    color: #1f2937;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 12px 0;
  }
  
  .help-answer-content p:last-child {
    margin-bottom: 0;
  }
  
  /* Markdown headers */
  .help-heading-2 {
    font-size: 16px;
    font-weight: 600;
    color: #0b4b34;
    margin: 20px 0 12px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #78c503;
  }
  
  .help-heading-2:first-child {
    margin-top: 0;
  }
  
  .help-heading-3 {
    font-size: 14px;
    font-weight: 600;
    color: #0b4b34;
    margin: 16px 0 10px 0;
  }
  
  .help-heading-3:first-child {
    margin-top: 0;
  }
  
  .help-heading-4 {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin: 14px 0 8px 0;
  }
  
  .help-heading-4:first-child {
    margin-top: 0;
  }
  
  /* Tables */
  .help-table-wrapper {
    margin: 16px 0;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgba(11, 75, 52, 0.15);
  }
  
  .help-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }
  
  .help-table thead {
    background: rgba(11, 75, 52, 0.08);
  }
  
  .help-table th {
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: #0b4b34;
    border-bottom: 2px solid rgba(11, 75, 52, 0.15);
    white-space: nowrap;
  }
  
  .help-table td {
    padding: 10px 14px;
    color: #374151;
    border-bottom: 1px solid rgba(11, 75, 52, 0.08);
  }
  
  .help-table tbody tr:last-child td {
    border-bottom: none;
  }
  
  .help-table tbody tr:hover {
    background: rgba(120, 197, 3, 0.05);
  }
  
  .help-table code,
  .help-table .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Inline code */
  .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Numbered lists */
  .help-numbered-list {
    list-style: none;
    padding: 0;
    margin: 12px 0;
    counter-reset: none;
  }
  
  .help-numbered-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    margin: 8px 0;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #1f2937;
  }
  
  .help-list-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    background: #0b4b34;
    color: white;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .help-step-content {
    flex: 1;
  }
  
  .help-step-title {
    display: block;
    font-weight: 600;
    color: #0b4b34;
    margin-bottom: 4px;
  }
  
  .help-step-desc {
    display: block;
    color: #4b5563;
  }
  
  /* Bullet lists */
  .help-bullet-list {
    list-style: none;
    padding: 0;
    margin: 12px 0;
  }
  
  .help-bullet-list li {
    position: relative;
    padding: 6px 12px 6px 24px;
    font-size: 14px;
    line-height: 1.5;
    color: #1f2937;
  }
  
  .help-bullet-list li::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 14px;
    width: 6px;
    height: 6px;
    background: #78c503;
    border-radius: 50%;
  }
  
  /* Inline links */
  .help-inline-link {
    color: #0b4b34;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: #78c503;
    text-underline-offset: 2px;
  }
  
  .help-inline-link:hover {
    color: #78c503;
  }
  
  /* Bold text */
  .help-answer-content strong {
    font-weight: 600;
    color: #0b4b34;
  }
  
  /* Truncated content */
  .help-answer-content.truncated {
    max-height: 400px;
    overflow: hidden;
    position: relative;
  }
  
  .help-answer-content.truncated::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, transparent, #f3f7f2);
    pointer-events: none;
  }
  
  /* Read more button */
  .help-read-more-container {
    margin: -8px 0 16px 0;
  }
  
  .help-read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #0b4b34;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 0;
    transition: color 0.15s;
  }
  
  .help-read-more-btn:hover {
    color: #78c503;
  }
  
  .help-read-more-btn svg {
    transition: transform 0.2s;
  }
  
  .help-read-more-btn.expanded svg {
    transform: rotate(180deg);
  }
  
  /* Link Button */
  .help-link-container {
    margin-bottom: 20px;
  }
  
  .help-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0b4b34;
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.15s;
  }
  
  .help-link-btn:hover {
    background: #083d2a;
    color: white;
  }
  
  /* Related Topics */
  .help-related-container {
    border-top: 1px solid #e5e7eb;
    padding-top: 16px;
  }
  
  .help-related-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  
  .help-related-tag {
    background: #f1f5f9;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .help-related-tag:hover {
    background: #e5e7eb;
    color: #0b4b34;
  }
  
  /* No Results State */
  .help-no-results,
  .help-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
  }
  
  .help-no-results svg,
  .help-error svg {
    color: #cbd5e1;
    margin-bottom: 16px;
  }
  
  .help-no-results p,
  .help-error p {
    color: #64748b;
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 4px 0;
  }
  
  .help-no-results span {
    color: #94a3b8;
    font-size: 13px;
  }
  
  .help-retry-btn {
    margin-top: 16px;
    background: #f1f5f9;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s;
  }
  
  .help-retry-btn:hover {
    background: #e5e7eb;
  }
  
  /* Footer */
  .help-modal-footer {
    padding: 14px 24px;
    border-top: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
    border-radius: 0 0 16px 16px;
    flex-shrink: 0;
  }
  
  .help-modal-footer p {
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
  }
  
  .help-support-link {
    background: none;
    border: none;
    font-size: 12px;
    color: #0b4b34;
    cursor: pointer;
    text-decoration: underline;
    transition: color 0.15s;
  }
  
  .help-support-link:hover {
    color: #083d2a;
  }
  
  /* Responsive */
  @media (max-width: 640px) {
    .help-modal-content {
      max-height: 90vh;
    }
    
    .help-topics-grid {
      grid-template-columns: 1fr;
    }
    
    .help-modal-footer {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>

<script>
console.log('[Help] Script starting...');
// Global help modal functions - defined immediately for availability
var _helpContext = '';
var _helpCurrentLanguage = '<%= language || 'en' %>';
var _helpCacheKey = 'gryffi_help_last_search';
var _helpCacheMaxAge = 10 * 60 * 1000; // 10 minutes

// Save search result to session storage
function _saveHelpSearch(query, data) {
  try {
    sessionStorage.setItem(_helpCacheKey, JSON.stringify({
      query: query,
      data: data,
      timestamp: Date.now()
    }));
  } catch (e) {
    console.warn('[Help] Could not save search:', e);
  }
}

// Get cached search if recent
function _getCachedHelpSearch() {
  try {
    var cached = sessionStorage.getItem(_helpCacheKey);
    if (!cached) return null;
    var parsed = JSON.parse(cached);
    var age = Date.now() - parsed.timestamp;
    if (age > _helpCacheMaxAge) {
      sessionStorage.removeItem(_helpCacheKey);
      return null;
    }
    return parsed;
  } catch (e) {
    return null;
  }
}

// Open help modal - globally available
function openHelpModal(context) {
  console.log('[Help] openHelpModal called with context:', context);
  _helpContext = context || window._detectHelpContext();
  var modal = document.getElementById('helpModal');
  console.log('[Help] modal element found:', !!modal);
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Check for cached recent search
    var cached = _getCachedHelpSearch();
    var input = document.getElementById('helpSearchInput');
    
    // Always clear the search input for a fresh question
    if (input) input.value = '';
    
    if (cached && cached.data) {
      // Show previous answer but keep search bar empty for new question
      window._displayHelpAnswer(cached.data);
      window._showHelpState('answer');
    } else {
      // Fresh start - show quick topics
      window._resetHelpModal();
      window._loadHelpQuickTopics();
    }
    
    // Focus on search input for quick typing
    if (input) input.focus();
    console.log('[Help] modal opened');
  }
}

// Close help modal - globally available
function closeHelpModal() {
  var modal = document.getElementById('helpModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

// Also expose on window for compatibility
window.openHelpModal = openHelpModal;
window.closeHelpModal = closeHelpModal;

(function() {
