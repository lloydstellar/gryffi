    else if (path.indexOf('/dashboard/participants') === 0) key = 'participants';
    else if (path.indexOf('/dashboard/analytics') === 0) key = 'analytics';
    else if (path.indexOf('/dashboard/team') === 0) key = 'team';
    else if (path.indexOf('/dashboard/system-settings') === 0) key = 'organization';
    else if (path.indexOf('/dashboard/settings') === 0) key = 'account';
    else if (path.indexOf('/dashboard/subscription') === 0) key = 'subscription';
    var selection = key === 'builder' ? (window.gryffiHelpSelection || {}) : {};
