<!-- Help Assistant Modal -->
<div id="helpModal" class="help-modal" style="display: none;">
  <div class="help-modal-overlay"></div>
  <div class="help-modal-content" role="dialog" aria-modal="true" aria-labelledby="helpModalTitle">
    <div class="help-modal-header">
      <div class="help-modal-header-content">
        <div class="help-modal-icon">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h2 id="helpModalTitle"><%= t('help.title') %></h2>
          <p><%= t('help.subtitle') %></p>
        </div>
      </div>
      <button type="button" class="help-modal-close" id="helpModalClose" aria-label="<%= t('common.close') %>">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="help-modal-body">
      <!-- Search Input -->
      <div class="help-search-container">
        <div class="help-search-wrapper">
          <svg class="help-search-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            id="helpSearchInput" 
            class="help-search-input" 
            placeholder="<%= t('help.searchPlaceholder') %>"
            autocomplete="off"
          >
          <button type="button" id="helpSearchBtn" class="help-search-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
        <p class="help-search-hint"><%= t('help.searchHint') %></p>
      </div>
      
      <!-- Results Area -->
      <div id="helpResults" class="help-results">
        <!-- Initial State - Quick Topics -->
        <div id="helpQuickTopics" class="help-quick-topics">
          <p class="help-section-label"><%= t('help.quickTopics') %></p>
          <div class="help-topics-grid" id="helpTopicsGrid">
            <!-- Topics will be loaded dynamically -->
          </div>
        </div>
        
        <!-- Loading State -->
        <div id="helpLoading" class="help-loading" style="display: none;">
          <div class="help-loading-spinner"></div>
          <p><%= t('help.searching') %></p>
        </div>
        
        <!-- Tells screen readers that an answer arrived -->
        <div id="helpStatus" class="sr-only" role="status" aria-live="polite"></div>

        <!-- Answer State -->
        <div id="helpAnswer" class="help-answer" style="display: none;">
          <div class="help-answer-content" id="helpAnswerContent">
            <div id="helpAnswerText"></div>
          </div>
          
          <!-- Read More Link (shown when content is truncated) -->
          <div id="helpReadMoreContainer" class="help-read-more-container" style="display: none;">
            <button type="button" id="helpReadMoreBtn" class="help-read-more-btn">
              <span id="helpReadMoreText"><%= t('help.readMore') || 'Read more' %></span>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </div>
          
          <!-- Screenshots of the help page the answer comes from -->
          <div id="helpScreenshots" class="help-screenshots" role="group" aria-label="<%= t('help.screenshots') %>" style="display: none;"></div>
          
          <!-- Go to Page Button -->
          <div id="helpLinkContainer" class="help-link-container" style="display: none;">
            <a id="helpLink" href="#" class="help-link-btn">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              <span><%= t('help.goToPage') %></span>
            </a>
          </div>
          
          <!-- Related Topics -->
          <div id="helpRelatedContainer" class="help-related-container" style="display: none;">
            <p class="help-section-label"><%= t('help.relatedTopics') %></p>
            <div id="helpRelatedTopics" class="help-related-topics"></div>
          </div>
        </div>
        
        <!-- No Results State -->
        <div id="helpNoResults" class="help-no-results" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p><%= t('help.noResults') %></p>
          <span><%= t('help.tryDifferent') %></span>
        </div>
        
        <!-- Error State -->
        <div id="helpError" class="help-error" style="display: none;">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <p><%= t('help.error') %></p>
          <button type="button" id="helpRetryBtn" class="help-retry-btn"><%= t('help.tryAgain') %></button>
        </div>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="help-modal-footer">
      <p><%= t('help.footerText') %></p>
      <button type="button" class="help-support-link" id="helpContactSupportBtn">
        <%= t('help.contactSupport') %>
      </button>
    </div>
  </div>
</div>

<style>
  /* Help Modal Styles */
  .help-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  
  .help-modal-content {
    position: relative;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    max-width: 680px;
    width: calc(100% - 32px);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    margin: 16px;
  }
  
  .help-modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-shrink: 0;
  }
  
  .help-modal-header-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  
  .help-modal-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ecf2eb 0%, #d4e6d0 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .help-modal-icon svg {
    color: #0b4b34;
  }
  
  .help-modal-header h2 {
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 2px;
  }
  
  .help-modal-header p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }
  
  .help-modal-close {
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #94a3b8;
    border-radius: 8px;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  
  .help-modal-close:hover {
    color: #475569;
    background: #f1f5f9;
  }
  
  .help-modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
  }
  
  /* Search Container */
  .help-search-container {
    margin-bottom: 20px;
  }
  
  .help-search-wrapper {
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 4px 4px 4px 14px;
    transition: all 0.15s;
  }
  
  .help-search-wrapper:focus-within {
    border-color: #0b4b34;
    box-shadow: 0 0 0 3px rgba(11, 75, 52, 0.08);
    background: #fff;
  }
  
  .help-search-icon {
    color: #94a3b8;
    flex-shrink: 0;
  }
  
  .help-search-input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 12px;
    font-size: 15px;
    color: #1f2937;
    outline: none;
  }
  
  .help-search-input::placeholder {
    color: #94a3b8;
  }
  
  .help-search-btn {
    background: #0b4b34;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .help-search-btn:hover {
    background: #083d2a;
  }
  
  .help-search-hint {
    font-size: 12px;
    color: #94a3b8;
    margin: 8px 0 0 0;
  }
  
  /* Results Area */
  .help-results {
    min-height: 200px;
  }
  
  .help-section-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 12px 0;
  }
  
  /* Quick Topics */
  .help-quick-topics {
    margin-top: 8px;
  }
  
  .help-topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  
  .help-topic-btn {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 12px 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s;
    font-size: 13px;
    color: #374151;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .help-topic-btn:hover {
    background: #ecf2eb;
    border-color: #0b4b34;
    color: #0b4b34;
  }
  
  .help-topic-btn svg {
    flex-shrink: 0;
    color: #78c503;
  }
  
  /* Loading State */
  .help-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
  }
  
  .help-loading-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #e5e7eb;
    border-top-color: #0b4b34;
    border-radius: 50%;
    animation: help-spin 0.8s linear infinite;
  }
  
  @keyframes help-spin {
    to { transform: rotate(360deg); }
  }
  
  .help-loading p {
    color: #64748b;
    font-size: 14px;
    margin: 16px 0 0 0;
  }
  
  /* Answer State */
  .help-answer {
    animation: help-fade-in 0.3s ease;
  }
  
  @keyframes help-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .help-answer-content {
    background: linear-gradient(135deg, #ecf2eb 0%, #f8fafc 100%);
    border: 1px solid #d4e6d0;
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 20px;
  }
  
  .help-answer-content p {
    color: #1f2937;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 12px 0;
  }
  
  .help-answer-content p:last-child {
    margin-bottom: 0;
  }
  
  /* Markdown headers */
  .help-heading-2 {
    font-size: 16px;
    font-weight: 600;
    color: #0b4b34;
    margin: 20px 0 12px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #78c503;
  }
  
  .help-heading-2:first-child {
    margin-top: 0;
  }
  
  .help-heading-3 {
    font-size: 14px;
    font-weight: 600;
    color: #0b4b34;
    margin: 16px 0 10px 0;
  }
  
  .help-heading-3:first-child {
    margin-top: 0;
  }
  
  .help-heading-4 {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin: 14px 0 8px 0;
  }
  
  .help-heading-4:first-child {
    margin-top: 0;
  }
  
  /* Tables */
  .help-table-wrapper {
    margin: 16px 0;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid rgba(11, 75, 52, 0.15);
  }
  
  .help-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }
  
  .help-table thead {
    background: rgba(11, 75, 52, 0.08);
  }
  
  .help-table th {
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: #0b4b34;
    border-bottom: 2px solid rgba(11, 75, 52, 0.15);
    white-space: nowrap;
  }
  
  .help-table td {
    padding: 10px 14px;
    color: #374151;
    border-bottom: 1px solid rgba(11, 75, 52, 0.08);
  }
  
  .help-table tbody tr:last-child td {
    border-bottom: none;
  }
  
  .help-table tbody tr:hover {
    background: rgba(120, 197, 3, 0.05);
  }
  
  .help-table code,
  .help-table .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Inline code */
  .help-inline-code {
    background: rgba(11, 75, 52, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: #0b4b34;
  }
  
  /* Numbered lists */
  .help-numbered-list {
    list-style: none;
    padding: 0;
    margin: 12px 0;
    counter-reset: none;
  }
  
  .help-numbered-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    margin: 8px 0;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #1f2937;
  }
  
  /* Plain step numbers: a round badge always means a marker in the screenshot */
  .help-list-number {
    min-width: 18px;
    color: #0b4b34;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .help-list-number::after {
    content: '.';
  }
  
  .help-step-content {
    flex: 1;
  }
  
  .help-step-title {
    display: block;
    font-weight: 600;
    color: #0b4b34;
    margin-bottom: 4px;
  }
  
  .help-step-desc {
    display: block;
    color: #4b5563;
  }

  .help-sub-list {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
  }

  .help-numbered-list .help-sub-list li {
    display: block;
    position: relative;
    margin: 0;
    padding: 3px 0 3px 16px;
    background: none;
    border-radius: 0;
  }

  .help-sub-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 13px;
    width: 6px;
    height: 6px;
    background: #78c503;
    border-radius: 50%;
  }
  
  /* Bullet lists */
  .help-bullet-list {
    list-style: none;
    padding: 0;
    margin: 12px 0;
  }
  
  .help-bullet-list li {
    position: relative;
    padding: 6px 12px 6px 24px;
    font-size: 14px;
    line-height: 1.5;
    color: #1f2937;
  }
  
  .help-bullet-list li::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 14px;
    width: 6px;
    height: 6px;
    background: #78c503;
    border-radius: 50%;
  }
  
  /* Inline links */
  .help-inline-link {
    color: #0b4b34;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: #78c503;
    text-underline-offset: 2px;
  }
  
  .help-inline-link:hover {
    color: #78c503;
  }
  
  /* Bold text */
  .help-answer-content strong {
    font-weight: 600;
    color: #0b4b34;
  }
  
  /* Truncated content */
  .help-answer-content.truncated {
    max-height: 400px;
    overflow: hidden;
    position: relative;
  }
  
  .help-answer-content.truncated::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, transparent, #f3f7f2);
    pointer-events: none;
  }
  
  /* Read more button */
  .help-read-more-container {
    margin: -8px 0 16px 0;
  }
  
  .help-read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: #0b4b34;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 0;
    transition: color 0.15s;
  }
  
  .help-read-more-btn:hover {
    color: #78c503;
  }
  
  .help-read-more-btn svg {
    transition: transform 0.2s;
  }
  
  .help-read-more-btn.expanded svg {
    transform: rotate(180deg);
  }
  
  /* Link Button */
  /* A reference in the answer to a numbered marker in the screenshot */
  button.help-marker {
    border: none;
    font-family: inherit;
    cursor: pointer;
  }
  button.help-marker:hover,
  button.help-marker.is-pinned {
    background: #0b4b34;
  }
  button.help-marker.is-pinned {
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #0b4b34;
  }
  /* A number without a position in the screenshot: not clickable */
  span.help-marker {
    background: transparent;
    color: #c73d1a;
    box-shadow: inset 0 0 0 1.5px #c73d1a;
  }
  .help-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    margin: 0 2px;
    border-radius: 10px;
    background: #c73d1a;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    vertical-align: 1px;
  }
  .help-screenshots {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  /* The answer does not refer to the screenshots: small, under the answer */
  .help-screenshots.is-small {
    grid-template-columns: repeat(auto-fill, minmax(180px, 240px));
  }
  .help-shot-tabs {
    display: none;
    gap: 6px;
  }
  .help-shot-tab {
    padding: 6px 12px;
    border: 1px solid #d4e6d0;
    border-radius: 999px;
    background: #fff;
    color: #0b4b34;
    font-size: 13px;
    cursor: pointer;
  }
  .help-shot-tab[aria-pressed="true"] {
    background: #0b4b34;
    border-color: #0b4b34;
    color: #fff;
  }
  .help-shot-tab:focus-visible,
  .help-marker:focus-visible,
  .help-screenshot-btn:focus-visible {
    outline: 3px solid #0b4b34;
    outline-offset: 2px;
  }
  .help-screenshot-btn {
    position: relative;
  }
  /* Ring around the marker, the rest of the screenshot dimmed */
  .help-shot-highlight {
    position: absolute;
    border: 3px solid #ff5a36;
    border-radius: 8px;
    box-shadow: 0 0 0 9999px rgba(15, 23, 42, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .help-shot-highlight.is-on {
    opacity: 1;
  }
  /* A zoomed-in part of the screenshot after a step (narrow screens) */
  .help-crop {
    display: block;
    width: 100%;
    max-width: 420px;
    margin: 10px 0 4px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .help-crop:not(.is-ready) {
    display: none;
  }
  .help-crop img {
    display: block;
    max-width: none;
  }
  /* Wide screens: the answer on the left, the screenshot panel on the right */
  @media (min-width: 1024px) {
    .help-modal-content.is-wide {
      max-width: 1120px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .help-modal-content {
        transition: max-width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
    }
    .help-answer.has-screens {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      column-gap: 24px;
      align-items: start;
    }
    .help-answer.has-screens > * {
      grid-column: 1;
    }
    .help-answer.has-screens > .help-screenshots {
      grid-column: 2;
      grid-row: 1 / span 6;
      position: sticky;
      top: 0;
      margin-top: 0;
    }
    .help-answer.has-screens .help-shot-tabs {
      display: flex;
    }
    .help-answer.has-screens .help-shot {
      display: none;
    }
    .help-answer.has-screens .help-shot.is-active {
      display: block;
    }
    .help-answer.has-screens .help-crop {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .help-shot-highlight {
      transition: none;
    }
  }
  .help-screenshot-btn {
    display: block;
