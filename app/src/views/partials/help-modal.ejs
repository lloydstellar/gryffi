  // Opens on click, never on hover; Escape or a click elsewhere closes it.
  var TIP_TEXT = <%- safeJson({ more: t('help.tip.more') }) %>;
  var _openTip = null;
  function _closeTip(returnFocus) {
    if (!_openTip) return;
    var btn = _openTip.btn;
    _openTip.bubble.remove();
    btn.setAttribute('aria-expanded', 'false');
    _openTip = null;
    if (returnFocus) btn.focus();
  }
  function _toggleTip(btn) {
    if (_openTip && _openTip.btn === btn) { _closeTip(false); return; }
    _closeTip(false);
    var bubble = document.createElement('div');
    bubble.className = 'tip-bubble';
    bubble.setAttribute('role', 'status');
    var text = document.createElement('p');
    text.textContent = btn.getAttribute('data-tip') || '';
    bubble.appendChild(text);
    var article = btn.getAttribute('data-tip-article');
    if (article) {
      var more = document.createElement('button');
      more.type = 'button';
      more.className = 'tip-more';
      more.textContent = TIP_TEXT.more;
      more.addEventListener('click', function() {
        _closeTip(false);
        window.openHelpArticle(article);
      });
      bubble.appendChild(more);
    }
    btn.insertAdjacentElement('afterend', bubble);
    btn.setAttribute('aria-expanded', 'true');
    // Fixed under the button, so a scrolling panel never cuts it off; kept on the screen
    var rect = btn.getBoundingClientRect();
    var width = bubble.offsetWidth;
    bubble.style.left = Math.min(Math.max(8, rect.left - 8), window.innerWidth - width - 8) + 'px';
    var below = rect.bottom + 8;
    bubble.style.top = (below + bubble.offsetHeight > window.innerHeight - 8 ? Math.max(8, rect.top - 8 - bubble.offsetHeight) : below) + 'px';
    _openTip = { btn: btn, bubble: bubble };
    window._helpCount('tip', window._helpScreen().key, btn.getAttribute('data-tip-key') || '');
  }
  document.addEventListener('click', function(e) {
    var btn = e.target.closest && e.target.closest('.tip-btn');
