      e.preventDefault();
      e.stopPropagation();
      _toggleTip(btn);
      return;
    }
    if (_openTip && !_openTip.bubble.contains(e.target)) _closeTip(false);
  }, true);
  // The button moved away under it: close instead of floating in the wrong place
  window.addEventListener('scroll', function(e) {
