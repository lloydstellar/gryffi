  };
  
  // Popular topics for quick access (titles are translated via helpTranslations)
  var defaultTopics = [
    { id: 'dashboard', title: helpTranslations.topics.dashboard },
    { id: 'journey-builder', title: helpTranslations.topics.journeyBuilder },
    { id: 'ai-guides-overview', title: helpTranslations.topics.aiGuides },
    { id: 'invitations-overview', title: helpTranslations.topics.invitations },
    { id: 'analytics-overview', title: helpTranslations.topics.analytics },
    { id: 'organization-settings', title: helpTranslations.topics.settings }
  ];
  
  // Initialize modal handlers - run immediately since HTML is already parsed
  (function initHelpModal() {
    var modal = document.getElementById('helpModal');
    
    if (modal) {
      // Close handlers
      var closeBtn = document.getElementById('helpModalClose');
      if (closeBtn) closeBtn.addEventListener('click', closeHelpModal);
      
      var overlay = modal.querySelector('.help-modal-overlay');
      if (overlay) overlay.addEventListener('click', closeHelpModal);
      
      // Contact support button - close help and open support modal
      var contactSupportBtn = document.getElementById('helpContactSupportBtn');
      if (contactSupportBtn) {
        contactSupportBtn.addEventListener('click', function() {
          closeHelpModal();
          if (typeof window.openSupportModal === 'function') {
            window.openSupportModal();
          }
        });
      }
      
      // Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') {
          closeHelpModal();
        }
      });
      
      // Search handlers
      var searchInput = document.getElementById('helpSearchInput');
      var searchBtn = document.getElementById('helpSearchBtn');
      
      if (searchBtn) {
        searchBtn.addEventListener('click', function() {
          window._performHelpSearch(searchInput.value);
        });
      }
      
      if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            window._performHelpSearch(searchInput.value);
          }
        });
      }
      
      // Retry button
      var retryBtn = document.getElementById('helpRetryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() {
          window._performHelpSearch(searchInput.value);
        });
      }
    }
    
    // Sidebar help button (defined in sidebar.ejs before this partial)
    var sidebarHelpBtn = document.getElementById('sidebarHelpBtn');
    console.log('[Help] Init - sidebarHelpBtn:', !!sidebarHelpBtn, ', modal:', !!modal);
    if (sidebarHelpBtn) {
      sidebarHelpBtn.addEventListener('click', function(e) {
        console.log('[Help] Sidebar button clicked');
        e.preventDefault();
        e.stopPropagation();
        // Close mobile menu if open
        var sidebar = document.getElementById('sidebar');
        if (sidebar && sidebar.classList.contains('mobile-open')) {
          sidebar.classList.remove('mobile-open');
          var backdrop = document.getElementById('sidebarBackdrop');
          if (backdrop) {
            backdrop.classList.remove('show');
            backdrop.style.display = 'none';
          }
          document.body.style.overflow = '';
        }
        openHelpModal();
      });
    }
    
    // Builder help button (defined in builder.ejs)
    var builderHelpBtn = document.getElementById('builderHelpBtn');
    if (builderHelpBtn) {
      builderHelpBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openHelpModal('journey-builder');
      });
    }
  })();

  // Detect current context from URL (global helper)
  window._detectHelpContext = function() {
    var path = window.location.pathname;
    if (path.includes('/builder')) return 'journey-builder';
    if (path.includes('/guides')) return 'ai-guides';
    if (path.includes('/invitations')) return 'invitations';
    if (path.includes('/settings')) return 'settings';
    if (path.includes('/analytics')) return 'analytics';
    if (path.includes('/team')) return 'team';
    return 'dashboard';
  };
  
  // Reset modal to initial state (global helper)
  window._resetHelpModal = function() {
    var input = document.getElementById('helpSearchInput');
    if (input) input.value = '';
    window._showHelpState('quickTopics');
  };
  
  // Show a specific state (global helper)
  window._showHelpState = function(state) {
    var el;
    el = document.getElementById('helpQuickTopics');
    if (el) el.style.display = state === 'quickTopics' ? 'block' : 'none';
    el = document.getElementById('helpLoading');
    if (el) el.style.display = state === 'loading' ? 'flex' : 'none';
    el = document.getElementById('helpAnswer');
    if (el) el.style.display = state === 'answer' ? 'block' : 'none';
    el = document.getElementById('helpNoResults');
    if (el) el.style.display = state === 'noResults' ? 'flex' : 'none';
    el = document.getElementById('helpError');
    if (el) el.style.display = state === 'error' ? 'flex' : 'none';
  };
  
  // Load quick topics (global helper)
  window._loadHelpQuickTopics = function() {
    var grid = document.getElementById('helpTopicsGrid');
    if (!grid) return;
    grid.innerHTML = '';
    
    defaultTopics.forEach(function(topic) {
      var btn = document.createElement('button');
      btn.className = 'help-topic-btn';
      btn.innerHTML = (topicIcons[topic.id] || topicIcons['default']) + '<span>' + topic.title + '</span>';
      btn.onclick = function() {
        document.getElementById('helpSearchInput').value = topic.title;
        window._performHelpSearch(topic.title);
      };
      grid.appendChild(btn);
    });
  };
  
  // Perform search (global helper)
  window._performHelpSearch = async function(query) {
    if (!query || query.trim().length < 2) return;
    
    window._showHelpState('loading');
    
    try {
      var response = await fetch('/api/help/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query: query.trim(),
          context: _helpContext,
          language: _helpCurrentLanguage
        })
      });
      
      var data = await response.json();
      
      if (!data.success) {
        throw new Error(data.error || 'Search failed');
      }
      
      if (data.noResults || !data.answer) {
        window._showHelpState('noResults');
        return;
      }
      
      // Save search for later restoration
      _saveHelpSearch(query, data);
      
      // Display answer
      window._displayHelpAnswer(data);
      
    } catch (err) {
      console.error('Help search error:', err);
      window._showHelpState('error');
    }
  };
  
  // Format answer text with proper HTML
  function _formatAnswerText(text) {
    if (!text) return '';
    
    // Escape HTML first
    var escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    
    // Remove [[goto:/path]] and [[show:...]] tags (link is provided via button)
    escaped = escaped.replace(/\[\[goto:[^\]]+\]\]/g, '');
    escaped = escaped.replace(/\[\[show:[^\]]+\]\]/g, '');
    
    // Remove any raw URLs that AI might have generated
    escaped = escaped.replace(/https?:\/\/[^\s<]+/g, '');
    escaped = escaped.replace(/\/dashboard\/[^\s<,.)]+/g, '');
    
    // Convert **bold** text
    escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    
    // Convert *italic* text (single asterisks, but not inside words)
    escaped = escaped.replace(/(?<![a-zA-Z*])\*([^*\n]+)\*(?![a-zA-Z*])/g, '<em>$1</em>');
    
    // Convert `code` text (inline code)
    escaped = escaped.replace(/`([^`]+)`/g, '<code class="help-inline-code">$1</code>');
    
    // Split into lines for processing
    var lines = escaped.split('\n');
    var result = [];
    var inList = false;
    var listItems = [];
    var inTable = false;
    var tableRows = [];
    var tableHeaders = [];
    
    // Helper function to close open list
    function closeList() {
      if (inList && listItems.length > 0) {
        var isBullet = listItems[0].includes('help-bullet');
        var listTag = isBullet ? 'ul class="help-bullet-list"' : 'ol class="help-numbered-list"';
        result.push('<' + listTag + '>' + listItems.join('') + '</' + (isBullet ? 'ul' : 'ol') + '>');
        listItems = [];
        inList = false;
      }
    }
    
    // Helper function to close open table
    function closeTable() {
      if (inTable && (tableHeaders.length > 0 || tableRows.length > 0)) {
        var tableHtml = '<div class="help-table-wrapper"><table class="help-table">';
        if (tableHeaders.length > 0) {
          tableHtml += '<thead><tr>';
          tableHeaders.forEach(function(header) {
            tableHtml += '<th>' + header.trim() + '</th>';
          });
          tableHtml += '</tr></thead>';
        }
        if (tableRows.length > 0) {
          tableHtml += '<tbody>';
          tableRows.forEach(function(row) {
            tableHtml += '<tr>';
            row.forEach(function(cell) {
              tableHtml += '<td>' + cell.trim() + '</td>';
            });
            tableHtml += '</tr>';
          });
          tableHtml += '</tbody>';
        }
        tableHtml += '</table></div>';
        result.push(tableHtml);
        tableHeaders = [];
        tableRows = [];
        inTable = false;
      }
    }
    
    // Helper to parse table row cells
    function parseTableCells(line) {
      // Remove leading/trailing pipes and split by |
      var trimmed = line.replace(/^\||\|$/g, '');
      return trimmed.split('|').map(function(cell) { return cell.trim(); });
    }
    
    // Helper to check if line is a table separator (|---|---|)
    function isTableSeparator(line) {
      return /^\|?[\s\-:]+\|[\s\-:|]+\|?$/.test(line);
    }
    
    // Helper to check if line is a table row (| cell | cell |)
    function isTableRow(line) {
      return /^\|.+\|$/.test(line) || /^[^|]+\|[^|]+/.test(line);
    }
    
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i].trim();
      if (!line) continue;
      
      // Check for markdown table rows
      if (isTableRow(line)) {
        // Close any open list first
        closeList();
        
        // Check if this is a separator row (|---|---|)
        if (isTableSeparator(line)) {
          // This is the separator between header and body, skip it
          continue;
        }
        
        var cells = parseTableCells(line);
        
        if (!inTable) {
          // First row is the header
          inTable = true;
          tableHeaders = cells;
        } else {
          // Subsequent rows are body rows
          tableRows.push(cells);
        }
        continue;
      }
      
      // Not a table row - close any open table
      closeTable();
      
      // Check for markdown headers (##, ###, ####)
      var h4Match = line.match(/^####\s+(.+)$/);
      if (h4Match) {
        closeList();
        result.push('<h5 class="help-heading-4">' + h4Match[1] + '</h5>');
        continue;
      }
      
      var h3Match = line.match(/^###\s+(.+)$/);
      if (h3Match) {
        closeList();
        result.push('<h4 class="help-heading-3">' + h3Match[1] + '</h4>');
        continue;
      }
      
      var h2Match = line.match(/^##\s+(.+)$/);
      if (h2Match) {
        closeList();
        result.push('<h3 class="help-heading-2">' + h2Match[1] + '</h3>');
        continue;
      }
      
      // Check for numbered item (1. 2. 3. etc.)
      var numMatch = line.match(/^(\d+)\.\s+(.+)$/);
      if (numMatch) {
        if (!inList) {
          inList = true;
          listItems = [];
        }
        var stepContent = numMatch[2];
        // Check if there's a title pattern like "**Title**: description" or "Title: description"
        var titleMatch = stepContent.match(/^(?:\*\*)?([^:*]+)(?:\*\*)?:\s*(.+)$/);
        if (titleMatch) {
          listItems.push('<li><span class="help-list-number">' + numMatch[1] + '</span><div class="help-step-content"><span class="help-step-title">' + titleMatch[1].trim() + '</span><span class="help-step-desc">' + titleMatch[2].trim() + '</span></div></li>');
        } else {
          listItems.push('<li><span class="help-list-number">' + numMatch[1] + '</span><div class="help-step-content">' + stepContent + '</div></li>');
        }
        continue;
      }
      
      // Check for bullet point (- item or • item) - but not if it looks like a table separator
      var bulletMatch = line.match(/^[-•]\s+(.+)$/);
      if (bulletMatch && !isTableSeparator(line)) {
        if (!inList) {
          inList = true;
          listItems = [];
        }
        listItems.push('<li class="help-bullet">' + bulletMatch[1] + '</li>');
        continue;
      }
      
      // Not a list item - close any open list first
      closeList();
      
      // Regular paragraph
      result.push('<p>' + line + '</p>');
    }
    
    // Close any remaining list or table
    closeList();
    closeTable();
    
    return result.join('');
  }
  
  // Display answer (global helper)
  window._displayHelpAnswer = function(data) {
    // Set answer text with formatting
    var answerText = document.getElementById('helpAnswerText');
    var answerContent = document.getElementById('helpAnswerContent');
    var readMoreContainer = document.getElementById('helpReadMoreContainer');
    var readMoreBtn = document.getElementById('helpReadMoreBtn');
    var readMoreText = document.getElementById('helpReadMoreText');
    
    if (answerText) answerText.innerHTML = _formatAnswerText(data.answer);
    
    // Check if content is truncated and show "Read more" if needed
    if (answerContent && readMoreContainer && readMoreBtn) {
      // Reset state
      answerContent.classList.remove('truncated');
      readMoreBtn.classList.remove('expanded');
      readMoreContainer.style.display = 'none';
      if (readMoreText) readMoreText.textContent = helpTranslations.readMore;
      
      // Check after rendering if content is too tall
      setTimeout(function() {
        var contentHeight = answerContent.scrollHeight;
        var maxHeight = 400;
        
        if (contentHeight > maxHeight) {
          answerContent.classList.add('truncated');
          readMoreContainer.style.display = 'block';
          
          // Toggle expand/collapse
          readMoreBtn.onclick = function() {
            var isTruncated = answerContent.classList.contains('truncated');
            if (isTruncated) {
              answerContent.classList.remove('truncated');
              readMoreBtn.classList.add('expanded');
              if (readMoreText) readMoreText.textContent = helpTranslations.showLess;
            } else {
              answerContent.classList.add('truncated');
              readMoreBtn.classList.remove('expanded');
              if (readMoreText) readMoreText.textContent = helpTranslations.readMore;
            }
          };
        }
      }, 50);
    }
    
    // Link
    var linkContainer = document.getElementById('helpLinkContainer');
    var linkEl = document.getElementById('helpLink');
    if (data.link && linkEl && linkContainer) {
      linkEl.href = data.link;
      linkContainer.style.display = 'block';
    } else if (linkContainer) {
      linkContainer.style.display = 'none';
    }
    
    // Related topics
    var relatedContainer = document.getElementById('helpRelatedContainer');
    var relatedEl = document.getElementById('helpRelatedTopics');
    if (data.relatedTopics && data.relatedTopics.length > 0 && relatedEl && relatedContainer) {
      relatedEl.innerHTML = '';
      data.relatedTopics.forEach(function(topic) {
        var tag = document.createElement('button');
        tag.className = 'help-related-tag';
        tag.textContent = topic.title;
        tag.onclick = function() {
          document.getElementById('helpSearchInput').value = topic.title;
          window._performHelpSearch(topic.title);
        };
        relatedEl.appendChild(tag);
      });
      relatedContainer.style.display = 'block';
    } else if (relatedContainer) {
      relatedContainer.style.display = 'none';
    }
    
    window._showHelpState('answer');
  };
})();
</script>
