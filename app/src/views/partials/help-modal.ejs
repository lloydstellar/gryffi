<script>
console.log('[Help] Script starting...');
// Global help modal functions - defined immediately for availability
var _helpContext = '';
var _helpCurrentLanguage = '<%= language || 'en' %>';
var _helpCacheKey = 'gryffi_help_last_search';
var _helpCacheMaxAge = 10 * 60 * 1000; // 10 minutes

// Save search result to session storage
function _saveHelpSearch(query, data) {
  try {
    sessionStorage.setItem(_helpCacheKey, JSON.stringify({
      query: query,
      data: data,
      timestamp: Date.now()
    }));
  } catch (e) {
    console.warn('[Help] Could not save search:', e);
  }
}

// Get cached search if recent
function _getCachedHelpSearch() {
  try {
    var cached = sessionStorage.getItem(_helpCacheKey);
    if (!cached) return null;
    var parsed = JSON.parse(cached);
    var age = Date.now() - parsed.timestamp;
    if (age > _helpCacheMaxAge) {
      sessionStorage.removeItem(_helpCacheKey);
      return null;
    }
    return parsed;
  } catch (e) {
    return null;
  }
}

// Open help modal - globally available
function openHelpModal(context) {
  console.log('[Help] openHelpModal called with context:', context);
  _helpContext = context || window._detectHelpContext();
  var modal = document.getElementById('helpModal');
  console.log('[Help] modal element found:', !!modal);
  if (modal) {
    // Focus goes back here when the help closes
    if (modal.style.display !== 'flex') window._helpOpener = document.activeElement;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Check for cached recent search
    var cached = _getCachedHelpSearch();
    var input = document.getElementById('helpSearchInput');
    
    // Always clear the search input for a fresh question
    if (input) input.value = '';
    
    if (cached && cached.data) {
      // Show previous answer but keep search bar empty for new question
      window._displayHelpAnswer(cached.data);
      window._showHelpState('answer');
    } else {
      // Fresh start - show quick topics
      window._resetHelpModal();
      window._loadHelpQuickTopics();
    }
    
    // Focus on search input for quick typing
    if (input) input.focus();
    console.log('[Help] modal opened');
  }
}

// Close help modal - globally available
function closeHelpModal() {
  var modal = document.getElementById('helpModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    var opener = window._helpOpener;
    window._helpOpener = null;
    if (opener && typeof opener.focus === 'function' && document.contains(opener)) opener.focus();
  }
}

// Also expose on window for compatibility
window.openHelpModal = openHelpModal;
window.closeHelpModal = closeHelpModal;

(function() {
  // Translation strings
  var helpTranslations = <%- safeJson({
    searching: t('help.searching'),
    error: t('help.error'),
    noResults: t('help.noResults'),
    readMore: t('help.readMore') || 'Read more',
    showLess: t('help.showLess') || 'Show less',
    enlargeScreenshot: t('help.enlargeScreenshot'),
    closeScreenshot: t('help.closeScreenshot'),
    showMarker: t('help.showMarker'),
    screenshotNumber: t('help.screenshotNumber'),
    markerCrop: t('help.markerCrop'),
    answerReady: t('help.answerReady'),
    topics: {
      dashboard: t('help.topics.dashboard'),
      journeyBuilder: t('help.topics.journeyBuilder'),
      aiGuides: t('help.topics.aiGuides'),
      invitations: t('help.topics.invitations'),
      analytics: t('help.topics.analytics'),
      settings: t('help.topics.settings')
    }
  }) %>;
  
  // Quick topic icons
  var topicIcons = {
    'dashboard': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>',
    'journey-builder': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>',
    'ai-guides-overview': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>',
    'invitations-overview': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>',
    'analytics-overview': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
    'organization-settings': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>',
    'default': '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>'
  };
  
  // Popular topics for quick access (titles are translated via helpTranslations)
  var defaultTopics = [
    { id: 'dashboard', title: helpTranslations.topics.dashboard },
    { id: 'journey-builder', title: helpTranslations.topics.journeyBuilder },
    { id: 'ai-guides-overview', title: helpTranslations.topics.aiGuides },
    { id: 'invitations-overview', title: helpTranslations.topics.invitations },
    { id: 'analytics-overview', title: helpTranslations.topics.analytics },
    { id: 'organization-settings', title: helpTranslations.topics.settings }
  ];
  
  // Initialize modal handlers - run immediately since HTML is already parsed
  (function initHelpModal() {
    var modal = document.getElementById('helpModal');
    
    if (modal) {
      // Close handlers
      var closeBtn = document.getElementById('helpModalClose');
      if (closeBtn) closeBtn.addEventListener('click', closeHelpModal);
      
      var overlay = modal.querySelector('.help-modal-overlay');
      if (overlay) overlay.addEventListener('click', closeHelpModal);
      
      // Contact support button - close help and open support modal
      var contactSupportBtn = document.getElementById('helpContactSupportBtn');
      if (contactSupportBtn) {
        contactSupportBtn.addEventListener('click', function() {
          closeHelpModal();
          if (typeof window.openSupportModal === 'function') {
            window.openSupportModal();
          }
        });
      }
      
      // Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') {
          closeHelpModal();
        }
      });

      // Keep Tab within the help window
      modal.addEventListener('keydown', function(e) {
        if (e.key !== 'Tab') return;
        var focusable = Array.prototype.filter.call(
          modal.querySelectorAll('.help-modal-content button, .help-modal-content a[href], .help-modal-content input'),
          function(el) { return !el.disabled && el.offsetParent !== null; }
        );
        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
      
      // Search handlers
      var searchInput = document.getElementById('helpSearchInput');
      var searchBtn = document.getElementById('helpSearchBtn');
      
      if (searchBtn) {
        searchBtn.addEventListener('click', function() {
          window._performHelpSearch(searchInput.value);
        });
      }
      
      if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            window._performHelpSearch(searchInput.value);
          }
        });
      }
      
      // Retry button
      var retryBtn = document.getElementById('helpRetryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() {
          window._performHelpSearch(searchInput.value);
        });
      }
    }
    
    // Sidebar help button (defined in sidebar.ejs before this partial)
    var sidebarHelpBtn = document.getElementById('sidebarHelpBtn');
    console.log('[Help] Init - sidebarHelpBtn:', !!sidebarHelpBtn, ', modal:', !!modal);
    if (sidebarHelpBtn) {
      sidebarHelpBtn.addEventListener('click', function(e) {
        console.log('[Help] Sidebar button clicked');
        e.preventDefault();
        e.stopPropagation();
        // Close mobile menu if open
        var sidebar = document.getElementById('sidebar');
        if (sidebar && sidebar.classList.contains('mobile-open')) {
          sidebar.classList.remove('mobile-open');
          var backdrop = document.getElementById('sidebarBackdrop');
          if (backdrop) {
            backdrop.classList.remove('show');
            backdrop.style.display = 'none';
          }
          document.body.style.overflow = '';
        }
        openHelpModal();
      });
    }
    
    // Builder help button (defined in builder.ejs)
    var builderHelpBtn = document.getElementById('builderHelpBtn');
    if (builderHelpBtn) {
      builderHelpBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openHelpModal('journey-builder');
      });
    }
  })();

  // Detect current context from URL (global helper)
  window._detectHelpContext = function() {
    var path = window.location.pathname;
    if (path.includes('/builder')) return 'journey-builder';
    if (path.includes('/guides')) return 'ai-guides';
    if (path.includes('/invitations')) return 'invitations';
    if (path.includes('/settings')) return 'settings';
    if (path.includes('/analytics')) return 'analytics';
    if (path.includes('/team')) return 'team';
    return 'dashboard';
  };
  
  // Reset modal to initial state (global helper)
  window._resetHelpModal = function() {
    var input = document.getElementById('helpSearchInput');
    if (input) input.value = '';
    window._showHelpState('quickTopics');
  };
  
  // Show a specific state (global helper)
  window._showHelpState = function(state) {
    var el;
    el = document.getElementById('helpQuickTopics');
    if (el) el.style.display = state === 'quickTopics' ? 'block' : 'none';
    el = document.getElementById('helpLoading');
    if (el) el.style.display = state === 'loading' ? 'flex' : 'none';
    el = document.getElementById('helpAnswer');
    if (el) el.style.display = state === 'answer' ? '' : 'none';
    // The window is only wide for an answer with screenshots
    el = document.querySelector('#helpModal .help-modal-content');
    if (el && state !== 'answer') el.classList.remove('is-wide');
    el = document.getElementById('helpNoResults');
    if (el) el.style.display = state === 'noResults' ? 'flex' : 'none';
    el = document.getElementById('helpError');
    if (el) el.style.display = state === 'error' ? 'flex' : 'none';
  };
  
  // Load quick topics (global helper)
  window._loadHelpQuickTopics = function() {
    var grid = document.getElementById('helpTopicsGrid');
    if (!grid) return;
    grid.innerHTML = '';
    
    defaultTopics.forEach(function(topic) {
      var btn = document.createElement('button');
      btn.className = 'help-topic-btn';
      btn.innerHTML = (topicIcons[topic.id] || topicIcons['default']) + '<span>' + topic.title + '</span>';
      btn.onclick = function() {
        document.getElementById('helpSearchInput').value = topic.title;
        window._performHelpSearch(topic.title);
      };
      grid.appendChild(btn);
    });
  };
  
  // Perform search (global helper)
  window._performHelpSearch = async function(query) {
    if (!query || query.trim().length < 2) return;
    
    window._showHelpState('loading');
    
    try {
      var response = await fetch('/api/help/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query: query.trim(),
          context: _helpContext,
          language: _helpCurrentLanguage
        })
      });
      
      var data = await response.json();
      
      if (!data.success) {
        throw new Error(data.error || 'Search failed');
      }
      
      if (data.noResults || !data.answer) {
        window._showHelpState('noResults');
        return;
      }
      
      // Save search for later restoration
      _saveHelpSearch(query, data);
      
      // Display answer
      window._displayHelpAnswer(data);
      
    } catch (err) {
      console.error('Help search error:', err);
      window._showHelpState('error');
    }
  };
  
  // Format answer text with proper HTML
  function _formatAnswerText(text, markerNumbers) {
    if (!text) return '';
    
    // Escape HTML first
    var escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    
    // Remove [[goto:/path]] and [[show:...]] tags (link is provided via button)
    escaped = escaped.replace(/\[\[goto:[^\]]+\]\]/g, '');
    escaped = escaped.replace(/\[\[show:[^\]]+\]\]/g, '');
    
    // Remove any raw URLs that AI might have generated
    escaped = escaped.replace(/https?:\/\/[^\s<]+/g, '');
    escaped = escaped.replace(/\/dashboard\/[^\s<,.)]+/g, '');
    
    // Convert **bold** text
    escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    
    // Convert *italic* text (single asterisks, but not inside words)
    escaped = escaped.replace(/(?<![a-zA-Z*])\*([^*\n]+)\*(?![a-zA-Z*])/g, '<em>$1</em>');
    
    // Convert `code` text (inline code)
    escaped = escaped.replace(/`([^`]+)`/g, '<code class="help-inline-code">$1</code>');
    
    // Split into lines for processing
    var lines = escaped.split('\n');
    var result = [];
    var inList = false;
    var listItems = [];
    var inTable = false;
    var tableRows = [];
    var tableHeaders = [];
    
    // Helper function to close open list
    function closeList() {
      if (inList && listItems.length > 0) {
        var isBullet = listItems[0].includes('help-bullet');
        var listTag = isBullet ? 'ul class="help-bullet-list"' : 'ol class="help-numbered-list"';
        result.push('<' + listTag + '>' + listItems.join('') + '</' + (isBullet ? 'ul' : 'ol') + '>');
        listItems = [];
        inList = false;
      }
    }
    
    // Helper function to close open table
    function closeTable() {
      if (inTable && (tableHeaders.length > 0 || tableRows.length > 0)) {
        var tableHtml = '<div class="help-table-wrapper"><table class="help-table">';
        if (tableHeaders.length > 0) {
          tableHtml += '<thead><tr>';
          tableHeaders.forEach(function(header) {
            tableHtml += '<th>' + header.trim() + '</th>';
          });
          tableHtml += '</tr></thead>';
        }
        if (tableRows.length > 0) {
          tableHtml += '<tbody>';
          tableRows.forEach(function(row) {
            tableHtml += '<tr>';
            row.forEach(function(cell) {
              tableHtml += '<td>' + cell.trim() + '</td>';
            });
            tableHtml += '</tr>';
          });
          tableHtml += '</tbody>';
        }
        tableHtml += '</table></div>';
        result.push(tableHtml);
        tableHeaders = [];
        tableRows = [];
        inTable = false;
      }
    }
    
    // Helper to parse table row cells
    function parseTableCells(line) {
      // Remove leading/trailing pipes and split by |
      var trimmed = line.replace(/^\||\|$/g, '');
      return trimmed.split('|').map(function(cell) { return cell.trim(); });
    }
    
    // Helper to check if line is a table separator (|---|---|)
    function isTableSeparator(line) {
      return /^\|?[\s\-:]+\|[\s\-:|]+\|?$/.test(line);
    }
    
    // Helper to check if line is a table row (| cell | cell |)
    function isTableRow(line) {
      return /^\|.+\|$/.test(line) || /^[^|]+\|[^|]+/.test(line);
    }
    
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i].trim();
      if (!line) continue;
      
      // Check for markdown table rows
      if (isTableRow(line)) {
        // Close any open list first
        closeList();
        
        // Check if this is a separator row (|---|---|)
        if (isTableSeparator(line)) {
          // This is the separator between header and body, skip it
          continue;
        }
        
        var cells = parseTableCells(line);
        
        if (!inTable) {
          // First row is the header
          inTable = true;
          tableHeaders = cells;
        } else {
          // Subsequent rows are body rows
          tableRows.push(cells);
        }
        continue;
      }
      
      // Not a table row - close any open table
      closeTable();
      
      // Check for markdown headers (##, ###, ####)
      var h4Match = line.match(/^####\s+(.+)$/);
      if (h4Match) {
        closeList();
        result.push('<h5 class="help-heading-4">' + h4Match[1] + '</h5>');
        continue;
      }
      
      var h3Match = line.match(/^###\s+(.+)$/);
      if (h3Match) {
        closeList();
        result.push('<h4 class="help-heading-3">' + h3Match[1] + '</h4>');
        continue;
      }
      
      var h2Match = line.match(/^##\s+(.+)$/);
      if (h2Match) {
        closeList();
        result.push('<h3 class="help-heading-2">' + h2Match[1] + '</h3>');
        continue;
      }
      
      // Check for numbered item (1. 2. 3. etc.)
      var numMatch = line.match(/^(\d+)\.\s+(.+)$/);
      if (numMatch) {
        if (!inList) {
          inList = true;
          listItems = [];
        }
        var stepContent = numMatch[2];
        // Check if there's a title pattern like "**Title**: description" or "Title: description"
        var titleMatch = stepContent.match(/^(?:\*\*)?([^:*]+)(?:\*\*)?:\s*(.+)$/);
        if (titleMatch) {
          listItems.push('<li><span class="help-list-number">' + numMatch[1] + '</span><div class="help-step-content"><span class="help-step-title">' + titleMatch[1].trim() + '</span><span class="help-step-desc">' + titleMatch[2].trim() + '</span></div></li>');
        } else {
          listItems.push('<li><span class="help-list-number">' + numMatch[1] + '</span><div class="help-step-content">' + stepContent + '</div></li>');
        }
        continue;
      }
      
      // Check for bullet point (- item or • item) - but not if it looks like a table separator
      var bulletMatch = line.match(/^[-•]\s+(.+)$/);
      if (bulletMatch && !isTableSeparator(line)) {
        if (!inList) {
          inList = true;
          listItems = [];
        }
        // A bullet right after a numbered step belongs to that step
        var lastItem = listItems[listItems.length - 1];
        if (lastItem && !lastItem.includes('help-bullet')) {
          var subItem = '<li>' + bulletMatch[1] + '</li>';
          listItems[listItems.length - 1] = lastItem.endsWith('</ul></div></li>')
            ? lastItem.slice(0, -'</ul></div></li>'.length) + subItem + '</ul></div></li>'
            : lastItem.slice(0, -'</div></li>'.length) + '<ul class="help-sub-list">' + subItem + '</ul></div></li>';
          continue;
        }
        listItems.push('<li class="help-bullet">' + bulletMatch[1] + '</li>');
        continue;
      }
      
      // Not a list item - close any open list first
      closeList();
      
      // Regular paragraph
      result.push('<p>' + line + '</p>');
    }
    
    // Close any remaining list or table
    closeList();
    closeTable();
    
    var html = result.join('');
    // "(5)" points at marker 5 in the screenshot: show it like that marker, as a
    // button that highlights the marker when the screenshot has its position
    if (markerNumbers) {
      html = html.replace(/\((\d{1,2})\)/g, function(match, number) {
        var label = '<span class="sr-only">(</span>' + number + '<span class="sr-only">)</span>';
        if (markerNumbers.indexOf(number) === -1) return '<span class="help-marker">' + label + '</span>';
        return '<button type="button" class="help-marker" data-marker="' + number + '" aria-pressed="false" aria-label="' +
          helpTranslations.showMarker.replace('{{number}}', number) + '">' + label + '</button>';
      });
    }
    return html;
  }
  
  // Display answer (global helper)
  // Screenshots of the answer. Wide screens: a panel next to the answer that
  // shows one screenshot at a time (tabs when there are more). Narrow screens:
  // the screenshots below the answer. A click (or Enter) shows one full size.
  var _helpShots = { images: [], figures: [], tabs: [], active: 0, pinned: null };

  function _renderHelpScreenshots(images) {
    var container = document.getElementById('helpScreenshots');
    if (!container) return;
    container.innerHTML = '';
    _helpShots = { images: images, figures: [], tabs: [], active: 0, pinned: null };
    if (images.length > 1) {
      var tabs = document.createElement('div');
      tabs.className = 'help-shot-tabs';
      images.forEach(function(image, i) {
        var tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'help-shot-tab';
        tab.textContent = helpTranslations.screenshotNumber.replace('{{number}}', i + 1);
        tab.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
        tab.onclick = function() { _showHelpShot(i); };
        tabs.appendChild(tab);
        _helpShots.tabs.push(tab);
      });
      // Arrow keys move between the tabs
      tabs.addEventListener('keydown', function(e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var next = (_helpShots.active + (e.key === 'ArrowRight' ? 1 : -1) + images.length) % images.length;
        e.preventDefault();
        _showHelpShot(next);
        _helpShots.tabs[next].focus();
      });
      container.appendChild(tabs);
    }
    images.forEach(function(image, i) {
      var figure = document.createElement('div');
      figure.className = 'help-shot' + (i === 0 ? ' is-active' : '');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'help-screenshot-btn';
      btn.setAttribute('aria-label', helpTranslations.enlargeScreenshot);
      var img = document.createElement('img');
      img.src = image.src;
      img.alt = image.alt || '';
      btn.appendChild(img);
      var highlight = document.createElement('div');
      highlight.className = 'help-shot-highlight';
      highlight.setAttribute('aria-hidden', 'true');
      btn.appendChild(highlight);
      btn.onclick = function() { _openHelpLightbox(image, btn); };
      figure.appendChild(btn);
      container.appendChild(figure);
      _helpShots.figures.push(figure);
    });
    container.style.display = images.length ? '' : 'none';
  }

  function _showHelpShot(index) {
    _helpShots.active = index;
    _helpShots.figures.forEach(function(figure, i) { figure.classList.toggle('is-active', i === index); });
    _helpShots.tabs.forEach(function(tab, i) { tab.setAttribute('aria-pressed', i === index ? 'true' : 'false'); });
  }

  // The screenshot that holds a marker number, and the marker's position
  function _findHelpMarker(number) {
    for (var i = 0; i < _helpShots.images.length; i++) {
      var marker = (_helpShots.images[i].markers || {})[number];
      if (marker) return { index: i, marker: marker };
    }
    return null;
  }

  // Ring around the marker in the panel, the rest dimmed
  function _highlightHelpMarker(number) {
    _helpShots.figures.forEach(function(figure) { figure.querySelector('.help-shot-highlight').classList.remove('is-on'); });
    if (!number) return;
    var found = _findHelpMarker(number);
    if (!found) return;
    _showHelpShot(found.index);
    var m = found.marker;
    var highlight = _helpShots.figures[found.index].querySelector('.help-shot-highlight');
    highlight.style.left = (m.x * 100) + '%';
    highlight.style.top = (m.y * 100) + '%';
    highlight.style.width = (m.width * 100) + '%';
    highlight.style.height = (m.height * 100) + '%';
    highlight.classList.add('is-on');
  }

  // A zoomed-in part of the screenshot around the given markers
  function _helpCrop(image, numbers) {
    var rect = null;
    numbers.forEach(function(n) {
      var m = (image.markers || {})[n];
      if (!m) return;
      rect = rect ? {
        x1: Math.min(rect.x1, m.x), y1: Math.min(rect.y1, m.y),
        x2: Math.max(rect.x2, m.x + m.width), y2: Math.max(rect.y2, m.y + m.height)
      } : { x1: m.x, y1: m.y, x2: m.x + m.width, y2: m.y + m.height };
    });
    if (!rect) return null;
    var crop = document.createElement('div');
    crop.className = 'help-crop';
    crop.setAttribute('role', 'img');
    crop.setAttribute('aria-label', helpTranslations.markerCrop.replace('{{number}}', numbers.join(', ')));
    var img = document.createElement('img');
    img.alt = '';
    img.onload = function() {
      // Some room around the markers, within the image
      var ratio = img.naturalWidth / img.naturalHeight;
      var margin = 0.06;
      var x1 = Math.max(0, rect.x1 - margin / 2);
      var x2 = Math.min(1, rect.x2 + margin / 2);
      var y1 = Math.max(0, rect.y1 - margin * ratio / 2);
      var y2 = Math.min(1, rect.y2 + margin * ratio / 2);
      var w = x2 - x1;
      var h = y2 - y1;
      crop.style.aspectRatio = (w * ratio / h).toFixed(4);
      img.style.width = (100 / w) + '%';
      img.style.marginLeft = (-x1 / w * 100) + '%';
      // Vertical percentages of a margin refer to the width of the box
      img.style.marginTop = (-y1 / ratio / w * 100) + '%';
      crop.classList.add('is-ready');
    };
    img.src = image.src;
    crop.appendChild(img);
    return crop;
  }

  // Link the numbers in the answer to the screenshots: hover or focus shows the
  // marker in the panel, a click keeps it shown; narrow screens get a crop of
  // the screenshot after each step or paragraph with numbers
  function _linkHelpMarkers(answerText, images) {
    if (!answerText || !images.length) return;
    answerText.querySelectorAll('button.help-marker').forEach(function(btn) {
      var number = btn.getAttribute('data-marker');
      btn.addEventListener('mouseenter', function() { _highlightHelpMarker(number); });
      btn.addEventListener('focus', function() { _highlightHelpMarker(number); });
      // Leaving with the mouse goes back to the pinned or focused number
      btn.addEventListener('mouseleave', function() {
        var focused = document.activeElement;
        var focusedNumber = focused && focused.matches && focused.matches('button.help-marker') ? focused.getAttribute('data-marker') : null;
        _highlightHelpMarker(_helpShots.pinned || focusedNumber);
      });
      btn.addEventListener('blur', function() { _highlightHelpMarker(_helpShots.pinned); });
      btn.addEventListener('click', function() {
        _helpShots.pinned = _helpShots.pinned === number ? null : number;
        answerText.querySelectorAll('button.help-marker').forEach(function(other) {
          var pinned = other.getAttribute('data-marker') === _helpShots.pinned;
          other.classList.toggle('is-pinned', pinned);
          other.setAttribute('aria-pressed', pinned ? 'true' : 'false');
        });
        _highlightHelpMarker(_helpShots.pinned || number);
      });
    });
    var blocks = [];
    answerText.querySelectorAll('button.help-marker').forEach(function(btn) {
      // Within a step, the crop goes under all of its text (sub-items included)
      var block = btn.closest('.help-step-content, .help-bullet-list li, p, td') || btn.parentNode;
      if (blocks.indexOf(block) === -1) blocks.push(block);
    });
    blocks.forEach(function(block) {
      var numbers = [];
      block.querySelectorAll('button.help-marker').forEach(function(btn) {
        var n = btn.getAttribute('data-marker');
        if (numbers.indexOf(n) === -1) numbers.push(n);
      });
      var found = _findHelpMarker(numbers[0]);
      if (!found) return;
      var sameImage = numbers.filter(function(n) { var f = _findHelpMarker(n); return f && f.index === found.index; });
      var crop = _helpCrop(images[found.index], sameImage);
      if (!crop) return;
      if (block.tagName !== 'P') block.appendChild(crop);
      else block.parentNode.insertBefore(crop, block.nextSibling);
    });
  }

  function _openHelpLightbox(image, trigger) {
    var lightbox = document.getElementById('helpLightbox');
    if (!lightbox) {
      lightbox = document.createElement('div');
      lightbox.id = 'helpLightbox';
      lightbox.className = 'help-lightbox';
      lightbox.setAttribute('role', 'dialog');
      lightbox.setAttribute('aria-modal', 'true');
      var close = document.createElement('button');
      close.type = 'button';
      close.className = 'help-lightbox-close';
      close.setAttribute('aria-label', helpTranslations.closeScreenshot);
      close.textContent = '\u00d7';
      var img = document.createElement('img');
      lightbox.append(close, img);
      document.body.appendChild(lightbox);
      var hide = function() {
        lightbox.hidden = true;
        if (lightbox._trigger) lightbox._trigger.focus();
      };
      close.onclick = hide;
      lightbox.onclick = function(e) { if (e.target === lightbox) hide(); };
      lightbox.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { e.stopPropagation(); hide(); }
        if (e.key === 'Tab') { e.preventDefault(); close.focus(); }
      });
    }
    var big = lightbox.querySelector('img');
    big.src = image.src;
    big.alt = image.alt || '';
    lightbox.setAttribute('aria-label', image.alt || helpTranslations.enlargeScreenshot);
    lightbox._trigger = trigger;
    lightbox.hidden = false;
    lightbox.querySelector('.help-lightbox-close').focus();
  }
  
  window._displayHelpAnswer = function(data) {
    // Set answer text with formatting
    var answerText = document.getElementById('helpAnswerText');
    var answerContent = document.getElementById('helpAnswerContent');
    var readMoreContainer = document.getElementById('helpReadMoreContainer');
    var readMoreBtn = document.getElementById('helpReadMoreBtn');
    var readMoreText = document.getElementById('helpReadMoreText');
    
    var images = data.images || [];
    var markerNumbers = [];
    images.forEach(function(image) { Object.keys(image.markers || {}).forEach(function(n) { markerNumbers.push(n); }); });
    if (answerText) answerText.innerHTML = _formatAnswerText(data.answer, images.length ? markerNumbers : null);
    // Side by side only when the answer points at the screenshots
    var linked = !!(answerText && answerText.querySelector('button.help-marker'));
    var sideBySide = linked && window.matchMedia('(min-width: 1024px)').matches;
    
    // Check if content is truncated and show "Read more" if needed
    if (answerContent && readMoreContainer && readMoreBtn) {
      // Tabbing to a link or number in the hidden part shows the whole answer
      if (!answerContent._expandOnFocus) {
        answerContent._expandOnFocus = true;
        answerContent.addEventListener('focusin', function(e) {
          if (!answerContent.classList.contains('truncated')) return;
          answerContent.scrollTop = 0;
          if (e.target.getBoundingClientRect().bottom > answerContent.getBoundingClientRect().bottom - 60) readMoreBtn.onclick();
        });
      }
      // Reset state
      answerContent.classList.remove('truncated');
      readMoreBtn.classList.remove('expanded');
      readMoreContainer.style.display = 'none';
      if (readMoreText) readMoreText.textContent = helpTranslations.readMore;
      
      // Check after rendering if content is too tall; next to the screenshots
      // the whole answer stays visible, the window scrolls
      setTimeout(function() {
        var contentHeight = answerContent.scrollHeight;
        var maxHeight = 400;
        
        if (!sideBySide && contentHeight > maxHeight) {
          answerContent.classList.add('truncated');
          readMoreContainer.style.display = 'block';
          
          // Toggle expand/collapse
          readMoreBtn.onclick = function() {
            var isTruncated = answerContent.classList.contains('truncated');
            if (isTruncated) {
              answerContent.classList.remove('truncated');
              readMoreBtn.classList.add('expanded');
              if (readMoreText) readMoreText.textContent = helpTranslations.showLess;
            } else {
              answerContent.classList.add('truncated');
              readMoreBtn.classList.remove('expanded');
              if (readMoreText) readMoreText.textContent = helpTranslations.readMore;
            }
          };
        }
      }, 50);
    }
    
    _renderHelpScreenshots(images);
    _linkHelpMarkers(answerText, images);
    var answerEl = document.getElementById('helpAnswer');
    if (answerEl) answerEl.classList.toggle('has-screens', linked);
    var modalContent = document.querySelector('#helpModal .help-modal-content');
    if (modalContent) modalContent.classList.toggle('is-wide', linked);
    var screenshots = document.getElementById('helpScreenshots');
    if (screenshots) screenshots.classList.toggle('is-small', images.length > 0 && !linked);
    var status = document.getElementById('helpStatus');
    if (status) {
      status.textContent = '';
      setTimeout(function() { status.textContent = helpTranslations.answerReady; }, 100);
    }
    
    // Link
    var linkContainer = document.getElementById('helpLinkContainer');
    var linkEl = document.getElementById('helpLink');
    if (data.link && linkEl && linkContainer) {
      linkEl.href = data.link;
      linkContainer.style.display = 'block';
    } else if (linkContainer) {
      linkContainer.style.display = 'none';
    }
    
    // Related topics
    var relatedContainer = document.getElementById('helpRelatedContainer');
    var relatedEl = document.getElementById('helpRelatedTopics');
    if (data.relatedTopics && data.relatedTopics.length > 0 && relatedEl && relatedContainer) {
      relatedEl.innerHTML = '';
      data.relatedTopics.forEach(function(topic) {
        var tag = document.createElement('button');
        tag.className = 'help-related-tag';
        tag.textContent = topic.title;
        tag.onclick = function() {
          document.getElementById('helpSearchInput').value = topic.title;
          window._performHelpSearch(topic.title);
        };
        relatedEl.appendChild(tag);
      });
      relatedContainer.style.display = 'block';
    } else if (relatedContainer) {
      relatedContainer.style.display = 'none';
    }
    
    window._showHelpState('answer');
  };
})();
</script>
