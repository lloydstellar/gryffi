      open:       t('journeys.wizard.steps.branching.complexity.descriptions.open')
    }) %>
  };
  window.GryffiWizardConfig = {
    interfaceLanguage: <%- safeJson(typeof language !== 'undefined' ? language : 'en') %>,
    hasExistingGuides: <%= (typeof existingGuides !== 'undefined' && Array.isArray(existingGuides) && existingGuides.length > 0) ? 'true' : 'false' %>,
    guidesAtLimit: <%= (typeof subscriptionUsage !== 'undefined' && subscriptionUsage && subscriptionUsage.guides && subscriptionUsage.guides.isAtLimit) ? 'true' : 'false' %>
  };
</script>
<script src="/js/journey-wizard.js?v=<%= typeof appVersion !== 'undefined' ? appVersion : Date.now() %>" defer></script>
