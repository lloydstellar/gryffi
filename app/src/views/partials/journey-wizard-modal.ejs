    branchingDescriptions: <%- safeJson({
      subtle:     t('journeys.wizard.steps.branching.complexity.descriptions.subtle'),
      variation:  t('journeys.wizard.steps.branching.complexity.descriptions.variation'),
      routes:     t('journeys.wizard.steps.branching.complexity.descriptions.routes'),
