      none: t('journeys.wizard.steps.reward.options.none.label')
    }) %>,
    // Branching complexity slider labels — short tick text and longer per-stop
    // hints. Both arrays are keyed by the stop token so the JS can look them
    // up by current state.branchingComplexity without an index.
