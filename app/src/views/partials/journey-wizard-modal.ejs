      space:     t('journeys.wizard.steps.components.options.space.label'),
      reward:    t('journeys.wizard.steps.components.options.reward.label'),
      branching: t('journeys.wizard.steps.components.options.branching.label')
    }) %>,
    purposeLabels: <%- safeJson({
      onboarding: t('journeys.wizard.steps.purpose.options.onboarding.label'),
