      reading2: <%- safeJson(t('journeys.wizard.progress.status.reading2')) %>,
      thinking: <%- safeJson(t('journeys.wizard.progress.status.thinking')) %>,
      thinking2: <%- safeJson(t('journeys.wizard.progress.status.thinking2')) %>,
      thinking3: <%- safeJson(t('journeys.wizard.progress.status.thinking3')) %>,
      thinking4: <%- safeJson(t('journeys.wizard.progress.status.thinking4')) %>,
      thinking5: <%- safeJson(t('journeys.wizard.progress.status.thinking5')) %>,
      creating: <%- safeJson(t('journeys.wizard.progress.status.creating')) %>,
      creating2: <%- safeJson(t('journeys.wizard.progress.status.creating2')) %>,
      steps: <%- safeJson(t('journeys.wizard.progress.status.steps')) %>,
      steps2: <%- safeJson(t('journeys.wizard.progress.status.steps2')) %>,
      paths: <%- safeJson(t('journeys.wizard.progress.status.paths')) %>,
      guide: <%- safeJson(t('journeys.wizard.progress.status.guide')) %>,
      guide2: <%- safeJson(t('journeys.wizard.progress.status.guide2')) %>,
      knowledge: <%- safeJson(t('journeys.wizard.progress.status.knowledge')) %>,
      knowledge2: <%- safeJson(t('journeys.wizard.progress.status.knowledge2')) %>,
      knowledge3: <%- safeJson(t('journeys.wizard.progress.status.knowledge3')) %>,
      finishing: <%- safeJson(t('journeys.wizard.progress.status.finishing')) %>
    },
    errors: {
      generic: <%- safeJson(t('journeys.wizard.errors.generic')) %>,
      uploadTooLarge: <%- safeJson(t('journeys.wizard.errors.uploadTooLarge')) %>,
      uploadTooManyPages: <%- safeJson(t('journeys.wizard.errors.uploadTooManyPages')) %>,
      uploadUnsupportedType: <%- safeJson(t('journeys.wizard.errors.uploadUnsupportedType')) %>,
      uploadNoText: <%- safeJson(t('journeys.wizard.errors.uploadNoText')) %>,
      uploadGeneric: <%- safeJson(t('journeys.wizard.errors.uploadGeneric')) %>,
      parserUnavailable: <%- safeJson(t('journeys.wizard.errors.parserUnavailable')) %>,
      parserDisabled: <%- safeJson(t('journeys.wizard.errors.parserDisabled')) %>,
      guidesLimit: <%- safeJson(t('journeys.wizard.errors.guidesLimit')) %>,
      topicMinLength: <%- safeJson(t('journeys.wizard.steps.topic.minLengthError')) %>,
      titleRequired: <%- safeJson(t('journeys.wizard.errors.titleRequired')) %>,
      timeout: <%- safeJson(t('journeys.wizard.errors.timeout')) %>,
      rateLimit: <%- safeJson(t('journeys.wizard.errors.rateLimit')) %>,
      serviceUnavailable: <%- safeJson(t('journeys.wizard.errors.serviceUnavailable')) %>
    },
    guideKbDisabledHint: <%- safeJson(t('journeys.wizard.steps.guide.kbDisabledHint')) %>,
    summaryLabels: <%- safeJson({
      source: t('journeys.wizard.steps.summary.labels.source'),
      sourceDocument: t('journeys.wizard.steps.summary.labels.sourceDocument'),
      sourceDescribe: t('journeys.wizard.steps.summary.labels.sourceDescribe'),
      purpose: t('journeys.wizard.steps.summary.labels.purpose'),
      audience: t('journeys.wizard.steps.summary.labels.audience'),
      components: t('journeys.wizard.steps.summary.labels.components'),
      componentsNone: t('journeys.wizard.steps.summary.labels.componentsNone'),
      guide: t('journeys.wizard.steps.summary.labels.guide'),
      guideNone: t('journeys.wizard.steps.summary.labels.guideNone'),
      guideExisting: t('journeys.wizard.steps.summary.labels.guideExisting'),
      guideNewWithKb: t('journeys.wizard.steps.summary.labels.guideNewWithKb'),
      guideNewNoKb: t('journeys.wizard.steps.summary.labels.guideNewNoKb'),
      length: t('journeys.wizard.steps.summary.labels.length'),
      branching: t('journeys.wizard.steps.summary.labels.branching'),
      branchingYes: t('journeys.wizard.steps.summary.labels.branchingYes'),
      branchingNo: t('journeys.wizard.steps.summary.labels.branchingNo'),
