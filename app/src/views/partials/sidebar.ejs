<!-- Mobile Header (only visible on mobile) -->
<header class="mobile-header">
  <div class="mobile-header-left">
    <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="<%= t('nav.openMenu') %>">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <img src="/images/logos/Logo---illustrationonly-transparant-lightgreen-cropped.png" alt="Gryffi" class="mobile-logo">
  </div>
  <span class="mobile-page-title"><%
    // Derive page title from current path
    let mobileTitle = t('nav.dashboard');
    if (currentPath) {
      if (currentPath.startsWith('/dashboard/journeys')) mobileTitle = t('nav.journeys');
      else if (currentPath.startsWith('/dashboard/guides')) mobileTitle = t('nav.guides');
      else if (currentPath.startsWith('/dashboard/invitations')) mobileTitle = t('nav.invitations');
      else if (currentPath.startsWith('/dashboard/team')) mobileTitle = t('nav.team');
      else if (currentPath.startsWith('/dashboard/system-settings')) mobileTitle = t('nav.systemSettings');
      else if (currentPath.startsWith('/dashboard/analytics')) mobileTitle = t('nav.analytics');
      else if (currentPath.startsWith('/dashboard/subscription')) mobileTitle = t('subscription.title');
      else if (currentPath === '/dashboard/settings') mobileTitle = t('nav.settings');
      else if (currentPath.startsWith('/dashboard/installation')) mobileTitle = t('installation.nav');
    }
  %><%= mobileTitle %></span>
</header>

<!-- Sidebar backdrop (mobile overlay) -->
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="sidebar" id="sidebar">
  <!-- Close button (mobile only) -->
  <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="<%= t('nav.closeMenu') %>">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  
  <!-- Logo -->
  <div class="px-4 pt-4 pb-4">
    <img src="/images/logos/Logo---transparant-lightgreen-cropped.png" alt="Gryffi" style="height: 58px; width: auto; margin-left: -1px; margin-top: 4px; display: block;">
  </div>
  
  <!-- Navigation -->
  <nav class="flex-1 py-4">
    <a href="/dashboard" class="sidebar-link">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      <%= t('nav.dashboard') %>
    </a>
    
    <a href="/dashboard/journeys" class="sidebar-link">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
      </svg>
      <%= t('nav.journeys') %>
    </a>
    
    <a href="/dashboard/guides" class="sidebar-link">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
      </svg>
      <%= t('nav.guides') %>
    </a>
    
    <% if (!(user && user.role === 'viewer')) { %>
      <a href="/dashboard/invitations" class="sidebar-link <%= currentPath.startsWith('/dashboard/invitations') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <%= t('nav.invitations') %>
      </a>
    <% } %>
    
    <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
      <a href="/dashboard/team" class="sidebar-link <%= currentPath.startsWith('/dashboard/team') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <%= t('nav.team') %>
      </a>
    <% } %>

    <a href="/dashboard/settings" class="sidebar-link <%= currentPath === '/dashboard/settings' ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <%= t('nav.settings') %>
    </a>
    
    <% if (user && user.role === 'admin') { %>
      <a href="/dashboard/system-settings" class="sidebar-link <%= currentPath.startsWith('/dashboard/system-settings') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
        </svg>
        <%= t('nav.systemSettings') %>
      </a>
    <% } %>
    
    <% if (user && (user.role === 'admin' || user.role === 'manager')) { %>
    <a href="/dashboard/analytics" class="sidebar-link <%= currentPath && currentPath.startsWith('/dashboard/analytics') ? 'active' : '' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <%= t('nav.analytics') %>
    </a>
    <% } %>
    
    <% if (user && user.role === 'admin' && locals.isCommunity) { %>
      <a href="/dashboard/installation" class="sidebar-link <%= currentPath && currentPath.startsWith('/dashboard/installation') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
        </svg>
        <%= t('installation.nav') %>
        <% if (locals.updateAvailable) { %>
          <span class="ml-auto rounded-full bg-gryffi-accent px-2 py-0.5 text-xs font-semibold text-gryffi-primary-dark"><%= t('installation.updateBadge') %></span>
        <% } %>
      </a>
    <% } %>

    <% if (user && (user.role === 'admin' || user.role === 'manager') && !locals.isCommunity) { %>
      <a href="/dashboard/subscription" class="sidebar-link <%= currentPath && currentPath.startsWith('/dashboard/subscription') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
        </svg>
        <%= t('subscription.title') %>
      </a>
    <% } %>
  </nav>
  
  <!-- User section -->
  <div class="p-4 border-t border-white/10 sidebar-user-section">
    <div class="flex items-center gap-3 sidebar-user-row">
      <!-- Avatar -->
      <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white font-medium sidebar-avatar">
        <%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : (user && user.email ? user.email.charAt(0).toUpperCase() : 'U') %>
      </div>
      <!-- Name and Organization -->
      <div class="flex-1 min-w-0 sidebar-user-info">
        <p class="text-white font-medium text-sm truncate sidebar-user-name" data-user-fullname>
          <%= user ? (user.fullName || user.email) : t('common.user') %>
        </p>
        <p class="text-white/50 text-xs truncate sidebar-org-name" data-organization-name><%= organization ? organization.name : '' %></p>
      </div>
      <!-- Action buttons grouped together -->
      <div class="flex items-center gap-0.5 sidebar-user-actions">
        <button type="button" class="text-white/50 hover:text-white p-1.5 rounded-md hover:bg-white/10 transition-colors" title="<%= t('help.sidebarTooltip') %>" id="sidebarHelpBtn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </button>
        <a href="/logout" class="text-white/50 hover:text-white p-1.5 rounded-md hover:bg-white/10 transition-colors" title="<%= t('nav.signOut') %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</aside>

<!-- Mobile Menu JavaScript -->
<script>
(function() {
  const menuBtn = document.getElementById('mobileMenuBtn');
  const closeBtn = document.getElementById('sidebarCloseBtn');
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  
  if (!menuBtn || !sidebar || !backdrop) return;
  
  function openMenu() {
    sidebar.classList.add('mobile-open');
    backdrop.style.display = 'block';
    // Trigger reflow for animation
    backdrop.offsetHeight;
    backdrop.classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  
  function closeMenu() {
    sidebar.classList.remove('mobile-open');
    backdrop.classList.remove('show');
    document.body.style.overflow = '';
    // Hide backdrop after animation
    setTimeout(() => {
      if (!backdrop.classList.contains('show')) {
        backdrop.style.display = 'none';
      }
    }, 300);
  }
  
  // Open menu on hamburger click
  menuBtn.addEventListener('click', openMenu);
  
  // Close menu on close button click
  if (closeBtn) {
    closeBtn.addEventListener('click', closeMenu);
  }
  
  // Close menu on backdrop click
  backdrop.addEventListener('click', closeMenu);
  
  // Close menu on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && sidebar.classList.contains('mobile-open')) {
      closeMenu();
    }
  });
  
  // Close menu when clicking a nav link (for smoother UX)
  sidebar.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', function() {
      // Small delay to show the click feedback
      setTimeout(closeMenu, 150);
    });
  });
  
})();
</script>
