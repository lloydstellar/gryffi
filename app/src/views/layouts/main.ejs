<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gryffi</title>
  <link rel="icon" href="/images/logos/Logo---illustration-only-cropped-transparant.png" type="image/png">
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
  <!-- Load app.js in head to ensure window.gryffi is available before inline scripts -->
  <script src="/js/app.js"></script>
</head>
<body class="bg-gryffi-bg">
  
  <% if (typeof user !== 'undefined' && user) { %>
    <%- include('../partials/sidebar') %>
    <%- include('../partials/support-modal') %>
    <%- include('../partials/help-modal') %>
    <%- include('../partials/onboarding-modal') %>
    
    <main class="main-content">
      <%- body %>
    </main>
  <% } else { %>
    <main>
      <%- body %>
    </main>
  <% } %>
</body>
</html>

